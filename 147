            else bind(btn, "BackgroundColor3", "Accent") btn.TextColor3 = onAccent() end
        else bind(btn, "BackgroundColor3", "Elevated") end
        btn.Activated:Connect(function()
            dialog:Close()
            if b.Callback then
                task.spawn(function()
                    local ok, err = pcall(b.Callback)
                    if not ok then Nihon:MakeNotification({Name = "Action failed", Content = tostring(err), Type = "Error"}) end
                end)
            end
        end)
    end
    layer.Activated:Connect(function() if cfg.Dismissable ~= false then dialog:Close() end end)
    play(layer, 0.25, {BackgroundTransparency = 0.55})
    play(box, 0.25, {GroupTransparency = 0})
    play(sc, 0.4, {Scale = 1}, Enum.EasingStyle.Back)
    return dialog
end

