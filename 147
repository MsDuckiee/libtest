    function dialog:Close()
        if closed then return end
        closed = true
        play(layer, 0.2, {BackgroundTransparency = 1})
        play(box, 0.2, {GroupTransparency = 1})
        play(sc, 0.2, {Scale = 0.94})
        task.delay(0.3, function() layer:Destroy() end)
