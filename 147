        local v, s = viewport(), hudFrame.AbsoluteSize
        return Vector2.new(math.clamp(p.X, 0, math.max(0, v.X - s.X)), math.clamp(p.Y, 0, math.max(0, v.Y - s.Y)))
    end,
})
onTheme(function() if Hud.enabled then hudRestyle() end end)

