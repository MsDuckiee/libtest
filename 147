local Metrics = {fps = 60, ping = 0, mem = 0}
do
    local frames, clock, sample = 0, 0, 0
    keep(RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1 clock = clock + dt sample = sample + dt
        if clock >= 0.5 then
            Metrics.fps = math.floor(frames / clock + 0.5)
