        {"Membership", (tostring(LocalPlayer.MembershipType):gsub("Enum.MembershipType.", ""))},
        {"Team", LocalPlayer.Team and LocalPlayer.Team.Name or "None"},
        {"Health", hum and (math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)) or "-"},
        {"WalkSpeed", hum and string.format("%.0f", hum.WalkSpeed) or "-"},
        {"JumpPower", hum and string.format("%.0f", hum.UseJumpPower and hum.JumpPower or hum.JumpHeight) or "-"},
        {"Position", pos and string.format("%d, %d, %d", pos.X, pos.Y, pos.Z) or "-"},
        {"FPS", Metrics.fps .. ""},
        {"Ping", Metrics.ping .. " ms"},
        {"Memory", Metrics.mem .. " MB"},
        {"Players", #Players:GetPlayers() .. " / " .. Players.MaxPlayers},
