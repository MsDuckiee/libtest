function Stat.humanoid()
    local ch = LocalPlayer.Character
    return ch and ch:FindFirstChildOfClass("Humanoid")
end

function Stat.age()
    local d = LocalPlayer.AccountAge or 0
    if d >= 365 then return string.format("%.1f yrs", d / 365) end
    return d .. " days"
end

function Stat.session()
    local s = math.floor(os.clock() - (Nihon.Started or os.clock()))
    return string.format("%02d:%02d:%02d", math.floor(s / 3600), math.floor(s / 60) % 60, s % 60)
end

function Stat.rows()
    local hum = Stat.humanoid()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local pos = root and root.Position
    local rows = {
        {"Display name", LocalPlayer.DisplayName},
        {"Username", "@" .. LocalPlayer.Name},
