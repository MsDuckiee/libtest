function NovaLib:MakeNotification(NotificationConfig)
    task.spawn(function()
        NotificationConfig.Name = NotificationConfig.Name or "Notification"
        NotificationConfig.Content = NotificationConfig.Content or ""
        NotificationConfig.Image = NotificationConfig.Image or "rbxassetid://4483362458"
        NotificationConfig.Time = NotificationConfig.Time or 5
        NotificationConfig.Color = NotificationConfig.Color or Color3.fromRGB(90, 140, 255)

        local notifParent = SetProps(MakeElement("TFrame"), {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Parent = NotificationHolder
        })

        local notifFrame = SetChildren(SetProps(MakeElement("RoundFrame", Color3.fromRGB(25, 25, 30), 0, 10), {
            Parent = notifParent,
            Size = UDim2.new(1, 0, 0, 0),
            Position = UDim2.new(1, -60, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y
        }), {
            MakeElement("Stroke", Color3.fromRGB(70, 70, 80), 1.2),
            MakeElement("Padding", 12, 12, 12, 12),
            SetProps(MakeElement("Frame", NotificationConfig.Color), {
                Size = UDim2.new(0, 3, 1, 0),
                Position = UDim2.new(0, 0, 0, 0)
            }),
            SetProps(MakeElement("Image", NotificationConfig.Image), {
                Size = UDim2.new(0, 22, 0, 22),
                Position = UDim2.new(0, 12, 0, 0),
                ImageColor3 = NotificationConfig.Color,
                Name = "Icon"
            }),
            SetProps(MakeElement("Label", NotificationConfig.Name, 15), {
                Size = UDim2.new(1, -40, 0, 22),
                Position = UDim2.new(0, 40, 0, 0),
                Font = Enum.Font.GothamBold,
                Name = "Title"
            }),
            SetProps(MakeElement("Label", NotificationConfig.Content, 13), {
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.new(0, 0, 0, 28),
                Font = Enum.Font.Gotham,
                Name = "Content",
                AutomaticSize = Enum.AutomaticSize.Y,
                TextColor3 = Color3.fromRGB(200, 200, 210),
                TextWrapped = true
            })
        })

        TweenService:Create(notifFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {
            Position = UDim2.new(0, 0, 0, 0)
        }):Play()

        task.wait(NotificationConfig.Time - 0.8)

        TweenService:Create(notifFrame.Icon, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {
            ImageTransparency = 1
        }):Play()
        TweenService:Create(notifFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quint), {
            BackgroundTransparency = 0.7
        }):Play()

        task.wait(0.3)

        TweenService:Create(notifFrame.UIStroke, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {
            Transparency = 0.9
        }):Play()
        TweenService:Create(notifFrame.Title, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {
            TextTransparency = 0.5
        }):Play()
        TweenService:Create(notifFrame.Content, TweenInfo.new(0.5, Enum.EasingStyle.Quint), {
            TextTransparency = 0.6
        }):Play()

        task.wait(0.1)

        notifFrame:TweenPosition(UDim2.new(1, 30, 0, 0), "In", "Quint", 0.7, true)
        task.wait(0.8)
        notifFrame:Destroy()
    end)
end

-- Initialize library
function NovaLib:Init()
    if NovaLib.SaveCfg then
        pcall(function()
            local configPath = NovaLib.Folder .. "/" .. game.GameId .. ".json"
            if isfile(configPath) then
                LoadCfg(readfile(configPath))
                NovaLib:MakeNotification({
                    Name = "Configuration",
                    Content = "Auto-loaded config for game " .. game.GameId,
                    Time = 4
                })
            end
        end)
    end
end

