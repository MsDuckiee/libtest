-- Load from GitHub (fix your URL: /main/ not /heads/main/)
local NovaLib = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/MsDuckiee/libtest/main/nova"
))()

local win = NovaLib:Window({
    Title = "Aurora Hub",
    Subtitle = "v2.0 — next-gen",
    Size = UDim2.new(0, 720, 0, 460),
})

-- Main tab
local main = win:Tab({ Name = "Home", Icon = "⌂" })
local sec  = main:Section({ Name = "Movement" })

local speed = sec:Slider({
    Name = "Walk Speed", Min = 16, Max = 300, Default = 16,
    ValueName = "spd", Flag = "speed",
    Callback = function(v)
        local h = game.Players.LocalPlayer.Character
              and game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = v end
    end,
})

local fly = sec:Toggle({
    Name = "Fly", Flag = "fly",
    Callback = function(on) print("Fly:", on) end,
})

local jp = sec:Slider({
    Name = "Jump Power", Min = 50, Max = 500, Default = 50,
    ValueName = "jp", Flag = "jp",
    Callback = function(v)
        local h = game.Players.LocalPlayer.Character
              and game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then h.JumpPower = v end
    end,
})

-- Cross-element linking: Fly on → jump power disabled
NovaLib:Link("fly", "jp", function(v) return v end)

-- Visuals tab with dropdown + colorpicker
local vis  = win:Tab({ Name = "Visuals", Icon = "◉" })
local vsec = vis:Section({ Name = "ESP" })

vsec:Toggle({ Name = "Player ESP", Flag = "esp" })
vsec:Dropdown({
    Name = "ESP Mode", Options = {"Box","Name","Health","Skeleton"},
    Default = "Box", Flag = "espmode",
})
vsec:Colorpicker({
    Name = "ESP Color", Default = Color3.fromRGB(120,130,255),
    Flag = "espcolor",
})
vsec:Dropdown({
    Name = "Players (multi)", Multi = true,
    Options = {"alice","bob","charlie"}, Default = {},
    Callback = function(arr) print("Selected:", table.concat(arr, ", ")) end,
})

-- Settings
local set  = win:Tab({ Name = "Settings", Icon = "⚙" })
local ssec = set:Section({ Name = "Theme" })
ssec:Dropdown({
    Name = "Theme", Options = NovaLib:GetThemes(),
    Default = "Aurora",
    Callback = function(v) NovaLib:SetTheme(v) end,
})

ssec:Keybind({
    Name = "Panic Key", Default = Enum.KeyCode.P,
    Callback = function() win:Hide() end,
})

ssec:Button({ Name = "Save Config", Callback = function()
    NovaLib:SaveConfig("mycfg")
    NovaLib:Notify({Name="Saved", Content="Config saved!", Time=3})
end })

-- Notify + palette hint
NovaLib:Notify({
    Name = "Loaded",
    Content = "Press RightShift to toggle • Ctrl+K for command palette",
    Time = 6,
})
