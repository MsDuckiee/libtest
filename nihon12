function Nihon:Dialog(cfg)
    cfg = cfg or {}
    local layer = mk("TextButton", {Name = "Dialog", Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
        ZIndex = 200, Parent = Root})
    local w = 340
    local box = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0,
        ZIndex = 201, Parent = layer})
    bind(box, "BackgroundColor3", "Surface")
    round(box, 12)
    outline(box, "Stroke", 1, 0)
    local sc = mk("UIScale", {Scale = 0.9, Parent = box})
    local col = mk("Frame", {Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = box})
    inset(col, 20, 20, 16, 20)
    stack(col, 8)
    tx("TextLabel", {Text = tostring(cfg.Title or "Confirm"), TextSize = 15,
        Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, Parent = col}, 3)
    if cfg.Content and cfg.Content ~= "" then
        tx("TextLabel", {Text = tostring(cfg.Content), TextSize = 12,
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            TextWrapped = true, LayoutOrder = 2, Parent = col}, 1, "Sub")
    end
    local row = mk("Frame", {Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1, LayoutOrder = 3, Parent = col})
    mk("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row})
    local dialog = {}
    local closed = false
    function dialog:Close()
        if closed then return end
        closed = true
        play(layer, 0.2, {BackgroundTransparency = 1})
        play(box, 0.2, {BackgroundTransparency = 1})
        play(sc, 0.25, {Scale = 0.9}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.3, function() pcall(function() layer:Destroy() end) end)
    end
    for i, b in ipairs(cfg.Buttons or {{Name = "OK", Primary = true}}) do
        local label = tostring(b.Name or "OK")
        local size = TextService:GetTextSize(label, 12, Fonts[currentFont][3], Vector2.new(400, 30))
        local btn = tx("TextButton", {Text = label,
            Size = UDim2.fromOffset(math.max(80, size.X + 28), 32),
            LayoutOrder = i, TextXAlignment = Enum.TextXAlignment.Center,
            BackgroundTransparency = 0, ZIndex = 202, Parent = row}, 3)
        round(btn, 7)
        btn.MouseEnter:Connect(function() play(btn, 0.12, {BackgroundTransparency = 0.15}) end)
        btn.MouseLeave:Connect(function() play(btn, 0.15, {BackgroundTransparency = 0}) end)
        if b.Primary then
            if b.Danger then btn.BackgroundColor3 = Pal.Error btn.TextColor3 = Color3.new(1, 1, 1)
            else bind(btn, "BackgroundColor3", "Accent") btn.TextColor3 = onAccent() end
        else bind(btn, "BackgroundColor3", "Elevated") end
        btn.Activated:Connect(function()
            dialog:Close()
            if b.Callback then
                task.spawn(function()
                    local ok, err = pcall(b.Callback)
                    if not ok then Nihon:MakeNotification({Name = "Error",
                        Content = tostring(err), Type = "Error"}) end
                end)
            end
        end)
    end
    layer.Activated:Connect(function() if cfg.Dismissable ~= false then dialog:Close() end end)
    play(layer, 0.25, {BackgroundTransparency = 0.6})
    play(box, 0.25, {BackgroundTransparency = 0})
    play(sc, 0.4, {Scale = 1}, Enum.EasingStyle.Back)
    return dialog
end

