local noteLayer = mk("Frame", {Name = "Notifications", BackgroundTransparency = 1,
    Size = UDim2.fromScale(1, 1), ZIndex = 100, Parent = Root})

local function noteWidth() return 290 end

local function relayout()
    local v = viewport()
    local y = v.Y - 20
    for i = #Notes.active, 1, -1 do
        local n = Notes.active[i]
        local h = n.frame.AbsoluteSize.Y
        if h < 5 then h = n.height or 72 end
        y = y - h - 10
        if not n.dragging then
            play(n.frame, 0.35, {Position = UDim2.new(1, -20, 0, y)})
        end
    end
end

local function promoteQueue()
    while #Notes.active < Notes.max and #Notes.queue > 0 do
        local entry = table.remove(Notes.queue, 1)
        spawnNote(entry)
    end
end

local function dismissNote(n, fast)
    if n.dying then return end
    n.dying = true
    for i, x in ipairs(Notes.active) do
        if x == n then table.remove(Notes.active, i) break end
    end
    local dur = fast and 0.2 or 0.35
    play(n.frame, dur, {GroupTransparency = 1})
    play(n.frame, dur, {Position = UDim2.new(1, 320, 0, n.frame.Position.Y.Offset)},
        nil, Enum.EasingDirection.In)
    task.delay(dur + 0.1, function() if n.frame then n.frame:Destroy() end end)
    relayout() promoteQueue()
end

local noteLoop
local function ensureNoteLoop()
    if noteLoop then return end
    noteLoop = RunService.Heartbeat:Connect(function(dt)
        local now = os.clock()
        for i = #Notes.active, 1, -1 do
            local n = Notes.active[i]
            if n and not n.dying then
                if n.hover then n.expires = n.expires + dt end
                local remain = n.expires - now
                if remain <= 0 then dismissNote(n)
                elseif n.bar then
                    n.bar.Size = UDim2.new(math.clamp(remain / n.time, 0, 1), 0, 0, 3)
                end
            end
        end
        if #Notes.active == 0 and noteLoop then noteLoop:Disconnect() noteLoop = nil end
    end)
end

local function bumpCount(n)
    n.count = n.count + 1
    if n.badge then
        n.badge.Text = n.count > 1 and (n.count .. "x") or ""
        n.badge.Visible = n.count > 1
        pop(n.badge, 1.3, 0.35)
    end
    if n.disc then
        local sc = n.disc:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
        sc.Parent = n.disc sc.Scale = 1.2
        play(sc, 0.32, {Scale = 1}, Enum.EasingStyle.Back)
    end
    n.expires = os.clock() + n.time
end

