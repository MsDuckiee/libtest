    -- KEYBIND
    function E:AddBind(o)
        o = o or {}
        local label = tostring(o.Name or "Keybind")
        local c = card(CARD_H, true)
        nameLabel(c, label, UDim2.new(1, -100, 1, 0))
        local chip = tx("TextButton", {AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(70, 24),
            TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 16, Parent = c}, 2, "Sub")
        bind(chip, "BackgroundColor3", "Elevated")
        chip.BackgroundTransparency = 0
        round(chip, 6)
        chip.MouseEnter:Connect(function() play(chip, 0.12, {BackgroundTransparency = 0.2}) end)
        chip.MouseLeave:Connect(function() play(chip, 0.15, {BackgroundTransparency = 0}) end)

        local obj = {Value = o.Default, Binding = false}
        local banned = {[Enum.KeyCode.Unknown] = true, [Enum.KeyCode.Return] = true, [Enum.KeyCode.Tab] = true}
        local function keyName(k)
            if not k then return "None" end
            local map = {LeftShift = "LShift", RightShift = "RShift",
                LeftControl = "LCtrl", RightControl = "RCtrl",
                LeftAlt = "LAlt", RightAlt = "RAlt"}
            return map[k.Name] or k.Name
        end
        local function refresh()
            chip.Text = obj.Binding and "…" or (obj.Value and keyName(obj.Value) or "None")
            chip.TextColor3 = obj.Value and Pal.Accent or Pal.Sub
        end
        function obj:Set(k, silent)
            obj.Value = k obj.Binding = false
            chip.BackgroundColor3 = Pal.Elevated
            refresh()
            if not silent then queueSave() end
        end
        function obj:Get() return obj.Value end
        chip.Activated:Connect(function()
            if obj:IsLocked() then return end
            obj.Binding = true
            chip.BackgroundColor3 = Pal.Accent
            chip.TextColor3 = Color3.new(1, 1, 1)
            refresh()
        end)
        keep(UserInputService.InputBegan:Connect(function(input, gpe)
            if obj.Binding then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode == Enum.KeyCode.Escape then obj:Set(nil)
                    elseif not banned[input.KeyCode] then obj:Set(input.KeyCode) end
                elseif input.UserInputType == Enum.UserInputType.MouseButton2
                    or input.UserInputType == Enum.UserInputType.MouseButton3 then
                    obj:Set(input.UserInputType)
                end
                return
            end
            if gpe or not obj.Value or obj:IsLocked() then return end
            if input.KeyCode == obj.Value or input.UserInputType == obj.Value then
                task.spawn(function()
                    local ok, err = pcall(o.Callback or function() end, true)
                    if not ok then fail(c, label, err) end
                end)
            end
        end))
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v, true) end)
        decorate(obj, c, o, "Keybind")
        obj:Set(o.Default, true)
        return obj
    end

    -- DROPDOWN
    local function buildDropdown(o, multi)
        o = o or {}
        local label = tostring(o.Name or (multi and "Multi Select" or "Dropdown"))
        local c = card(CARD_H, true)
        nameLabel(c, label, UDim2.new(0.5, 0, 1, 0))
        local valLbl = tx("TextLabel", {AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -32, 0.5, 0), Size = UDim2.new(0.5, 0, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Right,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextSize = 12, ZIndex = 15, Parent = c}, 2, "Sub")
        local arrow = makeIcon(c, "chevron-down", 14, "Sub", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0), ZIndex = 15})

        local obj = {Options = o.Options or {}, Value = multi and {} or nil, IsOpen = false}
        local firer
        local function selected(opt)
            if multi then return obj.Value[opt] == true end
            return obj.Value == opt
        end
        local function orderedSelection()
            local out = {}
            for _, opt in ipairs(obj.Options) do
                if obj.Value[opt] then out[#out + 1] = opt end
            end
            return out
        end
        local function summary()
            if multi then
                local list = orderedSelection()
                if #list == 0 then return "None" end
                if #list <= 2 then return table.concat(list, ", ") end
                return #list .. " selected"
            end
            return obj.Value ~= nil and tostring(obj.Value) or "None"
        end
        local function current()
            if multi then return orderedSelection() end
            return obj.Value
        end
        firer = makeFirer(function()
            if multi then return table.concat(orderedSelection(), "\0") end
            return obj.Value
        end, function()
            local ok, err = pcall(o.Callback or function() end, current())
            if not ok then fail(c, label, err) end
        end)

        function obj:Close()
            if obj.IsOpen then
                obj.IsOpen = false
                popupClose()
                play(arrow.Glyph, 0.22, {Rotation = 0}, Enum.EasingStyle.Back)
            end
        end
        function obj:Open()
            if obj.IsOpen or obj:IsLocked() then return end
            obj.IsOpen = true
            play(arrow.Glyph, 0.28, {Rotation = 180}, Enum.EasingStyle.Back)

            local useSearch = #obj.Options > 8
            local rowH = 38
            local maxRows = math.min(#obj.Options, 7)
            local searchH = useSearch and 44 or 0
            local popH = maxRows * rowH + searchH + 16

            Popup.open(c, {
                width = math.max(c.AbsoluteSize.X / math.max(currentScale, 0.01), 180),
                height = popH,
                align = "right",
                owner = obj,
                onClose = function()
                    obj.IsOpen = false
                    play(arrow.Glyph, 0.22, {Rotation = 0}, Enum.EasingStyle.Back)
                end,
                build = function(frame, w, h)
                    inset(frame, 8, 8, 8, 8)

                    local listOffset = 0
                    local filter = ""

                    if useSearch then
                        local search = tx("TextBox", {
                            Size = UDim2.new(1, 0, 0, 32),
                            PlaceholderText = "Search...",
                            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 62, Parent = frame})
                        bind(search, "BackgroundColor3", "Elevated")
                        search.BackgroundTransparency = 0
                        round(search, 6)
                        inset(search, 0, 10, 0, 10)
                        search:GetPropertyChangedSignal("Text"):Connect(function()
                            filter = search.Text:lower()
                        end)
                        listOffset = 40
                    end

                    local list = mk("ScrollingFrame", {
                        Position = UDim2.fromOffset(0, listOffset),
                        Size = UDim2.new(1, 0, 1, -listOffset),
                        BackgroundTransparency = 1,
                        ScrollBarThickness = 2, ScrollBarImageTransparency = 0.6,
                        CanvasSize = UDim2.new(),
                        AutomaticCanvasSize = Enum.AutomaticSize.Y,
                        ZIndex = 62, Parent = frame})
                    stack(list, 2)

                    local rowCache = {}
                    local function rebuild()
                        for _, r in ipairs(rowCache) do pcall(function() r:Destroy() end) end
                        rowCache = {}
                        local shown = 0
                        for i, opt in ipairs(obj.Options) do
                            local text = tostring(opt)
                            if filter == "" or text:lower():find(filter, 1, true) then
                                shown = shown + 1
                                local row = mk("TextButton", {
                                    Size = UDim2.new(1, 0, 0, 34),
                                    BackgroundColor3 = Color3.new(1, 1, 1),
                                    BackgroundTransparency = 1,
                                    LayoutOrder = shown, ZIndex = 63, Parent = list})
                                round(row, 6)
                                local lbl = tx("TextLabel", {
                                    Text = text, TextSize = 13,
                                    Position = UDim2.fromOffset(12, 0),
                                    Size = UDim2.new(1, -30, 1, 0),
                                    TextTruncate = Enum.TextTruncate.AtEnd,
                                    ZIndex = 64, Parent = row}, 2)
                                row.MouseEnter:Connect(function()
                                    play(row, 0.12, {BackgroundTransparency = 0.88})
                                end)
                                row.MouseLeave:Connect(function()
                                    play(row, 0.15, {BackgroundTransparency = 1})
                                end)
                                row.Activated:Connect(function()
                                    if multi then
                                        obj.Value[opt] = (not obj.Value[opt]) or nil
                                        if not obj.Value[opt] then obj.Value[opt] = nil end
                                        valLbl.Text = summary()
                                        firer.Fire() queueSave()
                                    else
                                        obj:Set(opt)
                                        obj:Close()
                                    end
                                end)
                                rowCache[#rowCache + 1] = row
                            end
                        end
                    end
                    rebuild()

                    if useSearch then
                        task.spawn(function()
                            while Popup.current and Popup.current.owner == obj do
                                task.wait(0.15)
                                rebuild()
                            end
                        end)
                    end
                end,
            })
        end
        function obj:Get() return current() end
        function obj:Set(v, silent)
            if multi then
                obj.Value = {}
                if type(v) == "table" then
                    for k, x in pairs(v) do
                        if type(k) == "number" then obj.Value[x] = true
                        elseif x then obj.Value[k] = true end
                    end
                end
            else
                if v ~= nil and not table.find(obj.Options, v) then return end
                obj.Value = v
            end
            valLbl.Text = summary()
            if silent then
                firer.Sync(multi and table.concat(orderedSelection(), "\0") or obj.Value)
            else firer.Fire() queueSave() end
        end
        function obj:Refresh(list, keepValue)
            obj.Options = list or {}
            if not keepValue then obj.Value = multi and {} or nil
            elseif not multi and obj.Value ~= nil and not table.find(obj.Options, obj.Value) then
                obj.Value = nil
            end
            if obj.IsOpen then obj:Close() end
            valLbl.Text = summary()
        end
        c.Activated:Connect(function()
            if obj.IsOpen then obj:Close() else obj:Open() end
        end)
        register(o.Flag, obj, o, current, function(v) obj:Set(v) end)
        decorate(obj, c, o, multi and "Multi Dropdown" or "Dropdown")
        if multi then obj:Set(o.Default or {}, true)
        else
            local first = o.Default
            if first == nil and o.AllowNone ~= true then first = obj.Options[1] end
            obj:Set(first, true)
        end
        valLbl.Text = summary()
        initFires[#initFires + 1] = function() firer.Fire() end
        return obj
    end
    function E:AddDropdown(o) return buildDropdown(o, false) end
    function E:AddMultiDropdown(o) return buildDropdown(o, true) end

    -- COLORPICKER
    function E:AddColorpicker(o)
        o = o or {}
        local label = tostring(o.Name or "Color")
        local c = card(CARD_H, true)
        nameLabel(c, label, UDim2.new(1, -70, 1, 0))
        local swatch = mk("Frame", {AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(44, 22),
            ZIndex = 15, Parent = c})
        round(swatch, 5)
        outline(swatch, "Text", 1, 0.75)

        local start = typeof(o.Default) == "Color3" and o.Default or Color3.fromRGB(56, 130, 246)
        local h, s, v = start:ToHSV()
        local obj = {Value = start, IsOpen = false, Rainbow = false}
        local firer = makeFirer(function() return obj.Value end, function(col)
            local ok, err = pcall(o.Callback or function() end, col)
            if not ok then fail(c, label, err) end
        end)
        local ui = {}
        local function apply(silent)
            local col = Color3.fromHSV(h, s, v)
            obj.Value = col
            swatch.BackgroundColor3 = col
            if ui.sv and ui.sv.Parent then
                ui.sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                ui.svKnob.Position = UDim2.fromScale(s, 1 - v)
                ui.svKnob.BackgroundColor3 = col
                ui.hueKnob.Position = UDim2.new(0.5, 0, h, 0)
                if ui.hex and not ui.hex:IsFocused() then
                    ui.hex.Text = "#" .. col:ToHex():upper()
                end
            end
            if silent then firer.Sync(col) else firer.Fire() queueSave() end
        end
        function obj:Close()
            if obj.IsOpen then
                obj.IsOpen = false
                popupClose()
            end
        end
        function obj:Open()
            if obj.IsOpen or obj:IsLocked() then return end
            obj.IsOpen = true
            Popup.open(c, {
                width = 240, height = 240, align = "right", owner = obj,
                onClose = function() obj.IsOpen = false ui = {} end,
                build = function(frame, w, h)
                    inset(frame, 12, 12, 12, 12)

                    local sv = mk("TextButton", {Size = UDim2.fromOffset(170, 140),
                        BackgroundColor3 = Color3.fromHSV(h, 1, 1), ZIndex = 63, Parent = frame})
                    round(sv, 6)
                    local white = mk("Frame", {Size = UDim2.fromScale(1, 1),
                        BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 64, Parent = sv})
                    round(white, 6)
                    mk("UIGradient", {Transparency = NumberSequence.new(0, 1), Parent = white})
                    local black = mk("Frame", {Size = UDim2.fromScale(1, 1),
                        BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 65, Parent = sv})
                    round(black, 6)
                    mk("UIGradient", {Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = black})
                    local svKnob = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5),
                        Size = UDim2.fromOffset(14, 14), BackgroundColor3 = obj.Value,
                        ZIndex = 67, Parent = sv})
                    round(svKnob, 7)
                    mk("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 2, Parent = svKnob})

                    local hue = mk("TextButton", {AnchorPoint = Vector2.new(1, 0),
                        Position = UDim2.new(1, 0, 0, 0),
                        Size = UDim2.fromOffset(18, 140),
                        BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = frame})
                    round(hue, 6)
                    local hKeys = {}
                    for i = 0, 6 do
                        hKeys[#hKeys + 1] = ColorSequenceKeypoint.new(i / 6,
                            Color3.fromHSV(math.min(i / 6, 0.999), 1, 1))
                    end
                    mk("UIGradient", {Color = ColorSequence.new(hKeys), Rotation = 90, Parent = hue})
                    local hueKnob = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.new(0.5, 0, h, 0), Size = UDim2.fromOffset(22, 6),
                        BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 65, Parent = hue})
                    round(hueKnob, 3)
                    mk("UIStroke", {Color = Color3.new(0, 0, 0), Transparency = 0.4, Parent = hueKnob})

                    local hex = tx("TextBox", {Position = UDim2.fromOffset(0, 152),
                        Size = UDim2.new(1, 0, 0, 26),
                        PlaceholderText = "#RRGGBB", TextSize = 12,
                        Text = "#" .. obj.Value:ToHex():upper(),
                        TextXAlignment = Enum.TextXAlignment.Center,
                        ZIndex = 64, Parent = frame}, 2)
                    bind(hex, "BackgroundColor3", "Elevated")
                    hex.BackgroundTransparency = 0
                    round(hex, 6)

                    ui = {sv = sv, svKnob = svKnob, hueKnob = hueKnob, hex = hex}
                    local mode
                    local function fromPos(pos)
                        if mode == "sv" then
                            s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
                            v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
                        elseif mode == "hue" then
                            h = math.clamp((pos.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 0.999)
                        end
                        apply()
                    end
                    trackPointer(sv, function(input) mode = "sv" fromPos(input.Position) end,
                        function(p) fromPos(p) end, function() mode = nil end)
                    trackPointer(hue, function(input) mode = "hue" fromPos(input.Position) end,
                        function(p) fromPos(p) end, function() mode = nil end)
                    hex.FocusLost:Connect(function()
                        local txt = hex.Text:gsub("#", "")
                        if #txt == 6 then
                            local ok, col = pcall(Color3.fromHex, txt)
                            if ok then h, s, v = col:ToHSV() apply() end
                        end
                        hex.Text = "#" .. obj.Value:ToHex():upper()
                    end)
                end,
            })
        end
        keep(RunService.Heartbeat:Connect(function()
            if obj.Rainbow then h = (os.clock() * 0.2) % 1 apply() end
        end))
        function obj:Set(col, silent)
            if typeof(col) ~= "Color3" then return end
            h, s, v = col:ToHSV() apply(silent)
        end
        function obj:Get() return obj.Value end
        c.Activated:Connect(function()
            if obj.IsOpen then obj:Close() else obj:Open() end
        end)
        register(o.Flag, obj, o, function() return obj.Value end, function(col) obj:Set(col) end)
        decorate(obj, c, o, "Colorpicker")
        apply(true)
        initFires[#initFires + 1] = function() firer.Fire() end
        return obj
    end
end

