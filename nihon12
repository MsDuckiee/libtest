local tipBox, tipToken = nil, 0
local function hideTip()
    tipToken = tipToken + 1
    if tipBox then tipBox:Destroy() tipBox = nil end
end

local function attachTip(gui, getText)
    if Nihon.IsMobile then return end
    gui.MouseEnter:Connect(function()
        tipToken = tipToken + 1
        local mine = tipToken
        task.delay(0.5, function()
            if mine ~= tipToken then return end
            local t = type(getText) == "function" and getText() or getText
            if t and t ~= "" then
                if tipBox then tipBox:Destroy() end
                local text = tostring(t)
                local size = TextService:GetTextSize(text, 12, Fonts[currentFont][2], Vector2.new(230, 1000))
                local box = mk("Frame", {Size = UDim2.fromOffset(size.X + 18, size.Y + 14),
                    ZIndex = 300, Parent = Root})
                bind(box, "BackgroundColor3", "Elevated")
                round(box, 8)
                outline(box, "Stroke", 1, 0.3)
                tx("TextLabel", {Size = UDim2.fromScale(1, 1), Text = text, TextSize = 12,
                    TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 301, Parent = box}, 2)
                local m = UserInputService:GetMouseLocation()
                local v = viewport()
                local x = math.clamp(m.X + 14, 6, v.X - size.X - 24)
                local y = math.clamp(m.Y + 18, 6, v.Y - size.Y - 24)
                box.Position = UDim2.fromOffset(x, y)
                tipBox = box
            end
        end)
    end)
    gui.MouseLeave:Connect(hideTip)
    gui.InputBegan:Connect(function(i) if isPointer(i) then hideTip() end end)
end

