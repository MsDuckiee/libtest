function TabImpl.select(Window, target, instant)
    if type(target) == "number" then target = Window.Tabs[target] end
    if type(target) == "string" then
        for _, t in ipairs(Window.Tabs) do
            if t.Name == target then target = t break end
        end
    end
    if type(target) ~= "table" or not target.Button then return end
    local prev = Window.Selected
    if prev == target then return end
    Window.Selected = target
    popupClose(true)

    for _, t in ipairs(Window.Tabs) do
        local active = t == target
        if active then
            t.Button.BackgroundColor3 = Pal.Accent
            t.Button.BackgroundTransparency = 0
            play(t.Button, 0.25, {BackgroundColor3 = Pal.Accent, BackgroundTransparency = 0})
            t.IconObj.Color(Color3.new(1, 1, 1), true)
            t.LabelNode.TextColor3 = Color3.new(1, 1, 1)
            t.LabelNode.Font = Fonts[currentFont][3]
        else
            play(t.Button, 0.2, {BackgroundTransparency = 1})
            t.IconObj.Color(Pal.Sub, true)
            t.LabelNode.TextColor3 = Pal.Sub
            t.LabelNode.Font = Fonts[currentFont][2]
        end
    end

    if instant or not prev then
        for _, t in ipairs(Window.Tabs) do
            t.Page.Visible = t == target
            t.Page.BackgroundTransparency = t == target and 0 or 1
            t.Page.Position = UDim2.fromOffset(0, 0)
        end
    else
        local dir = target.Index > prev.Index and 1 or -1
        for _, t in ipairs(Window.Tabs) do
            if t == prev then
                play(t.Page, 0.16, {BackgroundTransparency = 1})
                play(t.Page, 0.2, {Position = UDim2.fromOffset(-14 * dir, 0)},
                    Enum.EasingStyle.Quint, Enum.EasingDirection.In)
                task.delay(0.2, function()
                    if Window.Selected ~= prev then
                        t.Page.Visible = false
                        t.Page.Position = UDim2.fromOffset(0, 0)
                    end
                end)
            end
        end
        target.Page.Visible = true
        target.Page.BackgroundTransparency = 1
        target.Page.Position = UDim2.fromOffset(14 * dir, 0)
        play(target.Page, 0.3, {BackgroundTransparency = 0})
        play(target.Page, 0.35, {Position = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quint)
    end
end

------------------------------------------------------------
-- NUM FORMAT
------------------------------------------------------------
local function numFormat(v, step, suffix)
    local s
    if step < 1 then
        local frac = tostring(step):gsub("^0%.", "")
        local places = math.min(3, math.max(1, #frac))
        s = string.format("%." .. places .. "f", v)
        s = s:gsub("0+$", ""):gsub("%.$", "")
    else
        s = tostring(math.floor(v + 0.5))
    end
    if suffix and suffix ~= "" then return s .. " " .. suffix end
    return s
end
local function snapTo(v, step, min)
    if step <= 0 then return v end
    return min + math.floor((v - min) / step + 0.5) * step
end

