local Notes = {active = {}, queue = {}, max = 5, duration = 4}
local noteLayer = mk("Frame", {Name = "Notifications", BackgroundTransparency = 1,
    Size = UDim2.fromScale(1, 1), ZIndex = 100, Parent = Root})

local function noteWidth() return 300 end

local function relayout()
    local v = viewport()
    local y = v.Y - 14
    for i = #Notes.active, 1, -1 do
        local n = Notes.active[i]
        local h = n.frame.AbsoluteSize.Y
        if h < 5 then h = n.height or 64 end
        y = y - h - 8
        if not n.dragging then
            play(n.frame, 0.4, {Position = UDim2.new(1, -14, 0, y)}, Enum.EasingStyle.Quint)
        end
    end
end

local function promoteQueue()
    while #Notes.active < Notes.max and #Notes.queue > 0 do
        spawnNote(table.remove(Notes.queue, 1))
    end
end

local function dismissNote(n)
    if n.dying then return end
    n.dying = true
    for i, x in ipairs(Notes.active) do
        if x == n then table.remove(Notes.active, i) break end
    end
    play(n.frame, 0.25, {BackgroundTransparency = 0.2})
    play(n.frame, 0.35, {Position = UDim2.new(1, 350, 0, n.frame.Position.Y.Offset)},
        Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    task.delay(0.4, function() if n.frame then pcall(function() n.frame:Destroy() end) end end)
    task.delay(0.05, relayout)
    task.delay(0.4, promoteQueue)
end

local noteLoop
local function ensureNoteLoop()
    if noteLoop then return end
    noteLoop = RunService.Heartbeat:Connect(function(dt)
        local now = os.clock()
        for i = #Notes.active, 1, -1 do
            local n = Notes.active[i]
            if n and not n.dying then
                if n.hover then n.expires = n.expires + dt end
                if n.expires - now <= 0 and not n.sticky then dismissNote(n) end
            end
        end
        if #Notes.active == 0 and noteLoop then noteLoop:Disconnect() noteLoop = nil end
    end)
end

function spawnNote(entry)
    local cfg, handle = entry.cfg, entry.handle
    local kind = entry.kind
    local color = statusColor(kind)
    local w = noteWidth()
    local n = {key = entry.key, count = entry.count or 1, handle = handle,
        height = 64, time = math.max(1, tonumber(cfg.Time) or Notes.duration),
        sticky = cfg.Sticky == true}
    n.expires = os.clock() + n.time

    -- Use Frame, not CanvasGroup, so BackgroundTransparency tweens work
    local frame = mk("Frame", {Name = "Note", AnchorPoint = Vector2.new(1, 1),
        Size = UDim2.fromOffset(w, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 0.15, Position = UDim2.new(1, 350, 1, -14), Parent = noteLayer})
    bind(frame, "BackgroundColor3", "Surface")
    round(frame, 12)
    outline(frame, "Stroke", 1, 0.05)
    n.frame = frame

    -- left colored icon disc
    local disc = mk("Frame", {Position = UDim2.fromOffset(14, 14),
        Size = UDim2.fromOffset(28, 28), BackgroundColor3 = color,
        BackgroundTransparency = 0, ZIndex = 3, Parent = frame})
    round(disc, 14)
    local ico = makeIcon(disc, cfg.Icon or (kind == "Success" and "check"
        or kind == "Error" and "x" or kind == "Warning" and "activity" or "info"),
        14, false, {AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), ZIndex = 4})
    ico.Glyph.TextColor3 = Color3.new(1, 1, 1)
    ico.Image.ImageColor3 = Color3.new(1, 1, 1)

    -- title + body column
    local col = mk("Frame", {Position = UDim2.fromOffset(52, 12),
        Size = UDim2.new(1, -84, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, ZIndex = 2, Parent = frame})
    stack(col, 2)
    local title = tx("TextLabel", {Text = tostring(cfg.Name or "Notification"),
        Size = UDim2.new(1, 0, 0, 16), TextSize = 13, LayoutOrder = 1,
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3, Parent = col}, 3)
    local body = tx("TextLabel", {Text = tostring(cfg.Content or ""),
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        TextSize = 12, TextWrapped = true,
        LayoutOrder = 2, Visible = (cfg.Content and cfg.Content ~= ""),
        ZIndex = 3, Parent = col}, 1, "Sub")
    n.titleNode = title n.bodyNode = body

    -- close ✕ on the right
    local xBtn = tx("TextButton", {Text = "✕", TextSize = 12,
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(20, 20), TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = Pal.Sub, BackgroundTransparency = 1, ZIndex = 4, Parent = frame}, 2, "Sub")
    xBtn.MouseEnter:Connect(function() play(xBtn, 0.15, {BackgroundTransparency = 0.8}) end)
    xBtn.MouseLeave:Connect(function() play(xBtn, 0.2, {BackgroundTransparency = 1}) end)
    xBtn.Activated:Connect(function() dismissNote(n) end)

    -- count badge top-right (only if stacked)
    local badge = tx("TextLabel", {
        Text = tostring(n.count) .. "x", TextSize = 10,
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, -6),
        Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X,
        TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0,
        BackgroundColor3 = color, TextColor3 = Color3.new(1, 1, 1),
        Visible = n.count > 1, ZIndex = 6, Parent = frame}, 3)
    round(badge, 8)
    inset(badge, 0, 6, 0, 6)
    n.badgeNode = badge

    task.defer(function()
        local h = frame.AbsoluteSize.Y
        if h > 5 then n.height = h end
        relayout()
    end)

    frame.MouseEnter:Connect(function() n.hover = true end)
    frame.MouseLeave:Connect(function() n.hover = false end)

    -- swipe to dismiss
    local sx, swiped = 0, false
    trackPointer(frame, function(i) sx = i.Position.X swiped = false n.dragging = true end,
        function(pos)
            local dx = pos.X - sx
            if math.abs(dx) > 6 then swiped = true end
            if swiped then
                frame.Position = UDim2.new(1, -14 + dx, 1, frame.Position.Y.Offset)
            end
        end,
        function(pos)
            n.dragging = false
            if math.abs(pos.X - sx) > 70 then dismissNote(n) else relayout() end
        end)

    table.insert(Notes.active, 1, n)
    handle.n = n
    task.defer(function()
        relayout()
        play(frame, 0.35, {BackgroundTransparency = 0})
    end)
    ensureNoteLoop()
    return n
end

local function bumpNote(n, extra)
    n.count = n.count + 1
    n.badgeNode.Text = n.count .. "x"
    n.badgeNode.Visible = true
    n.expires = os.clock() + (extra or n.time)
    -- pop the badge
    local s = mk("UIScale", {Scale = 0.5, Parent = n.badgeNode})
    play(s, 0.4, {Scale = 1}, Enum.EasingStyle.Back)
    -- shake
    local base = n.frame.Position
    task.spawn(function()
        for _, dx in ipairs({5, -5, 3, -3, 0}) do
            if n.frame then n.frame.Position = base + UDim2.fromOffset(dx, 0) end
            task.wait(0.03)
        end
        if n.frame then n.frame.Position = base end
    end)
end

function Nihon:MakeNotification(cfg)
    if type(cfg) ~= "table" then cfg = {Content = tostring(cfg)} end
    local kind = (cfg.Type == "Success" or cfg.Type == "Error" or cfg.Type == "Warning")
        and cfg.Type or "Info"
    local name = tostring(cfg.Name or cfg.Title or "Notification")
    local content = tostring(cfg.Content or "")
    local key = kind .. "|" .. name .. "|" .. content
    if not cfg.Sticky then
        for _, n in ipairs(Notes.active) do
            if n.key == key and not n.dying then
                bumpNote(n, tonumber(cfg.Time))
                return n.handle
            end
        end
    end
    local handle = {}
    function handle:Dismiss() if handle.n then dismissNote(handle.n) end end
    function handle:SetTitle(t) if handle.n and handle.n.titleNode then handle.n.titleNode.Text = tostring(t) end end
    function handle:SetContent(t)
        if handle.n and handle.n.bodyNode then
            handle.n.bodyNode.Text = tostring(t)
            handle.n.bodyNode.Visible = tostring(t) ~= ""
        end
    end
    local entry = {cfg = cfg, kind = kind, key = key, count = 1, handle = handle}
    if #Notes.active >= Notes.max then
        Notes.queue[#Notes.queue + 1] = entry
    else spawnNote(entry) end
    return handle
end
function Nihon:Notify(cfg) return Nihon:MakeNotification(cfg) end

