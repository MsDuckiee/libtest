-- ELEMENT FACTORY
------------------------------------------------------------
function ElementFactory(Window, Tab, parent, sectionName)
    local P = Window._parts
    local mobile = P.mobile
    local E = {_count = 0}

    local function card(height, hover)
        local c = mk("TextButton", {Size = UDim2.new(1, 0, 0, height or CARD_H),
            BackgroundTransparency = 0, ZIndex = 14,
            LayoutOrder = E._count + 1, Parent = parent})
        bind(c, "BackgroundColor3", "Surface")
        round(c, 8)
        local st = outline(c, "Stroke", 1, 0.05)
        c:SetAttribute("NihonCard", true)
        if hover ~= false and not mobile then
            c.MouseEnter:Connect(function()
                play(c, 0.18, {BackgroundTransparency = -0.05})
                play(st, 0.18, {Transparency = 0.3})
            end)
            c.MouseLeave:Connect(function()
                play(c, 0.2, {BackgroundTransparency = 0})
                play(st, 0.2, {Transparency = 0.05})
            end)
        end
        return c, st
    end

    local function nameLabel(c, text, width)
        return tx("TextLabel", {Name = "Name", Text = tostring(text), TextSize = 12,
            Position = UDim2.fromOffset(14, 0),
            Size = width or UDim2.new(1, -80, 1, 0),
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 15, Parent = c}, 2)
    end

    local function decorate(obj, c, opts, kind)
        E._count = E._count + 1
        local locked = false
        local veil = mk("Frame", {Name = "Lock", Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5,
            Visible = false, ZIndex = 40, Parent = c})
        round(veil, 8)
        local lockIco = makeIcon(veil, "lock", 14, "Sub",
            {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 41})
        mk("TextButton", {Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1, ZIndex = 42, Parent = veil})
        function obj:Lock(v)
            if v == nil then v = true end
            locked = v and true or false
            veil.Visible = locked
        end
        function obj:IsLocked() return locked end
        function obj:SetVisible(v) c.Visible = v and true or false end
        function obj:Destroy()
            pcall(function() c:Destroy() end)
            for i, e in ipairs(P.searchIndex) do
                if e.owner == obj then table.remove(P.searchIndex, i) break end
            end
        end
        function obj:SetName(n)
            local l = c:FindFirstChild("Name")
            if l then l.Text = tostring(n) end
        end
        function obj:SetTooltip(t) attachTip(c, t) end
        obj.Card = c
        obj.Kind = kind
        if opts.Locked then obj:Lock(true) end
        if opts.Tooltip then attachTip(c, opts.Tooltip) end
        if opts.Visible == false then c.Visible = false end
        P.searchIndex[#P.searchIndex + 1] = {
            owner = obj, name = tostring(opts.Name or kind),
            tab = Tab.Name, section = sectionName, kind = kind,
        }
        return obj
    end

    local function register(flag, obj, opts, get, set)
        if not flag then return end
        registerFlag(flag, {get = get, set = set, save = opts.Save == true, obj = obj})
        Nihon.Flags[flag] = obj
    end

    local function fail(c, label, err)
        flashCard(c, Pal.Error, 0.9)
        shake(c)
        Nihon:MakeNotification({Name = (label or "Action") .. " failed",
            Content = errorText(err), Type = "Error", Time = 5})
    end

    function E:AddLabel(o)
        o = type(o) == "table" and o or {Name = o}
        local c = card(CARD_H, false)
        c.Active = false
        local l = nameLabel(c, o.Name or "", UDim2.new(1, -20, 1, 0))
        bind(l, "TextColor3", "Sub")
        local obj = {}
        function obj:Set(t) l.Text = tostring(t) end
        function obj:Get() return l.Text end
        return decorate(obj, c, o, "Label")
    end

    function E:AddParagraph(o)
        o = o or {}
        local c = card(CARD_H, false)
        c.AutomaticSize = Enum.AutomaticSize.Y
        c.Size = UDim2.new(1, 0, 0, CARD_H)
        c.Active = false

        local bar = mk("Frame", {Position = UDim2.fromOffset(0, 0),
            Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = Pal.Accent, ZIndex = 15, Parent = c})
        round(bar, 1)
        local iconWrap = mk("Frame", {Position = UDim2.fromOffset(14, 14),
            Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1,
            ZIndex = 15, Parent = c})
        makeIcon(iconWrap, o.Icon or "info", 18, "Accent",
            {AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromScale(0, 0)})

        local col = mk("Frame", {Position = UDim2.fromOffset(42, 10),
            Size = UDim2.new(1, -54, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, ZIndex = 15, Parent = c})
        stack(col, 3)
        local head = tx("TextLabel", {Text = tostring(o.Title or o.Name or "Info"),
            TextSize = 12, Size = UDim2.new(1, 0, 0, 16),
            LayoutOrder = 1, ZIndex = 15, Parent = col}, 3)
        local text = tx("TextLabel", {Text = tostring(o.Content or ""),
            TextSize = 11, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 2, ZIndex = 15, Parent = col}, 1, "Sub")
        c:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            local h = c.AbsoluteSize.Y
            if h > 5 then col.Size = UDim2.new(1, -54, 0, h - 20) end
        end)
        local obj = {}
        function obj:Set(t) text.Text = tostring(t) end
        function obj:SetTitle(t) head.Text = tostring(t) end
        o.Name = o.Name or o.Title
        return decorate(obj, c, o, "Paragraph")
    end

    function E:AddButton(o)
        o = o or {}
        local label = tostring(o.Name or "Button")
        local cooldown = tonumber(o.Cooldown) or 0.35
        local c = card(CARD_H, true)
        nameLabel(c, label, UDim2.new(1, -60, 1, 0))
        makeIcon(c, o.Icon or "chevron-right", 14, "Sub",
            {AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -14, 0.5, 0), ZIndex = 15})
        local timer = mk("Frame", {AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.fromScale(0, 1), Size = UDim2.new(0, 0, 0, 2),
            BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.2,
            Visible = false, ZIndex = 20, Parent = c})
        accentGradient(timer, 0)
        c.ClipsDescendants = true

        local obj = {}
        local ready = true
        local running = false
        function obj:Fire(...)
            local args = table.pack(...)
            if obj:IsLocked() or not ready or running then
                if not ready then shake(c) end
                return false
            end
            running = true
            ready = cooldown <= 0
            play(c, 0.08, {BackgroundTransparency = 0.25})
            task.delay(0.08, function() play(c, 0.25, {BackgroundTransparency = 0}) end)
            if cooldown > 0 then
                timer.Visible = true
                timer.Size = UDim2.new(1, 0, 0, 2)
                local tw = play(timer, cooldown, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear)
                after(tw, function() timer.Visible = false end)
                task.delay(cooldown, function() ready = true end)
            end
            task.spawn(function()
                local cb = o.Callback
                if type(cb) ~= "function" then
                    running = false
                    fail(c, label, "no callback attached")
                    return
                end
                local ok, err = pcall(cb, table.unpack(args, 1, args.n))
                running = false
                if not ok then
                    if type(o.OnError) == "function" then pcall(o.OnError, err) end
                    fail(c, label, err)
                else flashCard(c, Pal.Success, 0.4) end
            end)
            return true
        end
        c.Activated:Connect(function() obj:Fire() end)
        function obj:SetCallback(fn) o.Callback = fn end
        return decorate(obj, c, o, "Button")
    end

    function E:AddToggle(o)
        o = o or {}
        local label = tostring(o.Name or "Toggle")
        local c = card(CARD_H, true)
        nameLabel(c, label, UDim2.new(1, -70, 1, 0))

        local track = mk("Frame", {AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(40, 22),
            ZIndex = 15, Parent = c})
        bind(track, "BackgroundColor3", "Elevated")
        round(track, 11)
        local trackStroke = outline(track, "Stroke", 1, 0.25)

        local fill = mk("Frame", {Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1, ZIndex = 16, Parent = track})
        round(fill, 11)
        accentGradient(fill, 25)

        local knob = mk("Frame", {AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(16, 16),
            BackgroundColor3 = Color3.fromRGB(210, 210, 215),
            ZIndex = 18, Parent = track})
        round(knob, 8)

        local state = {value = false}
        local obj = {Value = false}
        local function paint(v, animated)
            local dur = animated and 0.28 or 0.001
            play(fill, dur, {BackgroundTransparency = v and 0 or 1})
            play(knob, dur, {
                Position = UDim2.new(0, v and 21 or 3, 0.5, 0),
                BackgroundColor3 = v and Color3.new(1, 1, 1) or Color3.fromRGB(210, 210, 215),
            }, Enum.EasingStyle.Quad)
            play(trackStroke, dur, {Transparency = v and 1 or 0.25})
        end
        local firer = makeFirer(function() return state.value end, function(v)
            local ok, err = pcall(o.Callback or function() end, v)
            if not ok then fail(c, label, err) end
        end)
        function obj:Set(v, silent)
            v = v and true or false
            state.value = v obj.Value = v
            paint(v, true)
            if silent then firer.Sync(v) else firer.Fire() queueSave() end
        end
        function obj:Get() return state.value end
        function obj:Toggle() obj:Set(not state.value) end
        c.Activated:Connect(function()
            if obj:IsLocked() then return end
            obj:Set(not state.value)
        end)
        c.InputBegan:Connect(function(i)
            if isPointer(i) and not obj:IsLocked() then
                play(knob, 0.1, {Size = UDim2.fromOffset(20, 16)})
            end
        end)
        c.InputEnded:Connect(function(i)
            if isPointer(i) then play(knob, 0.2, {Size = UDim2.fromOffset(16, 16)}) end
        end)
        register(o.Flag, obj, o, function() return state.value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Toggle")
        local start = o.Default and true or false
        state.value = start obj.Value = start
        paint(start, false)
        if start then initFires[#initFires + 1] = function() firer.Fire() end
        else firer.Sync(false) end
        return obj
    end

    extendElements(E, {Window = Window, Tab = Tab, P = P, card = card,
        nameLabel = nameLabel, decorate = decorate, register = register,
        fail = fail, mobile = mobile})
    return E
end

------------------------------------------------------------
-- WINDOW METHODS
------------------------------------------------------------
local function attachWindowMethods(Window)
    function Window:MakeTab(cfg) return TabImpl.make(Window, cfg) end
    function Window:SelectTab(tab, instant) TabImpl.select(Window, tab, instant) end
    function Window:Notify(cfg) return Nihon:MakeNotification(cfg) end
    function Window:SetTitle(t) Window.TitleLabel.Text = tostring(t) Window.Name = tostring(t) end
    function Window:SetSubtitle(t)
        Window.SubtitleLabel.Text = tostring(t)
        Window.SubtitleLabel.Visible = tostring(t) ~= ""
    end
    function Window:SetIcon(id) Window.LogoIcon.Set(id) Window.LauncherIcon.Set(id) end
    function Window:SetTabIcon(name, id)
        for _, t in ipairs(Window.Tabs) do
            if t.Name == name then t.IconObj.Set(id) end
        end
    end
    function Window:SetLauncherVisible(on)
        Nihon.ShowLauncher = on and true or false
        if Window._parts.launcher then
            Window._parts.launcher.Visible = Nihon.ShowLauncher and Window.Hidden
        end
    end
    function Window:SetResizeVisible(on) end
    function Window:SetControlVisible(kind, on)
        on = on and true or false
        local P = Window._parts
        if kind == "minimize" and P.minBtn then P.minBtn.Visible = on
        elseif kind == "close" and P.closeBtn then P.closeBtn.Visible = on
        elseif kind == "launcher" then Window:SetLauncherVisible(on) end
    end
    function Window:AddSettingsTab(opts)
        opts = opts or {}
        local tab = Window:MakeTab({Name = opts.Name or "Settings", Icon = opts.Icon or "settings"})
        local look = tab:AddSection({Name = "Appearance"})
        look:AddDropdown({Name = "Theme", Options = ThemeOrder, Default = themeName,
            Flag = "_theme", Save = true, Callback = function(v) setTheme(v, true) end})
        look:AddDropdown({Name = "Font", Options = FontOrder, Default = currentFont,
            Flag = "_font", Save = true, Callback = function(v) setFont(v) end})
        look:AddColorpicker({Name = "Accent color", Default = Pal.Accent,
            Flag = "_accent", Save = true, Callback = function(col)
                if col == Pal.Accent then return end
                setAccent(col)
            end})
        look:AddSlider({Name = "Animation speed", Min = 50, Max = 200, Default = 100,
            Increment = 10, ValueName = "%", Flag = "_anim", Save = true,
            Callback = function(v) animSpeed = v / 100 end})
        local alerts = tab:AddSection({Name = "Notifications"})
        alerts:AddSlider({Name = "Duration", Min = 1, Max = 12, Default = Notes.duration,
            ValueName = "s", Flag = "_noteTime", Save = true,
            Callback = function(v) Notes.duration = math.clamp(tonumber(v) or 4, 1, 30) end})
        alerts:AddButton({Name = "Send test", Icon = "bell", Callback = function()
            Nihon:MakeNotification({Name = "Success",
                Content = "Your settings have been saved!", Type = "Success"})
        end})
        alerts:AddButton({Name = "Clear all", Icon = "trash", Callback = function()
            for i = #Notes.active, 1, -1 do dismissNote(Notes.active[i]) end
        end})
        local cfg = tab:AddSection({Name = "Config"})
        local nameBox = cfg:AddTextbox({Name = "Profile name", Placeholder = "my-config"})
        local profiles = cfg:AddDropdown({Name = "Profiles",
            Options = Nihon:ListProfiles(), AllowNone = true})
        cfg:AddButton({Name = "Save profile", Icon = "save", Callback = function()
            local n = nameBox:Get()
            if n == "" then n = profiles:Get() or "" end
            if n == "" then error("type a profile name first") end
            if not Nihon:SaveProfile(n) then error("could not write file") end
            profiles:Refresh(Nihon:ListProfiles())
            Nihon:MakeNotification({Name = "Saved", Content = n, Type = "Success"})
        end})
        cfg:AddButton({Name = "Load profile", Icon = "download", Callback = function()
            local n = profiles:Get()
            if not n then error("choose a profile first") end
            if not Nihon:LoadProfile(n) then error("could not read profile") end
            Nihon:MakeNotification({Name = "Loaded", Content = n, Type = "Success"})
        end})
        cfg:AddButton({Name = "Delete profile", Icon = "trash", Callback = function()
            local n = profiles:Get()
            if not n then error("choose a profile first") end
            Nihon:Dialog({Title = "Delete profile",
                Content = "Permanently remove " .. n .. "?",
                Buttons = {{Name = "Cancel"}, {Name = "Delete", Primary = true, Danger = true,
                    Callback = function() Nihon:DeleteProfile(n) profiles:Refresh(Nihon:ListProfiles()) end}}})
        end})
        local about = tab:AddSection({Name = "About"})
        about:AddParagraph({Title = "Nihon Lib " .. Nihon.Version,
            Content = "Drag the header or grab bar to move. Double-click header to minimize."})
        return tab
    end
end

Hooks.attach = attachWindowMethods

------------------------------------------------------------
-- INIT / DESTROY
------------------------------------------------------------
function Nihon:Init()
    if Nihon._ready then return end
    local window = Nihon.Windows[1]
    for _, fn in ipairs(initFires) do task.spawn(pcall, fn) end
    table.clear(initFires)
    Nihon._ready = true
    if window then window.Show() end
end

function Nihon:Destroy()
    Nihon._ready = false
    hideTip()
    popupClose(true)
    if rainbowConn then rainbowConn:Disconnect() rainbowConn = nil end
    if noteLoop then noteLoop:Disconnect() noteLoop = nil end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    for _, w in ipairs(Nihon.Windows) do
        pcall(function() w._parts.launcher:Destroy() end)
    end
    Nihon.Windows = {}
    pcall(function() Root:Destroy() end)
    if env.NihonLibInstance == Nihon then env.NihonLibInstance = nil end
end

return Nihon
