local Popup = {current = nil}
local popupCatcher = mk("TextButton", {
    Name = "PopupCatcher", Size = UDim2.fromScale(1, 1),
    BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
    Visible = false, ZIndex = 55, Parent = Root,
})

local function popupClose(instant)
    local cur = Popup.current
    if not cur then return end
    Popup.current = nil
    popupCatcher.Visible = false
    if cur.follow then cur.follow:Disconnect() end
    if cur.onClose then pcall(cur.onClose) end
    if instant then
        pcall(function() cur.frame:Destroy() end)
        return
    end
    -- Use BackgroundTransparency (Frame-safe) instead of GroupTransparency
    play(cur.frame, 0.18, {BackgroundTransparency = 1})
    play(cur.frame, 0.2, {Size = UDim2.new(cur.frame.Size.X.Scale,
        cur.frame.Size.X.Offset, 0, 0)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    task.delay(0.25, function()
        pcall(function()
            if cur.frame and cur.frame.Parent then cur.frame:Destroy() end
        end)
    end)
end
Popup.close = popupClose

popupCatcher.Activated:Connect(function() Popup.close() end)
popupCatcher.MouseButton1Down:Connect(function() Popup.close() end)

-- close on scroll too
keep(UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel and Popup.current then
        Popup.close()
    end
end))

function Popup.open(anchor, opts)
    Popup.close(true)
    local sc = currentScale
    local w = opts.width or (anchor.AbsoluteSize.X / sc)
    local popupH = opts.height or 200
    local gap = 6

    -- Wrapper frame so we can scale cleanly
    local frame = mk("Frame", {
        Name = "Popup", AnchorPoint = Vector2.new(0, 0),
        Size = UDim2.fromOffset(w, popupH), ClipsDescendants = true,
        ZIndex = 60, Parent = Root,
    })
    bind(frame, "BackgroundColor3", "Surface")
    round(frame, 10)
    outline(frame, "Stroke", 1, 0)
    mk("UIScale", {Scale = sc, Parent = frame})

    local function place()
        -- GUARD: anchor destroyed or popup closed → bail
        if not anchor or not anchor.Parent then
            if Popup.current and Popup.current.frame == frame then
                Popup.close(true)
            end
            return false
        end
        local vp = viewport()
        local pa, ps = anchor.AbsolutePosition, anchor.AbsoluteSize
        local x = pa.X
        if opts.align == "right" then x = pa.X + ps.X - w * sc end
        x = math.clamp(x, 6, math.max(6, vp.X - w * sc - 6))
        local spaceBelow = vp.Y - (pa.Y + ps.Y) - gap - 6
        local spaceAbove = pa.Y - gap - 6
        local finalH = popupH * sc
        local y
        if spaceBelow >= finalH then y = pa.Y + ps.Y + gap
        elseif spaceAbove >= finalH then y = pa.Y - gap - finalH
        else y = math.clamp(pa.Y + ps.Y + gap, 6, vp.Y - finalH - 6) end
        frame.Position = UDim2.fromOffset(x, y)
        return true
    end
    place()

    opts.build(frame, w, popupH)
    popupCatcher.Visible = true

    local cur = {frame = frame, onClose = opts.onClose, owner = opts.owner}
    -- follow loop is now safe: only reads anchor if it still exists
    cur.follow = RunService.RenderStepped:Connect(function()
        if not Popup.current or Popup.current.frame ~= frame then
            cur.follow:Disconnect() return
        end
        place()
    end)
    Popup.current = cur
    play(frame, 0.22, {Size = UDim2.fromOffset(w, popupH)}, Enum.EasingStyle.Back)
    return frame
end

