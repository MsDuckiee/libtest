-- WINDOW & TAB SYSTEM (simplified version for enhanced library)
------------------------------------------------------------
function Nihon:MakeWindow(cfg)
    cfg = cfg or {}
    local title = tostring(cfg.Name or "UI Library")
    
    if cfg.Theme and Themes[cfg.Theme] then setTheme(cfg.Theme, false) end
    if cfg.Font and Fonts[cfg.Font] then setFont(cfg.Font) end
    if cfg.Accent then setAccent(cfg.Accent, cfg.Accent2) end

    local WIN_W = tonumber(cfg.Width) or DEFAULT_W
    local WIN_H = tonumber(cfg.Height) or DEFAULT_H

    local Window = {
        Tabs = {}, Name = title, Hidden = false,
        WIN_W = WIN_W, WIN_H = WIN_H,
    }
    Nihon.Windows[#Nihon.Windows + 1] = Window

    local shell = mk("Frame", {Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(WIN_W, WIN_H),
        ClipsDescendants = false, Visible = false, ZIndex = 10, Parent = Root})
    bind(shell, "BackgroundColor3", "Bg")
    round(shell, 12)
    outline(shell, "Stroke", 1.5, 0.1)
    Window.Shell = shell

    local header = mk("Frame", {Name = "Header", Size = UDim2.new(1, 0, 0, HEADER_H),
        BackgroundTransparency = 1, ZIndex = 12, Parent = shell})
    
    local logo = mk("Frame", {AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 14, 0.5, 0), Size = UDim2.fromOffset(22, 22),
        BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 13, Parent = header})
    round(logo, 6)
    accentGradient(logo, 45)

    local titleLbl = tx("TextLabel", {Text = title, TextSize = 14,
        Position = UDim2.fromOffset(44, 0.5 * HEADER_H - 7), 
        Size = UDim2.new(1, -90, 0, 16),
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 13, Parent = header}, 3)

    local closeBtn = tx("TextButton", {Text = "✕", TextSize = 14,
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(24, 24), TextXAlignment = Enum.TextXAlignment.Center,
        BackgroundTransparency = 1, ZIndex = 15, Parent = header}, 2, "Sub")
    closeBtn.MouseEnter:Connect(function() closeBtn.TextColor3 = Pal.Text end)
    closeBtn.MouseLeave:Connect(function() closeBtn.TextColor3 = Pal.Sub end)

    local content = mk("Frame", {Name = "Content",
        Position = UDim2.fromOffset(0, HEADER_H),
        Size = UDim2.new(1, 0, 1, -HEADER_H),
        BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 11, Parent = shell})

    local scroll = mk("ScrollingFrame", {Name = "Scroll", Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, ScrollBarThickness = 4,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 11, Parent = content})
    bind(scroll, "ScrollBarImageColor3", "Stroke")
    inset(scroll, PADDING, PADDING, PADDING, PADDING)
    stack(scroll, CARD_GAP)

    Window.Content = content
    Window.Scroll = scroll

    function Window:Show()
        Window.Hidden = false
        shell.Visible = true
        play(shell, 0.4, {}, Enum.EasingStyle.Back)
    end

    function Window:Hide()
        Window.Hidden = true
        shell.Visible = false
    end

    closeBtn.Activated:Connect(function() Window:Hide() end)

    makeDraggable({header}, shell, {speed = 30})

    local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
    keep(UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe or input.KeyCode ~= toggleKey then return end
        if Window.Hidden then Window:Show() else Window:Hide() end
    end))

    local tabApi = ElementFactory(Window, nil, scroll, nil)
    
    function Window:AddSection(cfg)
        cfg = cfg or {}
        local name = tostring(cfg.Name or "")
        local wrap = mk("Frame", {Name = "Section_" .. name,
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, LayoutOrder = #Window.Tabs + 1, ZIndex = 13, Parent = scroll})
        stack(wrap, 6)

        if name ~= "" then
            local head = mk("Frame", {Size = UDim2.new(1, 0, 0, SECTION_H),
                BackgroundTransparency = 1, LayoutOrder = 0, ZIndex = 14, Parent = wrap})
            local tick = mk("Frame", {Position = UDim2.fromOffset(0, 5),
                Size = UDim2.fromOffset(3, 14), BackgroundColor3 = Color3.new(1, 1, 1),
                ZIndex = 15, Parent = head})
            round(tick, 1)
            accentGradient(tick, 90)
            tx("TextLabel", {Text = string.upper(name), TextSize = 10,
                Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -8, 0, 14),
                ZIndex = 15, Parent = head}, 3, "Sub")
        end

        local body = mk("Frame", {Name = "Body", Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
            LayoutOrder = 1, ZIndex = 14, Parent = wrap})
        stack(body, CARD_GAP)

        local section = ElementFactory(Window, nil, body, name)
        section.Holder = wrap
        section.Body = body
        Window.Tabs[#Window.Tabs + 1] = section
        return section
    end

    Nihon._ready = true
    Window:Show()
    return Window
end

function Nihon:Init()
    if Nihon._ready then return end
    local window = Nihon.Windows[1]
    if window then window:Show() end
    Nihon._ready = true
end

function Nihon:Destroy()
    Nihon._ready = false
    hideTip()
    if rainbowConn then rainbowConn:Disconnect() rainbowConn = nil end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    Nihon.Windows = {}
    pcall(function() Root:Destroy() end)
    if env.NihonLibInstance == Nihon then env.NihonLibInstance = nil end
end

return Nihon
