local themeListeners = {}
local customAccent
local rainbowConn

local function setTheme(name, animated)
    if not Themes[name] then return end
    themeName = name customAccent = nil
    loadPalette(name)
    refreshTheme(animated)
    for _, fn in ipairs(themeListeners) do pcall(fn, name) end
end

local function setAccent(c1, c2)
    customAccent = {c1, c2 or c1:Lerp(Color3.new(1, 1, 1), 0.25)}
    Pal.Accent, Pal.Accent2 = customAccent[1], customAccent[2]
    refreshTheme(true, true)
end

local function setRainbow(on)
    if on and not rainbowConn then
        local acc = 0
        rainbowConn = RunService.Heartbeat:Connect(function(dt)
            acc = acc + dt
            if acc < 0.066 then return end
            acc = 0
            local h = (os.clock() * 0.12) % 1
            Pal.Accent = Color3.fromHSV(h, 0.7, 1)
            Pal.Accent2 = Color3.fromHSV((h + 0.1) % 1, 0.65, 1)
            refreshTheme(false, true)
        end)
    elseif not on and rainbowConn then
        rainbowConn:Disconnect() rainbowConn = nil
        loadPalette(themeName)
        if customAccent then Pal.Accent, Pal.Accent2 = customAccent[1], customAccent[2] end
        refreshTheme(true)
    end
end

function Nihon:SetTheme(n) setTheme(n, true) end
function Nihon:SetAccent(c1, c2) setAccent(c1, c2) end
function Nihon:SetRainbow(on) setRainbow(on and true or false) end
function Nihon:SetFont(n) setFont(n) end
function Nihon:GetThemes()
    local out = {}
    for _, n in ipairs(ThemeOrder) do out[#out + 1] = n end
    return out
end
function Nihon:SetAnimationSpeed(s) animSpeed = math.clamp(tonumber(s) or 1, 0.1, 60) end

