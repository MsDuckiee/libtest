-- NOTIFICATIONS
------------------------------------------------------------
local Notes = {active = {}, queue = {}, max = 5, duration = 4}
local noteLayer = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 100, Parent = Root})

local function relayout()
    local v = viewport()
    local y = v.Y - 14
    for i = #Notes.active, 1, -1 do
        local n = Notes.active[i]
        local h = n.height or 60
        y = y - h - 8
        play(n.frame, 0.35, {Position = UDim2.new(1, -14, 0, y)})
    end
end

local function dismissNote(n)
    if n.dying then return end
    n.dying = true
    for i, x in ipairs(Notes.active) do
        if x == n then table.remove(Notes.active, i) break end
    end
    play(n.frame, 0.3, {GroupTransparency = 1})
    task.delay(0.35, function() if n.frame then n.frame:Destroy() end end)
    relayout()
end

function spawnNote(entry)
    local cfg = entry.cfg
    local color = entry.kind == "Success" and Pal.Success or entry.kind == "Error" and Pal.Error or Pal.Accent
    local w = 280
    local n = {count = entry.count or 1, height = 64}
    n.expires = os.clock() + (tonumber(cfg.Time) or Notes.duration)

    local frame = mk("CanvasGroup", {AnchorPoint = Vector2.new(1, 1),
        Size = UDim2.fromOffset(w, 0), AutomaticSize = Enum.AutomaticSize.Y,
        GroupTransparency = 1, Position = UDim2.new(1, 300, 1, -14), Parent = noteLayer})
    bind(frame, "BackgroundColor3", "Surface")
    round(frame, 10)
    outline(frame, "Stroke", 1, 0)

    local disc = mk("Frame", {Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(30, 30),
        BackgroundColor3 = color, ZIndex = 3, Parent = frame})
    round(disc, 15)
    makeIcon(disc, entry.kind == "Success" and "✓" or entry.kind == "Error" and "✕" or "i", 15, false,
        {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 4})

    local col = mk("Frame", {Position = UDim2.fromOffset(52, 12), Size = UDim2.new(1, -84, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 2, Parent = frame})
    stack(col, 2)
    local title = tx("TextLabel", {Text = tostring(cfg.Name or "Notification"),
        Size = UDim2.new(1, 0, 0, 16), TextSize = 13, LayoutOrder = 1, Parent = col}, 3)
    local body = tx("TextLabel", {Text = tostring(cfg.Content or ""),
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        TextSize = 12, TextWrapped = true, LayoutOrder = 2,
        Visible = (cfg.Content and cfg.Content ~= ""), Parent = col}, 1, "Sub")

    local badge = tx("TextLabel", {Text = tostring(n.count) .. "x", TextSize = 10,
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6),
        Size = UDim2.fromOffset(24, 18), TextXAlignment = Enum.TextXAlignment.Center,
        BackgroundColor3 = color, TextColor3 = Color3.new(1, 1, 1),
        Visible = n.count > 1, ZIndex = 6, Parent = frame}, 3)
    round(badge, 8)
    inset(badge, 0, 6, 0, 6)
    n.badge = badge

    local xBtn = tx("TextButton", {Text = "✕", TextSize = 12,
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8),
        Size = UDim2.fromOffset(20, 20), TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = Pal.Sub, BackgroundTransparency = 1, ZIndex = 4, Parent = frame}, 2, "Sub")
    xBtn.Activated:Connect(function() dismissNote(n) end)

    n.frame = frame
    table.insert(Notes.active, 1, n)
    task.defer(function()
        relayout()
        play(frame, 0.35, {GroupTransparency = 0})
    end)
end

function Nihon:MakeNotification(cfg)
    if type(cfg) ~= "table" then cfg = {Content = tostring(cfg)} end
    local kind = (cfg.Type == "Success" or cfg.Type == "Error") and cfg.Type or "Info"
    local key = kind .. "|" .. tostring(cfg.Name or "") .. "|" .. tostring(cfg.Content or "")
    
    -- Stack duplicates
    for _, n in ipairs(Notes.active) do
        if n.key == key then
            n.count = n.count + 1
            n.badge.Text = n.count .. "x"
            n.badge.Visible = true
            return
        end
    end
    
    local entry = {cfg = cfg, kind = kind, key = key, count = 1}
    if #Notes.active >= Notes.max then
        table.insert(Notes.queue, entry)
    else
        spawnNote(entry)
    end
end

function Nihon:Notify(cfg) return Nihon:MakeNotification(cfg) end

