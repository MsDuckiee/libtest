                local value = {v = math.clamp(o.Default or min, min, max)}
                local function draw(frac)
                    fillBar.Size = UDim2.new(frac, 0, 1, 0)
                end
                
                local function fromX(x)
                    local rel = (x - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1)
                    value.v = min + (max - min) * math.clamp(rel, 0, 1)
                    draw((value.v - min) / (max - min))
                    if o.Callback then pcall(o.Callback, value.v) end
                end
                
                trackPointer(rail, function(input) fromX(input.Position.X) end,
                    function(pos) fromX(pos.X) end, function() end)
                
                draw((value.v - min) / (max - min))
                return c
            end
            
            function section:AddDropdown(o)
                o = o or {}
                local c = mk("TextButton", {Size = UDim2.new(1, 0, 0, CARD_H),
                    BackgroundTransparency = 0, ZIndex = 14, Parent = body})
                bind(c, "BackgroundColor3", "Surface")
                round(c, 8)
                c.AutoButtonColor = false
                
                local lbl = tx("TextLabel", {Text = tostring(o.Name or "Dropdown"), TextSize = 12,
                    Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -60, 1, 0),
                    ZIndex = 15, Parent = c}, 2)
                
                local valLbl = tx("TextLabel", {AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -30, 0.5, 0), Size = UDim2.new(0.4, 0, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Right, TextSize = 11,
                    ZIndex = 15, Parent = c}, 2, "Sub")
                
                local state = {value = nil}
                local popup = nil
                
                local function openDropdown()
                    if popup then return end
                    
                    local rowH = 26
                    local h = math.min(#o.Options, 6) * rowH + 10
                    popup = mk("Frame", {Size = UDim2.fromOffset(c.AbsoluteSize.X, h),
                        BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 62, Parent = Root})
                    bind(popup, "BackgroundColor3", "Surface")
                    round(popup, 8)
                    outline(popup, "Stroke", 1, 0)
                    
                    local list = mk("ScrollingFrame", {Size = UDim2.fromScale(1, 1),
                        BackgroundTransparency = 1, ScrollBarThickness = 2,
                        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                        ZIndex = 63, Parent = popup})
                    inset(list, 5, 5, 5, 5)
                    stack(list, 2)
                    
                    for i, opt in ipairs(o.Options) do
                        local b = mk("TextButton", {Size = UDim2.new(1, 0, 0, 24),
                            BackgroundTransparency = 1, LayoutOrder = i, ZIndex = 64, Parent = list})
                        round(b, 5)
                        
                        local l = tx("TextLabel", {Text = tostring(opt), TextSize = 12,
                            Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0),
                            ZIndex = 65, Parent = b}, 2, "Sub")
                        
                        b.MouseEnter:Connect(function()
                            play(b, 0.12, {BackgroundTransparency = 0.9})
                        end)
                        
                        b.MouseLeave:Connect(function()
                            play(b, 0.15, {BackgroundTransparency = 1})
                        end)
                        
                        b.Activated:Connect(function()
                            state.value = opt
                            valLbl.Text = tostring(opt)
                            if popup then
                                play(popup, 0.2, {GroupTransparency = 1})
                                task.delay(0.22, function() if popup then popup:Destroy() popup = nil end end)
                            end
                            if o.Callback then pcall(o.Callback, opt) end
                        end)
                    end
                    
                    local cPos = c.AbsolutePosition
                    local v = viewport()
                    popup.Position = UDim2.fromOffset(
                        math.clamp(cPos.X, 4, v.X - c.AbsoluteSize.X - 4),
                        math.clamp(cPos.Y + c.AbsoluteSize.Y + 4, 4, v.Y - h - 4))
                    
                    mk("UIScale", {Scale = 1, Parent = popup})
                    play(popup, 0.25, {GroupTransparency = 0})
                    
                    -- Close on click outside
                    local conn
                    conn = UserInputService.InputBegan:Connect(function(input)
                        if isPointer(input) then
                            local pos = v2(input)
                            local inPopup = popup and pos.X >= popup.AbsolutePosition.X
                                and pos.X <= popup.AbsolutePosition.X + popup.AbsoluteSize.X
                                and pos.Y >= popup.AbsolutePosition.Y
                                and pos.Y <= popup.AbsolutePosition.Y + popup.AbsoluteSize.Y
                            local inCard = pos.X >= c.AbsolutePosition.X
                                and pos.X <= c.AbsolutePosition.X + c.AbsoluteSize.X
                                and pos.Y >= c.AbsolutePosition.Y
                                and pos.Y <= c.AbsolutePosition.Y + c.AbsoluteSize.Y
                            
                            if not inPopup and not inCard then
                                if popup then
                                    play(popup, 0.2, {GroupTransparency = 1})
                                    task.delay(0.22, function() if popup then popup:Destroy() popup = nil end end)
                                end
                                conn:Disconnect()
                            end
                        end
                    end)
                end
                
                c.Activated:Connect(openDropdown)
                valLbl.Text = state.value and tostring(state.value) or "None"
                
                return c
            end
            
            return section
        end
        
        return Tab
    end
    
    Window:Show()
    return Window
end

Nihon._ready = true
return Nihon
