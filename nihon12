    local headerBottom = 8 + HEADER_H

    -- SIDEBAR
    local sidebar = mk("Frame", {Name = "Sidebar",
        Position = UDim2.fromOffset(0, headerBottom),
        Size = UDim2.new(0, SIDEBAR_W, 1, -headerBottom),
        BackgroundTransparency = 1, ZIndex = 12, Parent = clip})
    local tabScroll = mk("ScrollingFrame", {Name = "Tabs",
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        ScrollBarThickness = 0, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 13, Parent = sidebar})
    inset(tabScroll, 8, 6, 8, 6)
    stack(tabScroll, 4)

    local sideDiv = mk("Frame", {AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, headerBottom),
        Size = UDim2.new(0, 1, 1, -headerBottom), ZIndex = 11, Parent = clip})
    bind(sideDiv, "BackgroundColor3", "Stroke")

    -- CONTENT
    local content = mk("Frame", {Name = "Content",
        Position = UDim2.fromOffset(SIDEBAR_W + 1, headerBottom),
        Size = UDim2.new(1, -(SIDEBAR_W + 1), 1, -headerBottom),
        BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 11, Parent = clip})
    Window.Content = content

    -- DRAG
    local function dragClamp(topLeft)
        local v = viewport()
        local s = shell.AbsoluteSize
        return Vector2.new(math.clamp(topLeft.X, 0, v.X - s.X),
            math.clamp(topLeft.Y, 0, v.Y - s.Y))
    end
    local function reanchor()
        if shell.AnchorPoint == Vector2.new(0, 0) then return end
        local p = shell.AbsolutePosition
        shell.AnchorPoint = Vector2.new(0, 0)
        shell.Position = UDim2.fromOffset(p.X, p.Y)
        shadow.AnchorPoint = Vector2.new(0, 0)
        shadow.Position = UDim2.fromOffset(p.X - 30, p.Y - 30)
    end
    makeDraggable({header, grabBar}, shell, {speed = 30, clamp = dragClamp,
        onBegin = function() reanchor() end,
        canDrag = function() return not Window.Hidden end})

    -- LAUNCHER
    local launcher = mk("TextButton", {Name = "Launcher",
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 34, 0.5, 0),
        Size = UDim2.fromOffset(44, 44), BackgroundColor3 = Color3.new(1, 1, 1),
        Visible = false, ZIndex = 250, Parent = Root})
    round(launcher, 22)
    accentGradient(launcher, 45)
    local launcherIcon = makeIcon(launcher, cfg.Icon or "layers", 22, false,
        {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 251})
    launcherIcon.Glyph.TextColor3 = Color3.new(1, 1, 1)
    launcherIcon.Image.ImageColor3 = Color3.new(1, 1, 1)
    local launcherScale = mk("UIScale", {Scale = 0, Parent = launcher})
    Window.LauncherIcon = launcherIcon

    local launcherMoved = false
    makeDraggable({launcher}, launcher, {speed = 32,
        clamp = function(p)
            local v = viewport() local s = launcher.AbsoluteSize
            return Vector2.new(math.clamp(p.X, 0, v.X - s.X),
                math.clamp(p.Y, 0, v.Y - s.Y))
        end,
        onBegin = function()
            launcher.AnchorPoint = Vector2.new(0, 0)
            play(launcherScale, 0.12, {Scale = 0.92})
        end,
        onEnd = function(moved)
            launcherMoved = moved
            play(launcherScale, 0.3, {Scale = 1}, Enum.EasingStyle.Back)
        end})

    local function showLauncher(on)
        if on then
            launcher.Visible = true
            play(launcherScale, 0.45, {Scale = 1}, Enum.EasingStyle.Back)
        else
            local tw = play(launcherScale, 0.2, {Scale = 0},
                Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            after(tw, function() launcher.Visible = false end)
        end
    end

    local closeToken = 0
    local placed = false
    local function fitScale()
        local v = viewport()
        return math.min(1, (v.X - 40) / WIN_W, (v.Y - 40) / WIN_H)
    end
    local function applyScale(animated)
        local s = fitScale()
        currentScale = s
        if animated then
            play(uiScale, 0.3, {Scale = s})
            play(shadowScale, 0.3, {Scale = s})
        else
            uiScale.Scale = s shadowScale.Scale = s
        end
    end
    local function centerTopLeft()
        local v = viewport()
        local s = Vector2.new(WIN_W, WIN_H) * uiScale.Scale
        local x = math.floor((v.X - s.X) / 2)
        local y = math.floor((v.Y - s.Y) / 2)
        shell.AnchorPoint = Vector2.new(0, 0)
        shell.Position = UDim2.fromOffset(x, y)
        shadow.AnchorPoint = Vector2.new(0, 0)
        shadow.Position = UDim2.fromOffset(x - 30, y - 30)
    end

    local function show()
        Window.Hidden = false
        applyScale(false)
        if not placed then placed = true centerTopLeft() end
        closeToken = closeToken + 1
        shell.Visible = true shadow.Visible = true
        uiScale.Scale = fitScale() * 0.94
        play(uiScale, 0.35, {Scale = fitScale()}, Enum.EasingStyle.Back)
        if Nihon.ShowLauncher then showLauncher(false) end
    end
    local function hide(toLauncher)
        Window.Hidden = true
        popupClose(true)
        closeToken = closeToken + 1
        local mine = closeToken
        if not toLauncher then
            local tw = play(uiScale, 0.22, {Scale = fitScale() * 0.9},
                Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            after(tw, function()
                if Window.Hidden and mine == closeToken then
                    shell.Visible = false shadow.Visible = false
                end
            end)
            if Nihon.ShowLauncher then
                task.delay(0.18, function()
                    if mine ~= closeToken or not Window.Hidden then return end
                    showLauncher(true)
                end)
            end
            return
        end
        local w0 = shell.Size.X.Offset
        play(shell, 0.22, {Size = UDim2.fromOffset(w0, HEADER_H + 8)},
            Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
        task.delay(0.2, function()
            if mine ~= closeToken or not Window.Hidden then return end
            local sp = shell.AbsolutePosition
            play(shell, 0.22, {Size = UDim2.fromOffset(HEADER_H + 8, HEADER_H + 8)},
                Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
            play(titleLbl, 0.12, {TextTransparency = 1})
            Window._lastClosePos = Vector2.new(sp.X, sp.Y)
        end)
        task.delay(0.42, function()
            if mine ~= closeToken or not Window.Hidden then return end
            local tw = play(uiScale, 0.2, {Scale = fitScale() * 0.5},
                Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            after(tw, function()
                if Window.Hidden and mine == closeToken then
                    shell.Visible = false shadow.Visible = false
                    shell.Size = UDim2.fromOffset(w0, WIN_H)
                    titleLbl.TextTransparency = 0
                end
            end)
            local lp = Window._lastClosePos
            if lp then
                launcher.AnchorPoint = Vector2.new(0, 0)
                local v = viewport() local ls = launcher.AbsoluteSize
                launcher.Position = UDim2.fromOffset(
                    math.clamp(lp.X, 0, v.X - ls.X),
                    math.clamp(lp.Y, 0, v.Y - ls.Y))
            end
            showLauncher(true)
        end)
    end

    Window.Show, Window.Hide = show, hide
    function Window:Toggle()
        if Window.Hidden then show() else hide(true) end
    end
    function Window:RequestOpen() if Window.Hidden then show() end end

    launcher.Activated:Connect(function()
        if launcherMoved then launcherMoved = false return end
        show()
    end)
    closeBtn.Activated:Connect(function()
        hide(true)
        Nihon:MakeNotification({Name = "Menu hidden",
            Content = "Tap the floating button to bring it back.", Type = "Info"})
    end)

    local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
    Window.ToggleKey = toggleKey
    keep(UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == toggleKey then Window:Toggle() end
    end))

    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local now = os.clock()
            if Window._lastHeaderClick and now - Window._lastHeaderClick < 0.3 then
                Window:SetMinimized(not Window.Minimized)
                Window._lastHeaderClick = nil
            else
                Window._lastHeaderClick = now
            end
        end
    end)

    local minTween
    function Window:SetMinimized(state)
        state = state and true or false
        if Window.Minimized == state then return end
        Window.Minimized = state
        if minTween then minTween:Cancel() end
        local h = state and (HEADER_H + 8) or WIN_H
        minTween = play(shell, 0.35, {Size = UDim2.fromOffset(WIN_W, h)},
            Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
        play(minIco.Glyph, 0.3, {Rotation = state and 180 or 0})
    end
    minBtn.Activated:Connect(function() Window:SetMinimized(not Window.Minimized) end)

    local cam = workspace.CurrentCamera
    if cam then
        keep(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            if not Window.Hidden then applyScale(true) end
        end))
    end

    if cfg.ShowMinimize == false then minBtn.Visible = false end
    if cfg.ShowClose == false then closeBtn.Visible = false end
    if cfg.ShowLauncher == false then launcher.Visible = false end

    Window._parts = {
        shell = shell, clip = clip, header = header, sidebar = sidebar,
        tabScroll = tabScroll, content = content, uiScale = uiScale,
        applyScale = applyScale, mobile = Nihon.IsMobile,
        searchIndex = Window.SearchIndex, avatar = avatar, dot = dot,
        launcher = launcher, closeBtn = closeBtn, minBtn = minBtn,
        minIco = minIco, WIN_W = WIN_W, WIN_H = WIN_H,
    }

    Hooks.attach(Window)
    return Window
end

