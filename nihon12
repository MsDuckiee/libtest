        round(knob, 9)

        local state = {value = false}
        local obj = {Value = false}

        local function paint(v, animated)
            local dur = animated and 0.3 or 0.001
            play(fill, dur, {BackgroundTransparency = v and 0 or 1})
            play(knob, dur, {
                Position = UDim2.new(0, v and 23 or 3, 0.5, 0),
                BackgroundColor3 = v and Color3.new(1, 1, 1) or Color3.fromRGB(200, 200, 200),
            }, Enum.EasingStyle.Back)
        end

        function obj:Set(v, silent)
            v = v and true or false
            state.value = v obj.Value = v
            paint(v, true)
            if not silent then queueSave() end
        end
        function obj:Get() return state.value end
        function obj:Toggle() obj:Set(not state.value) end

        c.MouseButton1Down:Connect(function()
            play(knob, 0.12, {Size = UDim2.fromOffset(22, 22)}, Enum.EasingStyle.Quad)
