        outline(knob, "Text", 2, 0.6)

        local value = math.clamp(tonumber(o.Default) or min, min, max)
        local obj = {Value = value}

        local function fracOf(v) return math.clamp((v - min) / (max - min), 0, 1) end
        local function draw(frac)
            fillBar.Size = UDim2.new(frac, 0, 1, 0)
            knob.Position = UDim2.new(frac, 0, 0.5, 0)
        end

        function obj:Set(v, silent) 
            v = math.clamp(v, min, max)
            if v == obj.Value then return end
            obj.Value = v
            valBox.Text = tostring(math.floor(v + 0.5))
            draw(fracOf(v))
            if not silent then queueSave() end
        end
        function obj:Get() return obj.Value end

        trackPointer(rail, function(input)
            if obj:IsLocked() then return false end
            local rel = (input.Position.X - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1)
            obj:Set(min + (max - min) * math.clamp(rel, 0, 1))
            play(knob, 0.15, {Size = UDim2.fromOffset(16, 16)}, Enum.EasingStyle.Back)
        end, function(pos)
            local rel = (pos.X - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1)
            obj:Set(min + (max - min) * math.clamp(rel, 0, 1))
        end, function()
            play(knob, 0.25, {Size = UDim2.fromOffset(12, 12)}, Enum.EasingStyle.Back)
        end)

        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Slider")
        
        obj:Set(value, true)
        return obj
    end

    function E:AddDropdown(o)
        o = o or {}
        local label = tostring(o.Name or "Dropdown")
        local c = card(CARD_H, true)
        nameLabel(c, label, UDim2.new(0.5, 0, 1, 0))
        
        local valLbl = tx("TextLabel", {AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -28, 0.5, 0), Size = UDim2.new(0.45, 0, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Right,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextSize = 11, ZIndex = 15, Parent = c}, 2, "Sub")
        
        local arrow = makeIcon(c, "chevron-down", 13, "Sub", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), ZIndex = 15})

        local obj = {Options = o.Options or {}, Value = nil, IsOpen = false}
        local popupFrame

        function obj:Close()
            if popupFrame then
                local pf = popupFrame
                popupFrame = nil
                obj.IsOpen = false
                play(arrow.Glyph, 0.2, {Rotation = 0})
                play(pf, 0.16, {GroupTransparency = 1})
                local sc = pf:FindFirstChildOfClass("UIScale")
                if sc then play(sc, 0.16, {Scale = 0.9}) end
                task.delay(0.2, function() pf:Destroy() end)
            end
        end

        function obj:Open()
            if obj.IsOpen or obj:IsLocked() then return end
            obj.IsOpen = true
            play(arrow.Glyph, 0.2, {Rotation = 180})
            
            local rowCount = math.min(#obj.Options, 6)
            local popH = rowCount * 28 + 10
            popupFrame = mk("CanvasGroup", {Name = "DropdownPopup",
                Size = UDim2.fromOffset(c.AbsoluteSize.X, popH),
                GroupTransparency = 1, BackgroundColor3 = Color3.new(1, 1, 1),
                ZIndex = 62, Parent = Root})
            bind(popupFrame, "BackgroundColor3", "Surface")
            round(popupFrame, 10)
            outline(popupFrame, "Stroke", 1.5, 0.15)
            mk("UIScale", {Scale = 0.9, Parent = popupFrame})
            
            local list = mk("ScrollingFrame", {Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1, ScrollBarThickness = 3,
                CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ZIndex = 63, Parent = popupFrame})
            inset(list, 5, 5, 5, 5)
            stack(list, 2)
            
            for i, opt in ipairs(obj.Options) do
                local b = mk("TextButton", {Size = UDim2.new(1, 0, 0, 24),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BackgroundTransparency = (obj.Value == opt) and 0.85 or 1,
                    LayoutOrder = i, ZIndex = 64, Parent = list})
                round(b, 6)
                
                local l = tx("TextLabel", {Text = tostring(opt), TextSize = 11,
                    Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0),
                    TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 65, Parent = b}, 2,
                    (obj.Value == opt) and "Accent" or "Sub")
                
                b.MouseEnter:Connect(function()
                    play(b, 0.12, {BackgroundTransparency = 0.88})
                end)
                b.MouseLeave:Connect(function()
                    play(b, 0.15, {BackgroundTransparency = (obj.Value == opt) and 0.85 or 1})
                end)
                
                b.Activated:Connect(function()
                    obj.Value = opt
                    valLbl.Text = tostring(opt)
                    obj:Close()
                    queueSave()
                end)
            end
            
            local cPos = c.AbsolutePosition
            local cSize = c.AbsoluteSize
            local v = viewport()
            local w = cSize.X / math.max(currentScale, 0.01)
            popupFrame.Size = UDim2.fromOffset(w, popH)
            popupFrame.Position = UDim2.fromOffset(
                math.clamp(cPos.X, 4, v.X - w - 4),
                math.clamp(cPos.Y + cSize.Y + 8, 4, v.Y - popH - 4))
            
            play(popupFrame, 0.2, {GroupTransparency = 0})
            local sc = popupFrame:FindFirstChildOfClass("UIScale")
            if sc then play(sc, 0.28, {Scale = 1}, Enum.EasingStyle.Back) end
            
            task.spawn(function()
                local conn
                conn = UserInputService.InputBegan:Connect(function(input)
                    if isPointer(input) then
                        local pos = v2(input)
                        local pa = popupFrame and popupFrame.AbsolutePosition
                        local ps = popupFrame and popupFrame.AbsoluteSize
                        local ca = c.AbsolutePosition
                        local cs = c.AbsoluteSize
                        local inPopup = pa and (pos.X >= pa.X and pos.X <= pa.X + ps.X
                            and pos.Y >= pa.Y and pos.Y <= pa.Y + ps.Y)
                        local inCard = pos.X >= ca.X and pos.X <= ca.X + cs.X
                            and pos.Y >= ca.Y and pos.Y <= ca.Y + cs.Y
                        if not inPopup and not inCard then
                            obj:Close()
                            conn:Disconnect()
                        end
                    end
                end)
            end)
        end

        function obj:Get() return obj.Value end
        function obj:Set(v, silent)
            if v ~= nil and not table.find(obj.Options, v) then return end
            obj.Value = v
            valLbl.Text = v and tostring(v) or "None"
            if not silent then queueSave() end
        end

        c.Activated:Connect(function()
            if obj.IsOpen then obj:Close() else obj:Open() end
        end)

        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Dropdown")
        
        local first = o.Default or obj.Options[1]
        obj:Set(first, true)
        return obj
    end

    function E:AddColorpicker(o)
        o = o or {}
        local label = tostring(o.Name or "Color")
        local c = card(CARD_H, true)
        nameLabel(c, label, UDim2.new(1, -65, 1, 0))
        
        local swatch = mk("Frame", {AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(40, 22),
            ZIndex = 15, Parent = c})
        round(swatch, 6)
        outline(swatch, "Text", 1.5, 0.6)

        local start = typeof(o.Default) == "Color3" and o.Default or Color3.fromRGB(70, 140, 255)
        local h, s, v = start:ToHSV()
        local obj = {Value = start, IsOpen = false}
        local ui = {}
        
        local function apply(silent)
            local col = Color3.fromHSV(h, s, v)
            obj.Value = col
            swatch.BackgroundColor3 = col
            if ui.sv and ui.sv.Parent then
                ui.sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                ui.svKnob.Position = UDim2.fromScale(s, 1 - v)
                ui.svKnob.BackgroundColor3 = col
                ui.hueKnob.Position = UDim2.new(0.5, 0, h, 0)
            end
            if not silent then queueSave() end
        end

        local popupFrame
        function obj:Close()
            if popupFrame then
                local pf = popupFrame
                popupFrame = nil ui = {}
                obj.IsOpen = false
                play(pf, 0.16, {GroupTransparency = 1})
                local sc = pf:FindFirstChildOfClass("UIScale")
                if sc then play(sc, 0.16, {Scale = 0.9}) end
                task.delay(0.2, function() pf:Destroy() end)
            end
        end

        function obj:Open()
            if obj.IsOpen or obj:IsLocked() then return end
            obj.IsOpen = true
            
            local w, hgt = 210, 200
            popupFrame = mk("CanvasGroup", {Size = UDim2.fromOffset(w, hgt),
                GroupTransparency = 1, BackgroundColor3 = Color3.new(1, 1, 1),
                ZIndex = 62, Parent = Root})
            bind(popupFrame, "BackgroundColor3", "Surface")
            round(popupFrame, 10)
            outline(popupFrame, "Stroke", 1.5, 0.15)
            mk("UIScale", {Scale = 0.9, Parent = popupFrame})
            inset(popupFrame, 10, 10, 10, 10)

            -- SV picker
            local sv = mk("TextButton", {Size = UDim2.fromOffset(130, 120),
                BackgroundColor3 = Color3.fromHSV(h, 1, 1), ZIndex = 63, Parent = popupFrame})
            round(sv, 6)
            
            local white = mk("Frame", {Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 64, Parent = sv})
            round(white, 6)
            mk("UIGradient", {Transparency = NumberSequence.new(0, 1), Parent = white})
            
            local black = mk("Frame", {Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 65, Parent = sv})
            round(black, 6)
            mk("UIGradient", {Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = black})
            
            local svKnob = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(12, 12), BackgroundColor3 = obj.Value,
                ZIndex = 67, Parent = sv})
            round(svKnob, 6)
            mk("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 2.5, Parent = svKnob})

            -- Hue slider
            local hue = mk("TextButton", {AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, 6, 0, 0),
                Size = UDim2.fromOffset(16, 120),
                BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = popupFrame})
            round(hue, 6)
            
            local hKeys = {}
            for i = 0, 6 do
                hKeys[#hKeys + 1] = ColorSequenceKeypoint.new(i / 6,
                    Color3.fromHSV(math.min(i / 6, 0.999), 1, 1))
            end
            mk("UIGradient", {Color = ColorSequence.new(hKeys), Rotation = 90, Parent = hue})
            
            local hueKnob = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, h, 0), Size = UDim2.fromOffset(20, 6),
                BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 65, Parent = hue})
            round(hueKnob, 3)
            mk("UIStroke", {Color = Color3.new(0, 0, 0), Transparency = 0.5, Thickness = 1.5, Parent = hueKnob})

            ui = {sv = sv, svKnob = svKnob, hueKnob = hueKnob}
            local mode

            local function fromPos(pos)
                if mode == "sv" then
                    s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
                    v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
                elseif mode == "hue" then
                    h = math.clamp((pos.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 0.999)
                end
                apply()
            end

            trackPointer(sv, function(input) mode = "sv" fromPos(input.Position) end,
                function(p) fromPos(p) end, function() mode = nil end)
            trackPointer(hue, function(input) mode = "hue" fromPos(input.Position) end,
                function(p) fromPos(p) end, function() mode = nil end)

            local cPos = c.AbsolutePosition
            local cSize = c.AbsoluteSize
            local vp = viewport()
            popupFrame.Position = UDim2.fromOffset(
                math.clamp(cPos.X + cSize.X - w * currentScale, 4, vp.X - w * currentScale - 4),
                math.clamp(cPos.Y + cSize.Y + 8, 4, vp.Y - hgt * currentScale - 4))

            play(popupFrame, 0.2, {GroupTransparency = 0})
            local sc = popupFrame:FindFirstChildOfClass("UIScale")
            if sc then play(sc, 0.28, {Scale = 1}, Enum.EasingStyle.Back) end

            task.spawn(function()
                local conn
                conn = UserInputService.InputBegan:Connect(function(input)
                    if isPointer(input) then
                        local pos = v2(input)
                        local pa = popupFrame and popupFrame.AbsolutePosition
                        local ps = popupFrame and popupFrame.AbsoluteSize
                        local ca = c.AbsolutePosition
                        local cs = c.AbsoluteSize
                        local inPopup = pa and (pos.X >= pa.X and pos.X <= pa.X + ps.X
                            and pos.Y >= pa.Y and pos.Y <= pa.Y + ps.Y)
                        local inCard = pos.X >= ca.X and pos.X <= ca.X + cs.X
                            and pos.Y >= ca.Y and pos.Y <= ca.Y + cs.Y
                        if not inPopup and not inCard then
                            obj:Close()
                            conn:Disconnect()
                        end
                    end
                end)
            end)
        end

        function obj:Set(col, silent)
            if typeof(col) ~= "Color3" then return end
            h, s, v = col:ToHSV() 
            apply(silent)
        end
        function obj:Get() return obj.Value end

        c.Activated:Connect(function()
            if obj.IsOpen then obj:Close() else obj:Open() end
        end)

        register(o.Flag, obj, o, function() return obj.Value end, function(col) obj:Set(col) end)
        decorate(obj, c, o, "Colorpicker")
        
        swatch.BackgroundColor3 = start
        apply(true)
        return obj
    end

    return E
end

