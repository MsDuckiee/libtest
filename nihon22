    glass.Image.ZIndex = 183
    glass.Glyph.ZIndex = 183
    local input = tx("TextBox", {
        Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -90, 1, 0), PlaceholderText = "search features", TextSize = 14, ZIndex = 183, Parent = top,
    }, 2)
    input.ClearTextOnFocus = false
