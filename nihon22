local function flipTabs(Window, from, to, forward)
    local P = Window._parts
    local dir = forward and 1 or -1
    local contentW = P.content.AbsoluteSize.X

    if from and from ~= to then
        from.Remember()
        local outPage = from.Page
        outPage.Visible = true
        outPage.Position = UDim2.fromOffset(0, 0)
        outPage.GroupTransparency = 0
        play(outPage, 0.3, {Position = UDim2.fromOffset(-contentW * dir, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
        play(outPage, 0.25, {GroupTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
        task.delay(0.32, function()
            if Window.Selected ~= from then
                outPage.Visible = false
                outPage.Position = UDim2.fromOffset(0, 0)
                outPage.GroupTransparency = 1
            end
        end)
    end

    local inPage = to.Page
    inPage.Visible = true
    inPage.GroupTransparency = 1
    inPage.Position = UDim2.fromOffset(contentW * dir, 0)
    to.Restore()

    play(inPage, 0.42, {Position = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    play(inPage, 0.3, {GroupTransparency = 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

    local cards = {}
    for _, child in ipairs(to.Scroll:GetDescendants()) do
        if child:GetAttribute("NihonCard") then
            cards[#cards + 1] = child
        end
    end
    table.sort(cards, function(a, b)
        return a.AbsolutePosition.Y < b.AbsolutePosition.Y
    end)
    local viewH = P.content.AbsoluteSize.Y + P.content.AbsolutePosition.Y
    for i, card in ipairs(cards) do
        if card.AbsolutePosition.Y < viewH and i <= 10 then
            local rest = card.Position
            local cardScale = card:FindFirstChildOfClass("UIScale")
            if not cardScale then
                cardScale = mk("UIScale", {Scale = 1, Parent = card})
            end
            card.Position = rest + UDim2.fromOffset(0, 8)
            cardScale.Scale = 0.97
            task.delay((i - 1) * 0.035, function()
                if card.Parent then
                    play(card, 0.35, {Position = rest}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                    play(cardScale, 0.3, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                end
            end)
        end
    end
end

function TabImpl.select(Window, target, instant)
    local P = Window._parts
    if type(target) == "number" then target = Window.Tabs[target] end
    if type(target) == "string" then
        for _, t in ipairs(Window.Tabs) do
            if t.Name == target then target = t break end
        end
    end
    if type(target) ~= "table" or not target.Button then return end
    local prev = Window.Selected
    if prev == target then return end
    Popup.close(true)
    hideTip()
    Window.Selected = target

    local forward = not prev or target.Index > prev.Index
    if instant or not prev then
        for _, t in ipairs(Window.Tabs) do
            t.Page.Visible = t == target
            t.Page.GroupTransparency = t == target and 0 or 1
            t.Page.Position = UDim2.fromOffset(0, 0)
        end
        target.Restore()
    else
        flipTabs(Window, prev, target, forward)
    end

    for _, t in ipairs(Window.Tabs) do
        local active = t == target
        t.IconObj.Color(active and Pal.Accent or Pal.Sub, not instant)
    end

    task.defer(function()
        local b = target.Button
        local pill = P.pill
        pill.Visible = true
        local y = b.AbsolutePosition.Y - P.side.AbsolutePosition.Y
        local scale = math.max(currentScale, 0.01)
        local targetPos = UDim2.fromOffset(8, y / scale)
        local targetSize = UDim2.new(1, -16, 0, b.AbsoluteSize.Y / scale)
        if instant or not prev then
            pill.Position, pill.Size = targetPos, targetSize
        else
            play(pill, 0.35, {Position = targetPos, Size = targetSize}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        end
    end)

    if Window.OnTabChanged then
        task.spawn(Window.OnTabChanged, target)
    end
end

local function numFormat(v, step, suffix)
    local s
    if step < 1 then
        local frac = (tostring(step):gsub("^0%.", ""))
        local places = math.min(3, math.max(1, #frac))
        s = string.format("%." .. places .. "f", v)
        s = (s:gsub("0+$", ""))
        s = (s:gsub("%.$", ""))
    else
        s = tostring(math.floor(v + 0.5))
    end
    if suffix and suffix ~= "" then
        return s .. " " .. suffix
    end
    return s
end

local function snapTo(v, step, min)
    if step <= 0 then return v end
    return min + math.floor((v - min) / step + 0.5) * step
end

