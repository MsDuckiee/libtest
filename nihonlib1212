local HudStyles = {
    Modern = {bg=function() return Pal.Surface end, bgT=0.12, radius=10, stroke=function() return Pal.Stroke end, strokeW=1, text=function() return Pal.Text end, font=Enum.Font.GothamBold, size=12, dot=true, padX=10, padY=6},
    Minimal = {bgT=1, radius=0, strokeW=0, text=function() return Pal.Text end, font=Enum.Font.GothamMedium, size=13, dot=true, padX=4, padY=2, textStroke=true},
    Neon = {bg=function() return Color3.fromRGB(8,8,14) end, bgT=0.1, radius=8, stroke=function() return Pal.Accent end, strokeW=1.5, text=function() return Pal.Accent end, font=Enum.Font.GothamBold, size=12, dot=false, padX=10, padY=6},
}
local HudStyleOrder = {"Modern","Minimal","Neon"}
local function hudStyleChip(item, c)
    local st = HudStyles[Hud.style] or HudStyles.Modern
    c.frame.BackgroundColor3 = st.bg and st.bg(item) or Color3.new(0,0,0)
    c.frame.BackgroundTransparency = st.bgT
    c.corner.CornerRadius = UDim.new(0, st.radius)
    c.stroke.Enabled = st.strokeW > 0
    c.stroke.Thickness = st.strokeW
    c.stroke.Transparency = st.strokeT or 0.15
    if st.stroke then c.stroke.Color = st.stroke(item) end
    c.pad.PaddingLeft = UDim.new(0, st.padX)
    c.pad.PaddingRight = UDim.new(0, st.padX)
    c.pad.PaddingTop = UDim.new(0, st.padY)
    c.pad.PaddingBottom = UDim.new(0, st.padY)
    c.label.Font = st.font
    c.label.TextSize = st.size
    c.label.TextColor3 = st.text(item)
    c.label.TextStrokeTransparency = st.textStroke and 0.35 or 1
    c.label.TextStrokeColor3 = Color3.new(0,0,0)
    c.dot.Visible = st.dot
end
local function hudText(item)
    local st = HudStyles[Hud.style] or HudStyles.Modern
    local pre = st.prefix or ""
    if item == "FPS" then return pre .. Metrics.fps .. " FPS"
    elseif item == "Ping" then return pre .. Metrics.ping .. " ms"
    elseif item == "Memory" then return pre .. Metrics.mem .. " MB"
    elseif item == "Name" then return pre .. Hud.title end
    local fmt = Hud.clock24 and (Hud.seconds and "%H:%M:%S" or "%H:%M") or (Hud.seconds and "%I:%M:%S %p" or "%I:%M %p")
    return pre .. os.date(fmt)
end
local function hudDotColor(item)
    if item == "FPS" then return Metrics.fps >= 50 and Status.Success or (Metrics.fps >= 30 and Status.Warning or Status.Error)
    elseif item == "Ping" then return Metrics.ping <= 90 and Status.Success or (Metrics.ping <= 170 and Status.Warning or Status.Error)
    elseif item == "Memory" then return Pal.Accent2 end
    return Pal.Accent
end
local function hudUpdate()
    for item, c in pairs(Hud.chips) do
        c.label.Text = hudText(item)
        if c.dot.Visible then c.dot.BackgroundColor3 = hudDotColor(item) end
    end
end
local function hudBuild()
    for _, c in pairs(Hud.chips) do c.frame:Destroy() end
    Hud.chips = {}
    for i, item in ipairs(hudOrder) do
        if Hud.items[item] then
            local frame = mk("Frame", {AutomaticSize=Enum.AutomaticSize.XY, Size=UDim2.new(), LayoutOrder=i, Parent=hudFrame})
            local c = {frame=frame}
            c.corner = mk("UICorner", {Parent=frame})
            c.stroke = mk("UIStroke", {ApplyStrokeMode=Enum.ApplyStrokeMode.Border, Parent=frame})
            c.pad = mk("UIPadding", {Parent=frame})
            mk("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, VerticalAlignment=Enum.VerticalAlignment.Center, Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder, Parent=frame})
            c.dot = mk("Frame", {Size=UDim2.fromOffset(8,8), LayoutOrder=1, Parent=frame})
            round(c.dot, 4)
            c.label = mk("TextLabel", {BackgroundTransparency=1, AutomaticSize=Enum.AutomaticSize.XY, Size=UDim2.new(), LayoutOrder=2, Text="", Parent=frame})
            Hud.chips[item] = c
            hudStyleChip(item, c)
        end
    end
    hudUpdate()
end
local function hudRestyle() for item, c in pairs(Hud.chips) do hudStyleChip(item, c) end hudUpdate() end
function Hud.set(on)
    Hud.enabled = on and true or false
    hudFrame.Visible = Hud.enabled
