local function measure(text, size, font, bounds)
    local key = text .. "\0" .. size .. "\0" .. font.Name .. "\0" .. bounds.X .. "x" .. bounds.Y
    local cached = textSizeCache[key]
    if cached then return cached end
    local result = TextService:GetTextSize(text, size, font, bounds)
    if textSizeCacheCount > 512 then textSizeCache = {} textSizeCacheCount = 0 end
    textSizeCache[key] = result
    textSizeCacheCount = textSizeCacheCount + 1
    return result
end

