function Nihon:SetKeySystem(cfg)
    cfg = cfg or {}
    cfg.Title = cfg.Title or "Key System"
    cfg.Subtitle = cfg.Subtitle or "Enter your key to continue"
    cfg.ButtonText = cfg.ButtonText or "Verify"
    cfg.GetKeyText = cfg.GetKeyText or "Get Key"
    cfg.DiscordText = cfg.DiscordText or "Discord"
    cfg.Icon = cfg.Icon or "key"
    if cfg.KeyFile ~= nil then Nihon.KeyFile = cfg.KeyFile == true end
    if cfg.KeyFileName then Nihon.KeyFileName = tostring(cfg.KeyFileName) end
    if cfg.AutoVerify ~= nil then Nihon.AutoVerify = cfg.AutoVerify ~= false end
    Nihon._keyCfg = cfg
end

local function keyFSReady()
    return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" and type(makefolder) == "function" and type(isfolder) == "function"
end
function Nihon:_keyFolder() return Nihon.Folder .. "/keys" end
function Nihon:_keyPath() return Nihon:_keyFolder() .. "/" .. tostring(Nihon.KeyFileName or "key") .. ".key" end
function Nihon:SaveKeyToFile(key)
    if not keyFSReady() or key == nil or key == "" then return false end
    return pcall(function() if not isfolder(Nihon:_keyFolder()) then makefolder(Nihon:_keyFolder()) end writefile(Nihon:_keyPath(), tostring(key)) end)
end
function Nihon:LoadKeyFromFile()
    if not keyFSReady() then return nil end
    local path = Nihon:_keyPath()
    local ok, data = pcall(function() if not isfile(path) then return nil end return readfile(path) end)
    if ok and data and data ~= "" then return data end
    return nil
end
function Nihon:_validateKey(key)
    local cfg = Nihon._keyCfg or {}
    if type(cfg.Validate) == "function" then
        local ok, r = pcall(cfg.Validate, key)
        return ok and r == true
    elseif cfg.Key ~= nil then
        return tostring(key) == tostring(cfg.Key)
    end
    return true
end
