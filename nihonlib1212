                local want = state.targetPos
                local clamped = opts.clamp(want)
                local dx, dy = want.X - clamped.X, want.Y - clamped.Y
                if math.abs(dx) > 0.5 then hit("x", dx > 0 and 1 or -1, math.min(1, math.abs(dx) / 80)) state.velocity = Vector2.new(-state.velocity.X * 0.32, state.velocity.Y) end
                if math.abs(dy) > 0.5 then hit("y", dy > 0 and 1 or -1, math.min(1, math.abs(dy) / 80)) state.velocity = Vector2.new(state.velocity.X, -state.velocity.Y * 0.32) end
                state.targetPos = clamped
            end
