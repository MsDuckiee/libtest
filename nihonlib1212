    -- =========================================================
    -- SHOW / HIDE
    -- =========================================================
    local closeToken = 0
    local placed = false
    local function fitScale()
        local v = viewport()
        local estH = baseH + 42 + 54 + 60 + 40
        local estW = baseW
        local fit = math.min((v.X - 20) / estW, (v.Y - 20) / estH, 1)
        return math.max(fit, 0.5) * Window.Scale
    end
    local activeScale = 1
    local function applyScale(animated)
        activeScale = fitScale()
        currentScale = activeScale
        if animated then
            play(uiScale, 0.3, {Scale = activeScale})
            play(dockScale, 0.3, {Scale = activeScale})
        else
            uiScale.Scale = activeScale
            dockScale.Scale = activeScale
        end
    end
    local cam = workspace.CurrentCamera
    if cam then
        keep(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            if not Window.Hidden then applyScale(true) end
        end))
    end

    local function show(fromMorph)
        Window.Morphing = false
        if tweens[shell] then for _, tw in pairs(tweens[shell]) do pcall(function() tw:Cancel() end) end end
        Window.Hidden = false
        Window.Minimized = false
        applyScale(false)
        uiScale.Scale = activeScale
        dockScale.Scale = activeScale
        shell.AnchorPoint = Vector2.new(0.5, 0.5)
        if not placed then shell.Position = UDim2.fromScale(0.5, 0.5) placed = true end
        closeToken = closeToken + 1
        local mine = closeToken
        bottomDock.Position = UDim2.new(0.5, 0, 1, -14)
        bottomDock.Visible = true
        restoreGroup(bottomDock)
        winCard.Visible = true
        winCard.GroupTransparency = 0
        play(minIconHolder.Image, 0.3, {Rotation = 0})
        play(minIconHolder.Glyph, 0.3, {Rotation = 0})
        -- restore min button bg
        play(minBtnBox, 0.3, {BackgroundTransparency = 0.02})
        if minBtnStroke then
            local base = minBtnStroke:GetAttribute("_baseTrans") or 0.5
            play(minBtnStroke, 0.3, {Transparency = base})
        end

        if fromMorph and launcher.Visible then
            Window.Morphing = true
            play(launcher, 0.32, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            play(launcherStroke, 0.32, {Transparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            play(launcherTitle, 0.22, {TextTransparency = 1})
            play(launcherSub, 0.22, {TextTransparency = 1})
            play(launcherIconBox, 0.28, {BackgroundTransparency = 1})
            play(launcherIcon.Image, 0.28, {ImageTransparency = 1})
            play(launcherIcon.Glyph, 0.28, {TextTransparency = 1})
            play(launcherScale, 0.36, {Scale = 0.15}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            shell.Visible = true
            shell.GroupTransparency = 1
            uiScale.Scale = activeScale * 0.6
            play(uiScale, 0.5, {Scale = activeScale}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            task.delay(0.02, function() if mine == closeToken then fadeGroup(shell, 0.3, 0) end end)
            task.delay(0.40, function()
                if mine ~= closeToken then return end
                launcher.Visible = false
                launcherScale.Scale = 0
                Window.Morphing = false
            end)
        else
            shell.Visible = true
            shell.GroupTransparency = 1
            uiScale.Scale = activeScale * 0.85
            play(uiScale, 0.55, {Scale = activeScale}, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
            fadeGroup(shell, 0.3, 0)
            if Nihon.ShowLauncher then showLauncher(false) end
        end
        -- blur on
        play(NihonBlur, 0.4, {Size = 14}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    end

    local function hide(toMorph)
        Window.Morphing = false
        Window.Hidden = true
        Popup.close(true)
        hideTip()
        closeToken = closeToken + 1
        local mine = closeToken
        if toMorph and Nihon.ShowLauncher then
            Window.Morphing = true
            fadeGroup(shell, 0.3, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            fadeGroup(bottomDock, 0.3, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            play(uiScale, 0.3, {Scale = activeScale * 0.75}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            play(dockScale, 0.3, {Scale = activeScale * 0.75}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            task.delay(0.34, function()
                if mine ~= closeToken then return end
                shell.Visible = false
                restoreGroup(shell)
                Window.Morphing = false
                launcher.BackgroundTransparency = 1
                launcherStroke.Transparency = 1
                launcherTitle.TextTransparency = 1
                launcherSub.TextTransparency = 1
                launcherIcon.Image.ImageTransparency = 1
                launcherIcon.Glyph.TextTransparency = 1
                launcherIconBox.BackgroundTransparency = 1
                showLauncher(true)
                play(launcher, 0.4, {BackgroundTransparency = 0}, Enum.EasingStyle.Quart)
                play(launcherStroke, 0.4, {Transparency = 0.55}, Enum.EasingStyle.Quart)
                play(launcherTitle, 0.35, {TextTransparency = 0}, Enum.EasingStyle.Quart)
                play(launcherSub, 0.35, {TextTransparency = 0}, Enum.EasingStyle.Quart)
                play(launcherIconBox, 0.35, {BackgroundTransparency = 0}, Enum.EasingStyle.Quart)
                play(launcherIcon.Image, 0.35, {ImageTransparency = 0}, Enum.EasingStyle.Quart)
                play(launcherIcon.Glyph, 0.35, {TextTransparency = 0}, Enum.EasingStyle.Quart)
            end)
        else
            local tw = play(uiScale, 0.22, {Scale = activeScale * 0.9}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            fadeGroup(shell, 0.22, 1, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            after(tw, function() if Window.Hidden and mine == closeToken then shell.Visible = false end end)
            task.delay(0.32, function()
                if mine == closeToken and Window.Hidden then restoreGroup(shell) end
            end)
        end
        -- hide bottom dock + kill blur
        fadeGroup(bottomDock, 0.3, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.35, function()
            if Window.Hidden then bottomDock.Visible = false end
        end)
        play(NihonBlur, 0.35, {Size = 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    end

    Window.Show = function() show(false) end
    Window.Hide = function() hide(true) end
    function Window:Toggle() if Window.Hidden then show(true) else hide(true) end end

    -- =========================================================
    -- MINIMIZE
    -- =========================================================
    local function setMinimized(state)
        state = state and true or false
        if Window.Minimized == state then return end
        Window.Minimized = state
        Popup.close(true)

        if state then
            fadeGroup(winCard, 0.25, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            task.delay(0.27, function()
                if not Window.Minimized then return end
                winCard.Visible = false
                play(minBtnBox, 0.35, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart)
                if minBtnStroke then
                    play(minBtnStroke, 0.35, {Transparency = 1}, Enum.EasingStyle.Quart)
                end
                local dockH = bottomDock.AbsoluteSize.Y / math.max(dockScale.Scale, 0.01)
                local minH = minBtnBox.AbsoluteSize.Y / math.max(dockScale.Scale, 0.01)
                local slideDown = math.max(0, dockH - minH - 2)
                play(bottomDock, 0.5, {
                    Position = UDim2.new(0.5, 0, 1, -14 + slideDown)
                }, Enum.EasingStyle.Back, Enum.EasingDirection.InOut)
            end)
        else
            play(bottomDock, 0.5, {
                Position = UDim2.new(0.5, 0, 1, -14)
            }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            play(minBtnBox, 0.35, {BackgroundTransparency = 0.02}, Enum.EasingStyle.Quart)
            if minBtnStroke then
                local base = minBtnStroke:GetAttribute("_baseTrans") or 0.5
                play(minBtnStroke, 0.35, {Transparency = base}, Enum.EasingStyle.Quart)
            end
            winCard.Visible = true
            winCard.GroupTransparency = 1
            task.delay(0.15, function()
                if Window.Minimized then return end
                fadeGroup(winCard, 0.3, 0, Enum.EasingStyle.Quart)
            end)
        end

        play(minIconHolder.Image, 0.3, {Rotation = state and 180 or 0})
