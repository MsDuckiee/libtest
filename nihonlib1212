        function obj:Toggle() if obj.IsOpen then obj:Close() else obj:Open() end end
        keep(RunService.Heartbeat:Connect(function() if obj.Rainbow then h = (os.clock()*0.2)%1 apply() end end))
        function obj:Set(col, silent)
            if typeof(col) ~= "Color3" then return end
            h, s, v = col:ToHSV() apply(silent)
        end
        function obj:Get() return obj.Value end
        header.InputBegan:Connect(function(input) if isPointer(input) then obj:Toggle() end end)
        register(o.Flag, obj, o, function() return obj.Value end, function(col) obj:Set(col) end)
        decorate(obj, c, o, "Colorpicker")
        apply(true)
        initFires[#initFires + 1] = function()
            local ok, err = pcall(o.Callback or function() end, obj.Value)
            if not ok then fail(c, label, err) end
        end
