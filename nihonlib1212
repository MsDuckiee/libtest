            rb.InputBegan:Connect(function(input)
                if not isPointer(input) then return end
                obj.Rainbow = not obj.Rainbow
                rb.TextColor3 = obj.Rainbow and Pal.Accent or Pal.Text
            end)
            hex.Text = "#"..obj.Value:ToHex():upper()
            svKnob.Position = UDim2.fromScale(s, 1 - v)
        end
