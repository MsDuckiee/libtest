            if opts.onEnd then opts.onEnd(state.moved) end
            if not state.moved and opts.onClick then opts.onClick() end
        end))
    end
    local cleanup
    cleanup = target.Destroying:Connect(function()
        if state.runConn then state.runConn:Disconnect() state.runConn = nil end
        if cleanup then cleanup:Disconnect() end
    end)
end

local function makeFirer(getValue, run)
    local last = {}
    local busy = false
    local api = {}
    function api.Fire()
        if busy then return end
        busy = true
        task.spawn(function()
            while true do
                local v = getValue()
                if v == last then break end
                last = v
                pcall(run, v)
            end
            busy = false
        end)
    end
    function api.Sync(v) last = v end
    return api
end

