                    bodyClip.ClipsDescendants = true
                    collapseTween = play(bodyClip, 0.34, {Size = UDim2.new(1, 0, 0, target)}, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
                    after(collapseTween, function()
