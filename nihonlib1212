local corners = {
    TopRight={ax=1,ay=0}, TopLeft={ax=0,ay=0}, TopCenter={ax=0.5,ay=0},
    BottomRight={ax=1,ay=1}, BottomLeft={ax=0,ay=1}, BottomCenter={ax=0.5,ay=1},
}
local noteLoop
local function noteWidth() return math.clamp(math.floor(viewport().X - 28), 320, 420) end
local function noteBasePos()
    local c = corners[Notes.position] or corners.TopRight
    local mx = c.ax == 0.5 and 0 or (c.ax == 1 and -16 or 16)
    return UDim2.new(c.ax, mx, c.ay, c.ay == 0 and 16 or -16), c
end
local function layoutAll()
    local _, c = noteBasePos()
    for i, n in ipairs(Notes.active) do
        if n and n.frame and n.frame.Parent then
            local depth = i - 1
            local sc = math.max(0.78, 1 - depth * 0.08)
