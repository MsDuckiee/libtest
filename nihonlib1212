        mk("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder, VerticalAlignment=Enum.VerticalAlignment.Center, Parent=row})
        local obj = {Value=o.Default or options[1]}
        local firer = makeFirer(function() return obj.Value end, function(v)
            local ok, err = pcall(o.Callback or function() end, v)
            if not ok then fail(c, label, err) end
        end)
        local buttons = {}
        local function paint()
            for opt, b in pairs(buttons) do
                local on = opt == obj.Value
                play(b, 0.15, {BackgroundTransparency = on and 0 or 0.85})
                b.BackgroundColor3 = on and Pal.Accent or Pal.Elevated
                b.TextColor3 = on and onAccent() or Pal.Text
            end
        end
        for i, opt in ipairs(options) do
            local b = tx("TextButton", {Text=tostring(opt), TextSize=12, Size=UDim2.fromOffset(0,30), AutomaticSize=Enum.AutomaticSize.X, LayoutOrder=i, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=27, Parent=row}, 3)
            inset(b, 0, 14, 0, 14) round(b, 8) b.BackgroundTransparency = 0
            buttons[opt] = b
            b.InputBegan:Connect(function(input)
                if not isPointer(input) then return end
                obj.Value = opt paint() firer.Fire() queueSave()
            end)
        end
        function obj:Set(v, silent)
            if not buttons[v] then return end
            obj.Value = v paint()
            if silent then firer.Sync(v) else firer.Fire() queueSave() end
        end
        function obj:Get() return obj.Value end
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v, true) end)
        decorate(obj, c, o, "Radio")
        paint()
        return obj
    end

