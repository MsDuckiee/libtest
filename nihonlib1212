            if c.ay == 0 then targPos = UDim2.new(c.ax, xOff, 0, yOff)
            else targPos = UDim2.new(c.ax, xOff, 1, yOffBottom) end
            if n.spawned then
                play(n.frame, 0.45, {Position = targPos, Size = UDim2.fromOffset(w, h)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                play(n.pop, 0.4, {Scale = sc}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                local dim = depth == 0 and 0 or math.min(0.30, depth * 0.10)
                fadeGroup(n.frame, 0.32, dim, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            else
                n.frame.Position = targPos
                n.frame.Size = UDim2.fromOffset(w, h)
