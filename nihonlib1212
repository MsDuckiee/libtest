function ElementFactory(Window, Tab, parent, sectionName)
    local P = Window._parts
    local mobile = P.mobile
    local E = {_count = 0}
    local rowH = mobile and 44 or 40

    local function card(height, hover)
        local c = mk("TextButton", {Size=UDim2.new(1,0,0,height or rowH), BackgroundTransparency=0.38, ZIndex=24, LayoutOrder=E._count + 1, Parent=parent})
        bind(c, "BackgroundColor3", "Surface")
        round(c, 12)
        local st = outline(c, "Stroke", 1, 0.45)
        c:SetAttribute("NihonCard", true)
        return c, st
    end

    local function nameLabel(c, text, width)
        return tx("TextLabel", {Name="Name", Text=tostring(text), TextSize=13, Position=UDim2.fromOffset(14,0), Size=width or UDim2.new(1,-90,1,0), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=25, Parent=c}, 2)
    end

    local function decorate(obj, c, opts, kind)
        E._count = E._count + 1
        local locked = false
        local veil = mk("Frame", {Name="Lock", Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.5, Visible=false, ZIndex=40, Parent=c})
        round(veil, 12)
        local lockIco = makeIcon(veil, "lock", 15, "Sub", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=41})
        lockIco.Image.ZIndex = 41 lockIco.Glyph.ZIndex = 41
        function obj:Lock(v) if v == nil then v = true end locked = v and true or false veil.Visible = locked end
        function obj:IsLocked() return locked end
        function obj:SetVisible(v) c.Visible = v and true or false end
        function obj:Destroy()
            c:Destroy()
            for i, e in ipairs(P.searchIndex) do if e.owner == obj then table.remove(P.searchIndex, i) break end end
        end
        function obj:SetName(n)
            local l = c:FindFirstChild("Name")
            if l then l.Text = tostring(n) end
        end
        function obj:SetTooltip(t) attachTip(c, t) end
        obj.Card = c
        obj.Kind = kind
        if opts.Locked then obj:Lock(true) end
        if opts.Tooltip then attachTip(c, opts.Tooltip) end
        if opts.Visible == false then c.Visible = false end
        P.searchIndex[#P.searchIndex + 1] = {
            owner=obj, name=tostring(opts.Name or kind), tab=Tab.Name, section=sectionName, kind=kind,
            go = function()
                if Window.RequestOpen then Window.RequestOpen() end
                Window:SelectTab(Tab)
                task.delay(0.22, function()
                    if not c.Parent then return end
                    local sc = Tab.Scroll
                    local y = c.AbsolutePosition.Y - sc.AbsolutePosition.Y + sc.CanvasPosition.Y - 10
                    play(sc, 0.35, {CanvasPosition = Vector2.new(0, math.max(0, y))})
                    flashCard(c, Pal.Accent, 1.1)
                end)
            end,
        }
        return obj
    end

    local function register(flag, obj, opts, get, set)
        if not flag then return end
        registerFlag(flag, {get=get, set=set, save=opts.Save==true, obj=obj})
        Nihon.Flags[flag] = obj
    end

    local function fail(c, label, err)
        flashCard(c, Status.Error, 1.1)
        shake(c)
        Nihon:MakeNotification({Name=(label or "Action").." failed", Content=errorText(err), Type="Error", Time=5})
    end

    function E:AddLabel(o)
        o = type(o) == "table" and o or {Name = o}
        local c = card(rowH - 6, false)
        c.Active = false
        local l = nameLabel(c, o.Name or "", UDim2.new(1, -28, 1, 0))
        bind(l, "TextColor3", "Sub")
        local obj = {}
        function obj:Set(t) l.Text = tostring(t) end
        function obj:Get() return l.Text end
        return decorate(obj, c, o, "Label")
    end

    function E:AddParagraph(o)
        o = o or {}
        local c = card(0, false)
        c.AutomaticSize = Enum.AutomaticSize.Y
        c.Size = UDim2.new(1, 0, 0, 0)
        c.Active = false
        inset(c, 14, 16, 14, 16)
        local col = mk("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, ZIndex=25, Parent=c})
        stack(col, 6)
        tx("TextLabel", {Text=tostring(o.Title or o.Name or "Note"), TextSize=13, Size=UDim2.new(1,0,0,18), TextWrapped=false, TextTruncate=Enum.TextTruncate.AtEnd, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center, LayoutOrder=1, ZIndex=25, Parent=col}, 3)
        local text = tx("TextLabel", {Text=tostring(o.Content or ""), TextSize=12, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, LineHeight=1.15, Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, LayoutOrder=2, ZIndex=25, Parent=col}, 1, "Sub")
        local obj = {}
        function obj:Set(t) text.Text = tostring(t) end
        function obj:Get() return text.Text end
        function obj:SetTitle(t) end
        return decorate(obj, c, o, "Paragraph")
    end

    function E:AddButton(o)
        o = o or {}
        local label = tostring(o.Name or "Button")
        local cooldown = tonumber(o.Cooldown) or 0.35
        local c = card(rowH, true)
        nameLabel(c, label, UDim2.new(1, -60, 1, 0))
        local arrow = makeIcon(c, o.Icon or "chevron-right", 16, "Sub", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-14,0.5,0), ZIndex=25})
        arrow.Image.ZIndex = 25 arrow.Glyph.ZIndex = 25
        local timerMask = mk("Frame", {AnchorPoint=Vector2.new(0,1), Position=UDim2.fromScale(0,1), Size=UDim2.new(0,0,0,2), BackgroundColor3=Color3.new(1,1,1), BackgroundTransparency=0.2, Visible=false, ZIndex=23, Parent=c})
        accentGradient(timerMask, 0)
        c.ClipsDescendants = true
        local obj = {}
        local ready = true
        local running = false
        function obj:Fire(...)
            if obj:IsLocked() or not ready or running then
                if not ready then shake(c) end
                return false
            end
            running = true
            ready = cooldown <= 0
            play(c, 0.08, {BackgroundTransparency = 0.35})
            task.delay(0.08, function() play(c, 0.25, {BackgroundTransparency = 0.15}) end)
            if cooldown > 0 then
                timerMask.Visible = true
                timerMask.Size = UDim2.new(1, 0, 0, 2)
                local tw = play(timerMask, cooldown, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear)
                after(tw, function() timerMask.Visible = false end)
                task.delay(cooldown, function() ready = true end)
            end
            local args = table.pack(...)
            task.spawn(function()
                local cb = o.Callback
                if type(cb) ~= "function" then running = false fail(c, label, "no callback attached") return end
                local ok, err = pcall(cb, table.unpack(args, 1, args.n))
                running = false
                if not ok then
                    if type(o.OnError) == "function" then pcall(o.OnError, err, label) end
                    fail(c, label, err)
                else
                    flashCard(c, Status.Success, 0.55)
                end
            end)
            return true
        end
        c.InputBegan:Connect(function(input) if isPointer(input) then obj:Fire() end end)
        function obj:SetCallback(fn) o.Callback = fn end
        function obj:SetCooldown(s) cooldown = tonumber(s) or 0 end
        return decorate(obj, c, o, "Button")
    end

    function E:AddToggle(o)
        o = o or {}
        local label = tostring(o.Name or "Toggle")
        local c = card(rowH, true)
        nameLabel(c, label, UDim2.new(1, -80, 1, 0))
        local track = mk("Frame", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-14,0.5,0), Size=UDim2.fromOffset(42,24), ZIndex=25, Parent=c})
        bind(track, "BackgroundColor3", "Elevated")
        round(track, 12)
        local trackStroke = outline(track, "Stroke", 1, 0.3)
        local fill = mk("Frame", {Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(1,1,1), BackgroundTransparency=1, ZIndex=26, Parent=track})
        round(fill, 12)
        accentGradient(fill, 25)
        local knob = mk("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,3,0.5,0), Size=UDim2.fromOffset(18,18), BackgroundColor3=Color3.new(1,1,1), ZIndex=28, Parent=track})
        round(knob, 9)
        mk("UIStroke", {Thickness=1, Color=Color3.new(0,0,0), Transparency=0.85, ApplyStrokeMode=Enum.ApplyStrokeMode.Border, Parent=knob})
        local glowRing = mk("Frame", {Size=UDim2.fromScale(1,1), BackgroundColor3=Pal.Accent, BackgroundTransparency=1, ZIndex=24, Parent=track})
        round(glowRing, 12)
        local state = {value = false}
        local obj = {Value = false}
        local function paint(v, animated)
            local dur = animated and 0.28 or 0.001
            play(fill, dur, {BackgroundTransparency = v and 0 or 1}, Enum.EasingStyle.Quart)
            play(trackStroke, dur, {Transparency = v and 1 or 0.3})
            play(glowRing, dur + 0.1, {BackgroundTransparency = v and 0.85 or 1})
            play(knob, dur, {Position = UDim2.new(0, v and 21 or 3, 0.5, 0)}, Enum.EasingStyle.Back)
        end
        local firer = makeFirer(function() return state.value end, function(v)
            local ok, err = pcall(o.Callback or function() end, v)
            if not ok then fail(c, label, err) end
        end)
        function obj:Set(v, silent)
            v = v and true or false
            state.value = v obj.Value = v paint(v, true)
            if silent then firer.Sync(v) else firer.Fire() queueSave() end
        end
        function obj:Get() return state.value end
        function obj:Toggle() obj:Set(not state.value) end
        -- Hitbox covering the whole card
        local hitbox = mk("TextButton", {
            Name="ToggleHitbox", Size=UDim2.fromScale(1,1), Position=UDim2.fromScale(0,0),
            BackgroundTransparency=1, Text="", AutoButtonColor=false,
            Active=true, ZIndex=30, Parent=c,
        })
        hitbox.Activated:Connect(function()
            if obj:IsLocked() then return end
            obj:Set(not state.value)
        end)
        -- Fallback: press+release on the card itself
        local pressStart
        c.InputBegan:Connect(function(input)
            if not isPointer(input) then return end
            pressStart = Vector2.new(input.Position.X, input.Position.Y)
        end)
        c.InputEnded:Connect(function(input)
            if not isPointer(input) or not pressStart then return end
            local endPos = Vector2.new(input.Position.X, input.Position.Y)
            local dist = (endPos - pressStart).Magnitude
            pressStart = nil
            if dist > 8 then return end
            if obj:IsLocked() then return end
            obj:Set(not state.value)
        end)
        register(o.Flag, obj, o, function() return state.value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Toggle")
        local start = o.Default and true or false
        state.value = start obj.Value = start paint(start, false)
        if start then initFires[#initFires + 1] = function() firer.Fire() end
        else firer.Sync(false) end
        return obj
    end

    extendElements(E, {Window=Window, Tab=Tab, P=P, card=card, nameLabel=nameLabel, decorate=decorate, register=register, fail=fail, mobile=mobile, rowH=rowH})
    return E
end

