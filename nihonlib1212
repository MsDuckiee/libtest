local hudOrder = {"Name","FPS","Ping","Memory","Clock"}
local hudFrame = mk("Frame", {Name="HUD", BackgroundTransparency=1, AutomaticSize=Enum.AutomaticSize.XY, Size=UDim2.new(), Position=UDim2.fromOffset(120,10), Visible=false, ZIndex=90, Parent=Root})
