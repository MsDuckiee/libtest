            local isTouch = input.UserInputType == Enum.UserInputType.Touch
            if not isMouse and not isTouch then return end
            local now = os.clock()
            local newPos = v2(input)
            local dt = now - state.lastTime
            if dt > 0.001 and dt < 0.25 then
                local inst = (newPos - state.lastInput) / dt
