    local function buildDropdown(o, multi)
        o = o or {}
        local label = tostring(o.Name or (multi and "Multi Select" or "Dropdown"))
        local c = card(rowH, true)
        c.ClipsDescendants = false
        c.AutomaticSize = Enum.AutomaticSize.None
        local header = mk("TextButton", {Size=UDim2.new(1,0,0,rowH), BackgroundTransparency=1, ZIndex=25, Parent=c})
        header.Text = "" header.AutoButtonColor = false
        nameLabel(header, label, UDim2.new(0.45, 0, 1, 0))
        local valLbl = tx("TextLabel", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-36,0.5,0), Size=UDim2.new(0.5,-44,1,0), TextXAlignment=Enum.TextXAlignment.Right, TextTruncate=Enum.TextTruncate.AtEnd, TextSize=12, ZIndex=15, Parent=header}, 3, "Accent")
        local arrow = makeIcon(header, "chevron-down", 14, "Sub", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-14,0.5,0), ZIndex=15})
        arrow.Image.ZIndex = 15 arrow.Glyph.ZIndex = 15
        local listFrame = mk("Frame", {Name="List", Position=UDim2.fromOffset(8, rowH + 4), Size=UDim2.new(1,-16,0,0), BackgroundTransparency=1, ClipsDescendants=true, ZIndex=24, Parent=c})
        local listScroll = mk("ScrollingFrame", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, ScrollBarThickness=3, ScrollBarImageTransparency=0.35, CanvasSize=UDim2.new(), AutomaticCanvasSize=Enum.AutomaticSize.Y, ScrollingDirection=Enum.ScrollingDirection.Y, ElasticBehavior=Enum.ElasticBehavior.Never, ZIndex=24, Parent=listFrame})
        bind(listScroll, "ScrollBarImageColor3", "Accent")
        stack(listScroll, 3)
        inset(listScroll, 4, 4, 4, 4)
        local obj = {Options=o.Options or {}, Value=multi and {} or nil, IsOpen=false}
        local firer
        local rows = {}
        local function selected(opt) if multi then return obj.Value[opt] == true end return obj.Value == opt end
        local function orderedSelection()
            local out = {}
            for _, opt in ipairs(obj.Options) do if obj.Value[opt] then out[#out + 1] = opt end end
            return out
        end
        local function summary()
            if multi then
                local list = orderedSelection()
                if #list == 0 then return "None" end
                if #list <= 2 then return table.concat(list, ", ") end
                return #list .. " selected"
            end
            return obj.Value ~= nil and tostring(obj.Value) or "None"
        end
        local function current() if multi then return orderedSelection() end return obj.Value end
        firer = makeFirer(function()
            if multi then return table.concat(orderedSelection(), "\0") end
            return obj.Value
        end, function()
            local ok, err = pcall(o.Callback or function() end, current())
            if not ok then fail(c, label, err) end
        end)
        local function restyle()
            valLbl.Text = summary()
            for opt, r in pairs(rows) do
                if r.btn.Parent then
                    local on = selected(opt)
                    play(r.btn, 0.15, {BackgroundTransparency = on and 0.86 or 1})
                    play(r.check, 0.15, {ImageTransparency = on and 0 or 1})
                    r.label.TextColor3 = on and Pal.Text or Pal.Sub
                end
            end
        end
        local function layoutList()
            local visible = 0
            for _, r in pairs(rows) do if r.btn.Visible then visible = visible + 1 end end
            local searchH = (obj._hasSearch) and 38 or 0
            local h = math.min(visible * 34 + 8 + searchH, 240)
            if obj.IsOpen then play(listFrame, 0.28, {Size = UDim2.new(1,-16,0,h)}, Enum.EasingStyle.Quart)
            else play(listFrame, 0.2, {Size = UDim2.new(1,-16,0,0)}, Enum.EasingStyle.Quart) end
            play(c, 0.28, {Size = UDim2.new(1,0,0,rowH + (obj.IsOpen and (h + 8) or 0))}, Enum.EasingStyle.Quart)
            play(arrow.Image, 0.25, {Rotation = obj.IsOpen and 180 or 0}, Enum.EasingStyle.Back)
            play(arrow.Glyph, 0.25, {Rotation = obj.IsOpen and 180 or 0}, Enum.EasingStyle.Back)
        end
        local searchBox, filter = nil, ""
        local function rebuildRows()
            for _, r in pairs(rows) do r.btn:Destroy() end
            rows = {}
            local count = #obj.Options
            local wantSearch = count > 4
            obj._hasSearch = wantSearch
            if wantSearch and not searchBox then
                local searchHolder = mk("Frame", {Size=UDim2.new(1,0,0,34), BackgroundTransparency=1, ZIndex=25, Parent=listScroll, LayoutOrder=-1})
                local sb = tx("TextBox", {Size=UDim2.new(1,-42,1,0), Position=UDim2.fromOffset(30,0), PlaceholderText="Search...", TextSize=12, ZIndex=25, Parent=searchHolder}, 2)
                bind(sb, "BackgroundColor3", "Elevated")
                sb.BackgroundTransparency = 0 round(sb, 8) inset(sb, 0, 10, 0, 10)
                local sIcon = makeIcon(searchHolder, SEARCH_ICON, 12, "Sub", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,8,0.5,0), ZIndex=26})
                sIcon.Image.ZIndex = 26 sIcon.Glyph.ZIndex = 26
                sb:GetPropertyChangedSignal("Text"):Connect(function()
                    filter = sb.Text:lower()
                    for opt, r in pairs(rows) do
                        r.btn.Visible = filter == "" or tostring(opt):lower():find(filter, 1, true) ~= nil
                    end
                    layoutList()
                end)
                searchBox = searchHolder
            end
            for i, opt in ipairs(obj.Options) do
                local b = mk("TextButton", {Size=UDim2.new(1,0,0,32), BackgroundColor3=Color3.new(1,1,1), BackgroundTransparency=1, LayoutOrder=i, ZIndex=25, Parent=listScroll})
                round(b, 8)
                local l = tx("TextLabel", {Text=tostring(opt), TextSize=12, Position=UDim2.fromOffset(12,0), Size=UDim2.new(1,-44,1,0), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=26, Parent=b}, 2, "Sub")
                local ck = makeIcon(b, "check", 15, "Accent", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-12,0.5,0), ZIndex=26})
                ck.Image.ZIndex = 26 ck.Glyph.ZIndex = 26
                ck.Image.ImageTransparency = selected(opt) and 0 or 1
                ck.Glyph.TextTransparency = selected(opt) and 0 or 1
                rows[opt] = {btn=b, label=l, check=ck.Image}
                b.MouseEnter:Connect(function() if not selected(opt) then play(b, 0.12, {BackgroundTransparency = 0.92}) end end)
                b.MouseLeave:Connect(function() if not selected(opt) then play(b, 0.18, {BackgroundTransparency = 1}) end end)
                b.InputBegan:Connect(function(input)
                    if not isPointer(input) then return end
                    if multi then
                        obj.Value[opt] = (not obj.Value[opt]) or nil
                        restyle() firer.Fire() queueSave()
                    else
                        obj:Set(opt) obj:Toggle()
                    end
                end)
            end
            restyle()
        end
        function obj:Open()
            if obj.IsOpen or obj:IsLocked() then return end
            obj.IsOpen = true rebuildRows() layoutList()
        end
        function obj:Close()
            if not obj.IsOpen then return end
            obj.IsOpen = false layoutList()
        end
        function obj:Toggle() if obj.IsOpen then obj:Close() else obj:Open() end end
        function obj:Get() return current() end
        function obj:Set(v, silent)
            if multi then
                obj.Value = {}
                if type(v) == "table" then
                    for k, x in pairs(v) do
                        if type(k) == "number" then obj.Value[x] = true elseif x then obj.Value[k] = true end
                    end
                end
            else
                if v ~= nil and not table.find(obj.Options, v) then return end
                obj.Value = v
            end
            restyle()
            if silent then firer.Sync(multi and table.concat(orderedSelection(), "\0") or obj.Value)
            else firer.Fire() queueSave() end
        end
        function obj:Refresh(list, keepValue)
            obj.Options = list or {}
            if not keepValue then obj.Value = multi and {} or nil
            elseif not multi and obj.Value ~= nil and not table.find(obj.Options, obj.Value) then obj.Value = nil end
            if obj.IsOpen then rebuildRows() layoutList() end
            valLbl.Text = summary()
        end
        function obj:Add(opt) obj.Options[#obj.Options + 1] = opt end
        header.InputBegan:Connect(function(input) if isPointer(input) then obj:Toggle() end end)
        register(o.Flag, obj, o, current, function(v) obj:Set(v) end)
        decorate(obj, c, o, multi and "Multi Dropdown" or "Dropdown")
        if multi then obj:Set(o.Default or {}, true)
        else
            local first = o.Default
            if first == nil and o.AllowNone ~= true then first = obj.Options[1] end
            obj:Set(first, true)
        end
        valLbl.Text = summary()
        initFires[#initFires + 1] = function() firer.Fire() end
        return obj
    end
    function E:AddDropdown(o) return buildDropdown(o, false) end
    function E:AddMultiDropdown(o) return buildDropdown(o, true) end

