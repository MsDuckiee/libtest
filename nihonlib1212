local promoteQueue, spawnNote
promoteQueue = function()
    while #Notes.active < Notes.max and #Notes.queue > 0 do
        local entry = table.remove(Notes.queue, 1)
        Notes.queuedKey[entry.key] = nil
        spawnNote(entry)
    end
end
local function dismissNote(n)
    if not n or n.dying then return end
    n.dying = true
    for i, x in ipairs(Notes.active) do if x == n then table.remove(Notes.active, i) break end end
    if Notes.byKey[n.key] == n then Notes.byKey[n.key] = nil end
    if n.frame and n.frame.Parent then
        local c = corners[Notes.position] or corners.TopRight
        local outX = c.ax == 1 and (noteWidth() + 80) or (c.ax == 0 and -(noteWidth() + 80) or 0)
        local target = outX ~= 0 and UDim2.new(c.ax, (c.ax == 1 and -16 or 16) + outX, c.ay, (c.ay == 0 and 16 or -16)) or n.frame.Position
        fadeGroup(n.frame, 0.35, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(n.frame, 0.35, {Position = target}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.45, function() if n.frame and n.frame.Parent then n.frame:Destroy() end end)
    end
    layoutAll()
    promoteQueue()
end
local function bumpNote(n, extra)
    if not n then return end
    n.count = (n.count or 0) + 1
    n.expires = os.clock() + (extra or n.time or Notes.duration)
    if n.pop then
        local baseSc = math.max(0.78, 1 - ((n.slot or 1) - 1) * 0.08)
        n.pop.Scale = baseSc * 1.15
        play(n.pop, 0.4, {Scale = baseSc}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end
end
local function ensureNoteLoop()
    if noteLoop then return end
    noteLoop = RunService.Heartbeat:Connect(function(dt)
        local now = os.clock()
        for i = #Notes.active, 1, -1 do
            local n = Notes.active[i]
            if n and not n.dying and not n.sticky then
                if n.hover or n.dragging then n.expires = n.expires + dt end
                local left = n.expires - now
                if not n.custom and n.bar and n.bar.Parent then n.bar.Size = UDim2.new(math.clamp(left / n.time, 0, 1), 0, 0, 3) end
                if left <= 0 then dismissNote(n) end
            end
        end
        if #Notes.active == 0 and noteLoop then noteLoop:Disconnect() noteLoop = nil end
    end)
end
spawnNote = function(entry)
