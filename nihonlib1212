    local title = tx("TextLabel", {Text=tostring(cfg.Name or cfg.Title or "Notification"), TextSize=15, Font=Fonts[currentFont][3], Position=UDim2.fromOffset(78,15), Size=UDim2.new(1,-134,0,20), TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=4, Parent=frame}, 3)
    local body = tx("TextLabel", {Text=content, TextSize=12, Position=UDim2.fromOffset(78,38), Size=UDim2.new(1,-134,0,0), TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, Visible=content ~= "", ZIndex=4, Parent=frame}, 1, "Sub")

    local closeBtn = mk("TextButton", {AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,-12,0,12), Size=UDim2.fromOffset(24,24), BackgroundTransparency=1, ZIndex=5, Parent=frame})
    round(closeBtn, 6)
    local closeIcon = makeIcon(closeBtn, "x", 12, "Sub", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=6})
    closeBtn.MouseEnter:Connect(function() play(closeBtn, 0.15, {BackgroundTransparency = 0.88}) closeIcon.Color(Pal.Text, true) end)
    closeBtn.MouseLeave:Connect(function() play(closeBtn, 0.2, {BackgroundTransparency = 1}) closeIcon.Color(Pal.Sub, true) end)
    closeBtn.Activated:Connect(function() dismissNote(n) end)
    n.closeBtn = closeBtn
    n.closeGlyph = closeIcon

    n.bar = mk("Frame", {AnchorPoint=Vector2.new(0,1), Position=UDim2.fromScale(0,1), Size=UDim2.new(1,0,0,3), BackgroundColor3=color, BackgroundTransparency=0.15, Visible=not n.sticky, ZIndex=3, Parent=frame})
    round(n.bar, 2)
    local barGrad = mk("UIGradient", {Parent=n.bar})
