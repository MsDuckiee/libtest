            Size=UDim2.new(0.5,-4,1,0),
            BackgroundColor3=Status.Success,
            BackgroundTransparency=0.15,
            LayoutOrder=1,
            Parent=btnContainer
        })
        round(confirmBtn, 8)
        tx("TextLabel", {Text=cfg.ConfirmText, TextSize=12, Size=UDim2.fromScale(1,1), Parent=confirmBtn}, 3)
        
        confirmBtn.Activated:Connect(function()
            wrap:Destroy()
            if cfg.OnConfirm then cfg.OnConfirm() end
        end)
