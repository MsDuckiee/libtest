                    tx("TextLabel", {
                        Text="Rename Tab",
                        TextSize=14,
                        Size=UDim2.new(1,0,0,20),
                        LayoutOrder=1,
                        Parent=inputPrompt
                    }, 3)
                    
                    local input = tx("TextBox", {
                        Text=tabName,
                        PlaceholderText="New name",
                        TextSize=12,
                        Size=UDim2.new(1,0,0,32),
                        LayoutOrder=2,
                        Parent=inputPrompt
                    }, 2)
                    bind(input, "BackgroundColor3", "Elevated")
                    input.BackgroundTransparency = 0
                    round(input, 8)
                    inset(input, 0, 8, 0, 8)
                    
                    local btnFrame = mk("Frame", {
                        Size=UDim2.new(1,0,0,32),
                        BackgroundTransparency=1,
                        LayoutOrder=3,
                        Parent=inputPrompt
                    })
                    stack(btnFrame, 8, Enum.FillDirection.Horizontal)
                    
                    local okBtn = mk("TextButton", {
                        Size=UDim2.new(0.5,-4,1,0),
                        BackgroundColor3=Status.Success,
                        BackgroundTransparency=0.15,
                        LayoutOrder=1,
                        Parent=btnFrame
                    })
                    round(okBtn, 8)
                    tx("TextLabel", {Text="OK", Size=UDim2.fromScale(1,1), Parent=okBtn}, 3)
                    
                    okBtn.Activated:Connect(function()
                        local newName = input.Text
                        if newName ~= "" then
                            Window.TabData[tabName].Name = newName
                            btn.Name = "Tab_"..newName
                            btn:FindFirstChildOfClass("TextLabel").Text = newName
                            Window.Tabs[tabIndex].Name = newName
                        end
                        inputPrompt:Destroy()
                        overlay:Destroy()
                    end)
                    
                    overlay.Activated:Connect(function()
                        inputPrompt:Destroy()
                        overlay:Destroy()
                    end)
                end},
                {Name="Duplicate", Callback=function()
                    local newName = tabName.." (Copy)"
                    Window:AddTab(newName)
                end},
                {Name="Delete", Callback=function()
                    showDialog({
                        Title="Delete Tab",
                        Message="Are you sure you want to delete this tab?",
                        ConfirmText="Delete",
                        CancelText="Cancel",
                        OnConfirm=function()
                            table.remove(Window.Tabs, tabIndex)
                            Window.TabData[tabName] = nil
                            btn:Destroy()
                        end
                    })
                end}
            }, UserInputService:GetMouseLocation())
        end)
        
        btn.Activated:Connect(function()
            if Window.SelectedTab then
                local oldBtn = tabScroll:FindFirstChild("Tab_"..Window.Tabs[Window.SelectedTab].Name)
                if oldBtn then
                    play(oldBtn, 0.2, {BackgroundTransparency=0.4})
                    bind(oldBtn, "BackgroundColor3", "Card")
                end
            end
            Window.SelectedTab = tabIndex
            play(btn, 0.2, {BackgroundTransparency=0})
            bind(btn, "BackgroundColor3", "Elevated")
        end)
        
        return btn
    end
    
    function Window:AddTab(name)
        name = name or "Tab "..#self.Tabs+1
        local idx = #self.Tabs+1
        self.Tabs[idx] = {Name=name}
        self.TabData[name] = {Name=name, Features={}}
        createTabButton(name, idx)
    end
    
    -- INITIAL SETUP
    Window:AddTab("Library")
    Window.SelectedTab = 1
    
    -- TOGGLE
    function Window:Toggle()
        if Window.Hidden then
            Window.Hidden = false
            shell.Visible = true
            play(uiScale, 0.4, {Scale=0.9*Window.Scale}, Enum.EasingStyle.Back)
        else
            Window.Hidden = true
            play(uiScale, 0.25, {Scale=0.8}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            task.delay(0.3, function() if Window.Hidden then shell.Visible = false end end)
        end
    end
    
    closeBtn.Activated:Connect(function() Window:Toggle() end)
    
    keep(UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Window.ToggleKey then Window:Toggle() end
    end))
    
    -- SEARCH
    searchBtn.Activated:Connect(function()
        local searchFrame = mk("Frame", {
            AnchorPoint=Vector2.new(0.5,0),
            Position=UDim2.new(0.5,0,0,90),
            Size=UDim2.fromOffset(400,40),
            BackgroundTransparency=0.2,
            ZIndex=200,
            Parent=Root
        })
        bind(searchFrame, "BackgroundColor3", "Surface")
        round(searchFrame, 12)
        outline(searchFrame, "Stroke", 1, 0.4)
        
        local searchInput = tx("TextBox", {
            PlaceholderText="Search features...",
            TextSize=13,
            Position=UDim2.fromOffset(12,0),
            Size=UDim2.new(1,-24,1,0),
            Parent=searchFrame
        }, 2)
        bind(searchInput, "BackgroundColor3", "Surface")
        
        searchInput:CaptureFocus()
        task.delay(2, function() if searchFrame.Parent then searchFrame:Destroy() end end)
    end)
    
    shell.Visible = true
    play(uiScale, 0.5, {Scale=0.9*Window.Scale}, Enum.EasingStyle.Back)
    
    return Window
end

return Nihon
