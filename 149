  // ==================================================================
  // Window class
  // ==================================================================
  class NihonWindow {
    constructor(lib, cfg) {
      this.Lib = lib;
      this.Cfg = cfg;
      this.Name = String(cfg.Name || "UI Library");
      this.Subtitle = cfg.Subtitle != null ? String(cfg.Subtitle) : "Modern interface";
      this.Tabs = [];
      this.Selected = null;
      this.Hidden = false;
      this.Minimized = false;
      this.Scale = 1;
      this.SearchIndex = [];
      this._tabCounter = 0;
      this._build();
    }

    _build() {
      const lib = this.Lib;
      const P = lib.Palette;

      // Shell
      this.Root = el("div", { class: "nihon-window" });

      // Header
      const header = el("div", { class: "nihon-header" });
      const logo = el("div", { class: "nihon-logo", text: GlyphMap[this.Cfg.Icon] || "⚡" });
      header.appendChild(logo);

      const titles = el("div", { class: "nihon-titles" });
      this.TitleNode = el("div", { class: "nihon-title", text: this.Name });
      this.SubNode = el("div", { class: "nihon-subtitle", text: this.Subtitle });
      titles.appendChild(this.TitleNode);
      titles.appendChild(this.SubNode);
      header.appendChild(titles);

      const right = el("div", { class: "nihon-header-right" });

      // User chip (opens stats)
      const chip = el("div", { class: "nihon-user-chip" });
      const avatar = el("div", { class: "nihon-user-avatar", text: (this.Cfg.UserInitials || "U") });
      const dot = el("div", { class: "nihon-user-dot" });
      avatar.appendChild(dot);
      const chipCol = el("div", {});
      const chipName = el("div", { class: "nihon-user-name", text: this.Cfg.UserName || "Guest" });
      const chipSub = el("div", { class: "nihon-user-sub", text: this.Cfg.UserTag || "@guest" });
      chipCol.appendChild(chipName);
      chipCol.appendChild(chipSub);
      chip.appendChild(avatar);
      chip.appendChild(chipCol);
      chip.addEventListener("click", () => this.OpenStats());
      right.appendChild(chip);

      // Controls
      const mkCtrl = (label, cls) => {
        const b = el("button", { class: "nihon-ctrl" + (cls ? " " + cls : ""), text: label });
        right.appendChild(b);
        return b;
      };
      this.HelpBtn = mkCtrl("?", "");
      this.HelpBtn.addEventListener("click", () => this._openHelp());
      this.SearchBtn = mkCtrl("🔍", "");
      this.SearchBtn.addEventListener("click", () => this.OpenSearch());
      this.MinBtn = mkCtrl("−", "");
      this.MinBtn.addEventListener("click", () => this.SetMinimized(!this.Minimized));
      this.CloseBtn = mkCtrl("✕", "danger");
      this.CloseBtn.addEventListener("click", () => {
        this.Hide();
        lib.MakeNotification({
          Name: "Menu hidden",
          Content: "Press the floating button or hit the toggle key to reopen.",
          Type: "Info", Time: 3,
        });
      });

      header.appendChild(right);
      this.Root.appendChild(header);

      // Tab bar
      const tabbar = el("div", { class: "nihon-tabbar" });
      this.TabBar = tabbar;
      this.Indicator = el("div", { class: "nihon-tab-indicator" });
      tabbar.appendChild(this.Indicator);
      this.Root.appendChild(tabbar);

      // Content
      const content = el("div", { class: "nihon-content" });
      this.Content = content;
      this.Root.appendChild(content);

      document.body.appendChild(this.Root);

      // Launcher (floating)
      this.Launcher = el("button", {
        class: "nihon-ctrl",
        style: {
          position: "fixed", bottom: "20px", left: "20px",
          width: "48px", height: "48px", borderRadius: "50%",
          background: "linear-gradient(45deg, " + P.Accent + ", " + P.Accent2 + ")",
          color: "#fff", fontSize: "20px", zIndex: "9998",
          boxShadow: "0 8px 24px rgba(0,0,0,0.4)",
          display: "none",
        },
        text: GlyphMap[this.Cfg.Icon] || "⚡",
      });
      this.Launcher.addEventListener("click", () => this.Show());
      document.body.appendChild(this.Launcher);

      // Draggable header
      this._makeDraggable(header);
      this._makeDraggable(this.Launcher);

      // Resize grip
      this._makeResizable();

      // Search layer
      this._buildSearch();

      // Stats layer
      this._buildStats();

      // Global key
      this._bindGlobalKey();
    }

    _bindGlobalKey() {
      document.addEventListener("keydown", (e) => {
        if (e.key === "k" && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          this.OpenSearch();
        } else if (e.key === "Escape") {
          if (this._searchOpen) this.CloseSearch();
          else if (this._statsOpen) this.CloseStats();
        }
      });
    }

    _makeDraggable(node) {
      let drag = false, sx = 0, sy = 0, ox = 0, oy = 0;
      const onDown = (e) => {
        if (e.target.closest(".nihon-ctrl")) return;
        drag = true;
        const rect = node === this.Launcher ? this.Launcher.getBoundingClientRect() : this.Root.getBoundingClientRect();
        sx = e.clientX; sy = e.clientY; ox = rect.left; oy = rect.top;
        const target = node === this.Launcher ? this.Launcher : this.Root;
        target.style.left = ox + "px";
        target.style.top = oy + "px";
        target.style.right = "auto";
        target.style.bottom = "auto";
        target.style.margin = "0";
      };
      const onMove = (e) => {
        if (!drag) return;
        const target = node === this.Launcher ? this.Launcher : this.Root;
        const nx = ox + (e.clientX - sx);
        const ny = oy + (e.clientY - sy);
        target.style.left = nx + "px";
        target.style.top = ny + "px";
      };
      const onUp = () => { drag = false; };
      node.addEventListener("mousedown", onDown);
      document.addEventListener("mousemove", onMove);
      document.addEventListener("mouseup", onUp);
    }

    _makeResizable() {
      const grip = el("div", {
        class: "nihon-ctrl",
        style: {
          position: "absolute", right: "2px", bottom: "2px",
          width: "20px", height: "20px",
          cursor: "nwse-resize", zIndex: "30",
          fontSize: "12px", color: "var(--nihon-Sub)",
        },
        text: "◢",
      });
      this.Root.appendChild(grip);
      let resize = false, sx = 0, sy = 0, sw = 0, sh = 0;
      grip.addEventListener("mousedown", (e) => {
        e.stopPropagation();
        resize = true;
        const rect = this.Root.getBoundingClientRect();
        sx = e.clientX; sy = e.clientY; sw = rect.width; sh = rect.height;
      });
      document.addEventListener("mousemove", (e) => {
        if (!resize) return;
        const w = Math.max(500, sw + (e.clientX - sx));
        const h = Math.max(320, sh + (e.clientY - sy));
        this.Root.style.width = w + "px";
        this.Root.style.height = h + "px";
      });
      document.addEventListener("mouseup", () => { resize = false; });
    }

    // --------------------------------------------------------------
    Show() {
      this.Hidden = false;
      this.Root.classList.remove("nihon-window-hidden");
      this.Launcher.style.display = "none";
      requestAnimationFrame(() => this.Root.classList.add("nihon-window-in"));
      this._positionIndicator();
    }
    Hide() {
      this.Hidden = true;
      this.Root.classList.remove("nihon-window-in");
      setTimeout(() => {
        if (this.Hidden) this.Root.classList.add("nihon-window-hidden");
      }, 250);
      this.Launcher.style.display = "";
    }
    Toggle() { this.Hidden ? this.Show() : this.Hide(); }

    SetMinimized(state) {
      state = !!state;
      if (this.Minimized === state) return;
      this.Minimized = state;
      if (state) {
        this._restoreH = this.Root.style.height;
        this.Root.style.height = "56px";
        this.Root.classList.add("nihon-window-min");
      } else {
        this.Root.style.height = this._restoreH || "520px";
        this.Root.classList.remove("nihon-window-min");
      }
    }

    SetScale(s) { /* no-op in web version */ }

    SetTitle(t) { this.TitleNode.textContent = String(t); this.Name = String(t); }
    SetSubtitle(t) {
      this.Subtitle = String(t);
      this.SubNode.textContent = this.Subtitle;
      this.SubNode.style.display = this.Subtitle ? "" : "none";
    }
    SetIcon(glyph) { this.Root.querySelector(".nihon-logo").textContent = glyph; }

    SetTabIcon(name, glyph) {
      const t = this.Tabs.find((x) => x.Name === name);
      if (t) t._setIcon(glyph);
    }

    // --------------------------------------------------------------
    // Tabs
    // --------------------------------------------------------------
    MakeTab(cfg = {}) {
      const tab = new NihonTab(this, cfg);
      this.Tabs.push(tab);
      this.TabBar.insertBefore(tab.Button, this.Indicator);
      if (!this.Selected) {
        requestAnimationFrame(() => this.SelectTab(tab, true));
      }
      return tab;
    }

    SelectTab(target, instant) {
      if (typeof target === "string") target = this.Tabs.find((t) => t.Name === target);
      if (!target) return;
      if (this.Selected === target) return;
      this.Selected = target;
      this.Tabs.forEach((t) => {
        t.Button.classList.toggle("active", t === target);
        t.Page.classList.toggle("active", t === target);
      });
      this._positionIndicator();
    }

    _positionIndicator() {
      if (!this.Selected) return;
      const rect = this.Selected.Button.getBoundingClientRect();
      const barRect = this.TabBar.getBoundingClientRect();
      this.Indicator.style.left = (rect.left - barRect.left + this.TabBar.scrollLeft) + "px";
      this.Indicator.style.width = rect.width + "px";
    }

    _refreshTheme() {
      // The CSS vars are already updated via NihonLib._applyThemeVars()
      // Nothing else needed for this minimal web version.
    }
    _refreshFont() { /* handled via CSS var */ }

    // --------------------------------------------------------------
    // Search palette
    // --------------------------------------------------------------
    _buildSearch() {
      const layer = el("div", { class: "nihon-search-layer" });
      const box = el("div", { class: "nihon-search-box" });
      const input = el("input", { class: "nihon-search-input", placeholder: "Search features… (Ctrl+K)" });
      const list = el("div", { class: "nihon-search-list" });
      box.appendChild(input);
      box.appendChild(list);
      layer.appendChild(box);
      layer.addEventListener("click", (e) => { if (e.target === layer) this.CloseSearch(); });
      document.body.appendChild(layer);

      this._searchLayer = layer;
      this._searchInput = input;
      this._searchList = list;
      this._searchOpen = false;

      input.addEventListener("input", () => this._renderSearch(input.value));
    }

    OpenSearch() {
      this._searchOpen = true;
      this._searchLayer.classList.add("nihon-search-in");
      this._searchInput.value = "";
      this._renderSearch("");
      setTimeout(() => this._searchInput.focus(), 50);
    }
    CloseSearch() {
      this._searchOpen = false;
      this._searchLayer.classList.remove("nihon-search-in");
    }
    _renderSearch(q) {
      const list = this._searchList;
      list.innerHTML = "";
      const ql = q.toLowerCase();
      const matches = this.SearchIndex.filter((e) => {
        if (!ql) return true;
        return (e.name + " " + e.tab + " " + e.kind).toLowerCase().includes(ql);
      }).slice(0, 30);

      if (!matches.length) {
        list.appendChild(el("div", { class: "nihon-search-item", style: { color: "var(--nihon-Sub)" }, text: "No matches" }));
        return;
      }
      matches.forEach((e) => {
        const item = el("div", { class: "nihon-search-item" },
          el("span", { text: e.name }),
          el("span", { class: "nihon-search-meta", text: e.tab + " · " + e.kind })
        );
        item.addEventListener("click", () => {
          this.CloseSearch();
          this.SelectTab(e.tab);
          // Flash card
          if (e.node) {
            e.node.style.transition = "box-shadow 0.3s";
            e.node.style.boxShadow = "0 0 0 2px var(--nihon-Accent)";
            e.node.scrollIntoView({ behavior: "smooth", block: "center" });
            setTimeout(() => { e.node.style.boxShadow = ""; }, 1200);
          }
        });
        list.appendChild(item);
      });
    }

    // --------------------------------------------------------------
    // Stats panel
    // --------------------------------------------------------------
    _buildStats() {
      const layer = el("div", { class: "nihon-dialog-layer" });
      const sheet = el("div", { class: "nihon-dialog", style: { width: "340px" } });
      sheet.appendChild(el("div", { class: "nihon-dialog-title", text: "Statistics" }));
      const rows = el("div", { style: { fontSize: "12px", lineHeight: "1.8" } });
      sheet.appendChild(rows);
      const actions = el("div", { class: "nihon-dialog-actions", style: { marginTop: "12px" } });
      const close = el("button", { class: "nihon-dialog-btn primary", text: "Close" });
      actions.appendChild(close);
      sheet.appendChild(actions);
      layer.appendChild(sheet);
      layer.addEventListener("click", (e) => { if (e.target === layer) this.CloseStats(); });
      close.addEventListener("click", () => this.CloseStats());
      document.body.appendChild(layer);

      this._statsLayer = layer;
      this._statsRows = rows;
      this._statsOpen = false;
    }

    OpenStats() {
      this._statsOpen = true;
      this._statsLayer.classList.add("nihon-dialog-layer-in");
      this._statsLayer.querySelector(".nihon-dialog").classList.add("nihon-dialog-in");
      this._renderStats();
    }
    CloseStats() {
      this._statsOpen = false;
      this._statsLayer.classList.remove("nihon-dialog-layer-in");
      this._statsLayer.querySelector(".nihon-dialog").classList.remove("nihon-dialog-in");
    }
    _renderStats() {
      const rows = this._statsRows;
      rows.innerHTML = "";
      const data = [
        ["FPS", this._fps || 60],
        ["Frame time", (this._frameTime || 16.7).toFixed(1) + " ms"],
        ["Memory", this._mem || "—"],
        ["User agent", navigator.userAgent.slice(0, 40) + "…"],
        ["Language", navigator.language],
        ["Viewport", window.innerWidth + " × " + window.innerHeight],
        ["Online", navigator.onLine ? "Yes" : "No"],
      ];
      data.forEach(([k, v]) => {
        const row = el("div", { style: { display: "flex", justifyContent: "space-between", gap: "12px", padding: "2px 0" } },
          el("span", { style: { color: "var(--nihon-Sub)" }, text: k }),
          el("span", { text: String(v) })
        );
        rows.appendChild(row);
      });
    }

    // Help popup
    _openHelp() {
      this.Lib.Dialog({
        Title: "Nihon Lib " + this.Lib.Version,
        Content: "Press Ctrl+K to search features. Click your name (top right) for stats. Drag the header to move the window. Drag the bottom-right corner to resize.",
        Buttons: [{ Name: "Got it", Primary: true }],
      });
    }

    // --------------------------------------------------------------
    // Cleanup
    // --------------------------------------------------------------
    _destroy() {
      this.Root.remove();
      this.Launcher.remove();
      this._searchLayer.remove();
      this._statsLayer.remove();
    }

    // Public helper to attach a search entry
    _registerSearch(entry) {
      this.SearchIndex.push(entry);
    }
  }

  // ==================================================================
  // Tab class
  // ==================================================================
  class NihonTab {
    constructor(window, cfg) {
      this.Window = window;
      this.Name = String(cfg.Name || "Tab");
      this.Sections = [];
      this._build(cfg);
    }

    _build(cfg) {
      // Button
      const btn = el("button", { class: "nihon-tab" });
      const icon = el("span", { class: "nihon-tab-icon", text: GlyphMap[cfg.Icon] || GlyphMap.home });
      const label = el("span", { text: this.Name });
      btn.appendChild(icon);
      btn.appendChild(label);
      btn.addEventListener("click", () => this.Window.SelectTab(this));
      this.Button = btn;
      this._iconNode = icon;

      // Page
      const page = el("div", { class: "nihon-page" });
      this.Page = page;
      this.Window.Content.appendChild(page);
    }

    _setIcon(glyph) {
      this._iconNode.textContent = glyph;
    }

    AddSection(cfg = {}) {
      if (typeof cfg === "string") cfg = { Name: cfg };
      const sec = new NihonSection(this, cfg);
      this.Sections.push(sec);
      return sec;
    }
  }

  // ==================================================================
  // Section class
  // ==================================================================
  class NihonSection {
    constructor(tab, cfg) {
      this.Tab = tab;
      this.Name = String(cfg.Name || "Section");
      this._build(cfg);
    }
    _build(cfg) {
      const wrap = el("div", { class: "nihon-section" });
      const head = el("div", { class: "nihon-section-head" });
      const bar = el("div", { class: "nihon-section-bar" });
      const label = el("span", { text: this.Name });
      head.appendChild(bar);
      head.appendChild(label);
      wrap.appendChild(head);
      const body = el("div", { class: "nihon-section-body" });
      wrap.appendChild(body);
      this.Wrap = wrap;
      this.Body = body;
      this.Tab.Page.appendChild(wrap);
      this._count = 0;
    }

    _addCard(minH) {
      const card = el("div", { class: "nihon-card", style: minH ? { minHeight: minH + "px" } : null });
      this.Body.appendChild(card);
      this._count++;
      return card;
    }

    _nameLabel(text) {
      return el("div", { class: "nihon-card-name", text: String(text) });
    }

    _register(flag, obj, opts, get, set) {
      this.Tab.Window.Lib._registerFlag(flag, { get, set, save: opts.Save === true, obj });
    }

    _decorate(obj, card, opts, kind) {
      const window = this.Tab.Window;
      obj.Card = card;
      obj.Kind = kind;
      if (opts.Locked) obj.Lock(true);
      window._registerSearch({
        owner: obj, name: String(opts.Name || kind), tab: this.Tab.Name,
        section: this.Name, kind, node: card,
      });
      obj.SetVisible = (v) => { card.style.display = v ? "" : "none"; };
      obj.SetName = (n) => { const l = card.querySelector(".nihon-card-name"); if (l) l.textContent = String(n); };
      obj.SetTooltip = (t) => { card.title = String(t); };
      obj.Lock = (v) => {
        const locked = v == null ? true : !!v;
        card.style.opacity = locked ? "0.5" : "";
        card.style.pointerEvents = locked ? "none" : "";
      };
      obj.IsLocked = () => card.style.pointerEvents === "none";
      obj.Destroy = () => { card.remove(); };
      return obj;
    }

    // -------------------------------------------------------------
    // Elements
    // -------------------------------------------------------------
    AddLabel(o) {
      if (typeof o === "string") o = { Name: o };
      const card = this._addCard(34);
      const name = this._nameLabel(o.Name || "");
      name.style.color = "var(--nihon-Sub)";
      card.appendChild(name);
      const obj = {};
      obj.Set = (t) => { name.textContent = String(t); };
      obj.Get = () => name.textContent;
      return this._decorate(obj, card, o, "Label");
    }

    AddParagraph(o = {}) {
      const card = this._addCard(0);
      card.style.flexDirection = "column";
      card.style.alignItems = "flex-start";
      card.style.padding = "12px 14px";
      const title = el("div", { class: "nihon-card-name", text: String(o.Title || o.Name || "Note") });
      title.style.fontWeight = "600";
      title.style.marginBottom = "4px";
      const text = el("div", { style: { fontSize: "12px", color: "var(--nihon-Sub)", lineHeight: "1.4" }, text: String(o.Content || "") });
      card.appendChild(title);
      card.appendChild(text);
      const obj = {};
      obj.Set = (t) => { text.textContent = String(t); };
      obj.SetTitle = (t) => { title.textContent = String(t); };
      return this._decorate(obj, card, o, "Paragraph");
    }

    AddButton(o = {}) {
      const label = String(o.Name || "Button");
      const card = this._addCard(44);
      card.style.cursor = "pointer";
      const name = this._nameLabel(label);
      card.appendChild(name);
      const arrow = el("span", { style: { color: "var(--nihon-Sub)", fontSize: "14px" }, text: "›" });
      card.appendChild(arrow);
      const obj = {};
      const cooldown = parseFloat(o.Cooldown) || 0.35;
      let ready = true;
      obj.Fire = () => {
        if (!ready) return false;
        ready = false;
        setTimeout(() => { ready = true; }, cooldown * 1000);
        if (o.Callback) {
          try { o.Callback(); }
          catch (e) {
            this.Tab.Window.Lib.MakeNotification({ Name: label + " failed", Content: String(e), Type: "Error" });
          }
        }
        return true;
      };
      card.addEventListener("click", () => obj.Fire());
      obj.SetCallback = (fn) => { o.Callback = fn; };
      return this._decorate(obj, card, o, "Button");
    }

    AddToggle(o = {}) {
      const label = String(o.Name || "Toggle");
      const card = this._addCard(44);
      const name = this._nameLabel(label);
      card.appendChild(name);

      const track = el("div", { class: "nihon-toggle" });
      const knob = el("div", { class: "nihon-toggle-knob" });
      track.appendChild(knob);
      card.appendChild(track);

      let value = o.Default === true;
      const fire = (v) => {
        if (o.Callback) {
          try { o.Callback(v); }
          catch (e) {
            this.Tab.Window.Lib.MakeNotification({ Name: label + " failed", Content: String(e), Type: "Error" });
          }
        }
      };
      const paint = () => { track.classList.toggle("on", value); };

      const obj = {
        Value: value,
        Get: () => value,
        Set: (v, silent) => {
          value = !!v;
          paint();
          if (!silent) fire(value);
        },
        Toggle: () => obj.Set(!value),
      };
      track.addEventListener("click", () => obj.Set(!value));
      paint();

      this._register(o.Flag, obj, o, obj.Get, (v) => obj.Set(v, true));
      return this._decorate(obj, card, o, "Toggle");
    }

    AddSlider(o = {}) {
      const label = String(o.Name || "Slider");
      const min = parseFloat(o.Min) || 0;
      const max = parseFloat(o.Max) || 100;
      const step = parseFloat(o.Increment) || 1;
      const suffix = o.ValueName || "";
      const card = this._addCard(60);
      card.style.flexDirection = "column";
      card.style.alignItems = "stretch";
      card.style.padding = "10px 14px";

      const top = el("div", { class: "nihon-slider-top" });
      const name = el("div", { class: "nihon-card-name", text: label });
      const valBox = el("input", { class: "nihon-slider-value", type: "text" });
      top.appendChild(name);
      top.appendChild(valBox);
      card.appendChild(top);

      const rail = el("div", { class: "nihon-slider-rail" });
      const fill = el("div", { class: "nihon-slider-fill" });
      const knob = el("div", { class: "nihon-slider-knob" });
      rail.appendChild(fill);
      rail.appendChild(knob);
      card.appendChild(rail);

      let value = clamp(parseFloat(o.Default) || min, min, max);
      const snap = (v) => min + Math.round((v - min) / step) * step;
      const fmt = (v) => {
        let s;
        if (step < 1) {
          const places = Math.min(3, Math.max(1, (String(step).split(".")[1] || "").length));
          s = v.toFixed(places).replace(/0+$/, "").replace(/\.$/, "");
        } else s = String(Math.round(v));
        return suffix ? s + " " + suffix : s;
      };
      const draw = () => {
        const pct = clamp((value - min) / (max - min), 0, 1) * 100;
        fill.style.width = pct + "%";
        knob.style.left = pct + "%";
      };
      const fire = (v) => {
        if (o.Callback) {
          try { o.Callback(v); }
          catch (e) {
            this.Tab.Window.Lib.MakeNotification({ Name: label + " failed", Content: String(e), Type: "Error" });
          }
        }
      };
      const setVal = (v, silent) => {
        v = clamp(snap(parseFloat(v)), min, max);
        if (isNaN(v)) return;
        value = v;
        valBox.value = fmt(v);
        draw();
        if (!silent) fire(v);
      };

      const obj = {
        Get: () => value,
        Set: (v, silent) => setVal(v, silent),
      };
      valBox.addEventListener("change", () => setVal(valBox.value));

      let dragging = false;
      const updateFromEvent = (e) => {
        const rect = rail.getBoundingClientRect();
        const x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
        const pct = clamp(x / rect.width, 0, 1);
        setVal(min + pct * (max - min));
      };
      rail.addEventListener("mousedown", (e) => { dragging = true; updateFromEvent(e); });
      document.addEventListener("mousemove", (e) => { if (dragging) updateFromEvent(e); });
      document.addEventListener("mouseup", () => { dragging = false; });
      rail.addEventListener("touchstart", (e) => { dragging = true; updateFromEvent(e); }, { passive: true });
      document.addEventListener("touchmove", (e) => { if (dragging) updateFromEvent(e); }, { passive: true });
      document.addEventListener("touchend", () => { dragging = false; });

      setVal(value, true);
      this._register(o.Flag, obj, o, obj.Get, (v) => obj.Set(v, true));
      this.Tab.Window.Lib._initFires.push(() => fire(value));
      return this._decorate(obj, card, o, "Slider");
    }

    AddDropdown(o = {}) {
      return this._buildDropdown(o, false);
    }
    AddMultiDropdown(o = {}) {
      return this._buildDropdown(o, true);
    }

    _buildDropdown(o, multi) {
      const label = String(o.Name || (multi ? "Multi Select" : "Dropdown"));
      const card = this._addCard(44);
      const name = this._nameLabel(label);
      card.appendChild(name);
      const valNode = el("div", { style: { fontSize: "12px", color: "var(--nihon-Accent)", marginLeft: "auto", marginRight: "8px", maxWidth: "55%", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" } });
      card.appendChild(valNode);
      const arrow = el("span", { style: { color: "var(--nihon-Sub)", fontSize: "12px" }, text: "⌄" });
      card.appendChild(arrow);

      const obj = {
        Options: (o.Options || []).slice(),
        Value: multi ? {} : null,
        IsOpen: false,
      };

      const selected = (opt) => multi ? obj.Value[opt] === true : obj.Value === opt;
      const ordered = () => obj.Options.filter((opt) => obj.Value[opt]);
      const summary = () => {
        if (multi) {
          const list = ordered();
          if (!list.length) return "None";
          if (list.length <= 2) return list.join(", ");
          return list.length + " selected";
        }
        return obj.Value != null ? String(obj.Value) : "None";
      };
      const fire = () => {
        if (o.Callback) {
          try { o.Callback(multi ? ordered() : obj.Value); }
          catch (e) {
            this.Tab.Window.Lib.MakeNotification({ Name: label + " failed", Content: String(e), Type: "Error" });
          }
        }
      };

      let popup = null;
      const close = () => {
        if (popup) { popup.remove(); popup = null; }
        obj.IsOpen = false;
        arrow.textContent = "⌄";
      };
      const open = () => {
        if (obj.IsOpen) return;
        obj.IsOpen = true;
        arrow.textContent = "⌃";
        popup = el("div", { class: "nihon-popup" });
        const useSearch = obj.Options.length > 7;
        let filter = "";
        const listNode = el("div", { style: { overflowY: "auto", flex: "1" } });

        const rebuild = () => {
          listNode.innerHTML = "";
          const matches = obj.Options.filter((opt) => !filter || String(opt).toLowerCase().includes(filter));
          matches.forEach((opt) => {
            const item = el("div", { class: "nihon-popup-item" + (selected(opt) ? " selected" : ""), text: String(opt) });
            item.addEventListener("click", () => {
              if (multi) {
                obj.Value[opt] = !obj.Value[opt];
                if (!obj.Value[opt]) delete obj.Value[opt];
                valNode.textContent = summary();
                item.classList.toggle("selected", selected(opt));
                fire();
              } else {
                obj.Value = opt;
                valNode.textContent = summary();
                fire();
                close();
              }
            });
            listNode.appendChild(item);
          });
        };
        if (useSearch) {
          const input = el("input", { class: "nihon-popup-search", placeholder: "Search…" });
          input.addEventListener("input", () => { filter = input.value.toLowerCase(); rebuild(); });
          popup.appendChild(input);
        }
        popup.appendChild(listNode);
        rebuild();

        const rect = card.getBoundingClientRect();
        popup.style.left = rect.left + "px";
        popup.style.top = (rect.bottom + 6) + "px";
        popup.style.minWidth = rect.width + "px";
        document.body.appendChild(popup);
        requestAnimationFrame(() => popup.classList.add("nihon-popup-in"));

        const onDocClick = (e) => {
          if (!popup) return;
          if (popup.contains(e.target) || card.contains(e.target)) return;
          close();
          document.removeEventListener("click", onDocClick);
        };
        setTimeout(() => document.addEventListener("click", onDocClick), 0);
      };

      card.addEventListener("click", () => {
        if (obj.IsOpen) close();
        else open();
      });

      obj.Get = () => multi ? ordered() : obj.Value;
      obj.Set = (v, silent) => {
        if (multi) {
          obj.Value = {};
          if (Array.isArray(v)) v.forEach((x) => { obj.Value[x] = true; });
        } else {
          if (v != null && obj.Options.indexOf(v) < 0) return;
          obj.Value = v;
        }
        valNode.textContent = summary();
        if (!silent) fire();
      };
      obj.Refresh = (list, keepValue) => {
        obj.Options = (list || []).slice();
        if (!keepValue) obj.Value = multi ? {} : null;
        else if (!multi && obj.Value != null && obj.Options.indexOf(obj.Value) < 0) obj.Value = null;
        valNode.textContent = summary();
      };
      obj.Add = (opt) => { obj.Options.push(opt); };

      // Initial value
      if (multi) obj.Set(o.Default || [], true);
      else {
        const first = o.Default != null ? o.Default : (o.AllowNone ? null : obj.Options[0]);
        obj.Set(first, true);
      }
      this._register(o.Flag, obj, o, obj.Get, (v) => obj.Set(v, true));
      this.Tab.Window.Lib._initFires.push(fire);
      return this._decorate(obj, card, o, multi ? "MultiDropdown" : "Dropdown");
    }

    AddTextbox(o = {}) {
      const label = String(o.Name || "Textbox");
      const card = this._addCard(44);
      const name = this._nameLabel(label);
      card.appendChild(name);
      const input = el("input", {
        class: "nihon-input",
        type: "text",
        placeholder: o.Placeholder || "type here",
        value: String(o.Default || ""),
        style: { maxWidth: "55%", marginLeft: "auto" },
      });
      card.appendChild(input);

      const obj = {
        Value: input.value,
        Get: () => obj.Value,
        Set: (v, silent) => {
          input.value = String(v);
          obj.Value = input.value;
          if (!silent && o.Callback) {
            try { o.Callback(obj.Value); }
            catch (e) {
              this.Tab.Window.Lib.MakeNotification({ Name: label + " failed", Content: String(e), Type: "Error" });
            }
          }
        },
      };
      input.addEventListener("change", () => {
        obj.Value = input.value;
        if (o.Callback) {
          try { o.Callback(obj.Value); }
          catch (e) {
            this.Tab.Window.Lib.MakeNotification({ Name: label + " failed", Content: String(e), Type: "Error" });
          }
        }
        if (o.TextDisappear) input.value = "";
      });
      this._register(o.Flag, obj, o, obj.Get, (v) => obj.Set(v, true));
      return this._decorate(obj, card, o, "Textbox");
    }

    AddBind(o = {}) {
      const label = String(o.Name || "Keybind");
      const card = this._addCard(44);
      const name = this._nameLabel(label);
      card.appendChild(name);
      const chip = el("div", {
        class: "nihon-badge",
        style: { minWidth: "56px", textAlign: "center", cursor: "pointer" },
        text: o.Default ? String(o.Default) : "None",
      });
      card.appendChild(chip);

      const obj = {
        Value: o.Default || null,
        Binding: false,
        Get: () => obj.Value,
        Set: (k, silent) => {
          obj.Value = k;
          obj.Binding = false;
          chip.textContent = k ? String(k) : "None";
          chip.style.color = k ? "var(--nihon-Accent)" : "var(--nihon-Sub)";
          if (!silent) return;
        },
      };
      chip.addEventListener("click", () => {
        obj.Binding = true;
        chip.textContent = "…";
      });
      document.addEventListener("keydown", (e) => {
        if (obj.Binding) {
          e.preventDefault();
          if (e.key === "Escape") obj.Set(null);
          else obj.Set(e.key.length === 1 ? e.key.toUpperCase() : e.key);
          return;
        }
        if (obj.Value && (e.key === obj.Value || e.key.toUpperCase() === String(obj.Value).toUpperCase())) {
          if (o.Callback) {
            try { o.Callback(true); }
            catch (err) {
              this.Tab.Window.Lib.MakeNotification({ Name: label + " failed", Content: String(err), Type: "Error" });
            }
          }
        }
      });
      document.addEventListener("keyup", (e) => {
        if (o.Hold && obj.Value && (e.key === obj.Value || e.key.toUpperCase() === String(obj.Value).toUpperCase())) {
          if (o.Callback) {
            try { o.Callback(false); }
            catch (err) {}
          }
        }
      });
      this._register(o.Flag, obj, o, obj.Get, (v) => obj.Set(v, true));
      return this._decorate(obj, card, o, "Keybind");
    }

    AddStepper(o = {}) {
      const label = String(o.Name || "Stepper");
      const min = parseFloat(o.Min) || 0;
      const max = parseFloat(o.Max) || 100;
      const step = parseFloat(o.Step) || 1;
      const card = this._addCard(44);
      const name = this._nameLabel(label);
      card.appendChild(name);
      const holder = el("div", { style: { marginLeft: "auto", display: "flex", alignItems: "center", gap: "4px" } });
      const minus = el("button", { class: "nihon-btn", text: "−" });
      const val = el("div", { style: { minWidth: "40px", textAlign: "center", fontSize: "13px", color: "var(--nihon-Accent)", fontWeight: "600" } });
      const plus = el("button", { class: "nihon-btn", text: "+" });
      holder.appendChild(minus);
      holder.appendChild(val);
      holder.appendChild(plus);
      card.appendChild(holder);

      let value = clamp(parseFloat(o.Default) || min, min, max);
      const fire = (v) => {
        if (o.Callback) {
          try { o.Callback(v); }
          catch (e) {
            this.Tab.Window.Lib.MakeNotification({ Name: label + " failed", Content: String(e), Type: "Error" });
          }
        }
      };
      const setVal = (v, silent) => {
        v = clamp(v, min, max);
        value = v;
        val.textContent = String(v);
        if (!silent) fire(v);
      };
      minus.addEventListener("click", () => setVal(value - step));
      plus.addEventListener("click", () => setVal(value + step));

      const obj = { Get: () => value, Set: (v, silent) => setVal(parseFloat(v), silent) };
      setVal(value, true);
      this._register(o.Flag, obj, o, obj.Get, (v) => obj.Set(v, true));
      return this._decorate(obj, card, o, "Stepper");
    }

    AddProgress(o = {}) {
      const card = this._addCard(46);
      const name = this._nameLabel(o.Name || "Progress");
      card.appendChild(name);
      const pct = el("div", { style: { fontSize: "12px", color: "var(--nihon-Accent)", marginLeft: "auto", marginRight: "8px", fontWeight: "600" }, text: "0%" });
      card.appendChild(pct);
      const rail = el("div", { class: "nihon-progress", style: { maxWidth: "40%" } });
      const fill = el("div", { class: "nihon-progress-fill" });
      rail.appendChild(fill);
      card.appendChild(rail);

      const obj = {
        Value: 0,
        Set: (v) => {
          v = clamp(parseFloat(v) || 0, 0, 1);
          obj.Value = v;
          fill.style.width = (v * 100) + "%";
          pct.textContent = Math.round(v * 100) + "%";
        },
        Get: () => obj.Value,
      };
      obj.Set(o.Default || 0);
      return this._decorate(obj, card, o, "Progress");
    }

    AddColorpicker(o = {}) {
      const label = String(o.Name || "Color");
      const card = this._addCard(44);
      const name = this._nameLabel(label);
      card.appendChild(name);
      let current = o.Default || { __color: true, value: "#5882ff" };
      if (typeof current === "string") current = { __color: true, value: current };
      if (!current.value) current.value = "#5882ff";
      const swatch = el("div", { class: "nihon-swatch", style: { background: current.value, marginLeft: "auto" } });
      card.appendChild(swatch);

      const obj = {
        Value: current,
        Get: () => obj.Value,
        Set: (c, silent) => {
          if (typeof c === "string") c = { __color: true, value: c };
          obj.Value = c;
          swatch.style.background = c.value;
          if (!silent) fire(c);
        },
      };
      const fire = (c) => {
        if (o.Callback) {
          try { o.Callback(c); }
          catch (e) {
            this.Tab.Window.Lib.MakeNotification({ Name: label + " failed", Content: String(e), Type: "Error" });
          }
        }
      };

      swatch.addEventListener("click", () => {
        const picker = el("input", { type: "color", value: current.value, style: { position: "fixed", opacity: "0", pointerEvents: "none" } });
        document.body.appendChild(picker);
        picker.addEventListener("input", () => obj.Set({ __color: true, value: picker.value }));
        picker.addEventListener("change", () => { obj.Set({ __color: true, value: picker.value }); picker.remove(); });
        picker.click();
      });

      this._register(o.Flag, obj, o, obj.Get, (v) => obj.Set(v, true));
      return this._decorate(obj, card, o, "Colorpicker");
    }
  }

  // ==================================================================
  // Attach window methods (before any MakeWindow call)
  // ==================================================================
  NihonWindow.prototype.AddSettingsTab = function (opts = {}) {
    const tab = this.MakeTab({ Name: opts.Name || "Settings", Icon: opts.Icon || "settings" });
    const lib = this.Lib;

    const look = tab.AddSection({ Name: "Appearance" });
    look.AddDropdown({
      Name: "Theme", Options: ThemeOrder, Default: lib.Theme, Flag: "_theme", Save: true,
      Callback: (v) => lib.SetTheme(v),
    });
    look.AddDropdown({
      Name: "Font", Options: FontOrder, Default: lib.Font, Flag: "_font", Save: true,
      Callback: (v) => lib.SetFont(v),
    });
    look.AddSlider({
      Name: "Animation speed", Min: 50, Max: 200, Default: 100, Increment: 10, ValueName: "%",
      Flag: "_anim", Save: true,
      Callback: (v) => lib.SetAnimationSpeed(v / 100),
    });

    const alerts = tab.AddSection({ Name: "Notifications" });
    alerts.AddDropdown({
      Name: "Position",
      Options: ["top-right", "top-left", "top-center", "bottom-right", "bottom-left", "bottom-center"],
      Default: lib._notifications.position, Flag: "_notePos", Save: true,
      Callback: (v) => lib.SetNotificationPosition(v),
    });
    alerts.AddSlider({ Name: "Visible at once", Min: 1, Max: 8, Default: 5, Flag: "_noteMax", Save: true, Callback: (v) => lib.SetNotificationLimit(v) });
    alerts.AddSlider({ Name: "Duration", Min: 1, Max: 12, Default: 4, ValueName: "s", Flag: "_noteTime", Save: true, Callback: (v) => lib.SetNotificationTime(v) });
    alerts.AddButton({ Name: "Send test", Callback: () => lib.MakeNotification({ Name: "Test", Content: "This is what alerts look like.", Type: "Info" }) });
    alerts.AddButton({ Name: "Clear all", Callback: () => lib.ClearNotifications() });

    const cfg = tab.AddSection({ Name: "Config" });
    const nameBox = cfg.AddTextbox({ Name: "Profile name", Placeholder: "my-config" });
    const profiles = cfg.AddDropdown({ Name: "Profiles", Options: lib.ListProfiles(), AllowNone: true });
    const refresh = () => profiles.Refresh(lib.ListProfiles());
    cfg.AddButton({ Name: "Save profile", Callback: () => {
      const n = nameBox.Get() || profiles.Get();
      if (!n) throw new Error("Type a profile name first");
      lib.SaveProfile(n);
      refresh();
      lib.MakeNotification({ Name: "Saved", Content: n, Type: "Success" });
    }});
    cfg.AddButton({ Name: "Load profile", Callback: () => {
      const n = profiles.Get();
      if (!n) throw new Error("Choose a profile first");
      if (!lib.LoadProfile(n)) throw new Error("Could not load profile");
      lib.MakeNotification({ Name: "Loaded", Content: n, Type: "Success" });
    }});
    cfg.AddButton({ Name: "Delete profile", Callback: () => {
      const n = profiles.Get();
      if (!n) throw new Error("Choose a profile first");
      lib.Dialog({
        Title: "Delete profile", Content: "Permanently remove " + n + "?",
        Buttons: [
          { Name: "Cancel" },
          { Name: "Delete", Primary: true, Danger: true, Callback: () => { lib.DeleteProfile(n); refresh(); } },
        ],
      });
    }});
    cfg.AddButton({ Name: "Copy config", Callback: () => {
      const text = lib.ExportConfig();
      if (!navigator.clipboard) throw new Error("Clipboard not available");
      navigator.clipboard.writeText(text);
      lib.MakeNotification({ Name: "Copied", Content: "Config copied to clipboard", Type: "Success" });
    }});
    const importBox = cfg.AddTextbox({ Name: "Paste config", Placeholder: "paste json", TextDisappear: true });
    cfg.AddButton({ Name: "Import pasted", Callback: () => {
      const raw = importBox.Get();
      if (!raw) throw new Error("Paste a config first");
      if (!lib.ImportConfig(raw)) throw new Error("Invalid config");
      lib.MakeNotification({ Name: "Imported", Content: "Config applied", Type: "Success" });
    }});

    const ui = tab.AddSection({ Name: "Interface" });
    ui.AddButton({ Name: "Reset position", Callback: () => {
      this.Root.style.left = "60px";
      this.Root.style.top = "60px";
    }});
    ui.AddButton({ Name: "Destroy menu", Callback: () => {
      lib.Dialog({
        Title: "Destroy menu", Content: "This removes everything.",
        Buttons: [
          { Name: "Cancel" },
          { Name: "Destroy", Primary: true, Danger: true, Callback: () => lib.Destroy() },
        ],
      });
    }});

    const about = tab.AddSection({ Name: "About" });
    about.AddParagraph({ Title: "Nihon Lib " + lib.Version, Content: "Ctrl+K to search. Click your name (top right) for stats." });
    return tab;
  };

  // ==================================================================
  // FPS meter (for stats panel)
  // ==================================================================
  let lastFrame = performance.now();
  let frames = 0;
  let accum = 0;
  function fpsLoop() {
    const now = performance.now();
    const dt = now - lastFrame;
    lastFrame = now;
    frames++;
    accum += dt;
    if (accum >= 500) {
      const inst = frames / (accum / 1000);
      NihonLib.prototype._noop = NihonLib.prototype._noop || function () {};
      (global.NihonLibInstance || {})._fps = Math.round(inst);
      if (global.NihonLibInstance) global.NihonLibInstance._frameTime = 1000 / inst;
      frames = 0;
      accum = 0;
    }
    requestAnimationFrame(fpsLoop);
  }
  requestAnimationFrame(fpsLoop);

  // ==================================================================
  // Expose
  // ==================================================================
  global.NihonLib = NihonLib;
  global.NihonLibInstance = null;

  // Convenience factory (matches the Lua API's `return Nihon`)
  global.Nihon = function (opts) {
    const lib = new NihonLib(opts);
    global.NihonLibInstance = lib;
    return lib;
  };
})(typeof window !== "undefined" ? window : globalThis);
