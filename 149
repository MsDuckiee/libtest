/*
 * Nihon Lib Web Edition | v3.2
 * A browser-based reimplementation of the Nihon Roblox UI library.
 * Renders to the DOM (not Roblox), with the same public API shape.
 *
 * Usage:
 *   const Nihon = new NihonLib();
 *   const win = Nihon.MakeWindow({ Name: "My App", Subtitle: "Modern UI" });
 *   const tab = win.MakeTab({ Name: "Home", Icon: "home" });
 *   const sec = tab.AddSection({ Name: "Main" });
 *   sec.AddToggle({ Name: "Enable", Default: false, Flag: "feat",
 *                   Callback: v => console.log("toggled", v) });
 *   Nihon.Init();
 */

(function (global) {
  "use strict";

  // ------------------------------------------------------------------
  // Theme palette
  // ------------------------------------------------------------------
  const Themes = {
    Nihon: {
      Bg: "#0f0f14", Surface: "#16161e", Elevated: "#1e1e28",
      Stroke: "#2a2a38", Text: "#f4f4fa", Sub: "#9696aa",
      Accent: "#5882ff", Accent2: "#785aff",
    },
    Sakura: {
      Bg: "#1a1016", Surface: "#261821", Elevated: "#34222e",
      Stroke: "#503448", Text: "#fdf1f7", Sub: "#b796ac",
      Accent: "#ff85b2", Accent2: "#ffbace",
    },
    Midnight: {
      Bg: "#0a0b14", Surface: "#121420", Elevated: "#1c1f30",
      Stroke: "#292e48", Text: "#e8ecfa", Sub: "#848caa",
      Accent: "#6e8cff", Accent2: "#b078ff",
    },
    Ocean: {
      Bg: "#09111d", Surface: "#122032", Elevated: "#1c2e46",
      Stroke: "#2b4667", Text: "#e4f1fc", Sub: "#85a1be",
      Accent: "#38c8e8", Accent2: "#4880ff",
    },
    Forest: {
      Bg: "#0a130e", Surface: "#122219", Elevated: "#1c3226",
      Stroke: "#2d4e3a", Text: "#ebf7ef", Sub: "#8aa795",
      Accent: "#58dc8c", Accent2: "#b0e85c",
    },
    Sunset: {
      Bg: "#150d0f", Surface: "#26171a", Elevated: "#362124",
      Stroke: "#553537", Text: "#fcf2ee", Sub: "#b49894",
      Accent: "#ff804e", Accent2: "#ffca54",
    },
    Amoled: {
      Bg: "#000000", Surface: "#0c0c0e", Elevated: "#16161a",
      Stroke: "#26262e", Text: "#f5f5f8", Sub: "#8c8c98",
      Accent: "#6ec8ff", Accent2: "#aa8cff",
    },
    Light: {
      Bg: "#f3f4f9", Surface: "#ffffff", Elevated: "#ebedf5",
      Stroke: "#cbcedd", Text: "#1a1c2a", Sub: "#6c708a",
      Accent: "#e03454", Accent2: "#ff785a",
    },
  };

  const ThemeOrder = ["Nihon", "Sakura", "Midnight", "Ocean", "Forest", "Sunset", "Amoled", "Light"];
  const FontOrder = ["Modern", "Rounded", "Mono", "Classic", "Clean"];

  const StatusColors = {
    Info: "#609cff",
    Success: "#4ed68c",
    Warning: "#ffc048",
    Error: "#ff5a66",
  };

  const StatusIcons = {
    Info: "i",
    Success: "✓",
    Warning: "!",
    Error: "✕",
  };

  const GlyphMap = {
    home: "⌂", eye: "👁", bell: "🔔", star: "★", settings: "⚙",
    user: "👤", sword: "⚔", target: "◎", zap: "⚡", globe: "🌐",
    list: "☰", palette: "🎨", layers: "▤", shield: "🛡", cpu: "▣",
    map: "📍", wrench: "🔧", flag: "⚑", "help-circle": "?",
    search: "🔍", minus: "−", x: "✕", "chevron-down": "⌄",
    "chevron-right": "›", check: "✓", info: "i",
    "check-circle": "✓", "alert-triangle": "⚠", "x-circle": "✕",
    lock: "🔒", trash-2: "🗑", save: "💾", download: "⬇",
    upload: "⬆", copy: "📋", refresh: "⟳", "refresh-cw": "⟳",
    shuffle: "🔀",
  };

  // ------------------------------------------------------------------
  // Helpers
  // ------------------------------------------------------------------
  function el(tag, props, children) {
    const node = document.createElement(tag);
    if (props) {
      for (const k in props) {
        if (k === "class") node.className = props[k];
        else if (k === "text") node.textContent = props[k];
        else if (k === "html") node.innerHTML = props[k];
        else if (k.startsWith("on") && typeof props[k] === "function") {
          node.addEventListener(k.slice(2).toLowerCase(), props[k]);
        } else if (k === "style" && typeof props[k] === "object") {
          Object.assign(node.style, props[k]);
        } else if (k === "dataset" && typeof props[k] === "object") {
          Object.assign(node.dataset, props[k]);
        } else {
          node.setAttribute(k, props[k]);
        }
      }
    }
    if (children) {
      (Array.isArray(children) ? children : [children]).forEach((c) => {
        if (c == null) return;
        if (typeof c === "string") node.appendChild(document.createTextNode(c));
        else node.appendChild(c);
      });
    }
    return node;
  }

  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

  function deepMerge(target, src) {
    for (const k in src) {
      if (src[k] && typeof src[k] === "object" && !Array.isArray(src[k])) {
        target[k] = target[k] || {};
        deepMerge(target[k], src[k]);
      } else target[k] = src[k];
    }
    return target;
  }

  // ------------------------------------------------------------------
  // NihonLib
  // ------------------------------------------------------------------
  class NihonLib {
    constructor(opts = {}) {
      this.Version = "3.2.0";
      this.Flags = {};
      this.Windows = [];
      this.Profile = "default";
      this.SaveConfig = false;
      this.Theme = opts.Theme && Themes[opts.Theme] ? opts.Theme : "Nihon";
      this.Palette = Object.assign({}, Themes[this.Theme]);
      this.Font = opts.Font && FontOrder.indexOf(opts.Font) >= 0 ? opts.Font : "Modern";
      this.AnimationSpeed = 1;
      this._ready = false;
      this._themeListeners = [];
      this._initFires = [];
      this._flagRefs = {};
      this._flagOrder = [];

      // Inject base CSS once
      this._injectStyles();

      // Notifications container
      this._noteLayer = el("div", { class: "nihon-notify-layer" });
      document.body.appendChild(this._noteLayer);
      this._notifications = {
        active: [],
        queue: [],
        max: 5,
        duration: 4,
        position: "top-right",
      };

      // Event bus for theme changes
      this._root = document.body;
      this._applyThemeVars();
    }

    // --------------------------------------------------------------
    // Public: window creation
    // --------------------------------------------------------------
    MakeWindow(cfg = {}) {
      const win = new NihonWindow(this, cfg);
      this.Windows.push(win);
      return win;
    }

    // --------------------------------------------------------------
    // Public: config
    // --------------------------------------------------------------
    SetTheme(name) {
      if (!Themes[name]) return;
      this.Theme = name;
      this.Palette = Object.assign({}, Themes[name]);
      this._applyThemeVars();
      this._themeListeners.forEach((fn) => { try { fn(name); } catch (e) { console.error(e); } });
      this.Windows.forEach((w) => w._refreshTheme());
    }

    GetThemes() { return ThemeOrder.slice(); }
    AddTheme(name, data) {
      if (!Themes[name]) ThemeOrder.push(name);
      Themes[name] = data;
    }

    SetFont(name) {
      if (FontOrder.indexOf(name) < 0) return;
      this.Font = name;
      document.documentElement.style.setProperty("--nihon-font", this._fontStack(name));
      this.Windows.forEach((w) => w._refreshFont());
    }

    SetAnimationSpeed(s) {
      const n = parseFloat(s);
      if (!isNaN(n)) this.AnimationSpeed = clamp(n, 0.1, 60);
    }

    SetAutoload(name) {
      try { localStorage.setItem("nihon.autoload", name); } catch (e) {}
    }
    GetAutoload() {
      try { return localStorage.getItem("nihon.autoload"); } catch (e) { return null; }
    }

    SaveProfile(name) {
      name = name || this.Profile;
      const data = this._snapshot();
      try {
        localStorage.setItem("nihon.profile." + name, JSON.stringify(data));
        return true;
      } catch (e) { return false; }
    }
    LoadProfile(name) {
      name = name || this.Profile;
      let data;
      try { data = JSON.parse(localStorage.getItem("nihon.profile." + name) || "null"); }
      catch (e) { return false; }
      if (!data || typeof data !== "object") return false;
      this.Profile = name;
      this._flagOrder.forEach((flag) => {
        const ref = this._flagRefs[flag];
        if (ref && ref.save && data[flag] !== undefined) {
          try { ref.set(this._decode(data[flag])); } catch (e) {}
        }
      });
      return true;
    }
    DeleteProfile(name) {
      try { localStorage.removeItem("nihon.profile." + name); return true; }
      catch (e) { return false; }
    }
    ListProfiles() {
      const out = [];
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && k.startsWith("nihon.profile.")) out.push(k.slice("nihon.profile.".length));
      }
      return out.sort();
    }
    ExportConfig() { return JSON.stringify(this._snapshot()); }
    ImportConfig(str) {
      let data;
      try { data = JSON.parse(str); } catch (e) { return false; }
      if (!data || typeof data !== "object") return false;
      this._flagOrder.forEach((flag) => {
        const ref = this._flagRefs[flag];
        if (ref && ref.save && data[flag] !== undefined) {
          try { ref.set(this._decode(data[flag])); } catch (e) {}
        }
      });
      return true;
    }

    _snapshot() {
      const data = {};
      this._flagOrder.forEach((flag) => {
        const ref = this._flagRefs[flag];
        if (ref && ref.save) data[flag] = this._encode(ref.get());
      });
      return data;
    }
    _encode(v) {
      if (v == null) return { t: "null" };
      if (typeof v === "object" && v.__color) return { t: "c", v: v.value };
      if (Array.isArray(v)) return { t: "a", v: v.slice() };
      return v;
    }
    _decode(v) {
      if (v && typeof v === "object" && v.t === "c") return { __color: true, value: v.v };
      if (v && typeof v === "object" && v.t === "a") return v.v.slice();
      if (v && typeof v === "object" && v.t === "null") return null;
      return v;
    }

    _registerFlag(flag, ref) {
      if (!flag) return;
      if (!this._flagRefs[flag]) this._flagOrder.push(flag);
      this._flagRefs[flag] = ref;
      this.Flags[flag] = ref.obj;
    }

    // --------------------------------------------------------------
    // Public: notifications
    // --------------------------------------------------------------
    MakeNotification(cfg) {
      if (typeof cfg !== "object" || cfg === null) cfg = { Content: String(cfg) };
      const kind = StatusColors[cfg.Type] ? cfg.Type : "Info";
      const name = String(cfg.Name || cfg.Title || "Notification");
      const content = String(cfg.Content || "");
      const key = kind + "|" + name + "|" + content;
      const dedupe = !cfg.Sticky;

      if (dedupe) {
        const live = this._notifications.active.find((n) => n.key === key && !n.dying);
        if (live) { this._bumpNote(live, cfg.Time); return live.handle; }
        const waiting = this._notifications.queue.find((n) => n.key === key);
        if (waiting) { waiting.count++; return waiting.handle; }
      }

      const handle = {
        Dismiss: () => { const n = this._notifications.active.find((x) => x.handle === handle); if (n) this._dismissNote(n); },
        SetTitle: (t) => { const n = handle._n; if (n) n.titleNode.textContent = String(t); },
        SetContent: (t) => { const n = handle._n; if (n) { n.bodyNode.textContent = String(t); n.bodyNode.style.display = t ? "" : "none"; } },
        SetProgress: (p) => {
          const n = handle._n; if (!n) return;
          n.custom = true;
          n.barNode.style.display = "";
          n.barNode.style.width = clamp(p, 0, 1) * 100 + "%";
        },
      };

      const entry = { cfg, kind, key, count: 1, handle, dedupe };
      if (this._notifications.active.length >= this._notifications.max) {
        this._notifications.queue.push(entry);
      } else {
        this._spawnNote(entry);
      }
      return handle;
    }

    Notify(cfg) { return this.MakeNotification(cfg); }
    SetNotificationLimit(n) { this._notifications.max = clamp(parseInt(n, 10) || 5, 1, 10); }
    SetNotificationTime(s) { this._notifications.duration = clamp(parseFloat(s) || 4, 1, 30); }
    SetNotificationPosition(pos) {
      this._notifications.position = pos;
      this._noteLayer.className = "nihon-notify-layer nihon-pos-" + pos;
    }
    ClearNotifications() {
      this._notifications.queue.length = 0;
      [...this._notifications.active].forEach((n) => this._dismissNote(n));
    }

    _spawnNote(entry) {
      const cfg = entry.cfg;
      const color = StatusColors[entry.kind];
      const frame = el("div", { class: "nihon-note", style: { "--nihon-note-accent": color } });
      const strip = el("div", { class: "nihon-note-strip", style: { background: color } });
      const iconWrap = el("div", { class: "nihon-note-icon", style: { color: color, borderColor: color } },
        el("span", { text: cfg.Icon ? (GlyphMap[cfg.Icon] || cfg.Icon) : StatusIcons[entry.kind] }));
      const col = el("div", { class: "nihon-note-body" });
      const title = el("div", { class: "nihon-note-title", text: String(cfg.Name || cfg.Title || "Notification") });
      const body = el("div", { class: "nihon-note-content", text: String(cfg.Content || "") });
      body.style.display = cfg.Content ? "" : "none";
      col.appendChild(title);
      col.appendChild(body);

      if (Array.isArray(cfg.Actions) && cfg.Actions.length) {
        const row = el("div", { class: "nihon-note-actions" });
        cfg.Actions.forEach((act, i) => {
          const b = el("button", { class: "nihon-note-btn" + (i === 0 ? " primary" : ""), text: String(act.Name || "OK") });
          if (i === 0) b.style.background = color, b.style.color = "#0e0e14";
          b.addEventListener("click", () => {
            try { act.Callback && act.Callback(); }
            catch (e) { this.MakeNotification({ Name: "Action failed", Content: String(e), Type: "Error" }); }
            const n = this._notifications.active.find((x) => x.handle === entry.handle);
            if (n) this._dismissNote(n);
          });
          row.appendChild(b);
        });
        col.appendChild(row);
      }

      const bar = el("div", { class: "nihon-note-bar", style: { background: color } });
      const badge = el("div", { class: "nihon-note-badge", text: entry.count + "x", style: { background: color, color: color } });
      badge.style.display = entry.count > 1 ? "" : "none";

      frame.appendChild(strip);
      frame.appendChild(iconWrap);
      frame.appendChild(col);
      frame.appendChild(bar);
      frame.appendChild(badge);
      this._noteLayer.appendChild(frame);

      const n = {
        key: entry.key, count: entry.count, handle: entry.handle,
        frame, titleNode: title, bodyNode: body, barNode: bar, badgeNode: badge,
        time: Math.max(1, parseFloat(cfg.Time) || this._notifications.duration),
        sticky: cfg.Sticky === true,
        dying: false, hover: false, custom: false,
      };
      n.expires = performance.now() + n.time * 1000;
      entry.handle._n = n;

      requestAnimationFrame(() => frame.classList.add("nihon-note-in"));

      this._notifications.active.unshift(n);
      this._bindNoteHover(n);
      this._ensureNoteLoop();
    }

    _bindNoteHover(n) {
      n.frame.addEventListener("mouseenter", () => { n.hover = true; });
      n.frame.addEventListener("mouseleave", () => { n.hover = false; });
      n.frame.addEventListener("click", () => this._dismissNote(n));
    }

    _bumpNote(n, extra) {
      n.count++;
      n.badgeNode.textContent = n.count + "x";
      n.badgeNode.style.display = "";
      n.expires = performance.now() + (parseFloat(extra) || n.time) * 1000;
      n.frame.classList.remove("nihon-note-in");
      void n.frame.offsetWidth;
      n.frame.classList.add("nihon-note-in");
    }

    _dismissNote(n) {
      if (n.dying) return;
      n.dying = true;
      n.frame.classList.remove("nihon-note-in");
      n.frame.classList.add("nihon-note-out");
      setTimeout(() => {
        n.frame.remove();
        const i = this._notifications.active.indexOf(n);
        if (i >= 0) this._notifications.active.splice(i, 1);
        if (this._notifications.queue.length) this._spawnNote(this._notifications.queue.shift());
      }, 350);
    }

    _ensureNoteLoop() {
      if (this._noteLoop) return;
      const tick = () => {
        const now = performance.now();
        for (let i = this._notifications.active.length - 1; i >= 0; i--) {
          const n = this._notifications.active[i];
          if (n.dying || n.sticky) continue;
          if (n.hover) { n.expires = now + 1500; continue; }
          const left = n.expires - now;
          if (!n.custom && n.barNode) n.barNode.style.width = clamp(left / (n.time * 1000), 0, 1) * 100 + "%";
          if (left <= 0) this._dismissNote(n);
        }
        if (this._notifications.active.length === 0) {
          this._noteLoop = null;
        } else {
          this._noteLoop = requestAnimationFrame(tick);
        }
      };
      this._noteLoop = requestAnimationFrame(tick);
    }

    // --------------------------------------------------------------
    // Public: dialog
    // --------------------------------------------------------------
    Dialog(cfg = {}) {
      const layer = el("div", { class: "nihon-dialog-layer" });
      const box = el("div", { class: "nihon-dialog" });
      const title = el("div", { class: "nihon-dialog-title", text: String(cfg.Title || "Confirm") });
      box.appendChild(title);
      if (cfg.Content) box.appendChild(el("div", { class: "nihon-dialog-content", text: String(cfg.Content) }));
      const row = el("div", { class: "nihon-dialog-actions" });
      let closed = false;
      const close = () => {
        if (closed) return; closed = true;
        box.classList.remove("nihon-dialog-in");
        layer.classList.remove("nihon-dialog-layer-in");
        setTimeout(() => layer.remove(), 220);
      };
      const buttons = cfg.Buttons || [{ Name: "OK", Primary: true }];
      buttons.forEach((b) => {
        const btn = el("button", { class: "nihon-dialog-btn" + (b.Primary ? " primary" : "") + (b.Danger ? " danger" : ""), text: String(b.Name || "OK") });
        btn.addEventListener("click", () => {
          close();
          if (b.Callback) {
            try { b.Callback(); }
            catch (e) { this.MakeNotification({ Name: "Action failed", Content: String(e), Type: "Error" }); }
          }
        });
        row.appendChild(btn);
      });
      box.appendChild(row);
      layer.appendChild(box);
      layer.addEventListener("click", (e) => { if (e.target === layer && cfg.Dismissable !== false) close(); });
      document.body.appendChild(layer);
      requestAnimationFrame(() => {
        layer.classList.add("nihon-dialog-layer-in");
        box.classList.add("nihon-dialog-in");
      });
      return { Close: close };
    }

    // --------------------------------------------------------------
    // Public: init + destroy
    // --------------------------------------------------------------
    Init() {
      if (this._ready) return;
      const window = this.Windows[0];
      const cfg = (window && window.Cfg) || {};
      const finish = () => {
        if (this.SaveConfig) {
          const auto = this.GetAutoload();
          this.LoadProfile(auto || "default");
        }
        this._initFires.forEach((fn) => { try { fn(); } catch (e) { console.error(e); } });
        this._initFires.length = 0;
        this._ready = true;
        if (window) window.Show();
      };
      if (cfg.IntroEnabled === false) { finish(); return; }
      this._loadingScreen(cfg, window ? window.Name : "Nihon Lib", finish);
    }

    Destroy() {
      this._ready = false;
      this.Windows.forEach((w) => w._destroy());
      this.Windows = [];
      this._noteLayer.remove();
      if (global.NihonLibInstance === this) delete global.NihonLibInstance;
    }

    _loadingScreen(cfg, title, done) {
      const layer = el("div", { class: "nihon-loading-layer" });
      const card = el("div", { class: "nihon-loading-card" });
      const orb = el("div", { class: "nihon-loading-orb" }, el("span", { text: GlyphMap[cfg.Icon] || "⚡" }));
      card.appendChild(orb);
      card.appendChild(el("div", { class: "nihon-loading-title", text: String(cfg.IntroText || title) }));
      const statusNode = el("div", { class: "nihon-loading-status", text: "starting" });
      card.appendChild(statusNode);
      const rail = el("div", { class: "nihon-loading-rail" });
      const bar = el("div", { class: "nihon-loading-bar" });
      rail.appendChild(bar);
      card.appendChild(rail);
      layer.appendChild(card);
      document.body.appendChild(layer);
      requestAnimationFrame(() => {
        layer.classList.add("nihon-loading-in");
        card.classList.add("nihon-loading-card-in");
      });

      const steps = [
        ["reading theme", 0.22],
        ["building interface", 0.5],
        ["loading config", 0.78],
        ["ready", 1],
      ];
      let i = 0;
      const next = () => {
        if (i >= steps.length) {
          card.classList.remove("nihon-loading-card-in");
          layer.classList.remove("nihon-loading-in");
          setTimeout(() => { layer.remove(); done(); }, 300);
          return;
        }
        statusNode.textContent = steps[i][0];
        bar.style.width = steps[i][1] * 100 + "%";
        i++;
        setTimeout(next, 280);
      };
      next();
    }

    // --------------------------------------------------------------
    // Internal: styling
    // --------------------------------------------------------------
    _fontStack(name) {
      switch (name) {
        case "Rounded": return "'Nunito', 'Quicksand', sans-serif";
        case "Mono": return "'Roboto Mono', 'Consolas', monospace";
        case "Classic": return "'Source Sans Pro', 'Helvetica', sans-serif";
        case "Clean": return "'Ubuntu', 'Segoe UI', sans-serif";
        default: return "'Gotham', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif";
      }
    }

    _applyThemeVars() {
      const p = this.Palette;
      const root = document.documentElement;
      for (const k in p) root.style.setProperty("--nihon-" + k.toLowerCase(), p[k]);
      root.style.setProperty("--nihon-font", this._fontStack(this.Font));
    }

    _refreshThemeAll() { this._applyThemeVars(); }

    _injectStyles() {
      if (document.getElementById("nihon-styles")) return;
      const css = `
        :root {
          --nihon-Bg: #0f0f14; --nihon-Surface: #16161e; --nihon-Elevated: #1e1e28;
          --nihon-Stroke: #2a2a38; --nihon-Text: #f4f4fa; --nihon-Sub: #9696aa;
          --nihon-Accent: #5882ff; --nihon-Accent2: #785aff;
          --nihon-font: 'Gotham', 'Inter', -apple-system, 'Segoe UI', sans-serif;
          --nihon-radius: 12px;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: var(--nihon-font); color: var(--nihon-Text); background: transparent; }

        .nihon-window {
          position: fixed; top: 60px; left: 60px;
          width: 760px; height: 520px;
          background: var(--nihon-Bg);
          border: 1px solid var(--nihon-Stroke);
          border-radius: 14px;
          box-shadow: 0 20px 60px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.02) inset;
          display: flex; flex-direction: column;
          overflow: hidden;
          z-index: 9999;
          opacity: 0; transform: scale(0.94);
          transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.2,0.9,0.3,1.2);
          user-select: none;
