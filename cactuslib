        shell.BackgroundColor3 = Pal.WindowBg
    end)

    -- Resize grip
    local resizeGrip = mk("TextButton", {Name="ResizeGrip", AnchorPoint=Vector2.new(1,1), Position=UDim2.new(1,-4,1,-4), Size=UDim2.fromOffset(16,16), BackgroundTransparency=1, ZIndex=40, Parent=winClip})
    local resizeGlyph = makeIcon(resizeGrip, "chevron-right", 10, "Sub", {AnchorPoint=Vector2.new(1,1), Position=UDim2.new(1,-2,1,-2), Rotation=45, ZIndex=41})
    resizeGlyph.Image.ZIndex = 41 resizeGlyph.Glyph.ZIndex = 41
    resizeGlyph.Image.Rotation = 45 resizeGlyph.Glyph.Rotation = 45

    local resizing, resizeStart, fullH = false, nil, baseH
    resizeGrip.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        if Window.Hidden or Window.Minimized then return end
        resizing = true resizeStart = v2(input)
    end)
    keep(UserInputService.InputChanged:Connect(function(input)
        if not resizing then return end
        local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        local isTouch = input.UserInputType == Enum.UserInputType.Touch
        if not isMouse and not isTouch then return end
        local d = Vector2.new(input.Position.X, input.Position.Y) - resizeStart
        local sc = math.max(currentScale, 0.01)
        local newW = math.max(math.floor((baseW * sc) + d.X), math.floor(baseW * 0.6 * sc))
        local newH = math.max(math.floor((fullH * sc) + d.Y), math.floor((headerH + tabBarH + 120) * sc))
        shell.Size = UDim2.fromOffset(math.floor(newW / sc), math.floor(newH / sc))
    end))
    keep(UserInputService.InputEnded:Connect(function(input)
        if not resizing then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        resizing = false
    end))

    -- Launcher (small floating button)
    local launcher = mk("TextButton", {Name="Launcher", AnchorPoint=Vector2.new(0,0), Position=UDim2.new(0,16,0,16), Size=UDim2.fromOffset(44,44), BackgroundColor3=Pal.Surface, BackgroundTransparency=0, Visible=false, ZIndex=250, Parent=Root})
    round(launcher, 12)
    local launcherStroke = outline(launcher, "Stroke", 1, 0.5)
    local launcherIconBox = mk("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), Size=UDim2.fromOffset(22,22), BackgroundTransparency=1, ZIndex=251, Parent=launcher})
    local launcherIcon = makeIcon(launcherIconBox, cfg.Icon or "leaf", 18, "Text", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=252})
    launcherIcon.Color(Pal.Text)
    local launcherScale = mk("UIScale", {Scale=0, Parent=launcher})
    Window.LauncherIcon = launcherIcon
    Window.Launcher = launcher

    launcher.MouseEnter:Connect(function() play(launcher, 0.12, {BackgroundTransparency = 0}) end)
    launcher.MouseLeave:Connect(function() play(launcher, 0.18, {BackgroundTransparency = 0}) end)

    -- ===== TOGGLE KEY =====
    local function syncToggleUI(k) Window.ToggleKey = k end
    Window.SetToggleKey = function(k)
        if typeof(k) == "string" then k = Enum.KeyCode[k] or Enum.UserInputType[k] or nil end
        if k ~= nil then
            local t = typeof(k)
            if t ~= "EnumItem" then return false end
            local et = k.EnumType
            if et ~= Enum.KeyCode and et ~= Enum.UserInputType then return false end
        end
        syncToggleUI(k)
        return true
    end
    Window.GetToggleKey = function() return Window.ToggleKey end
    syncToggleUI(Window.ToggleKey)

    -- Drag
    makeDraggable({grabStrip}, shell, {
        smoothing = 28,
        clamp = function(topLeft)
            local v = viewport()
            local s = shell.AbsoluteSize
            return Vector2.new(math.clamp(topLeft.X, 0, math.max(0, v.X - s.X)), math.clamp(topLeft.Y, 0, math.max(0, v.Y - s.Y)))
        end,
        canDrag = function() return not Window.Hidden and not Window.Morphing end,
    })
    makeDraggable({launcher}, launcher, {
        smoothing = 30,
        clamp = function(p)
            local v = viewport()
            local s = launcher.AbsoluteSize
            return Vector2.new(math.clamp(p.X, 0, math.max(0, v.X - s.X)), math.clamp(p.Y, 0, math.max(0, v.Y - s.Y)))
        end,
        onBegin = function() launcher.AnchorPoint = Vector2.new(0, 0) end,
    })

    local function showLauncher(on)
        if on then
            launcher.Visible = true
            launcherScale.Scale = 0.4
            play(launcherScale, 0.32, {Scale = 1}, Enum.EasingStyle.Quart)
        else
            local tw = play(launcherScale, 0.2, {Scale = 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            after(tw, function() launcher.Visible = false end)
        end
    end

    local show, hide

    local launcherMoved = false
    launcher.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        launcherMoved = false
    end)
    launcher.InputEnded:Connect(function(input)
        local pointer = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
        if pointer and not launcherMoved then show(false) end
        launcherMoved = false
    end)

    local closeToken = 0
    local function fitScale()
        local v = viewport()
        local estH = baseH + 20
        local estW = baseW
        local fit = math.min((v.X - 20) / estW, (v.Y - 20) / estH, 1)
        return math.max(fit, 0.6) * Window.Scale
    end
    local activeScale = 1
    local function applyScale(animated)
        activeScale = fitScale()
        currentScale = activeScale
        if animated then
            play(shell, 0.28, {Size = UDim2.fromOffset(math.floor(baseW), math.floor(baseH))})
        end
    end
    local cam = workspace.CurrentCamera
    if cam then
        keep(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            if not Window.Hidden then applyScale(true) end
        end))
    end

    show = function()
        Window.Morphing = false
        Window.Hidden = false
        Window.Minimized = false
        closeToken = closeToken + 1
        shell.Visible = true
        shell.GroupTransparency = 1
        shell.Size = UDim2.fromOffset(baseW, baseH)
        shell.Position = UDim2.fromScale(0.5, 0.5)
        shell.AnchorPoint = Vector2.new(0.5, 0.5)
        fadeGroup(shell, 0.28, 0)
        play(CactusBlur, 0.4, {Size = 10}, Enum.EasingStyle.Quart)
        if Cactus.ShowLauncher then showLauncher(false) end
    end

    hide = function()
        Window.Morphing = false
        Window.Hidden = true
        Popup.close(true)
        hideTip()
        closeToken = closeToken + 1
        local mine = closeToken
        fadeGroup(shell, 0.24, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(CactusBlur, 0.3, {Size = 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        task.delay(0.28, function()
            if Window.Hidden and mine == closeToken then
                shell.Visible = false
                restoreGroup(shell)
            end
        end)
        if Cactus.ShowLauncher then task.delay(0.1, function() if Window.Hidden then showLauncher(true) end end) end
    end

    Window.Show = function() show() end
    Window.Hide = function() hide() end
    function Window:Toggle()
        if Window.Hidden then show() else hide() end
    end

    local function setMinimized(state)
        state = state and true or false
        if Window.Minimized == state then return end
        Window.Minimized = state
        Popup.close(true)
        play(shell, 0.32, {
            Size = state and UDim2.fromOffset(baseW, headerH) or UDim2.fromOffset(baseW, baseH)
        }, Enum.EasingStyle.Quart)
    end
    Window.SetMinimized = setMinimized

    keep(UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe or activeBindCapture then return end
        local k = Window.GetToggleKey and Window.GetToggleKey() or Window.ToggleKey
        if not k then return end
        local hit = (k.EnumType == Enum.KeyCode and input.KeyCode == k) or (k.EnumType == Enum.UserInputType and input.UserInputType == k)
        if not hit then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Unknown then return end
        Window:Toggle()
    end))

    Window.RequestOpen = function() if Window.Hidden then show() end end

    Window._parts = {
        shell=shell, winClip=winClip, header=header,
        contentWrap=contentWrap, content=content, tabBar=tabBar, tabScroll=tabScroll,
        applyScale=applyScale, headerH=headerH, tabBarH=tabBarH, mobile=mobile,
        searchIndex=searchIndex, baseW=baseW, baseH=baseH,
        launcher=launcher, fullH=function() return fullH end,
        setFullH=function(h) fullH = h end,
        minBtn=minBtn, closeBtn=closeBtn,
        resizeGrip=resizeGrip,
        titleLbl=titleLbl, subLbl=subLbl, logo=logoBox,
    }

    if not Cactus.ShowLauncher then launcher.Visible = false end
    if not Cactus.ShowResize then resizeGrip.Visible = false end

    if Hooks.attach then Hooks.attach(Window)
    else
        Hooks._pending = Hooks._pending or {}
        Hooks._pending[#Hooks._pending + 1] = Window
    end
    return Window
end

