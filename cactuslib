            bind(c.label, "TextColor3", "Text")
            Hud.chips[item] = c
        end
    end
    hudUpdate()
end
function Hud.set(on) Hud.enabled = on and true or false hudFrame.Visible = Hud.enabled if Hud.enabled then hudBuild() end end
