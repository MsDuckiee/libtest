        local knob = mk("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0,0,0.5,0), Size=UDim2.fromOffset(14,14), BackgroundColor3=Color3.new(1,1,1), ZIndex=19, Parent=rail})
        round(knob, 7)
        mk("UIStroke", {Thickness=1, Color=Color3.new(0,0,0), Transparency=0.8, ApplyStrokeMode=Enum.ApplyStrokeMode.Border, Parent=knob})
        local value = math.clamp(tonumber(o.Default) or min, min, max)
        local obj = {Value=value}
        local function fracOf(v) return math.clamp((v - min) / (max - min), 0, 1) end
        local function draw(frac)
            fillBar.Size = UDim2.new(frac,0,1,0)
            knob.Position = UDim2.new(frac,0,0.5,0)
        end
        local firer = makeFirer(function() return obj.Value end, function(v)
            local ok, err = pcall(o.Callback or function() end, v)
            if not ok then fail(c, label, err) end
        end)
        local function commit(v, silent)
            v = math.clamp(snapTo(v, step, min), min, max)
            if v == obj.Value then return end
            obj.Value = v draw(fracOf(v)) valBox.Text = numFormat(v, step, suffix)
            if silent then firer.Sync(v) else firer.Fire() queueSave() end
        end
        function obj:Set(v, silent) commit(tonumber(v) or min, silent) end
        function obj:Get() return obj.Value end
        local function fromX(x)
            local rel = (x - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1)
            commit(min + (max - min) * math.clamp(rel, 0, 1))
        end
        local railDragging = false
        rail.InputBegan:Connect(function(input)
            if not isPointer(input) then return end
            if obj:IsLocked() then return end
            railDragging = true fromX(input.Position.X)
        end)
        keep(UserInputService.InputChanged:Connect(function(input)
            if not railDragging then return end
            local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            local isTouch = input.UserInputType == Enum.UserInputType.Touch
            if not isMouse and not isTouch then return end
            fromX(input.Position.X)
        end))
        keep(UserInputService.InputEnded:Connect(function(input)
            if not railDragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            railDragging = false
        end))
        valBox.FocusLost:Connect(function()
            local n = tonumber(valBox.Text:match("-?%d+%.?%d*"))
            if n then obj:Set(n) else valBox.Text = numFormat(obj.Value, step, suffix) end
        end)
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Slider")
        valBox.Text = numFormat(value, step, suffix)
        draw(fracOf(value))
        initFires[#initFires + 1] = function() firer.Fire() end
        return obj
    end

