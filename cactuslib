function ElementFactory(Window, Tab, parent, sectionName)
    local P = Window._parts local mobile = P.mobile local E = {_count = 0} local rowH = mobile and 44 or 42

    local function card(height, hover)
        local c = mk("TextButton", {Size=UDim2.new(1,0,0,height or rowH), BackgroundTransparency=0.42, ZIndex=24, LayoutOrder=E._count + 1, Parent=parent})
        bind(c, "BackgroundColor3", "Surface") round(c, 8) outline(c, "Stroke", 1, 0.6) c:SetAttribute("CactusCard", true)
        if hover then
            c.MouseEnter:Connect(function() play(c, 0.15, {BackgroundTransparency=0.3}) end)
            c.MouseLeave:Connect(function() play(c, 0.2, {BackgroundTransparency=0.42}) end)
        end
        return c
    end

    local function nameLabel(c, text, width) return tx("TextLabel", {Name="Name", Text=tostring(text), TextSize=13, Position=UDim2.fromOffset(16,0), Size=width or UDim2.new(1,-90,1,0), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=25, Parent=c}, 2) end
    local function decorate(obj, c, opts, kind)
        E._count = E._count + 1 local locked = false
        local veil = mk("Frame", {Name="Lock", Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.5, Visible=false, ZIndex=40, Parent=c}) round(veil, 8)
        local lockIco = makeIcon(veil, "lock", 15, "Sub", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=41})
        function obj:Lock(v) if v == nil then v = true end locked = v and true or false veil.Visible = locked end 
        function obj:IsLocked() return locked end 
        function obj:SetVisible(v) c.Visible = v and true or false end 
        function obj:Destroy() c:Destroy() for i, e in ipairs(P.searchIndex) do if e.owner == obj then table.remove(P.searchIndex, i) break end end end 
        function obj:SetName(n) local l = c:FindFirstChild("Name") if l then l.Text = tostring(n) end end 
        
        obj.Card = c obj.Kind = kind if opts.Locked then obj:Lock(true) end if opts.Visible == false then c.Visible = false end
        
        -- Register in search index
        P.searchIndex[#P.searchIndex + 1] = { 
            owner=obj, name=tostring(opts.Name or kind), tab=Tab.Name, section=sectionName, kind=kind, 
            go = function() 
                if Window.Hidden then Window.Show() end 
                if Window.Selected ~= Tab then Window:SelectTab(Tab) end 
                task.delay(0.1, function() 
                    if not c.Parent then return end 
                    local sc = Tab.Scroll 
                    local y = c.AbsolutePosition.Y - sc.AbsolutePosition.Y + sc.CanvasPosition.Y - 20
                    play(sc, 0.4, {CanvasPosition = Vector2.new(0, math.max(0, y))}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut) 
                    task.delay(0.25, function() if c.Parent then flashCard(c, Pal.Accent, 1.2) end end) 
                end) 
            end, 
        }
        return obj
    end
    local function register(flag, obj, opts, get, set) if not flag then return end registerFlag(flag, {get=get, set=set, save=opts.Save==true, obj=obj}) Cactus.Flags[flag] = obj end
    local function fail(c, label, err) flashCard(c, Status.Error, 1.1) shake(c) Cactus:MakeNotification({Name=(label or "Action").." failed", Content=errorText(err), Type="Error", Time=5}) end

    function E:AddLabel(o)
        o = type(o) == "table" and o or {Name = o} local c = card(rowH - 6, false) c.Active = false local l = nameLabel(c, o.Name or "", UDim2.new(1, -28, 1, 0)) bind(l, "TextColor3", "Sub")
        local obj = {} function obj:Set(t) l.Text = tostring(t) end function obj:Get() return l.Text end
        return decorate(obj, c, o, "Label")
    end

    function E:AddParagraph(o)
        o = o or {} local c = card(0, false) c.AutomaticSize = Enum.AutomaticSize.Y c.Size = UDim2.new(1, 0, 0, 0) c.Active = false inset(c, 12, 14, 12, 14)
        local col = mk("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, ZIndex=25, Parent=c}) stack(col, 4)
        tx("TextLabel", {Text=tostring(o.Title or o.Name or "Note"), TextSize=13, Size=UDim2.new(1,0,0,18), TextWrapped=false, TextTruncate=Enum.TextTruncate.AtEnd, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center, LayoutOrder=1, ZIndex=25, Parent=col}, 3)
        local text = tx("TextLabel", {Text=tostring(o.Content or ""), TextSize=12, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, LineHeight=1.15, Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, LayoutOrder=2, ZIndex=25, Parent=col}, 1, "Sub")
        local obj = {} function obj:Set(t) text.Text = tostring(t) end function obj:Get() return text.Text end function obj:SetTitle(t) end
        return decorate(obj, c, o, "Paragraph")
    end

    function E:AddButton(o)
        o = o or {} local label = tostring(o.Name or "Button") local isPrimary = o.Primary == true or o.Priority == true
        local c = card(rowH, true) local icon = makeIcon(c, o.Icon or "chevron-right", 16, isPrimary and "Text" or "Sub", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-16,0.5,0), ZIndex=30}) c.ClipsDescendants = false
        local nameLbl = nameLabel(c, label, UDim2.new(1, -60, 1, 0)) nameLbl.Position = UDim2.fromOffset(16, 0)
        if isPrimary then c.BackgroundTransparency = 0 local grad = mk("UIGradient", {Rotation = 20, Parent = c}) grad.Color = ColorSequence.new(Pal.Accent, Pal.Accent2) bind(grad, "Color", "Accent", function(_, p) return ColorSequence.new(p.Accent, p.Accent2) end) nameLbl.TextColor3 = onAccent() bind(nameLbl, "TextColor3", "Accent", function() return onAccent() end) icon.Color(onAccent()) end
        local obj = {} local running = false
        function obj:Fire(...) 
            if obj:IsLocked() or running then if running then shake(c) end return false end 
            running = true 
            -- REMOVED BOUNCE: Smooth color fade instead
            if isPrimary then play(c, 0.1, {BackgroundTransparency = 0.15}) task.delay(0.1, function() play(c, 0.2, {BackgroundTransparency = 0}) end) 
            else play(c, 0.1, {BackgroundTransparency = 0.2}) task.delay(0.1, function() play(c, 0.2, {BackgroundTransparency = 0.3}) end) end
            
            local args = table.pack(...) 
            task.spawn(function() 
                local cb = o.Callback 
                if type(cb) ~= "function" then running = false fail(c, label, "no callback attached") return end 
                local ok, err = pcall(cb, table.unpack(args, 1, args.n)) 
                running = false 
                if not ok then if type(o.OnError) == "function" then pcall(o.OnError, err, label) end fail(c, label, err) else flashCard(c, isPrimary and Pal.Accent2 or Status.Success, 0.5) end 
            end) 
            return true 
        end
        c.InputBegan:Connect(function(input) if isPointer(input) then obj:Fire() end end) function obj:SetCallback(fn) o.Callback = fn end
        return decorate(obj, c, o, isPrimary and "Primary Button" or "Button")
    end

    function E:AddToggle(o)
        o = o or {} local label = tostring(o.Name or "Toggle") local c = card(rowH, true) nameLabel(c, label, UDim2.new(1, -80, 1, 0))
        local track = mk("Frame", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-14,0.5,0), Size=UDim2.fromOffset(40,22), ZIndex=25, Parent=c}) bind(track, "BackgroundColor3", "Elevated") round(track, 11) outline(track, "Stroke", 1, 0.4)
        local fill = mk("Frame", {Size = UDim2.fromScale(1,1), BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 1, ZIndex = 26, Parent = track}) round(fill, 11)
        local fillGrad = mk("UIGradient", {Rotation = 25, Parent = fill}) bind(fillGrad, "Color", "Accent", function(_, p) return ColorSequence.new(p.Accent, p.Accent2) end)
        local knob = mk("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,2,0.5,0), Size=UDim2.fromOffset(18,18), BackgroundColor3=Color3.new(1,1,1), ZIndex=28, Parent=track}) round(knob, 9)
        local state = {value = false} local obj = {Value = false}
        local function paint(v, animated) local dur = animated and 0.3 or 0.001 play(fill, dur, {BackgroundTransparency = v and 0 or 1}, Enum.EasingStyle.Quart) play(knob, dur + 0.05, {Position = UDim2.new(0, v and 20 or 2, 0.5, 0)}, Enum.EasingStyle.Back) end
        local firer = makeFirer(function() return state.value end, function(v) local ok, err = pcall(o.Callback or function() end, v) if not ok then fail(c, label, err) end end)
        function obj:Set(v, silent) v = v and true or false state.value = v obj.Value = v paint(v, true) if silent then firer.Sync(v) else firer.Fire() queueSave() end end function obj:Get() return state.value end function obj:Toggle() if obj.IsLocked and obj:IsLocked() then return end obj:Set(not state.value) end
        c.InputBegan:Connect(function(input) if isPointer(input) then if obj.IsLocked and obj:IsLocked() then return end obj:Set(not state.value) end end)
        register(o.Flag, obj, o, function() return state.value end, function(v) obj:Set(v) end) decorate(obj, c, o, "Toggle")
        local start = o.Default and true or false state.value = start obj.Value = start paint(start, false)
        if start then initFires[#initFires + 1] = function() firer.Fire() end else firer.Sync(false) end
        return obj
    end

    extendElements(E, {Window=Window, Tab=Tab, P=P, card=card, nameLabel=nameLabel, decorate=decorate, register=register, fail=fail, mobile=mobile, rowH=rowH})
    return E
end

