    {"Cactus", function() return env and env.CactusLibInstance end},
}

function Detect.executor()
    if type(identifyexecutor) == "function" then
        local ok, name, ver = pcall(identifyexecutor)
        if ok and name and name ~= "" and tostring(name):lower() ~= "unknown" then
            return tostring(name), ver and tostring(ver) or nil
        end
    end
    for _, entry in ipairs(EXECUTOR_SIGNS) do
        local ok, res = pcall(entry[2])
        if ok and res then return entry[1], nil end
    end
    return nil, nil
end

function Detect.supportsScript()
    local caps = 0
    if type(game.HttpGet) == "function" or type(game.http_get) == "function" then caps = caps + 1 end
    if type(writefile) == "function" then caps = caps + 1 end
    if type(hookfunction) == "function" or type(hookfunc) == "function" then caps = caps + 1 end
    if type(getgenv) == "function" then caps = caps + 1 end
    return caps >= 3
end

local friendsCache = nil
local function fetchFriends()
    if friendsCache then return friendsCache end
    local list = {}
    local ok, pages = pcall(function() return Players:GetFriendsAsync(LocalPlayer.UserId) end)
    if ok and pages then
        local guard = 0
        while guard < 25 do
            guard = guard + 1
            local pageOk, page = pcall(function() return pages:GetCurrentPage() end)
            if not pageOk or type(page) ~= "table" then break end
            for _, f in ipairs(page) do
                list[#list + 1] = {Id=f.Id, Username=f.Username, DisplayName=f.DisplayName, IsOnline=f.IsOnline}
            end
            if pages.IsFinished then break end
            local advOk = pcall(function() pages:AdvanceToNextPageAsync() end)
            if not advOk then break end
        end
    end
    friendsCache = list
    return list
end

function Detect.friendStats()
    local list = fetchFriends()
    local inServer, online, offline = {}, 0, 0
    local inGame = {}
    for _, p in ipairs(Players:GetPlayers()) do inGame[p.UserId] = true end
    for _, f in ipairs(list) do
        if inGame[f.Id] then inServer[#inServer + 1] = f end
        if f.IsOnline then online = online + 1 else offline = offline + 1 end
    end
    return { total=#list, online=online, offline=offline, inServer=inServer }
end

Cactus.Detect = Detect
Cactus._fetchFriends = fetchFriends

