    function E:AddNumberStepper(o)
        o = o or {}
        local label = tostring(o.Name or "Value")
        local min, max = tonumber(o.Min) or 0, tonumber(o.Max) or 100
        local step = tonumber(o.Increment) or 1
        local c = card(rowH, true)
        nameLabel(c, label, UDim2.new(0.5, 0, 1, 0))
        local holder = mk("Frame", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-12,0.5,0), Size=UDim2.fromOffset(120,28), BackgroundTransparency=1, ZIndex=16, Parent=c})
        mk("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0,4), VerticalAlignment=Enum.VerticalAlignment.Center, SortOrder=Enum.SortOrder.LayoutOrder, Parent=holder})
        local function stepBtn(order, glyph)
            local b = mk("TextButton", {Size=UDim2.fromOffset(26,26), LayoutOrder=order, BackgroundColor3=Pal.Elevated, ZIndex=17, Parent=holder})
            round(b, 6)
            local ic = makeIcon(b, glyph, 12, "Text", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=18})
            ic.Image.ZIndex = 18 ic.Glyph.ZIndex = 18
            return b
        end
        local minus = stepBtn(1, "minus")
        local valBox = tx("TextBox", {Size=UDim2.fromOffset(54,26), LayoutOrder=2, TextSize=13, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=17, Parent=holder}, 3, "Accent")
        bind(valBox, "BackgroundColor3", "Surface") valBox.BackgroundTransparency = 0 round(valBox, 6)
        local plus = stepBtn(3, "plus")
        local value = math.clamp(tonumber(o.Default) or min, min, max)
        local obj = {Value=value}
        local firer = makeFirer(function() return obj.Value end, function(v)
            local ok, err = pcall(o.Callback or function() end, v)
            if not ok then fail(c, label, err) end
        end)
        local function commit(v, silent)
            v = math.clamp(tonumber(v) or min, min, max)
            v = min + math.floor((v - min) / step + 0.5) * step
            v = math.clamp(v, min, max)
            obj.Value = v
            valBox.Text = numFormat(v, step, o.ValueName or "")
            if silent then firer.Sync(v) else firer.Fire() queueSave() end
        end
        minus.InputBegan:Connect(function(input) if isPointer(input) then commit(obj.Value - step) end end)
        plus.InputBegan:Connect(function(input) if isPointer(input) then commit(obj.Value + step) end end)
        valBox.FocusLost:Connect(function() commit(valBox.Text) end)
        function obj:Set(v, silent) commit(v, silent) end
        function obj:Get() return obj.Value end
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v, true) end)
        decorate(obj, c, o, "Stepper")
        valBox.Text = numFormat(value, step, o.ValueName or "")
        return obj
    end

