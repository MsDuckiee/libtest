-- FLAG REGISTER + UTILITIES
-- =========================================================
local flagRefs, flagOrder, initFires, saveToken = {}, {}, {}, 0
local function encode(v)
    local t = typeof(v)
    if t == "Color3" then return {t="c", r=v.R, g=v.G, b=v.B}
    elseif t == "EnumItem" then return {t="k", n=v.Name, e=tostring(v.EnumType)}
    elseif t == "table" then local list = {} for i, x in ipairs(v) do list[i] = x end return {t="l", v=list} end
    if v == nil then return {t="k"} end
    return v
end
local function decode(v)
    if type(v) ~= "table" then return v end
    if v.t == "c" then return Color3.new(v.r, v.g, v.b)
    elseif v.t == "k" then
        if v.n == nil then return nil end
        if v.e and Enum[v.e] then local ok, item = pcall(function() return Enum[v.e][v.n] end) if ok and item then return item end end
        return Enum.KeyCode[v.n] or Enum.UserInputType[v.n]
    elseif v.t == "l" then return v.v end
    return v
end
local function fsReady() return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" and type(makefolder) == "function" and type(isfolder) == "function" end
local function cfgPath(name) return Cactus.Folder .. "/" .. name .. ".json" end
local function ensureFolder() if not isfolder(Cactus.Folder) then makefolder(Cactus.Folder) end end
local function snapshot() local data = {} for _, flag in ipairs(flagOrder) do local ref = flagRefs[flag] if ref.save then data[flag] = encode(ref.get()) end end return data end
function Cactus:SaveProfile(name) name = name or Cactus.Profile if not fsReady() then return false end return pcall(function() ensureFolder() writefile(cfgPath(name), HttpService:JSONEncode(snapshot())) end) end
function Cactus:LoadProfile(name) name = name or Cactus.Profile if not fsReady() then return false end local ok, data = pcall(function() if not isfile(cfgPath(name)) then return nil end return HttpService:JSONDecode(readfile(cfgPath(name))) end) if not ok or type(data) ~= "table" then return false end Cactus.Profile = name for _, flag in ipairs(flagOrder) do local ref = flagRefs[flag] if ref.save and data[flag] ~= nil then pcall(ref.set, decode(data[flag])) end end return true end
function Cactus:DeleteProfile(name) if not fsReady() or not delfile then return false end return pcall(function() if isfile(cfgPath(name or Cactus.Profile)) then delfile(cfgPath(name or Cactus.Profile)) end end) end
function Cactus:ListProfiles() local out = {} if not fsReady() or not listfiles then return out end pcall(function() ensureFolder() for _, p in ipairs(listfiles(Cactus.Folder)) do local n = p:match("([^/\\]+)%.json$") if n and n:sub(1,1) ~= "_" then out[#out + 1] = n end end end) table.sort(out) return out end
function Cactus:SetAutoload(name) if not fsReady() then return end pcall(function() ensureFolder() writefile(Cactus.Folder .. "/_meta.json", HttpService:JSONEncode({autoload = name})) end) end
function Cactus:GetAutoload() if not fsReady() then return nil end local ok, data = pcall(function() local p = Cactus.Folder .. "/_meta.json" if not isfile(p) then return nil end return HttpService:JSONDecode(readfile(p)) end) return ok and data and data.autoload or nil end
function Cactus:ExportConfig() return HttpService:JSONEncode(snapshot()) end
function Cactus:ImportConfig(str) local ok, data = pcall(function() return HttpService:JSONDecode(str) end) if not ok or type(data) ~= "table" then return false end for _, flag in ipairs(flagOrder) do local ref = flagRefs[flag] if ref.save and data[flag] ~= nil then pcall(ref.set, decode(data[flag])) end end return true end
local function queueSave() if not (Cactus.SaveConfig or Cactus.Autosave) or not Cactus._ready then return end saveToken = saveToken + 1 local mine = saveToken task.delay(Cactus.AutosaveDelay, function() if mine == saveToken then Cactus:SaveProfile() end end) end

local function registerFlag(flag, ref) if not flag then return end if not flagRefs[flag] then flagOrder[#flagOrder + 1] = flag end flagRefs[flag] = ref end
local function errorText(err) local s = tostring(err or "unknown error") s = s:gsub("^[%w_%.%-%/:]+:%d+:%s*", "") if #s > 90 then s = s:sub(1, 87) .. "..." end return s end
local function flashCard(card, color, seconds)
    if not card or not card.Parent then return end
    local sheet = mk("Frame", {Size=UDim2.fromScale(1,1), BackgroundColor3=color, BackgroundTransparency=0.55, ZIndex=44, Parent=card}) round(sheet, 8)
    local stroke = card:FindFirstChildOfClass("UIStroke") local oldTrans = stroke and stroke.Transparency
    if stroke then stroke.Color = color stroke.Transparency = 0 end
    local dur = seconds or 0.9
    local tw = play(sheet, dur, {BackgroundTransparency = 1}, Enum.EasingStyle.Quint) after(tw, function() if sheet.Parent then sheet:Destroy() end end)
    task.delay(dur, function() if stroke and stroke.Parent then play(stroke, 0.3, {Color = Pal.Stroke, Transparency = oldTrans or 0.45}) end if sheet.Parent then sheet:Destroy() end end)
end
local function shake(card)
    if not card or not card.Parent then return end
    local base = card.Position
    task.spawn(function() for _, dx in ipairs({6,-6,4,-4,2,0}) do if not card.Parent then return end card.Position = base + UDim2.fromOffset(dx, 0) task.wait(0.03) end if card.Parent then card.Position = base end end)
end

