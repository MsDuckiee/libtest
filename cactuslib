    -- Launcher
    local launcher = mk("TextButton", {Name="Launcher", AnchorPoint=Vector2.new(0.5,0), Position=UDim2.new(0.5,0,0,16), Size=UDim2.fromOffset(200,48), BackgroundTransparency=0.04, Visible=false, ZIndex=250, Parent=Root})
    bind(launcher, "BackgroundColor3", "Surface") round(launcher, 12) outline(launcher, "Stroke", 1.2, 0.28)
    local launcherTitle = tx("TextLabel", {Text=title, TextSize=13, Font=Fonts[currentFont][3], TextXAlignment=Enum.TextXAlignment.Center, Size=UDim2.fromScale(1,1), ZIndex=251, Parent=launcher}, 3)
    local launcherScale = mk("UIScale", {Scale=0, Parent=launcher})
    Window.Launcher = launcher

    local function showLauncher(on)
        if on then
            launcher.BackgroundTransparency = 0 launcherScale.Scale = 0.2 launcher.Visible = true
            play(launcherScale, 0.42, {Scale = 1}, Enum.EasingStyle.Quart)
        else
            local tw = play(launcherScale, 0.22, {Scale = 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            after(tw, function() launcher.Visible = false end)
        end
    end

    launcher.InputEnded:Connect(function(input) if isPointer(input) then show(true) end end)

    local closeToken = 0
    local activeScale = 1
    local function fitScale()
        local v = viewport()
        local fit = math.min((v.X - 20) / baseW, (v.Y - 20) / baseH, 1)
        return math.max(fit, 0.5) * Window.Scale
    end
    local function applyScale(animated)
        activeScale = fitScale() currentScale = activeScale
        if animated then play(uiScale, 0.28, {Scale = activeScale}) else uiScale.Scale = activeScale end
    end

    local show, hide
    show = function(fromMorph)
        Window.Hidden = false
        applyScale(false)
        shell.Position = UDim2.fromScale(0.5, 0.5)
        closeToken = closeToken + 1
        shell.Visible = true
        if fromMorph and launcher.Visible then
            Window.Morphing = true
            play(launcher, 0.28, {BackgroundTransparency = 1}) play(launcherScale, 0.28, {Scale = 0.15})
            shell.GroupTransparency = 1 uiScale.Scale = activeScale * 0.82
            play(uiScale, 0.42, {Scale = activeScale}, Enum.EasingStyle.Quart)
            fadeGroup(shell, 0.3, 0)
            task.delay(0.32, function() launcher.Visible = false Window.Morphing = false end)
        else
            shell.GroupTransparency = 1 uiScale.Scale = activeScale * 0.85
            play(uiScale, 0.42, {Scale = activeScale}, Enum.EasingStyle.Quart)
            fadeGroup(shell, 0.3, 0)
            if Cactus.ShowLauncher then showLauncher(false) end
        end
        play(CactusBlur, 0.45, {Size = 14})
    end

    hide = function(toMorph)
        Window.Hidden = true
        Popup.close(true)
        closeToken = closeToken + 1
        local mine = closeToken
        if toMorph and Cactus.ShowLauncher then
            Window.Morphing = true
            fadeGroup(shell, 0.28, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            play(uiScale, 0.28, {Scale = activeScale * 0.82}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            task.delay(0.3, function()
                if mine ~= closeToken then return end
                shell.Visible = false restoreGroup(shell) Window.Morphing = false
                showLauncher(true)
            end)
        else
            local tw = play(uiScale, 0.2, {Scale = activeScale * 0.9}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            fadeGroup(shell, 0.2, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            after(tw, function() if Window.Hidden and mine == closeToken then shell.Visible = false end end)
        end
        play(CactusBlur, 0.3, {Size = 0})
    end

    Window.Show = function() show(false) end
    Window.Hide = function() hide(true) end
    function Window:Toggle() if Window.Morphing then return end if Window.Hidden then show(true) else hide(true) end end

    closeBtn.Activated:Connect(function() hide(true) end)
    minBtn.Activated:Connect(function() hide(true) end)

    keep(UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        local k = Window.ToggleKey
        if not k then return end
        local hit = (k.EnumType == Enum.KeyCode and input.KeyCode == k) or (k.EnumType == Enum.UserInputType and input.UserInputType == k)
        if hit then Window:Toggle() end
    end))

    makeDraggable({grabStrip}, shell, {
        smoothing = 28,
        clamp = function(topLeft) local v = viewport() local s = shell.AbsoluteSize return Vector2.new(math.clamp(topLeft.X, 4, math.max(4, v.X - s.X - 4)), math.clamp(topLeft.Y, 4, math.max(4, v.Y - s.Y - 4))) end,
    })

    Window._parts = {
        shell=shell, winCard=winCard, winClip=winClip, header=header, sidebar=sidebar, sideBg=sideBg,
        contentWrap=contentWrap, content=content, tabScroll=tabScroll, uiScale=uiScale, applyScale=applyScale, topH=topH, mobile=mobile,
        searchIndex=searchIndex, baseW=baseW, baseH=baseH, launcher=launcher, searchBox=searchBox, sText=sText,
        resizeGrip=resizeGrip, playerPill=playerPill,
    }

    if not Cactus.ShowLauncher then launcher.Visible = false end
    if not Cactus.ShowResize then resizeGrip.Visible = false end
    if not Cactus.ShowMinimize then minBtn.Visible = false end
    if not Cactus.ShowClose then closeBtn.Visible = false end

    -- Search box opens overlay (fix: was previously non-functional)
    searchBox.Activated:Connect(function()
        if Window.OpenSearch then Window:OpenSearch() end
    end)

    if Hooks.attach then Hooks.attach(Window)
    else Hooks._pending = Hooks._pending or {} Hooks._pending[#Hooks._pending + 1] = Window end
    return Window
end

