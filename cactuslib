local function hudText(item)
    if item == "FPS" then return Metrics.fps .. " fps"
    elseif item == "Ping" then return Metrics.ping .. " ms"
    elseif item == "Memory" then return Metrics.mem .. " mb"
    elseif item == "Name" then return Hud.title end
    return os.date("%H:%M:%S")
end
local function hudUpdate()
    for item, c in pairs(Hud.chips) do c.label.Text = hudText(item) end
end
local function hudBuild()
    for _, c in pairs(Hud.chips) do c.frame:Destroy() end
    Hud.chips = {}
    for i, item in ipairs(hudOrder) do
        if Hud.items[item] then
