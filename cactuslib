    notePadding.PaddingBottom = UDim.new(0, c.ay == 1 and 20 or 0)
    notePadding.PaddingRight = UDim.new(0, c.ax == 1 and 20 or 0)
    notePadding.PaddingLeft = UDim.new(0, c.ax == 0 and 20 or 0)
end
updateNotePosition()

local function dismissNote(n)
    if not n or n.dying then return end
    n.dying = true
    for i, x in ipairs(Notes.active) do if x == n then table.remove(Notes.active, i) break end end
    if Notes.byKey[n.key] == n then Notes.byKey[n.key] = nil end
    
    local c = CORNERS[Notes.position] or CORNERS.TopCenter
    local slideDir = c.ax == 1 and 120 or (c.ax == 0 and -120 or 0)
    local slideY = c.ay == 1 and 120 or -120
    
    play(n.frame, 0.35, {Position = n.frame.Position + UDim2.fromOffset(slideDir ~= 0 and slideDir or 0, slideDir == 0 and slideY or 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    play(n.frame, 0.3, {GroupTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    task.delay(0.4, function() if n.frame then n.frame:Destroy() end end)
    
    task.delay(0.1, function()
        for i, entry in ipairs(Notes.queue) do
            if #Notes.active < Notes.max then
                table.remove(Notes.queue, i)
                Notes.queuedKey[entry.key] = nil
                Notes.spawn(entry)
                break
            end
        end
    end)
end

function Notes.spawn(entry)
    local cfg, handle = entry.cfg, entry.handle
    local color = Status[entry.kind]
    local width = 340
    
    local n = {
        key = entry.key, handle = handle, time = math.max(1, tonumber(cfg.Time) or Notes.duration),
        sticky = cfg.Sticky == true, dying = false,
    }
    n.expires = os.clock() + n.time
    
    local content = tostring(cfg.Content or "")
    local titleText = tostring(cfg.Name or cfg.Title or "Notification")
    
    local frame = mk("CanvasGroup", {
        Name = "Note", Size = UDim2.fromOffset(width, 70),
        BackgroundColor3 = Pal.Surface, BackgroundTransparency = 0.05, GroupTransparency = 1, Parent = noteContainer
    })
    round(frame, 12)
    local stroke = outline(frame, "Stroke", 1.2, 0.4)
    
    -- Spawn Animation Offset
    local c = CORNERS[Notes.position] or CORNERS.TopCenter
    frame.Position = UDim2.fromOffset(c.ax == 1 and 120 or (c.ax == 0 and -120 or 0), c.ay == 1 and 120 or -120)
    
    local scaleObj = mk("UIScale", {Scale = 0.9, Parent = frame})
    
    local iconWrap = mk("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,16,0.5,0), Size=UDim2.fromOffset(36,36), BackgroundTransparency=0.9, BackgroundColor3=color, ZIndex=5, Parent=frame})
    round(iconWrap, 10)
    local icon = makeIcon(iconWrap, cfg.Icon or firstIcon(StatusIcons[entry.kind]) or "bell", 20, false, {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=6})
    icon.Color(Color3.new(1,1,1))
    
    local textHolder = mk("Frame", {Position=UDim2.fromOffset(64,0), AnchorPoint=Vector2.new(0,0.5), Size=UDim2.new(1,-80,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=frame})
    mk("UIListLayout", {SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,4), HorizontalAlignment=Enum.HorizontalAlignment.Left, VerticalAlignment=Enum.VerticalAlignment.Center, Parent=textHolder})
    
    local title = tx("TextLabel", {Text=titleText, TextSize=14, Font=Fonts[currentFont][3], Size=UDim2.new(1,0,0,18), TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, LayoutOrder=1, ZIndex=5, Parent=textHolder}, 3)
    title.TextColor3 = Color3.new(1,1,1)
    
    local body = tx("TextLabel", {Text=content, TextSize=12, Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, Visible=content ~= "", LayoutOrder=2, ZIndex=5, Parent=textHolder}, 1)
    body.TextColor3 = Pal.Sub
    
    local barWrap = mk("Frame", {AnchorPoint=Vector2.new(0,1), Position=UDim2.new(0,12,1,0), Size=UDim2.new(1,-24,0,3), BackgroundColor3=Color3.fromRGB(40,40,45), Visible=not n.sticky, ZIndex=3, Parent=frame})
    round(barWrap, 1.5)
    local bar = mk("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=color, ZIndex=4, Parent=barWrap})
    round(bar, 1.5)
    
    n.frame = frame
    table.insert(Notes.active, 1, n)
    if entry.dedupe then Notes.byKey[n.key] = n end
    handle.n = n
    
    task.defer(function()
        if n.dying or not frame.Parent then return end
        if content ~= "" then
            local sz = TextService:GetTextSize(content, 12, Fonts[currentFont][1], Vector2.new(width - 80, 1000))
            local lines = math.clamp(math.ceil(sz.Y / 15), 1, 3)
            body.Size = UDim2.new(1, 0, 0, lines * 15)
            frame.Size = UDim2.fromOffset(width, 26 + 18 + 4 + (lines * 15) + 16)
        end
        play(frame, 0.45, {Position = UDim2.fromOffset(0,0), GroupTransparency = 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        play(scaleObj, 0.45, {Scale = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        
        if not n.sticky then
            play(bar, n.time, {Size = UDim2.new(0,0,1,0)}, Enum.EasingStyle.Linear)
        end
    end)
    
    -- Hover logic to pause
    frame.MouseEnter:Connect(function() n.hover = true end)
    frame.MouseLeave:Connect(function() n.hover = false end)
    
    if not noteLoop then
        noteLoop = RunService.Heartbeat:Connect(function(dt)
            local now = os.clock()
            for i = #Notes.active, 1, -1 do
                local note = Notes.active[i]
                if note and not note.dying and not note.sticky then
                    if note.hover then note.expires = (note.expires or now) + dt end
                    if (note.expires or now) - now <= 0 then dismissNote(note) end
                end
            end
            if #Notes.active == 0 and noteLoop then noteLoop:Disconnect() noteLoop = nil end
        end)
    end
    return n
end

function Cactus:MakeNotification(cfg)
    if type(cfg) ~= "table" then cfg = {Content = tostring(cfg)} end
    local kind = Status[cfg.Type] and cfg.Type or "Info"
    local name = tostring(cfg.Name or cfg.Title or "Notification")
    local content = tostring(cfg.Content or "")
    local key = kind .. "|" .. name .. "|" .. content
    
    local handle = {}
    function handle:Dismiss() if handle.n then dismissNote(handle.n) end end
    
    local entry = {cfg = cfg, kind = kind, key = key, handle = handle, dedupe = not cfg.Sticky}
    if #Notes.active >= Notes.max then table.insert(Notes.queue, entry) else Notes.spawn(entry) end
    return handle
end
