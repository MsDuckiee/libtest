local Notes = {active={}, queue={}, byKey={}, queuedKey={}, max=4, duration=4, position="TopRight", expanded=false}
local noteLayer = mk("Frame", {Name="Notifications", BackgroundTransparency=1, Size=UDim2.fromScale(1,1), ZIndex=100, Parent=Root})
local CORNERS = {
    TopRight={ax=1,ay=0,dy=1}, TopLeft={ax=0,ay=0,dy=1}, TopCenter={ax=0.5,ay=0,dy=1},
    BottomRight={ax=1,ay=1,dy=-1}, BottomLeft={ax=0,ay=1,dy=-1}, BottomCenter={ax=0.5,ay=1,dy=-1},
}
local PEEK, EDGE, GAP = 12, 16, 8
local noteLoop, collapseToken = nil, 0

local function cornerOf() return CORNERS[Notes.position] or CORNERS.TopRight end
local function stackWidth() local v = viewport() return math.clamp(math.floor(v.X - 32), 260, 380) end
local function spawnOffset(c) if c.ax == 1 then return 120, 0 end if c.ax == 0 then return -120, 0 end return 0, -120 * c.dy end
local function edgeOffset(c) local xOff = (c.ax == 0.5) and 0 or (c.ax == 1 and -EDGE or EDGE) local yOff = (c.ay == 0) and EDGE or -EDGE return xOff, yOff end
local function anyHovered() for _, n in ipairs(Notes.active) do if n.hover then return true end end return false end

local function layoutAll(animated)
    local c = cornerOf()
    local w = stackWidth()
    local cum = 0
    for i, n in ipairs(Notes.active) do
        if n.frame and n.frame.Parent and not n.dying then
            local depth = i - 1
            n.depth = depth
            local h = n.height or 70
            local xOff, yOff = edgeOffset(c)
            local sc, pos
            if Notes.expanded then
                pos = UDim2.new(c.ax, xOff, c.ay, yOff + cum * c.dy)
                sc = 1
                cum = cum + h + GAP
            else
                sc = math.max(0.72, 1 - depth * 0.045)
                pos = UDim2.new(c.ax, xOff, c.ay, yOff + depth * PEEK * c.dy)
            end
            n.frame.ZIndex = 300 - i
            if animated then
                play(n.frame, 0.42, {Position = pos, Size = UDim2.fromOffset(w, h)}, Enum.EasingStyle.Quart)
                play(n.scaleObj, 0.42, {Scale = sc}, Enum.EasingStyle.Quart)
            else
                n.frame.Position = pos n.frame.Size = UDim2.fromOffset(w, h) n.scaleObj.Scale = sc
            end
        end
    end
end

local function tryExpand() collapseToken = collapseToken + 1 if not Notes.expanded then Notes.expanded = true layoutAll(true) end end
local function tryCollapse()
    collapseToken = collapseToken + 1 local mine = collapseToken
    task.delay(0.22, function() if mine == collapseToken and not anyHovered() and Notes.expanded then Notes.expanded = false layoutAll(true) end end)
end

local spawnNote, dismissNote, promoteQueue
local function ensureNoteLoop()
    if noteLoop then return end
    noteLoop = RunService.Heartbeat:Connect(function(dt)
        local now = os.clock()
        for i = #Notes.active, 1, -1 do
            local n = Notes.active[i]
            if n and not n.dying and not n.sticky then
                if n.hover then n.expires = (n.expires or now) + dt end
                local left = (n.expires or now) - now
                if n.bar and n.bar.Parent and n.time and n.time > 0 then
                    local ratio = math.clamp(left / n.time, 0, 1)
                    n.bar.Size = UDim2.new(ratio, 0, 1, 0)
                end
                if left <= 0 then dismissNote(n) end
            end
        end
        if #Notes.active == 0 and noteLoop then noteLoop:Disconnect() noteLoop = nil end
    end)
end

spawnNote = function(entry)
    local cfg, handle = entry.cfg, entry.handle
    local color = Status[entry.kind]
    local w = stackWidth()
    local c = cornerOf()
    local xOff, yOff = edgeOffset(c)
    local spawnX, spawnY = spawnOffset(c)

    local n = {
        key=entry.key, handle=handle, height=64, depth=0,
        time=math.max(1, tonumber(cfg.Time) or Notes.duration), sticky=cfg.Sticky == true,
        spawned=false, hover=false, dying=false,
    }
    n.expires = os.clock() + n.time
    local content = tostring(cfg.Content or "")
    local titleText = tostring(cfg.Name or cfg.Title or "Notification")

    local frame = mk("CanvasGroup", {
        Name="Note", AnchorPoint=Vector2.new(c.ax, c.ay),
        Position=UDim2.new(c.ax, xOff + spawnX, c.ay, yOff + spawnY),
        Size=UDim2.fromOffset(w, n.height),
        BackgroundColor3=Pal.Surface, BackgroundTransparency=0.04, GroupTransparency=1, Parent=noteLayer,
    })
    round(frame, 12)
    local frameStroke = outline(frame, "Stroke", 1, 0.55)

    local scaleObj = mk("UIScale", {Scale = 0.9, Parent = frame})
    n.scaleObj = scaleObj

    -- Left accent bar
    local accentBar = mk("Frame", {Position=UDim2.fromOffset(0, 12), Size=UDim2.fromOffset(3, 0), BackgroundColor3=color, ZIndex=5, Parent=frame})
    round(accentBar, 2)
    accentBar.Size = UDim2.new(0, 3, 0, 40)

    -- Icon
    local iconWrap = mk("Frame", {Position=UDim2.fromOffset(16, 0), AnchorPoint=Vector2.new(0, 0.5), Size=UDim2.fromOffset(24, 24), BackgroundTransparency=1, ZIndex=5, Parent=frame})
    local icon = makeIcon(iconWrap, cfg.Icon or StatusIcons[entry.kind] or "bell", 18, false, {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=6})
    icon.Color(color)

    -- Text
    local textHolder = mk("Frame", {Position=UDim2.fromOffset(52, 0), AnchorPoint=Vector2.new(0, 0.5), Size=UDim2.new(1, -68, 0, 0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=frame})
    mk("UIListLayout", {SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0, 3), HorizontalAlignment=Enum.HorizontalAlignment.Left, VerticalAlignment=Enum.VerticalAlignment.Center, Parent=textHolder})

    local title = tx("TextLabel", {Text=titleText, TextSize=13, Font=Fonts[currentFont][3], Size=UDim2.new(1, 0, 0, 17), TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, LayoutOrder=1, ZIndex=5, Parent=textHolder}, 3)
    title.TextColor3 = Color3.new(1, 1, 1)
    local body = tx("TextLabel", {Text=content, TextSize=11, Size=UDim2.new(1, 0, 0, 0), AutomaticSize=Enum.AutomaticSize.Y, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, Visible=content ~= "", LayoutOrder=2, ZIndex=5, Parent=textHolder}, 1)
    body.TextColor3 = Pal.Sub

    -- Progress bar
    local barWrap = mk("Frame", {AnchorPoint=Vector2.new(0, 1), Position=UDim2.new(0, 0, 1, 0), Size=UDim2.new(1, 0, 0, 2), BackgroundColor3=Pal.Divider, Visible=not n.sticky, ZIndex=3, Parent=frame})
    n.bar = mk("Frame", {Size=UDim2.new(1, 0, 1, 0), BackgroundColor3=color, ZIndex=4, Parent=barWrap})
    round(n.bar, 1)

    n.frame, n.title, n.body = frame, title, body

    frame.MouseEnter:Connect(function() n.hover = true tryExpand() play(frameStroke, 0.15, {Transparency = 0.15}) end)
    frame.MouseLeave:Connect(function() n.hover = false tryCollapse() play(frameStroke, 0.2, {Transparency = 0.55}) end)

    task.defer(function()
        if n.dying or not frame.Parent then return end
        if content ~= "" then
            local sz = TextService:GetTextSize(content, 11, Fonts[currentFont][1], Vector2.new(w - 68, 1000))
            local lines = math.clamp(math.ceil(sz.Y / 14), 1, 3)
            body.Size = UDim2.new(1, 0, 0, lines * 14)
            n.height = 16 + 17 + 3 + (lines * 14) + 16
        else n.height = 52 end
        if n.spawned then layoutAll(true) end
    end)

    table.insert(Notes.active, 1, n)
    if entry.dedupe then Notes.byKey[n.key] = n end
    handle.n = n

    task.delay(0.01, function()
        if n.dying or not frame.Parent then return end
        n.spawned = true
        layoutAll(true)
        play(frame, 0.36, {GroupTransparency = 0}, Enum.EasingStyle.Quart)
        play(accentBar, 0.5, {Size = UDim2.new(0, 3, 0, n.height - 24)}, Enum.EasingStyle.Quart)
    end)

    ensureNoteLoop()
    return n
end

dismissNote = function(n)
    if not n or n.dying then return end
    n.dying = true
    for i, x in ipairs(Notes.active) do if x == n then table.remove(Notes.active, i) break end end
    if Notes.byKey[n.key] == n then Notes.byKey[n.key] = nil end
    if n.hover then n.hover = false tryCollapse() end

    if n.frame and n.frame.Parent then
        local c = cornerOf()
        local dx, dy = spawnOffset(c)
        local curPos = n.frame.Position
        local targetPos = UDim2.new(curPos.X.Scale, curPos.X.Offset + dx, curPos.Y.Scale, curPos.Y.Offset + dy)
        play(n.frame, 0.38, {Position = targetPos}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(n.frame, 0.32, {GroupTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(n.scaleObj, 0.38, {Scale = 0.86}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        local f = n.frame
        task.delay(0.42, function() if f and f.Parent then f:Destroy() end end)
    end
    layoutAll(true)
    promoteQueue()
end

promoteQueue = function()
    while #Notes.active < Notes.max and #Notes.queue > 0 do
        local entry = table.remove(Notes.queue, 1)
        Notes.queuedKey[entry.key] = nil
        spawnNote(entry)
    end
end

function Cactus:MakeNotification(cfg)
    if type(cfg) ~= "table" then cfg = {Content = tostring(cfg)} end
    local kind = Status[cfg.Type] and cfg.Type or "Info"
    local name = tostring(cfg.Name or cfg.Title or "Notification")
    local content = tostring(cfg.Content or "")
    local key = kind .. "|" .. name .. "|" .. content
    local dedupe = not cfg.Sticky and not (type(cfg.Actions) == "table" and #cfg.Actions > 0)
    if dedupe then
        local live = Notes.byKey[key]
        if live and not live.dying then return live.handle end
        local waiting = Notes.queuedKey[key]
        if waiting then return waiting.handle end
    end
    local handle = {}
    function handle:Dismiss() if handle.n then dismissNote(handle.n) end end
    function handle:SetTitle(t) if handle.n and handle.n.title then handle.n.title.Text = tostring(t) end end
    function handle:SetContent(t) if handle.n and handle.n.body then handle.n.body.Text = tostring(t) end end
    local entry = {cfg=cfg, kind=kind, key=key, handle=handle, dedupe=dedupe}
    if #Notes.active >= Notes.max then
        Notes.queue[#Notes.queue + 1] = entry
        if dedupe then Notes.queuedKey[key] = entry end
    else spawnNote(entry) end
    return handle
end

function Cactus:Notify(cfg) return Cactus:MakeNotification(cfg) end
function Cactus:SetNotificationLimit(n) Notes.max = math.clamp(math.floor(tonumber(n) or 5), 1, 10) end
function Cactus:SetNotificationTime(s) Notes.duration = math.clamp(tonumber(s) or 4, 1, 30) end
function Cactus:SetNotificationPosition(name)
    if not CORNERS[name] then return end
    Notes.position = name
    for _, n in ipairs(Notes.active) do
        if n.frame then local c = CORNERS[name] n.frame.AnchorPoint = Vector2.new(c.ax, c.ay) end
    end
    layoutAll(true)
end
function Cactus:ClearNotifications() Notes.queue = {} Notes.queuedKey = {} for i = #Notes.active, 1, -1 do dismissNote(Notes.active[i]) end end

