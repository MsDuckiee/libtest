function Cactus:SetKeySystem(cfg)
    cfg = cfg or {}
    cfg.Title = cfg.Title or "Key System"
    cfg.Subtitle = cfg.Subtitle or "Enter your key to continue"
    cfg.ButtonText = cfg.ButtonText or "Verify"
    cfg.GetKeyText = cfg.GetKeyText or "Get Key"
    cfg.DiscordText = cfg.DiscordText or "Discord"
    if cfg.KeyFile ~= nil then Cactus.KeyFile = cfg.KeyFile == true end
    if cfg.KeyFileName then Cactus.KeyFileName = tostring(cfg.KeyFileName) end
    if cfg.AutoVerify ~= nil then Cactus.AutoVerify = cfg.AutoVerify ~= false end
    Cactus._keyCfg = cfg
end

local function keyFSReady() return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" and type(makefolder) == "function" and type(isfolder) == "function" end
function Cactus:_keyFolder() return Cactus.Folder .. "/keys" end
function Cactus:_keyPath() return Cactus:_keyFolder() .. "/" .. tostring(Cactus.KeyFileName or "key") .. ".key" end
function Cactus:SaveKeyToFile(key) if not keyFSReady() or key == nil or key == "" then return false end return pcall(function() if not isfolder(Cactus:_keyFolder()) then makefolder(Cactus:_keyFolder()) end writefile(Cactus:_keyPath(), tostring(key)) end) end
function Cactus:LoadKeyFromFile() if not keyFSReady() then return nil end local path = Cactus:_keyPath() local ok, data = pcall(function() if not isfile(path) then return nil end return readfile(path) end) if ok and data and data ~= "" then return data end return nil end
function Cactus:_validateKey(key) local cfg = Cactus._keyCfg or {} if type(cfg.Validate) == "function" then local ok, r = pcall(cfg.Validate, key) return ok and r == true elseif cfg.Key ~= nil then return tostring(key) == tostring(cfg.Key) end return true end

function Cactus:_showKeyGate(onSuccess)
    local cfg = Cactus._keyCfg or {} local prefill = Cactus:LoadKeyFromFile()
    local layer = mk("TextButton", {Name="KeyGate", Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.4, ZIndex=300, Parent=Root})
    local w = math.clamp(viewport().X - 32, 320, 420)
    local box = mk("CanvasGroup", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), Size=UDim2.fromOffset(w,0), AutomaticSize=Enum.AutomaticSize.Y, GroupTransparency=1, ZIndex=301, Parent=layer})
    bind(box, "BackgroundColor3", "Bg") box.BackgroundTransparency = 0.1 round(box, 12) outline(box, "Stroke", 1, 0.2)
    local boxScale = mk("UIScale", {Scale=0.92, Parent=box})
    local col = mk("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=box})
    inset(col, 22, 22, 22, 22) stack(col, 10)

    tx("TextLabel", {Text=tostring(cfg.Title or "Key System"), TextSize=16, Font=Fonts[currentFont][3], Size=UDim2.new(1,0,0,22), TextTruncate=Enum.TextTruncate.AtEnd, LayoutOrder=1, ZIndex=302, Parent=col}, 3)
    tx("TextLabel", {Text=tostring(cfg.Subtitle or ""), TextSize=11, Size=UDim2.new(1,0,0,15), TextTruncate=Enum.TextTruncate.AtEnd, LayoutOrder=2, ZIndex=302, Parent=col}, 1, "Muted")

    local input = tx("TextBox", {Size=UDim2.new(1,0,0,36), LayoutOrder=3, PlaceholderText="Paste your key here...", Text=prefill or "", TextSize=12, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=302, Parent=col}, 2)
    bind(input, "BackgroundColor3", "Input") input.BackgroundTransparency = 0 round(input, 8) inset(input, 0, 12, 0, 12)
    local ring = outline(input, "Accent", 1.4, 0.5)
    input.Focused:Connect(function() play(ring, 0.15, {Transparency = 0.1}) end)
    input.FocusLost:Connect(function() play(ring, 0.2, {Transparency = 0.5}) end)

    local errLbl = tx("TextLabel", {Text="", TextSize=11, Size=UDim2.new(1,0,0,14), LayoutOrder=4, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=302, Parent=col}, 1)
    errLbl.TextColor3 = Status.Error errLbl.Visible = false

    local row = mk("Frame", {Size=UDim2.new(1,0,0,34), BackgroundTransparency=1, LayoutOrder=5, Parent=col})
    mk("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, HorizontalAlignment=Enum.HorizontalAlignment.Right, VerticalAlignment=Enum.VerticalAlignment.Center, Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder, Parent=row})

    local verifyBtn = tx("TextButton", {Text=tostring(cfg.ButtonText or "Verify"), TextSize=12, Font=Fonts[currentFont][3], Size=UDim2.fromOffset(96,32), LayoutOrder=2, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=302, Parent=row}, 3)
    bind(verifyBtn, "BackgroundColor3", "Accent") verifyBtn.BackgroundTransparency = 0 round(verifyBtn, 8) verifyBtn.TextColor3 = onAccent()

    if cfg.GetKey and (cfg.GetKeyURL or cfg.DiscordURL) then
        local getBtn = tx("TextButton", {Text=tostring(cfg.GetKeyText or "Get Key"), TextSize=12, Size=UDim2.fromOffset(96,32), LayoutOrder=1, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=302, Parent=row}, 2)
        bind(getBtn, "BackgroundColor3", "Input") getBtn.BackgroundTransparency = 0 round(getBtn, 8)
        getBtn.InputBegan:Connect(function(i)
            if not isPointer(i) then return end
            local url = cfg.GetKeyURL or cfg.DiscordURL
            if setclipboard then pcall(setclipboard, url) end
            Cactus:MakeNotification({Name="Link copied", Content=url, Type="Info", Time=3})
        end)
    end

    play(layer, 0.22, {BackgroundTransparency = 0.4}) fadeGroup(box, 0.28, 0) play(boxScale, 0.38, {Scale = 1}, Enum.EasingStyle.Quart)

    local verifying = false
    local function setError(msg)
        if msg then errLbl.Text = msg errLbl.Visible = true
        else errLbl.Visible = false end
    end
    local function doVerify()
        if verifying then return end
        local key = input.Text
        if key == nil or key == "" then setError("Please enter a key") shake(box) return end
        verifying = true
        setError(nil)
        verifyBtn.Text = "Verifying..."
        local origColor = verifyBtn.BackgroundColor3
        verifyBtn.BackgroundColor3 = Pal.Muted
        task.spawn(function()
            local ok = Cactus:_validateKey(key)
            if ok then
                Cactus._keyVerified = true
                if Cactus.KeyFile then Cactus:SaveKeyToFile(key) end
                task.wait(0.3)
                play(layer, 0.22, {BackgroundTransparency = 1})
                fadeGroup(box, 0.24, 1, Enum.EasingStyle.Quart)
                play(boxScale, 0.24, {Scale = 0.92}, Enum.EasingStyle.Quart)
                task.wait(0.28)
                layer:Destroy()
                if onSuccess then onSuccess() end
            else
                verifying = false
                verifyBtn.Text = tostring(cfg.ButtonText or "Verify")
                verifyBtn.BackgroundColor3 = origColor
                setError("Invalid key")
                shake(box)
            end
        end)
    end
    verifyBtn.InputBegan:Connect(function(i) if isPointer(i) then doVerify() end end)
    input.FocusLost:Connect(function(enter) if enter then doVerify() end end)
end

-- =========================================================
-- INIT
-- =========================================================
function Cactus:Init()
    if Cactus._ready then return end
    local window = Cactus.Windows[1] local cfg = window and window.Cfg or {}
    local function finish()
        if window then
            local has = false
            for _, t in ipairs(window.Tabs) do if t.Name == ALWAYS_NAME then has = true break end end
            if not has then
                local always = window:MakeTab({Name=ALWAYS_NAME, Icon=ALWAYS_ICON})
                populateAlwaysTab(always)
                local alwaysTab = nil
                for _, t in ipairs(window.Tabs) do if t.Name == ALWAYS_NAME then alwaysTab = t break end end
                if alwaysTab then
                    for i, t in ipairs(window.Tabs) do if t == alwaysTab then table.remove(window.Tabs, i) break end end
                    table.insert(window.Tabs, 1, alwaysTab)
                    for i, t in ipairs(window.Tabs) do t.Index = i if t.Button then t.Button.LayoutOrder = i end end
                    if alwaysTab.IconObj then alwaysTab.IconObj.Set(ALWAYS_ICON) end
                    window.Selected = nil
                    window:SelectTab(alwaysTab, true)
                end
            end
        end
        if Cactus.SaveConfig then local auto = Cactus:GetAutoload() Cactus:LoadProfile(auto or "default") end
        refreshTheme(false)
        for _, fn in ipairs(initFires) do task.spawn(pcall, fn) end table.clear(initFires)
        Cactus._ready = true
        if window and Cactus.AutoShow then window.Show() elseif window and Cactus.ShowLauncher then window.Launcher.Visible = true window.Launcher.BackgroundTransparency = 0 end
        startCactusAds()
    end
    local function afterLoading()
        if Cactus._keyCfg and not Cactus._keyVerified then
            if Cactus.KeyFile and Cactus.AutoVerify then
                local saved = Cactus:LoadKeyFromFile()
                if saved and saved ~= "" and Cactus:_validateKey(saved) then
                    Cactus._keyVerified = true
                    if Cactus._keyCfg.OnSuccess then pcall(Cactus._keyCfg.OnSuccess, saved) end
                end
            end
            if not Cactus._keyVerified then
                Cactus:_showKeyGate(function() finish() end)
                return
            end
        end
        finish()
    end
    loadingScreen(cfg, window and window.Name or "CactusLib", afterLoading)
end

function Cactus:Destroy()
    Cactus._ready = false Popup.close(true)
    if rainbowConn then rainbowConn:Disconnect() rainbowConn = nil end
    if noteLoop then noteLoop:Disconnect() noteLoop = nil end
    if adConn then pcall(function() task.cancel(adConn) end) adConn = nil end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end conns = {}
    for _, w in ipairs(Cactus.Windows) do pcall(function() w._parts.launcher:Destroy() end) end Cactus.Windows = {}
    if CactusBlur then CactusBlur:Destroy() CactusBlur = nil end
    pcall(function() Root:Destroy() end)
    if env.CactusLibInstance == Cactus then env.CactusLibInstance = nil end
end

return Cactus
