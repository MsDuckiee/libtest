-- NOTIFICATIONS
-- =========================================================
local Notes = {active={}, queue={}, byKey={}, queuedKey={}, max=4, duration=4, position="TopRight"}
local noteLayer = mk("Frame", {Name="Notifications", BackgroundTransparency=1, Size=UDim2.fromScale(1,1), ZIndex=100, Parent=Root})
local corners = {
    TopRight={ax=1,ay=0}, TopLeft={ax=0,ay=0}, TopCenter={ax=0.5,ay=0},
    BottomRight={ax=1,ay=1}, BottomLeft={ax=0,ay=1}, BottomCenter={ax=0.5,ay=1},
}
local noteLoop

local function noteWidth() return math.clamp(math.floor(viewport().X - 32), 280, 380) end
local function baseOrigin()
    local c = corners[Notes.position] or corners.TopRight
    local xOff = c.ax == 0.5 and 0 or (c.ax == 1 and -16 or 16)
    local yOff = c.ay == 0 and 16 or -16
    return c, xOff, yOff
end

local function layoutAll()
    local c, xOff, yOff = baseOrigin()
    for i, n in ipairs(Notes.active) do
        if n and n.frame and n.frame.Parent then
            local depth = i - 1
            local sc = math.max(0.9, 1 - depth * 0.04)
            local targetW = noteWidth() * sc
            local gap = 10
            local y
            if c.ay == 0 then y = yOff + depth * (n.height or 64) + depth * gap
            else y = yOff - depth * (n.height or 64) - depth * gap end
            local targetPos = UDim2.new(c.ax, xOff, c.ay, y)
            n.frame.ZIndex = 300 - depth
            n.popTarget = sc
            play(n.frame, 0.32, {Position = targetPos, Size = UDim2.fromOffset(targetW, n.height)}, Enum.EasingStyle.Quart)
            play(n.pop, 0.28, {Scale = sc}, Enum.EasingStyle.Quart)
            local dim = depth == 0 and 0 or math.min(0.5, depth * 0.15)
            fadeGroup(n.frame, 0.24, dim, Enum.EasingStyle.Quart)
        end
    end
end

local promoteQueue, spawnNote
promoteQueue = function()
    while #Notes.active < Notes.max and #Notes.queue > 0 do
        local entry = table.remove(Notes.queue, 1)
        Notes.queuedKey[entry.key] = nil
        spawnNote(entry)
    end
end

local function dismissNote(n)
    if not n or n.dying then return end
    n.dying = true
    for i, x in ipairs(Notes.active) do if x == n then table.remove(Notes.active, i) break end end
    if Notes.byKey[n.key] == n then Notes.byKey[n.key] = nil end
    if n.frame and n.frame.Parent then
        local c, _, _ = baseOrigin()
        local outX = c.ax == 1 and (noteWidth() + 90) or (c.ax == 0 and -(noteWidth() + 90) or 0)
        local target = outX ~= 0
            and UDim2.new(c.ax, (c.ax == 1 and -16 or 16) + outX, c.ay, (c.ay == 0 and 16 or -16))
            or n.frame.Position
        fadeGroup(n.frame, 0.26, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(n.frame, 0.26, {Position = target}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(n.pop, 0.24, {Scale = (n.popTarget or 1) * 0.95}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.34, function() if n.frame and n.frame.Parent then n.frame:Destroy() end end)
    end
    layoutAll()
    promoteQueue()
end

local function bumpNote(n, extra)
    if not n then return end
    n.count = (n.count or 0) + 1
    n.expires = os.clock() + (extra or n.time or Notes.duration)
    if n.pop then
        local base = n.popTarget or 1
        n.pop.Scale = base * 1.08
        play(n.pop, 0.34, {Scale = base}, Enum.EasingStyle.Quart)
    end
    if n.countLbl then
        n.countLbl.Text = "x" .. tostring(n.count)
        n.countLbl.Visible = n.count > 1
    end
    if n.bar then n.bar.Size = UDim2.new(1, 0, 0, 2) end
end

local function ensureNoteLoop()
    if noteLoop then return end
    noteLoop = RunService.Heartbeat:Connect(function(dt)
        local now = os.clock()
        for i = #Notes.active, 1, -1 do
            local n = Notes.active[i]
            if n and not n.dying and not n.sticky then
                if n.hover then n.expires = (n.expires or now) + dt end
                local left = (n.expires or now) - now
                if not n.custom and n.bar and n.bar.Parent and n.time and n.time > 0 then
                    n.bar.Size = UDim2.new(math.clamp(left / n.time, 0, 1), 0, 0, 2)
                end
                if left <= 0 then dismissNote(n) end
            end
        end
        if #Notes.active == 0 and noteLoop then
            noteLoop:Disconnect() noteLoop = nil
        end
    end)
end

spawnNote = function(entry)
    local cfg, handle = entry.cfg, entry.handle
    local color = Status[entry.kind]
    local w = noteWidth()
    local n = {
        key=entry.key, count=entry.count, handle=handle, height=64, slot=0,
        time=math.max(1, tonumber(cfg.Time) or Notes.duration),
        sticky=cfg.Sticky==true, spawned=false, hover=false,
    }
    n.expires = os.clock() + n.time
    local content = tostring(cfg.Content or "")

    local frame = mk("CanvasGroup", {
        Name="Note",
        Size=UDim2.fromOffset(w, n.height),
        GroupTransparency=1,
        BackgroundColor3=Pal.Surface,
        BackgroundTransparency=0,
        Parent=noteLayer,
    })
    round(frame, 10)
    bind(frame, "BackgroundColor3", "Surface")
    local frameStroke = mk("UIStroke", {Thickness=1, Transparency=0.5, Parent=frame})
    bind(frameStroke, "Color", "Stroke")
    frameStroke:SetAttribute("_baseTrans", 0.5)

    local frameScale = mk("UIScale", {Scale=1, Parent=frame})
    n.pop = frameScale

    -- left accent bar
    local accent = mk("Frame", {Size=UDim2.new(0,3,1,-16), Position=UDim2.fromOffset(0,8), BackgroundColor3=color, ZIndex=5, Parent=frame})
    round(accent, 2)

    local icon = makeIcon(frame, cfg.Icon or firstIcon(StatusIcons[entry.kind]) or "bell",
        16, false, {AnchorPoint=Vector2.new(0,0), Position=UDim2.fromOffset(15,14), ZIndex=5})
    n.iconImage = icon
    onTheme(function() icon.Color(color, false) end)

    local title = tx("TextLabel", {
        Text=tostring(cfg.Name or cfg.Title or "Notification"),
        TextSize=13, Font=Fonts[currentFont][3],
        Position=UDim2.fromOffset(40,10), Size=UDim2.new(1,-80,0,16),
        TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd,
        ZIndex=5, Parent=frame,
    }, 3)
    local body = tx("TextLabel", {
        Text=content, TextSize=12, Position=UDim2.fromOffset(40,28),
        Size=UDim2.new(1,-54,0,0), TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top,
        Visible=content ~= "", ZIndex=5, Parent=frame,
    }, 1, "Sub")
    bind(title, "TextColor3", "Text")
    bind(body, "TextColor3", "Sub")

    local closeBtn = mk("TextButton", {
        AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,-8,0,8),
        Size=UDim2.fromOffset(22,22), BackgroundTransparency=1, ZIndex=5, Parent=frame,
    })
    round(closeBtn, 5)
    local closeIcon = makeIcon(closeBtn, "x", 11, "Sub",
        {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=6})
    closeBtn.MouseEnter:Connect(function()
        play(closeBtn, 0.12, {BackgroundTransparency = 0.88})
        closeIcon.Color(Pal.Text, true)
    end)
    closeBtn.MouseLeave:Connect(function()
        play(closeBtn, 0.18, {BackgroundTransparency = 1})
        closeIcon.Color(Pal.Sub, true)
    end)
    closeBtn.Activated:Connect(function() dismissNote(n) end)

    local countLbl = tx("TextLabel", {
        Text="x"..tostring(n.count), TextSize=10,
        AnchorPoint=Vector2.new(1,0), Position=UDim2.new(1,-34,0,11),
        Size=UDim2.fromOffset(26,12), TextXAlignment=Enum.TextXAlignment.Right,
        TextColor3=color, ZIndex=6, Parent=frame, Visible=n.count > 1,
    }, 3)
    n.countLbl = countLbl

    n.bar = mk("Frame", {
        AnchorPoint=Vector2.new(0,1), Position=UDim2.fromScale(0,1),
        Size=UDim2.new(1,0,0,2), BackgroundColor3=color,
        BackgroundTransparency=0.1, Visible=not n.sticky, ZIndex=3, Parent=frame,
    })
    round(n.bar, 2)

    n.frame, n.title, n.body = frame, title, body

    frame.MouseEnter:Connect(function() n.hover = true end)
    frame.MouseLeave:Connect(function() n.hover = false end)

    task.defer(function()
        if n.dying or not frame.Parent then return end
        local topPad = 12
        local bodyH = 0
        if content ~= "" then
            local sz = measure(content, 12, Fonts[currentFont][1], Vector2.new(w - 54, 1000))
            bodyH = math.max(16, math.ceil(sz.Y))
            body.Size = UDim2.new(1, -54, 0, bodyH)
        end
        local total = topPad + 16 + (bodyH > 0 and (bodyH + 6) or 0) + topPad
        n.height = math.max(64, total)
        if n.spawned then layoutAll() end
    end)

    table.insert(Notes.active, 1, n)
    if entry.dedupe then Notes.byKey[n.key] = n end
    handle.n = n

    local c, xOff, _ = baseOrigin()
    local outX = c.ax == 1 and (noteWidth() + 100) or (c.ax == 0 and -(noteWidth() + 100) or 0)
    frame.AnchorPoint = Vector2.new(c.ax, c.ay)
    frame.Position = UDim2.new(c.ax, xOff + outX, c.ay, c.ay == 0 and 16 or -16)

    task.delay(0.02, function()
        if not n.dying and frame.Parent then
            n.spawned = true
            layoutAll()
        end
    end)

    ensureNoteLoop()
    return n
end

function Cactus:MakeNotification(cfg)
    if type(cfg) ~= "table" then cfg = {Content = tostring(cfg)} end
    local kind = Status[cfg.Type] and cfg.Type or "Info"
    local name = tostring(cfg.Name or cfg.Title or "Notification")
    local content = tostring(cfg.Content or "")
    local key = kind .. "|" .. name .. "|" .. content
    local dedupe = not cfg.Sticky
    if dedupe then
        local live = Notes.byKey[key]
        if live and not live.dying then bumpNote(live, tonumber(cfg.Time)) return live.handle end
        local waiting = Notes.queuedKey[key]
        if waiting then waiting.count = waiting.count + 1 return waiting.handle end
    end
    local handle = {}
    function handle:Dismiss() if handle.n then dismissNote(handle.n) end end
    function handle:SetTitle(t) if handle.n and handle.n.title then handle.n.title.Text = tostring(t) end end
    function handle:SetContent(t)
        if handle.n and handle.n.body then
            handle.n.body.Text = tostring(t)
            handle.n.body.Visible = tostring(t) ~= ""
        end
    end
    function handle:SetProgress(p)
        local n = handle.n
        if not n or not n.bar then return end
        n.custom = true n.bar.Visible = true
        play(n.bar, 0.16, {Size = UDim2.new(math.clamp(p, 0, 1), 0, 0, 2)})
    end
    local entry = {cfg=cfg, kind=kind, key=key, count=1, handle=handle, dedupe=dedupe}
    if #Notes.active >= Notes.max then
        Notes.queue[#Notes.queue + 1] = entry
        if dedupe then Notes.queuedKey[key] = entry end
    else
        spawnNote(entry)
    end
    return handle
end

function Cactus:Notify(cfg) return Cactus:MakeNotification(cfg) end
function Cactus:SetNotificationLimit(n) Notes.max = math.clamp(math.floor(tonumber(n) or 4), 1, 8) end
function Cactus:SetNotificationTime(s) Notes.duration = math.clamp(tonumber(s) or 4, 1, 30) end
function Cactus:SetNotificationPosition(name)
    if not corners[name] then return end
    Notes.position = name
    for _, n in ipairs(Notes.active) do
        if n.frame then
            local c = corners[name]
            n.frame.AnchorPoint = Vector2.new(c.ax, c.ay)
        end
    end
    layoutAll()
end
function Cactus:ClearNotifications()
    Notes.queue = {} Notes.queuedKey = {}
    for i = #Notes.active, 1, -1 do dismissNote(Notes.active[i]) end
end

