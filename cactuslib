local binds = {}
local fontObjs = setmetatable({}, {__mode = "k"})
local themeHooks, tweens = {}, setmetatable({}, {__mode = "k"})

local function play(obj, dur, props, style, dir)
    if not obj or not obj.Parent then return end
    local names = {}
    for k in pairs(props) do names[#names + 1] = k end
    table.sort(names)
    local key = table.concat(names, ",")
    local slot = tweens[obj] or {}
    tweens[obj] = slot
    if slot[key] then slot[key]:Cancel() end
    local info = TweenInfo.new(math.max(dur / animSpeed, 0.001), style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    local tw = TweenService:Create(obj, info, props)
    slot[key] = tw tw:Play()
    return tw
end

local function after(tw, fn)
    if not tw then return end
    local c
    c = tw.Completed:Connect(function(state)
        c:Disconnect()
        if state == Enum.PlaybackState.Completed then fn() end
    end)
end

local function fadeGroup(container, dur, target, style, dir)
    if not container or not container.Parent then return end
    local tw
    if container:IsA("CanvasGroup") then tw = play(container, dur, {GroupTransparency = target}, style, dir) end
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("UIStroke") then
            if d:GetAttribute("_baseTrans") == nil then d:SetAttribute("_baseTrans", d.Transparency) end
            local base = d:GetAttribute("_baseTrans")
            local newT = base + (1 - base) * target
            play(d, dur, {Transparency = newT}, style, dir)
        end
    end
    return tw
end

local function restoreGroup(container)
    if not container then return end
    if container:IsA("CanvasGroup") then container.GroupTransparency = 0 end
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("UIStroke") then
            local base = d:GetAttribute("_baseTrans")
            if base then d.Transparency = base end
        end
    end
end

local function mk(class, props, kids)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    if class == "TextButton" then inst.Text = "" inst.AutoButtonColor = false
    elseif class == "TextLabel" then inst.Text = "" end
    local parent
    if props then
        for k, v in pairs(props) do
            if k == "Parent" then parent = v else inst[k] = v end
        end
    end
    if kids then for _, c in ipairs(kids) do c.Parent = inst end end
    if parent then inst.Parent = parent end
    return inst
end

local function bind(obj, prop, key, fn)
    local list = binds[obj]
    if not list then list = {} binds[obj] = list end
    list[#list + 1] = {prop = prop, key = key, fn = fn}
    local v = Pal[key]
    if fn then v = fn(v, Pal) end
    if v ~= nil then pcall(function() obj[prop] = v end) end
    return obj
end

local function refreshTheme(animated, accentOnly)
    for _, hook in ipairs(themeHooks) do pcall(hook, animated) end
    local toRemove = {}
    for obj, list in pairs(binds) do
        if not obj.Parent then
            toRemove[#toRemove + 1] = obj
        else
            for _, rec in ipairs(list) do
                if not accentOnly or rec.key == "Accent" or rec.key == "Accent2" then
                    local v = Pal[rec.key]
                    if rec.fn then v = rec.fn(v, Pal) end
                    if v ~= nil then
                        if animated and typeof(v) == "Color3" then
                            play(obj, 0.3, {[rec.prop] = v})
                        else
                            pcall(function() obj[rec.prop] = v end)
                        end
                    end
                end
            end
        end
    end
    for _, obj in ipairs(toRemove) do binds[obj] = nil end
end

