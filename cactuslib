        local banned = {[Enum.KeyCode.Unknown]=true, [Enum.KeyCode.Return]=true, [Enum.KeyCode.Tab]=true}
        local function refresh() local t = obj.Binding and "..." or (obj.Value and keyText(obj.Value) or "None") chip.Text = t local w = math.max(50, #t * 7 + 20) play(chip, 0.22, {Size = UDim2.fromOffset(w, 24)}, Enum.EasingStyle.Quart) if kbVisible then kbRebuild() end end
        function obj:Set(k, silent) if typeof(k) == "string" then k = Enum.KeyCode[k] or Enum.UserInputType[k] or nil end local old = obj.Value obj.Value = k obj.Binding = false refresh() if not silent then queueSave() end if old ~= k and type(o.OnChange) == "function" then local ok, err = pcall(o.OnChange, k) if not ok then Cactus:MakeNotification({Name=label.." bind", Content=errorText(err), Type="Warning", Time=4}) end end end
        function obj:Get() return obj.Value end
        chip.InputBegan:Connect(function(input) if not isPointer(input) then return end if obj:IsLocked() then return end if activeBindCapture and activeBindCapture ~= obj then activeBindCapture.Binding = false end activeBindCapture = obj obj.Binding = true refresh() end)
        keep(UserInputService.InputBegan:Connect(function(input, gpe)
            if obj.Binding then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode == Enum.KeyCode.Escape then obj:Set(nil) activeBindCapture = nil
                    elseif not banned[input.KeyCode] then obj:Set(input.KeyCode) activeBindCapture = nil end
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                    obj:Set(input.UserInputType) activeBindCapture = nil
                end
                return
            end
            if gpe or not obj.Value or obj:IsLocked() then return end
            if input.KeyCode == obj.Value or input.UserInputType == obj.Value then
                task.spawn(function() local ok, err = pcall(o.Callback or function() end, true) if not ok then fail(c, label, err) end end)
            end
        end))
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v, true) if type(o.OnChange) == "function" then local ok, err = pcall(o.OnChange, obj.Value) if not ok then Cactus:MakeNotification({Name=label.." bind", Content=errorText(err), Type="Warning", Time=4}) end end end)
        decorate(obj, c, o, "Keybind")
        kbEntries[#kbEntries + 1] = {name=label, get=function() return obj.Value end}
        obj:Set(o.Default, true)
        return obj
    end
