local function populateHomeTab(tab)
    local Window = tab.Window or Cactus.Windows[1]
    if not Window then return end

    local profile = tab:AddSection({Name="Profile", Collapsible=false})
    local avatarRow = profile:AddAvatar({
        Name = LocalPlayer.DisplayName,
        Subtitle = "@"..LocalPlayer.Name.."  ·  v"..Cactus.Version,
        Image = (function()
            local ok, img = pcall(function()
                return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            end)
            return ok and img or nil
        end)(),
    })
    task.spawn(function()
        while avatarRow.Card.Parent do
            avatarRow:SetSubtitle("@"..LocalPlayer.Name.."  ·  "..Stat.session())
            task.wait(1)
        end
    end)

    local server = tab:AddSection({Name="Server", Collapsible=false})
    local playerPill = server:AddStatPill({Name="Players", Value="-"})
    local maxPill = server:AddStatPill({Name="Max", Value="-"})
    local latencyPill = server:AddStatPill({Name="Latency", Value="-"})
    local sessionPill = server:AddStatPill({Name="Session", Value="-"})
    server:AddButton({
        Name = "Rejoin", Icon = "download",
        Callback = function()
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end)
            if not ok then
                Cactus:MakeNotification({Name="Rejoin failed", Content="Teleport not permitted here.", Type="Warning"})
            end
        end,
    })
    local function refreshServer()
        playerPill:Set(#Players:GetPlayers())
        maxPill:Set(Players.MaxPlayers)
        sessionPill:Set(Stat.session())
    end
    keep(Players.PlayerAdded:Connect(refreshServer))
    keep(Players.PlayerRemoving:Connect(refreshServer))
    task.spawn(function()
        while server.Holder.Parent do
            refreshServer()
            latencyPill:Set(Metrics.ping.." ms")
            latencyPill:SetTone(Metrics.ping <= 90 and Status.Success or Metrics.ping <= 170 and Status.Warning or Status.Error)
            task.wait(1)
        end
    end)

    local wave = tab:AddSection({Name="Executor", Collapsible=false})
    local execName, execVer = Detect.executor()
    local supported = Detect.supportsScript()
    wave:AddStatPill({
        Name = "Status",
        Value = supported and "Supported" or "Limited",
        Tone = supported and Status.Success or Status.Warning,
    })
    wave:AddKeyValue({Name="Executor", Value = execName or "Unknown"})
    if execVer then wave:AddKeyValue({Name="Version", Value = execVer}) end

    local friends = tab:AddSection({Name="Friends", Collapsible=false})
    local inServerPill = friends:AddStatPill({Name="In Server", Value="-"})
    local offlinePill  = friends:AddStatPill({Name="Offline",  Value="-"})
    local onlinePill   = friends:AddStatPill({Name="Online",   Value="-"})
    local allPill      = friends:AddStatPill({Name="Total",    Value="-"})

    local listSec = tab:AddSection({Name="Friend list"})
    local listBox = listSec:AddTable({Headers={"Name","Status"}})
    local filterDropdown
    local function rebuild()
        local mode = filterDropdown and filterDropdown:Get() or "All"
        local rows = {}
        for _, f in ipairs(fetchFriends()) do
            local inThis = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.UserId == f.Id then inThis = true break end
            end
            local show = mode == "All"
                or (mode == "Online" and f.IsOnline)
                or (mode == "Offline" and not f.IsOnline)
                or (mode == "In Server" and inThis)
            if show then
                rows[#rows + 1] = {
                    f.DisplayName or f.Username,
                    inThis and "In Server" or (f.IsOnline and "Online" or "Offline"),
                }
            end
        end
        listBox:SetRows(rows)
    end
    filterDropdown = listSec:AddDropdown({
        Name = "Filter",
        Options = {"All", "Online", "Offline", "In Server"},
        Default = "All",
        Callback = function() rebuild() end,
    })
    task.spawn(function()
        local stats = Detect.friendStats()
        inServerPill:Set(#stats.inServer)
        offlinePill:Set(stats.offline)
        onlinePill:Set(stats.online)
        allPill:Set(stats.total)
        rebuild()
    end)
    keep(Players.PlayerAdded:Connect(rebuild))
    keep(Players.PlayerRemoving:Connect(rebuild))

    local about = tab:AddSection({Name="About"})
    local gameRow = about:AddKeyValue({Name="Game", Value="Loading..."})
    local creatorRow = about:AddKeyValue({Name="Creator", Value="..."})
    about:AddKeyValue({Name="Place ID", Value=tostring(game.PlaceId)})
    about:AddKeyValue({Name="Executor", Value=execName or "Unknown"})
    Stat.gameName(function(n) gameRow:Set(n) end)
    task.spawn(function()
        local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
        if ok and info and info.Creator then creatorRow:Set(info.Creator.Name) end
    end)
end

