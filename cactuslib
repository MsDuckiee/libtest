local Hud = {enabled=false, style="Modern", scale=1, clock24=true, seconds=true, items={FPS=true, Ping=true, Clock=true, Memory=false, Name=false}, title="CactusLib", chips={}, elapsed=0}
local hudOrder = {"Name","FPS","Ping","Memory","Clock"}
local hudFrame = mk("Frame", {Name="HUD", BackgroundTransparency=1, AutomaticSize=Enum.AutomaticSize.XY, Size=UDim2.new(), Position=UDim2.fromOffset(120,10), Visible=false, ZIndex=90, Parent=Root})
stack(hudFrame, 6, Enum.FillDirection.Horizontal) mk("UIScale", {Parent=hudFrame})
local function hudText(item)
    if item == "FPS" then return Metrics.fps .. " FPS"
    elseif item == "Ping" then return Metrics.ping .. " ms"
    elseif item == "Memory" then return Metrics.mem .. " MB"
    elseif item == "Name" then return Hud.title end
    local fmt = Hud.clock24 and (Hud.seconds and "%H:%M:%S" or "%H:%M") or (Hud.seconds and "%I:%M:%S %p" or "%I:%M %p")
    return os.date(fmt)
end
local function hudDotColor(item)
    if item == "FPS" then return Metrics.fps >= 50 and Status.Success or (Metrics.fps >= 30 and Status.Warning or Status.Error)
    elseif item == "Ping" then return Metrics.ping <= 90 and Status.Success or (Metrics.ping <= 170 and Status.Warning or Status.Error)
    elseif item == "Memory" then return Pal.Accent2 end
    return Pal.Accent
end
local function hudUpdate() for item, c in pairs(Hud.chips) do c.label.Text = hudText(item) if c.dot.Visible then c.dot.BackgroundColor3 = hudDotColor(item) end end end
local function hudBuild()
    for _, c in pairs(Hud.chips) do c.frame:Destroy() end Hud.chips = {}
    for i, item in ipairs(hudOrder) do
        if Hud.items[item] then
            local frame = mk("Frame", {AutomaticSize=Enum.AutomaticSize.XY, Size=UDim2.new(), LayoutOrder=i, Parent=hudFrame})
