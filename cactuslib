    -- DROPDOWN (rewritten: value label lives in an overlay that sits above the list)
    local function buildDropdown(o, multi)
        o = o or {} local label = tostring(o.Name or (multi and "Multi Select" or "Dropdown"))
        local c = card(rowH, true)

        -- Header row: label + value + arrow
        local header = mk("TextButton", {Size=UDim2.new(1,0,0,rowH), BackgroundTransparency=1, ZIndex=50, Parent=c})
        nameLabel(header, label, UDim2.new(0.42, 0, 1, 0))
        local valLbl = tx("TextLabel", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-36,0.5,0), Size=UDim2.new(0.55,-46,1,0), TextXAlignment=Enum.TextXAlignment.Right, TextTruncate=Enum.TextTruncate.AtEnd, TextSize=11, ZIndex=51, Parent=header}, 2, "Sub")
        local arrow = makeIcon(header, "chevron-down", 12, "Muted", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-14,0.5,0), ZIndex=51})
        arrow.Image.ZIndex = 51 arrow.Glyph.ZIndex = 51

        -- List panel (ZIndex 25, below header's 50)
        local listFrame = mk("CanvasGroup", {Name="List", Position=UDim2.fromOffset(6, rowH + 2), Size=UDim2.new(1,-12,0,0), BackgroundTransparency=0.04, ClipsDescendants=true, ZIndex=25, Parent=c, GroupTransparency=1})
        bind(listFrame, "BackgroundColor3", "Bg")
        round(listFrame, 6)
        outline(listFrame, "Stroke", 1, 0.5)
        local listScroll = mk("ScrollingFrame", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, ScrollBarThickness=3, ScrollBarImageTransparency=0.4, CanvasSize=UDim2.new(), AutomaticCanvasSize=Enum.AutomaticSize.Y, ScrollingDirection=Enum.ScrollingDirection.Y, ElasticBehavior=Enum.ElasticBehavior.Never, ZIndex=26, Parent=listFrame})
        bind(listScroll, "ScrollBarImageColor3", "Accent") stack(listScroll, 1) inset(listScroll, 4, 4, 4, 4)

        local obj = {Options=o.Options or {}, Value=multi and {} or nil, IsOpen=false}
        local firer local rows = {}

        local function selected(opt) if multi then return obj.Value[opt] == true end return obj.Value == opt end
        local function orderedSelection() local out = {} for _, opt in ipairs(obj.Options) do if obj.Value[opt] then out[#out + 1] = opt end end return out end
        local function summary()
            if multi then
                local list = orderedSelection()
                if #list == 0 then return "None" end
                if #list <= 2 then return table.concat(list, ", ") end
                return #list .. " selected"
            end
            return obj.Value ~= nil and tostring(obj.Value) or "None"
        end
        local function current() if multi then return orderedSelection() end return obj.Value end
        firer = makeFirer(function() if multi then return table.concat(orderedSelection(), "\0") end return obj.Value end, function() local ok, err = pcall(o.Callback or function() end, current()) if not ok then fail(c, label, err) end end)

        local function restyle()
            valLbl.Text = summary()
            for opt, r in pairs(rows) do
                if r.btn.Parent then
                    local on = selected(opt)
                    play(r.btn, 0.12, {BackgroundTransparency = on and 0.88 or 1})
                    if r.check then play(r.check, 0.12, {ImageTransparency = on and 0 or 1}) end
                    if r.glyph then r.glyph.TextTransparency = on and 0 or 1 end
                    r.label.TextColor3 = on and Pal.Text or Pal.Sub
                end
            end
        end

        local function layoutList()
            local visible = 0
            for _, r in pairs(rows) do if r.btn.Visible then visible = visible + 1 end end
            local h = math.min(visible * 30 + 6, 180)
            if obj.IsOpen then
                listFrame.GroupTransparency = 0
                play(listFrame, 0.24, {Size = UDim2.new(1,-12,0,h)}, Enum.EasingStyle.Quart)
            else
                play(listFrame, 0.18, {Size = UDim2.new(1,-12,0,0), GroupTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            end
            play(c, 0.24, {Size = UDim2.new(1,0,0,rowH + (obj.IsOpen and (h + 4) or 0))}, Enum.EasingStyle.Quart)
            play(arrow.Image, 0.2, {Rotation = obj.IsOpen and 180 or 0}, Enum.EasingStyle.Quart)
            play(arrow.Glyph, 0.2, {Rotation = obj.IsOpen and 180 or 0}, Enum.EasingStyle.Quart)
        end

        local function rebuildRows()
            for _, r in pairs(rows) do r.btn:Destroy() end rows = {}
            for i, opt in ipairs(obj.Options) do
                local b = mk("TextButton", {Size=UDim2.new(1,0,0,30), BackgroundColor3=Color3.new(1,1,1), BackgroundTransparency=1, LayoutOrder=i, ZIndex=27, Parent=listScroll})
                round(b, 4)
                local l = tx("TextLabel", {Text=tostring(opt), TextSize=11, Position=UDim2.fromOffset(10,0), Size=UDim2.new(1,-36,1,0), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=28, Parent=b}, 2, "Sub")
                local ck = makeIcon(b, "check", 12, "Accent", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-10,0.5,0), ZIndex=28})
                ck.Image.ZIndex = 28 ck.Glyph.ZIndex = 28
                ck.Image.ImageTransparency = selected(opt) and 0 or 1 ck.Glyph.TextTransparency = selected(opt) and 0 or 1
                rows[opt] = {btn=b, label=l, check=ck.Image, glyph=ck.Glyph}
                b.MouseEnter:Connect(function() if not selected(opt) then play(b, 0.12, {BackgroundTransparency = 0.9}) end end)
                b.MouseLeave:Connect(function() if not selected(opt) then play(b, 0.18, {BackgroundTransparency = 1}) end end)
                b.InputBegan:Connect(function(input)
                    if not isPointer(input) then return end
                    if multi then
                        obj.Value[opt] = (not obj.Value[opt]) or nil
                        restyle() firer.Fire() queueSave()
                    else
                        obj:Set(opt) obj:Toggle()
                    end
                end)
            end
            restyle()
        end

        function obj:Open() if obj.IsOpen or obj:IsLocked() then return end obj.IsOpen = true rebuildRows() layoutList() end
        function obj:Close() if not obj.IsOpen then return end obj.IsOpen = false layoutList() end
        function obj:Toggle() if obj.IsOpen then obj:Close() else obj:Open() end end
        function obj:Get() return current() end
        function obj:Set(v, silent)
            if multi then
                obj.Value = {}
                if type(v) == "table" then
                    for k, x in pairs(v) do if type(k) == "number" then obj.Value[x] = true elseif x then obj.Value[k] = true end end
                end
            else
                if v ~= nil and not table.find(obj.Options, v) then return end
                obj.Value = v
            end
            restyle()
            if silent then firer.Sync(multi and table.concat(orderedSelection(), "\0") or obj.Value)
            else firer.Fire() queueSave() end
        end
        function obj:Refresh(list, keepValue)
            obj.Options = list or {}
            if not keepValue then obj.Value = multi and {} or nil
            elseif not multi and obj.Value ~= nil and not table.find(obj.Options, obj.Value) then obj.Value = nil end
            if obj.IsOpen then rebuildRows() layoutList() end
            valLbl.Text = summary()
        end
        function obj:Add(opt) obj.Options[#obj.Options + 1] = opt end

        header.InputBegan:Connect(function(input) if isPointer(input) then obj:Toggle() end end)

        register(o.Flag, obj, o, current, function(v) obj:Set(v) end)
        decorate(obj, c, o, multi and "Multi Dropdown" or "Dropdown")
        if multi then obj:Set(o.Default or {}, true)
        else
            local first = o.Default
            if first == nil and o.AllowNone ~= true then first = obj.Options[1] end
            obj:Set(first, true)
        end
        valLbl.Text = summary()
        initFires[#initFires + 1] = function() firer.Fire() end
        return obj
    end
    function E:AddDropdown(o) return buildDropdown(o, false) end
    function E:AddMultiDropdown(o) return buildDropdown(o, true) end

