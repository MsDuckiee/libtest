    local top = mk("Frame", {Size=UDim2.new(1,0,0,42), BackgroundTransparency=1, LayoutOrder=1, ZIndex=182, Parent=box})
    makeIcon(top, SEARCH_ICON, 15, "Muted", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,14,0.5,0), ZIndex=183})
    local input = tx("TextBox", {Name="Input", Position=UDim2.fromOffset(38,0), Size=UDim2.new(1,-82,1,0), PlaceholderText="Search tabs, sections, settings...", TextSize=13, ZIndex=183, Parent=top}, 2)
    input.ClearTextOnFocus = false
    local hint = tx("TextLabel", {Text="ESC", TextSize=9, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-14,0.5,0), Size=UDim2.fromOffset(26,16), TextXAlignment=Enum.TextXAlignment.Center, BackgroundColor3=Pal.Input, BackgroundTransparency=0.4, ZIndex=183, Parent=top}, 2, "Muted")
    round(hint, 4)

    local line = mk("Frame", {Size=UDim2.new(1,0,0,1), LayoutOrder=2, ZIndex=182, Parent=box}) bind(line, "BackgroundColor3", "Divider")
    local list = mk("ScrollingFrame", {Size=UDim2.new(1,0,0,0), BackgroundTransparency=1, ScrollBarThickness=2, LayoutOrder=3, CanvasSize=UDim2.new(), AutomaticCanvasSize=Enum.AutomaticSize.Y, ZIndex=182, Parent=box})
    inset(list, 6, 6, 6, 6) stack(list, 1)

    local open = false local buttons = {} local picked = 1 local shown = {}
    local function highlight() for i, b in ipairs(buttons) do play(b, 0.1, {BackgroundTransparency = i == picked and 0.85 or 1}) end end
    local function render()
        for _, b in ipairs(buttons) do b:Destroy() end buttons = {} shown = {}
        local q = input.Text local scored = {}
        for _, e in ipairs(P.searchIndex) do local sc = fuzzy(q, e.name.." "..e.tab.." "..(e.section or "").." "..e.kind) if sc then scored[#scored + 1] = {e=e, s=sc} end end
        table.sort(scored, function(a, b) return a.s > b.s end)
        for i = 1, math.min(#scored, 30) do shown[i] = scored[i].e end
        for i, e in ipairs(shown) do
            local b = mk("TextButton", {Size=UDim2.new(1,0,0,38), BackgroundColor3=Color3.new(1,1,1), BackgroundTransparency=1, LayoutOrder=i, ZIndex=183, Parent=list})
            round(b, 5)
            tx("TextLabel", {Text=e.name, TextSize=12, Position=UDim2.fromOffset(10,4), Size=UDim2.new(1,-82,0,16), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=184, Parent=b}, 2)
            tx("TextLabel", {Text=e.tab..(e.section and (" › "..e.section) or ""), TextSize=10, Position=UDim2.fromOffset(10,21), Size=UDim2.new(1,-82,0,13), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=184, Parent=b}, 1, "Muted")
            tx("TextLabel", {Text=e.kind, TextSize=9, AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-10,0.5,0), Size=UDim2.fromOffset(60,14), TextXAlignment=Enum.TextXAlignment.Right, ZIndex=184, Parent=b}, 1, "Muted")
            b.InputBegan:Connect(function(input) if not isPointer(input) then return end Window:CloseSearch() task.delay(0.1, function() e.go() end) end)
            buttons[i] = b
        end
        picked = 1
        local targetH = math.min(math.max(#shown, 1) * 38 + 12, P.mobile and 180 or 300)
        play(list, 0.24, {Size = UDim2.new(1, 0, 0, targetH)}, Enum.EasingStyle.Quart)
        highlight()
    end
    input:GetPropertyChangedSignal("Text"):Connect(function() if open then render() end end)
    function Window:OpenSearch()
        if open then return end
        open = true Popup.close(true)
        for _, t in ipairs(Window.Tabs) do if t._EnsureBuilt then t:_EnsureBuilt() end end
        input.Text = "" layer.Visible = true render()
        play(layer, 0.24, {BackgroundTransparency = 0.55}, Enum.EasingStyle.Quart)
        fadeGroup(box, 0.28, 0, Enum.EasingStyle.Quart)
        play(boxScale, 0.42, {Scale = 1}, Enum.EasingStyle.Quart)
        if not P.mobile then task.delay(0.05, function() if open then input:CaptureFocus() end end) end
    end
    function Window:CloseSearch()
        if not open then return end
        open = false input:ReleaseFocus()
        play(layer, 0.2, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        fadeGroup(box, 0.22, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(boxScale, 0.22, {Scale = 0.94}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.26, function() if not open then layer.Visible = false restoreGroup(box) end end)
    end
    layer.InputBegan:Connect(function(input) if isPointer(input) then Window:CloseSearch() end end)
    box.Active = true
    input.FocusLost:Connect(function(enter) if enter and shown[picked] then local e = shown[picked] Window:CloseSearch() task.delay(0.1, function() e.go() end) end end)
    keep(UserInputService.InputBegan:Connect(function(i, gpe)
        if i.KeyCode == Enum.KeyCode.K and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
            if open then Window:CloseSearch() else Window:OpenSearch() end
            return
        end
        if not open then return end
        if i.KeyCode == Enum.KeyCode.Escape then Window:CloseSearch()
        elseif i.KeyCode == Enum.KeyCode.Down then picked = math.min(picked + 1, #shown) highlight()
        elseif i.KeyCode == Enum.KeyCode.Up then picked = math.max(picked - 1, 1) highlight() end
    end))
end

