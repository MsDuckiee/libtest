local ElementFactory
local TabImpl = {}

function TabImpl.make(Window, tcfg)
    local P = Window._parts
    tcfg = tcfg or {}
    local name = tostring(tcfg.Name or "Tab")
    local pendingBuilder = type(tcfg.Builder) == "function" and tcfg.Builder or nil
    local tabBuilt = false
    local Tab = {Name=name, Sections={}, Window=Window}
    local index = #Window.Tabs + 1
    Tab.Index = index

    local btn = mk("TextButton", {Name="Tab_"..name, Size=UDim2.new(1,0,0,34), BackgroundTransparency=1, LayoutOrder=index, ZIndex=17, Parent=P.tabScroll})
    round(btn, 6) Tab.Button = btn
    local activeBar = mk("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,0,0.5,0), Size=UDim2.fromOffset(2,0), BackgroundColor3=Pal.Accent, ZIndex=19, Parent=btn})
    round(activeBar, 1)
    local ico = makeIcon(btn, tcfg.Icon or "chevron-right", 15, "Muted", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,12,0.5,0), ZIndex=18}) ico.Image.ZIndex = 18 ico.Glyph.ZIndex = 18 Tab.IconObj = ico
    local tabLabel = tx("TextLabel", {Text=name, TextSize=12, Position=UDim2.new(0,36,0,0), Size=UDim2.new(1,0,1,0), TextXAlignment=Enum.TextXAlignment.Left, ZIndex=18, Parent=btn}, 2) Tab.Label = tabLabel
    function Tab:SetIcon(id) ico.Set(id) end

    local page = mk("CanvasGroup", {Name="Page_"..name, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, GroupTransparency=1, Visible=false, ZIndex=23, Parent=P.content})
    local scroll = mk("ScrollingFrame", {Name="Scroll", Size=UDim2.fromScale(1,1), BackgroundTransparency=1, ScrollBarThickness=4, ScrollBarImageTransparency=0.4, CanvasSize=UDim2.new(), AutomaticCanvasSize=Enum.AutomaticSize.Y, ScrollingDirection=Enum.ScrollingDirection.Y, ElasticBehavior=Enum.ElasticBehavior.Never, ZIndex=23, Parent=page})
    bind(scroll, "ScrollBarImageColor3", "Stroke") inset(scroll, 18, 18, 18, 18) stack(scroll, 10)
    Tab.Page, Tab.Scroll = page, scroll
    local scrollMemory = 0 Tab.Remember = function() scrollMemory = scroll.CanvasPosition.Y end Tab.Restore = function() scroll.CanvasPosition = Vector2.new(0, scrollMemory) end
    Window.Tabs[index] = Tab

    btn.MouseEnter:Connect(function()
        if Window.Selected ~= Tab then
            play(btn, 0.15, {BackgroundTransparency = 0.9})
            ico.Color(Pal.Text) tabLabel.TextColor3 = Pal.Text
        end
    end)
    btn.MouseLeave:Connect(function()
        if Window.Selected ~= Tab then
            play(btn, 0.2, {BackgroundTransparency = 1})
            ico.Color(Pal.Muted) tabLabel.TextColor3 = Pal.Muted
        end
    end)
    btn.InputBegan:Connect(function(i) if isPointer(i) then Window:SelectTab(Tab) end end)

    if #Window.Tabs == 1 then task.defer(function() task.wait() Window:SelectTab(Tab, true) end) end

    local tabApi = ElementFactory(Window, Tab, scroll, nil)
    tabApi.Window = Window tabApi.Tab = Tab

    function Tab:_EnsureBuilt() if tabBuilt then return end tabBuilt = true if pendingBuilder then pcall(pendingBuilder, tabApi) end end
    function tabApi:AddSubTab(subName) return tabApi:AddSection({Name=tostring(subName or "Tab")}) end

    function tabApi:AddSection(sc)
        sc = type(sc) == "table" and sc or {Name = sc}
        local secName = tostring(sc.Name or "Section")
        local holder = mk("Frame", {Name="Section_"..secName, Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, LayoutOrder=#Tab.Sections + 1, ZIndex=23, Parent=scroll})
        stack(holder, 6)
        local head = mk("TextButton", {Size=UDim2.new(1,0,0,28), BackgroundTransparency=1, LayoutOrder=0, ZIndex=24, Parent=holder})
        local secLabel = tx("TextLabel", {Text=string.upper(secName), TextSize=10, Font=Fonts[currentFont][3], Position=UDim2.fromOffset(4,0), Size=UDim2.new(1,-30,1,0), ZIndex=25, Parent=head}, 3, "Muted")
        local chev = makeIcon(head, "chevron-down", 12, "Muted", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-4,0.5,0), ZIndex=25}) chev.Image.ZIndex = 25 chev.Glyph.ZIndex = 25
        local bodyClip = mk("Frame", {Name="Body", Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, LayoutOrder=1, ZIndex=24, Parent=holder})
        stack(bodyClip, 6)
        local section = ElementFactory(Window, Tab, bodyClip, secName) section.Holder = holder Tab.Sections[#Tab.Sections + 1] = section

        local collapsed = false local fullSize = 0 local collapseTween
        local function setCollapsed(state)
            if collapsed == state then return end
            collapsed = state Popup.close(true) if collapseTween then collapseTween:Cancel() end
            if state then
                fullSize = bodyClip.AbsoluteSize.Y / math.max(currentScale, 0.01)
                bodyClip.AutomaticSize = Enum.AutomaticSize.None bodyClip.ClipsDescendants = true bodyClip.Size = UDim2.new(1, 0, 0, fullSize)
                collapseTween = play(bodyClip, 0.28, {Size = UDim2.new(1, 0, 0, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
                play(chev.Image, 0.2, {Rotation = -90}) play(chev.Glyph, 0.2, {Rotation = -90})
            else
                play(chev.Image, 0.2, {Rotation = 0}) play(chev.Glyph, 0.2, {Rotation = 0})
                local target = fullSize bodyClip.Size = UDim2.new(1, 0, 0, 0) bodyClip.AutomaticSize = Enum.AutomaticSize.Y
                task.defer(function()
                    if collapsed then return end
                    local measured = bodyClip.AbsoluteSize.Y / math.max(currentScale, 0.01)
                    if measured > 0 then target = measured end
                    bodyClip.AutomaticSize = Enum.AutomaticSize.None bodyClip.ClipsDescendants = true
                    collapseTween = play(bodyClip, 0.3, {Size = UDim2.new(1, 0, 0, target)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
                    after(collapseTween, function() if not collapsed then bodyClip.AutomaticSize = Enum.AutomaticSize.Y bodyClip.ClipsDescendants = false end end)
                end)
            end
        end
        head.InputBegan:Connect(function(i) if not isPointer(i) then return end if sc.Collapsible == false then return end setCollapsed(not collapsed) end)
        head.MouseEnter:Connect(function() secLabel.TextColor3 = Pal.Sub end)
        head.MouseLeave:Connect(function() secLabel.TextColor3 = Pal.Muted end)
        if sc.Collapsible == false then chev.Holder.Visible = false end
        if sc.Collapsed then task.defer(function() setCollapsed(true) end) end
        function section:SetName(n) secLabel.Text = string.upper(tostring(n)) end
        function section:Collapse(state) setCollapsed(state ~= false) end
        function section:IsCollapsed() return collapsed end
        return section
    end

    function tabApi:SetAllCollapsed(state) state = state ~= false for _, sec in ipairs(Tab.Sections) do if sec.Collapse then pcall(sec.Collapse, state) end end end
    function tabApi:CollapseAll() tabApi:SetAllCollapsed(true) end
    function tabApi:ExpandAll() tabApi:SetAllCollapsed(false) end

    return tabApi
end

local function flipTabs(Window, from, to, forward)
    local P = Window._parts local dir = forward and 1 or -1 local contentW = P.content.AbsoluteSize.X
    if from and from ~= to then
        from.Remember() local outPage = from.Page
        outPage.Visible = true outPage.Position = UDim2.fromOffset(0, 0) outPage.GroupTransparency = 0
        play(outPage, 0.3, {Position = UDim2.fromOffset(-contentW * dir, 0)}, Enum.EasingStyle.Quart)
        play(outPage, 0.24, {GroupTransparency = 1}, Enum.EasingStyle.Quart)
        task.delay(0.32, function() if Window.Selected ~= from then outPage.Visible = false outPage.Position = UDim2.fromOffset(0, 0) outPage.GroupTransparency = 1 end end)
    end
    local inPage = to.Page inPage.Visible = true inPage.GroupTransparency = 1 inPage.Position = UDim2.fromOffset(contentW * dir, 0)
    to.Restore()
    play(inPage, 0.38, {Position = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quart)
    play(inPage, 0.3, {GroupTransparency = 0}, Enum.EasingStyle.Quart)
end

function TabImpl.select(Window, target, instant)
    if type(target) == "number" then target = Window.Tabs[target] end
    if type(target) == "string" then for _, t in ipairs(Window.Tabs) do if t.Name == target then target = t break end end end
    if type(target) ~= "table" or not target.Button then return end
    local prev = Window.Selected if prev == target then return end
    Popup.close(true) Window.Selected = target if target._EnsureBuilt then target:_EnsureBuilt() end
    local forward = not prev or target.Index > prev.Index
    if instant or not prev then
        for _, t in ipairs(Window.Tabs) do
            t.Page.Visible = t == target
            t.Page.GroupTransparency = t == target and 0 or 1
            t.Page.Position = UDim2.fromOffset(0, 0)
        end
        if target.Restore then target.Restore() end
    else flipTabs(Window, prev, target, forward) end
    for _, t in ipairs(Window.Tabs) do
        local active = t == target
        t.IconObj.Color(active and Pal.Accent or Pal.Muted, not instant)
        if t.Label then t.Label.TextColor3 = active and Pal.Text or Pal.Muted end
        local bar = t.Button:FindFirstChildOfClass("Frame")
        if bar then play(bar, 0.25, {Size = UDim2.fromOffset(2, active and 16 or 0)}, Enum.EasingStyle.Quart) end
        if active then t.Button.BackgroundColor3 = Pal.Surface t.Button.BackgroundTransparency = 0.5
        else play(t.Button, 0.2, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart) end
    end
    if Window.OnTabChanged then task.spawn(Window.OnTabChanged, target) end
end

