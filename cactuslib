local function numFormat(v, step, suffix)
    local s
    if step < 1 then
        local frac = (tostring(step):gsub("^0%.", ""))
        local places = math.min(3, math.max(1, #frac))
        s = string.format("%."..places.."f", v)
        s = (s:gsub("0+$", "")) s = (s:gsub("%.$", ""))
    else s = tostring(math.floor(v + 0.5)) end
    if suffix and suffix ~= "" then return s.." "..suffix end return s
end
local function snapTo(v, step, min) if step <= 0 then return v end return min + math.floor((v - min) / step + 0.5) * step end
local function toneColor(name)
    if name == nil then return Pal.Accent end
    if typeof(name) == "Color3" then return name end
    if type(name) == "string" then if Pal[name] then return Pal[name] end if Status[name] then return Status[name] end end
    return Pal.Accent
end

ElementFactory = function(Window, Tab, parent, sectionName)
    local P = Window._parts local mobile = P.mobile local E = {_count = 0} local rowH = mobile and 42 or 40

    local function card(height, hover)
        local c = mk("TextButton", {Size=UDim2.new(1,0,0,height or rowH), BackgroundTransparency=0.42, ZIndex=24, LayoutOrder=E._count + 1, Parent=parent})
        bind(c, "BackgroundColor3", "Surface") round(c, 7) outline(c, "Stroke", 1, 0.6)
        return c
    end

    local function nameLabel(c, text, width) return tx("TextLabel", {Name="Name", Text=tostring(text), TextSize=12, Position=UDim2.fromOffset(14,0), Size=width or UDim2.new(1,-90,1,0), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=25, Parent=c}, 2) end

    local function decorate(obj, c, opts, kind)
        E._count = E._count + 1
        local locked = false
        local veil = mk("Frame", {Name="Lock", Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.5, Visible=false, ZIndex=40, Parent=c}) round(veil, 7)
        makeIcon(veil, "lock", 14, "Muted", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=41})
        function obj:Lock(v) if v == nil then v = true end locked = v and true or false veil.Visible = locked end
        function obj:IsLocked() return locked end
        function obj:SetVisible(v) c.Visible = v and true or false end
        function obj:Destroy() c:Destroy() for i, e in ipairs(P.searchIndex) do if e.owner == obj then table.remove(P.searchIndex, i) break end end end
        function obj:SetName(n) local l = c:FindFirstChild("Name") if l then l.Text = tostring(n) end end
        obj.Card = c obj.Kind = kind
        if opts.Locked then obj:Lock(true) end
        if opts.Visible == false then c.Visible = false end
        P.searchIndex[#P.searchIndex + 1] = {
            owner=obj, name=tostring(opts.Name or kind), tab=Tab.Name, section=sectionName, kind=kind,
            go = function()
                if Window.RequestOpen then Window.RequestOpen() end
                local alreadyOn = (Window.Selected == Tab)
                if not alreadyOn then task.wait(0.06) Window:SelectTab(Tab) end
                task.delay(alreadyOn and 0.05 or 0.28, function()
                    if not c.Parent then return end
                    local sc = Tab.Scroll
                    local y = c.AbsolutePosition.Y - sc.AbsolutePosition.Y + sc.CanvasPosition.Y - 10
                    play(sc, 0.4, {CanvasPosition = Vector2.new(0, math.max(0, y))}, Enum.EasingStyle.Quart)
                    task.delay(0.2, function() if c.Parent then flashCard(c, Pal.Accent, 1.1) end end)
                end)
            end,
        }
        return obj
    end
    local function register(flag, obj, opts, get, set) if not flag then return end registerFlag(flag, {get=get, set=set, save=opts.Save==true, obj=obj}) Cactus.Flags[flag] = obj end
    local function fail(c, label, err) flashCard(c, Status.Error, 1.0) shake(c) Cactus:MakeNotification({Name=(label or "Action").." failed", Content=errorText(err), Type="Error", Time=5}) end

    function E:AddLabel(o)
        o = type(o) == "table" and o or {Name = o}
        local c = card(rowH - 6, false) c.Active = false
        local l = nameLabel(c, o.Name or "", UDim2.new(1, -28, 1, 0)) bind(l, "TextColor3", "Sub")
        local obj = {} function obj:Set(t) l.Text = tostring(t) end function obj:Get() return l.Text end
        return decorate(obj, c, o, "Label")
    end

    function E:AddParagraph(o)
        o = o or {}
        local c = card(0, false) c.AutomaticSize = Enum.AutomaticSize.Y c.Size = UDim2.new(1, 0, 0, 0) c.Active = false
        inset(c, 12, 14, 12, 14)
        local col = mk("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, ZIndex=25, Parent=c}) stack(col, 3)
        tx("TextLabel", {Text=tostring(o.Title or o.Name or "Note"), TextSize=13, Font=Fonts[currentFont][3], Size=UDim2.new(1,0,0,17), TextTruncate=Enum.TextTruncate.AtEnd, TextXAlignment=Enum.TextXAlignment.Left, LayoutOrder=1, ZIndex=25, Parent=col}, 3)
        local text = tx("TextLabel", {Text=tostring(o.Content or ""), TextSize=12, TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, LineHeight=1.2, Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, LayoutOrder=2, ZIndex=25, Parent=col}, 1, "Sub")
        local obj = {} function obj:Set(t) text.Text = tostring(t) end function obj:Get() return text.Text end
        return decorate(obj, c, o, "Paragraph")
    end

    function E:AddButton(o)
        o = o or {} local label = tostring(o.Name or "Button") local isPrimary = o.Primary == true
        local c = card(rowH, true)
        local icon = makeIcon(c, o.Icon or "chevron-right", 15, isPrimary and "Text" or "Muted", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-14,0.5,0), ZIndex=30}) icon.Image.ZIndex = 30 icon.Glyph.ZIndex = 30 c.ClipsDescendants = false
        local nameLbl = nameLabel(c, label, UDim2.new(1, -60, 1, 0)) nameLbl.Position = UDim2.fromOffset(14, 0)
        if isPrimary then
            c.BackgroundTransparency = 0
            local grad = mk("UIGradient", {Rotation = 20, Parent = c})
            grad.Color = ColorSequence.new(Pal.Accent, Pal.Accent2)
            bind(grad, "Color", "Accent", function(_, p) return ColorSequence.new(p.Accent, p.Accent2) end)
            nameLbl.TextColor3 = onAccent()
            bind(nameLbl, "TextColor3", "Accent", function() return onAccent() end)
            icon.Color(onAccent())
        end
        local obj = {} local running = false
        function obj:Fire(...)
            if obj:IsLocked() or running then if running then shake(c) end return false end
            running = true
            local sc = c:FindFirstChildOfClass("UIScale") or mk("UIScale", {Scale=1, Parent=c})
            play(c, 0.07, {BackgroundTransparency = isPrimary and 0.06 or 0.28})
            play(sc, 0.08, {Scale = 0.985})
            task.delay(0.08, function()
                play(c, 0.22, {BackgroundTransparency = isPrimary and 0 or 0.42})
                play(sc, 0.28, {Scale = 1}, Enum.EasingStyle.Quart)
            end)
            local args = table.pack(...)
            task.spawn(function()
                local cb = o.Callback
                if type(cb) ~= "function" then running = false fail(c, label, "no callback attached") return end
                local ok, err = pcall(cb, table.unpack(args, 1, args.n))
                running = false
                if not ok then if type(o.OnError) == "function" then pcall(o.OnError, err, label) end fail(c, label, err)
                else flashCard(c, isPrimary and Pal.Accent2 or Status.Success, 0.4) end
            end)
            return true
        end
