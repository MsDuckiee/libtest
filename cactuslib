function Cactus:SetKeySystem(cfg)
    cfg = cfg or {}
    cfg.Title = cfg.Title or "Key System"
    cfg.Subtitle = cfg.Subtitle or "Enter your key to continue"
    cfg.ButtonText = cfg.ButtonText or "Verify"
    cfg.GetKeyText = cfg.GetKeyText or "Get Key"
    cfg.Icon = cfg.Icon or "key"
    if cfg.KeyFile ~= nil then Cactus.KeyFile = cfg.KeyFile == true end
    if cfg.KeyFileName then Cactus.KeyFileName = tostring(cfg.KeyFileName) end
    if cfg.AutoVerify ~= nil then Cactus.AutoVerify = cfg.AutoVerify ~= false end
    Cactus._keyCfg = cfg
end

local function keyFSReady()
    return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" and type(makefolder) == "function" and type(isfolder) == "function"
end
function Cactus:_keyFolder() return Cactus.Folder .. "/keys" end
function Cactus:_keyPath() return Cactus:_keyFolder() .. "/" .. tostring(Cactus.KeyFileName or "key") .. ".key" end
function Cactus:SaveKeyToFile(key)
    if not keyFSReady() or key == nil or key == "" then return false end
    return pcall(function() if not isfolder(Cactus:_keyFolder()) then makefolder(Cactus:_keyFolder()) end writefile(Cactus:_keyPath(), tostring(key)) end)
end
function Cactus:LoadKeyFromFile()
    if not keyFSReady() then return nil end
    local path = Cactus:_keyPath()
    local ok, data = pcall(function() if not isfile(path) then return nil end return readfile(path) end)
    if ok and data and data ~= "" then return data end
    return nil
end
function Cactus:_validateKey(key)
    local cfg = Cactus._keyCfg or {}
    if type(cfg.Validate) == "function" then
        local ok, r = pcall(cfg.Validate, key)
        return ok and r == true
    elseif cfg.Key ~= nil then
        return tostring(key) == tostring(cfg.Key)
    end
    return true
end
function Cactus:_showKeyGate(onSuccess)
    local cfg = Cactus._keyCfg or {}
    local prefill = Cactus:LoadKeyFromFile()
    local layer = mk("TextButton", {Name="KeyGate", Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.35, ZIndex=300, Parent=Root})
    local w = math.clamp(viewport().X - 32, 300, 400)
