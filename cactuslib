            Hud.chips[item] = {frame=frame, label=label}
        end
    end
    hudUpdate()
end
function Hud.set(on)
    Hud.enabled = on and true or false
    hudFrame.Visible = Hud.enabled
    if Hud.enabled then hudBuild() end
end
keep(RunService.Heartbeat:Connect(function(dt)
    if not Hud.enabled then return end
    Hud.elapsed = Hud.elapsed + dt
    if Hud.elapsed >= 0.25 then Hud.elapsed = 0 hudUpdate() end
end))
