        valBox.FocusLost:Connect(function() local n = tonumber(valBox.Text:match("-?%d+%.?%d*")) if n then obj:Set(n) else valBox.Text = numFormat(obj.Value, step, suffix) end end)
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Slider")
        valBox.Text = numFormat(value, step, suffix) draw(fracOf(value))
        initFires[#initFires + 1] = function() firer.Fire() end
