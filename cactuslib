local ElementFactory
local TabImpl = {}

function TabImpl.make(Window, tcfg)
    local P = Window._parts
    local mobile = P.mobile
    tcfg = tcfg or {}
    local name = tostring(tcfg.Name or "Tab")
    local pendingBuilder = type(tcfg.Builder) == "function" and tcfg.Builder or nil
    local tabBuilt = false
    local Tab = {Name=name, Sections={}, Window=Window, SubTabs={}}
    local index = #Window.Tabs + 1
    Tab.Index = index

    -- Active tab uses accent underline; inactive is subtle text
    local measureW = measure(name, 13, Fonts[currentFont][2], Vector2.new(400, 100))
    local tabW = math.max(60, math.ceil(measureW.X) + 20)
    local btn = mk("TextButton", {Name="Tab_"..name, Size=UDim2.fromOffset(tabW, P.tabBarH), BackgroundColor3=Color3.new(1,1,1), BackgroundTransparency=1, LayoutOrder=index, ZIndex=25, Parent=P.tabScroll})
    Tab.Button = btn
    local underline = mk("Frame", {AnchorPoint=Vector2.new(0.5,1), Position=UDim2.new(0.5,0,1,-1), Size=UDim2.fromOffset(tabW - 20, 2), BackgroundColor3=Pal.Accent, BackgroundTransparency=1, ZIndex=26, Parent=btn})
    round(underline, 1)
    Tab.Underline = underline
    local ico = makeIcon(btn, tcfg.Icon or name, 13, "Sub", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,8,0.5,0), ZIndex=26})
    ico.Image.ZIndex = 26 ico.Glyph.ZIndex = 26
    Tab.IconObj = ico
    local tabLabel = tx("TextLabel", {Text=name, TextSize=12, Position=UDim2.new(0,26,0,0), Size=UDim2.new(1,-32,1,0), TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center, ZIndex=26, Parent=btn}, 2)
    Tab.Label = tabLabel
    function Tab:SetIcon(id) ico.Set(id) end

    local page = mk("CanvasGroup", {Name="Page_"..name, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, GroupTransparency=1, Visible=false, ZIndex=23, Parent=P.content})
    local scroll = mk("ScrollingFrame", {Name="Scroll", Size=UDim2.fromScale(1,1), BackgroundTransparency=1, ScrollBarThickness=mobile and 2 or 3, ScrollBarImageTransparency=0.5, CanvasSize=UDim2.new(), AutomaticCanvasSize=Enum.AutomaticSize.Y, ScrollingDirection=Enum.ScrollingDirection.Y, ElasticBehavior=Enum.ElasticBehavior.Never, ZIndex=23, Parent=page})
    bind(scroll, "ScrollBarImageColor3", "Stroke")
    inset(scroll, 16, 16, 16, 16)
    stack(scroll, 12)
    Tab.Page, Tab.Scroll = page, scroll
    local scrollMemory = 0
    Tab.Remember = function() scrollMemory = scroll.CanvasPosition.Y end
    Tab.Restore = function() scroll.CanvasPosition = Vector2.new(0, scrollMemory) end
    Window.Tabs[index] = Tab

    btn.MouseEnter:Connect(function()
        if Window.Selected ~= Tab then
            tabLabel.TextColor3 = Pal.Text
            ico.Color(Pal.Text, true)
        end
    end)
    btn.MouseLeave:Connect(function()
        if Window.Selected ~= Tab then
            tabLabel.TextColor3 = Pal.Sub
            ico.Color(Pal.Sub, true)
        end
    end)
    btn.InputBegan:Connect(function(i)
        if isPointer(i) then
            Window:SelectTab(Tab)
            local target = btn.AbsolutePosition.X - P.tabScroll.AbsolutePosition.X + P.tabScroll.CanvasPosition.X - 60
            play(P.tabScroll, 0.28, {CanvasPosition = Vector2.new(math.max(0, target), 0)}, Enum.EasingStyle.Quart)
        end
    end)

    if #Window.Tabs == 1 then task.defer(function() task.wait() Window:SelectTab(Tab, true) end) end

    local tabApi = ElementFactory(Window, Tab, scroll, nil)
    tabApi.Window = Window
    tabApi.Tab = Tab

    function Tab:_EnsureBuilt()
        if tabBuilt then return end
        tabBuilt = true
        if pendingBuilder then pcall(pendingBuilder, tabApi) end
    end
    function tabApi:AddSubTab(subName) return tabApi:AddSection({Name=tostring(subName or "Tab")}) end

    function tabApi:AddSection(sc)
        sc = type(sc) == "table" and sc or {Name = sc}
        local secName = tostring(sc.Name or "Section")
        local holder = mk("Frame", {Name="Section_"..secName, Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, LayoutOrder=#Tab.Sections + 1, ZIndex=23, Parent=scroll})
        stack(holder, 8)
        local head = mk("TextButton", {Size=UDim2.new(1,0,0,mobile and 28 or 26), BackgroundTransparency=1, LayoutOrder=0, ZIndex=24, Parent=holder})
        local secLabel = tx("TextLabel", {Text=string.upper(secName), TextSize=11, Position=UDim2.fromOffset(4,0), Size=UDim2.new(1,-70,1,0), ZIndex=25, Parent=head}, 3, "Sub")
        local chev = makeIcon(head, "chevron-down", 12, "Sub", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-4,0.5,0), ZIndex=25})
        chev.Image.ZIndex = 25 chev.Glyph.ZIndex = 25
        local bodyClip = mk("Frame", {Name="Body", Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, LayoutOrder=1, ZIndex=24, Parent=holder})
        stack(bodyClip, 6)
        local section = ElementFactory(Window, Tab, bodyClip, secName)
        section.Holder = holder
        Tab.Sections[#Tab.Sections + 1] = section

        local collapsed = false
        local fullSize = 0
        local collapseTween
        local function setCollapsed(state)
            if collapsed == state then return end
            collapsed = state
            Popup.close(true)
            if collapseTween then collapseTween:Cancel() end
            if state then
                fullSize = bodyClip.AbsoluteSize.Y / math.max(currentScale, 0.01)
                bodyClip.AutomaticSize = Enum.AutomaticSize.None
                bodyClip.ClipsDescendants = true
                bodyClip.Size = UDim2.new(1, 0, 0, fullSize)
                collapseTween = play(bodyClip, 0.28, {Size = UDim2.new(1, 0, 0, 0)}, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
                play(chev.Image, 0.22, {Rotation = -90})
                play(chev.Glyph, 0.22, {Rotation = -90})
            else
                play(chev.Image, 0.22, {Rotation = 0})
                play(chev.Glyph, 0.22, {Rotation = 0})
                local target = fullSize
                bodyClip.Size = UDim2.new(1, 0, 0, 0)
                bodyClip.AutomaticSize = Enum.AutomaticSize.Y
                task.defer(function()
                    if collapsed then return end
                    local measured = bodyClip.AbsoluteSize.Y / math.max(currentScale, 0.01)
                    if measured > 0 then target = measured end
                    bodyClip.AutomaticSize = Enum.AutomaticSize.None
                    bodyClip.ClipsDescendants = true
                    collapseTween = play(bodyClip, 0.3, {Size = UDim2.new(1, 0, 0, target)}, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
                    after(collapseTween, function()
                        if not collapsed then
                            bodyClip.AutomaticSize = Enum.AutomaticSize.Y
                            bodyClip.ClipsDescendants = false
                        end
                    end)
                end)
            end
        end
        head.InputBegan:Connect(function(i)
            if not isPointer(i) then return end
            if sc.Collapsible == false then return end
            setCollapsed(not collapsed)
        end)
        head.MouseEnter:Connect(function() secLabel.TextColor3 = Pal.Text end)
        head.MouseLeave:Connect(function() secLabel.TextColor3 = Pal.Sub end)
        if sc.Collapsible == false then chev.Holder.Visible = false end
        if sc.Collapsed then task.defer(function() setCollapsed(true) end) end
        function section:SetName(n) secLabel.Text = string.upper(tostring(n)) end
        function section:Collapse(state) setCollapsed(state ~= false) end
        function section:IsCollapsed() return collapsed end
        return section
    end

    function tabApi:SetAllCollapsed(state)
        state = state ~= false
        for _, sec in ipairs(Tab.Sections) do
            if sec.Collapse then pcall(sec.Collapse, state) end
        end
    end
    function tabApi:CollapseAll() tabApi:SetAllCollapsed(true) end
    function tabApi:ExpandAll() tabApi:SetAllCollapsed(false) end

    return tabApi
end

local function flipTabs(Window, from, to, forward)
    local P = Window._parts
    local dir = forward and 1 or -1
    local contentW = P.content.AbsoluteSize.X
    if from and from ~= to then
        from.Remember()
        local outPage = from.Page
        outPage.Visible = true
        outPage.Position = UDim2.fromOffset(0, 0)
        outPage.GroupTransparency = 0
        play(outPage, 0.26, {Position = UDim2.fromOffset(-contentW * dir, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
        play(outPage, 0.22, {GroupTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
        task.delay(0.28, function()
            if Window.Selected ~= from then
                outPage.Visible = false
                outPage.Position = UDim2.fromOffset(0, 0)
                outPage.GroupTransparency = 1
            end
        end)
    end
    local inPage = to.Page
    inPage.Visible = true
    inPage.GroupTransparency = 1
    inPage.Position = UDim2.fromOffset(contentW * dir, 0)
    to.Restore()
    play(inPage, 0.34, {Position = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quart)
    play(inPage, 0.28, {GroupTransparency = 0}, Enum.EasingStyle.Quart)
end

function TabImpl.select(Window, target, instant)
    if type(target) == "number" then target = Window.Tabs[target] end
    if type(target) == "string" then
        for _, t in ipairs(Window.Tabs) do if t.Name == target then target = t break end end
    end
    if type(target) ~= "table" or not target.Button then return end
    local prev = Window.Selected
    if prev == target then return end
    Popup.close(true)
    hideTip()
    Window.Selected = target
    if target._EnsureBuilt then target:_EnsureBuilt() end
    local forward = not prev or target.Index > prev.Index
    if instant or not prev then
        for _, t in ipairs(Window.Tabs) do
            t.Page.Visible = t == target
            t.Page.GroupTransparency = t == target and 0 or 1
            t.Page.Position = UDim2.fromOffset(0, 0)
        end
        target.Restore()
    else
        flipTabs(Window, prev, target, forward)
    end
    for _, t in ipairs(Window.Tabs) do
        local active = t == target
        t.IconObj.Color(active and Pal.Accent or Pal.Sub, not instant)
        if t.Label then t.Label.TextColor3 = active and Pal.Text or Pal.Sub end
        if t.Underline then
            play(t.Underline, 0.22, {BackgroundTransparency = active and 0 or 1, Size = UDim2.fromOffset((t.Button.AbsoluteSize.X) - 20, 2)})
            t.Underline.BackgroundColor3 = Pal.Accent
        end
    end
    if Window.OnTabChanged then task.spawn(Window.OnTabChanged, target) end
end

local function numFormat(v, step, suffix)
    local s
    if step < 1 then
        local frac = (tostring(step):gsub("^0%.", ""))
        local places = math.min(3, math.max(1, #frac))
        s = string.format("%."..places.."f", v)
        s = (s:gsub("0+$", ""))
        s = (s:gsub("%.$", ""))
    else
        s = tostring(math.floor(v + 0.5))
    end
    if suffix and suffix ~= "" then return s.." "..suffix end
    return s
end
local function snapTo(v, step, min) if step <= 0 then return v end return min + math.floor((v - min) / step + 0.5) * step end
local function toneColor(name)
    if name == nil then return Pal.Accent end
    if typeof(name) == "Color3" then return name end
    if type(name) == "string" then
        if Pal[name] then return Pal[name] end
        if Status[name] then return Status[name] end
    end
    return Pal.Accent
end

