    bind(box, "BackgroundColor3", "Surface")
    box.BackgroundTransparency = 0
    round(box, 12)
    outline(box, "Stroke", 1, 0.4)
    local boxScale = mk("UIScale", {Scale=0.94, Parent=box})
    local col = mk("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=box})
    inset(col, 22, 22, 22, 22)
    stack(col, 10)
    local header = mk("Frame", {Size=UDim2.new(1,0,0,44), BackgroundTransparency=1, LayoutOrder=1, Parent=col})
    local logo = mk("Frame", {Size=UDim2.fromOffset(28,36), BackgroundTransparency=1, ZIndex=302, Parent=header})
    local logoIcon = makeIcon(logo, cfg.Icon or "key", 20, "Text", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5), ZIndex=303})
    logoIcon.Color(Pal.Text)
    tx("TextLabel", {Text=tostring(cfg.Title or "Key System"), TextSize=17, Position=UDim2.fromOffset(48,3), Size=UDim2.new(1,-56,0,20), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=302, Parent=header}, 3)
    tx("TextLabel", {Text=tostring(cfg.Subtitle or ""), TextSize=11, Position=UDim2.fromOffset(48,23), Size=UDim2.new(1,-56,0,14), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=302, Parent=header}, 1, "Sub")
    local input = tx("TextBox", {Size=UDim2.new(1,0,0,38), LayoutOrder=2, PlaceholderText="Paste your key here...", Text=prefill or "", TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=302, Parent=col}, 2)
    bind(input, "BackgroundColor3", "Elevated")
    input.BackgroundTransparency = 0
    round(input, 9)
    inset(input, 0, 12, 0, 12)
    local ring = outline(input, "Accent", 1.2, 0.5)
    input.Focused:Connect(function() play(ring, 0.15, {Transparency = 0.2}) end)
    input.FocusLost:Connect(function() play(ring, 0.2, {Transparency = 0.5}) end)
    local row = mk("Frame", {Size=UDim2.new(1,0,0,36), BackgroundTransparency=1, LayoutOrder=3, Parent=col})
    mk("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, HorizontalAlignment=Enum.HorizontalAlignment.Center, VerticalAlignment=Enum.VerticalAlignment.Center, Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder, Parent=row})
    local getBtn = tx("TextButton", {Text=tostring(cfg.GetKeyText or "Get Key"), TextSize=13, Size=UDim2.new(0.5,-4,1,0), LayoutOrder=1, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=302, Parent=row}, 3)
    bind(getBtn, "BackgroundColor3", "Elevated")
    getBtn.BackgroundTransparency = 0
    round(getBtn, 9)
    local verifyBtn = tx("TextButton", {Text=tostring(cfg.ButtonText or "Verify"), TextSize=13, Size=UDim2.new(0.5,-4,1,0), LayoutOrder=2, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=302, Parent=row}, 3)
    bind(verifyBtn, "BackgroundColor3", "Accent")
    verifyBtn.BackgroundTransparency = 0
    round(verifyBtn, 9)
    verifyBtn.TextColor3 = onAccent()
    play(layer, 0.22, {BackgroundTransparency = 0.35})
    fadeGroup(box, 0.26, 0, Enum.EasingStyle.Quart)
    play(boxScale, 0.34, {Scale = 1}, Enum.EasingStyle.Quart)
    local function closeGate()
        play(layer, 0.22, {BackgroundTransparency = 1})
        fadeGroup(box, 0.24, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(boxScale, 0.24, {Scale = 0.96})
        task.delay(0.28, function() layer:Destroy() end)
    end
    local verifying = false
    local function doVerify()
        if verifying then return end
        local key = input.Text
        if key == nil or key == "" then return end
        verifying = true
        task.spawn(function()
            local ok = Cactus:_validateKey(key)
            if ok then
                Cactus._keyVerified = true
                if Cactus.KeyFile then Cactus:SaveKeyToFile(key) end
                task.wait(0.3)
                closeGate()
                task.wait(0.28)
                if onSuccess then onSuccess() end
            else
                verifying = false
                shake(box)
            end
        end)
    end
    verifyBtn.InputBegan:Connect(function(i) if isPointer(i) then doVerify() end end)
    input.FocusLost:Connect(function(enter) if enter then doVerify() end end)
end

