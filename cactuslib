local function registerFlag(flag, ref)
    if not flag then return end
    if not flagRefs[flag] then flagOrder[#flagOrder + 1] = flag end
    flagRefs[flag] = ref
end
local function errorText(err)
    local s = tostring(err or "unknown error")
    s = s:gsub("^[%w_%.%-%/:]+:%d+:%s*", "")
    if #s > 90 then s = s:sub(1, 87) .. "..." end
    return s
end
local function flashCard(card, color, seconds)
    if not card or not card.Parent then return end
    local sheet = mk("Frame", {Size=UDim2.fromScale(1,1), BackgroundColor3=color, BackgroundTransparency=0.7, ZIndex=44, Parent=card})
    round(sheet, 12)
    local stroke = card:FindFirstChildOfClass("UIStroke")
    local oldTrans = stroke and stroke.Transparency
    if stroke then stroke.Color = color stroke.Transparency = 0 end
    local dur = seconds or 0.9
    local tw = play(sheet, dur, {BackgroundTransparency = 1}, Enum.EasingStyle.Quint)
    after(tw, function() if sheet.Parent then sheet:Destroy() end end)
    task.delay(dur, function()
        if stroke and stroke.Parent then play(stroke, 0.3, {Color = Pal.Stroke, Transparency = oldTrans or 0.5}) end
        if sheet.Parent then sheet:Destroy() end
    end)
end
local function shake(card)
    if not card or not card.Parent then return end
    local base = card.Position
    task.spawn(function()
        for _, dx in ipairs({5,-5,3,-3,1,0}) do
            if not card.Parent then return end
            card.Position = base + UDim2.fromOffset(dx, 0)
            task.wait(0.028)
        end
        if card.Parent then card.Position = base end
    end)
end

