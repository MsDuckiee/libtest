    local maxPill = server:AddStatPill({Name="Max Players", Value="-"})
    local latencyPill = server:AddStatPill({Name="Latency", Value="-"})
    local sessionPill = server:AddStatPill({Name="Session", Value="-"})
    local function refreshServer() playerPill:Set(#Players:GetPlayers()) maxPill:Set(Players.MaxPlayers) sessionPill:Set(Stat.session()) end
    keep(Players.PlayerAdded:Connect(refreshServer)) keep(Players.PlayerRemoving:Connect(refreshServer))
    task.spawn(function()
        while server.Holder.Parent do
            refreshServer()
            latencyPill:Set(Metrics.ping.." ms")
            latencyPill:SetTone(Metrics.ping <= 90 and Status.Success or Metrics.ping <= 170 and Status.Warning or Status.Error)
            task.wait(1)
        end
    end)
    local wave = tab:AddSection({Name="Environment", Collapsible=false})
    local execName, execVer = Detect.executor() local supported = Detect.supportsScript()
    wave:AddStatPill({Name = "Status", Value = supported and "Supported" or "Limited", Tone = supported and Status.Success or Status.Warning})
    wave:AddLabel({Name = "Executor", Value = execName or "Unknown"})
    if execVer then wave:AddLabel({Name = "Version", Value = execVer}) end
end

