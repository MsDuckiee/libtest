    function E:AddBind(o)
        o = o or {}
        local label = tostring(o.Name or "Keybind")
        local c = card(rowH, true)
        nameLabel(c, label, UDim2.new(1, -110, 1, 0))
        local chip = tx("TextButton", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-14,0.5,0), Size=UDim2.fromOffset(56,26), TextSize=12, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=16, Parent=c}, 3)
        bind(chip, "BackgroundColor3", "Elevated")
        chip.BackgroundTransparency = 0
        round(chip, 8)
        local obj = {Value=o.Default, Binding=false, Locked=false}
        function obj:IsLocked() return obj.Locked == true end
        function obj:SetLocked(v) obj.Locked = v and true or false return obj end
        local banned = {[Enum.KeyCode.Unknown]=true, [Enum.KeyCode.Return]=true, [Enum.KeyCode.Tab]=true}
        local function refresh()
            local t = obj.Binding and "..." or (obj.Value and keyText(obj.Value) or "None")
            chip.Text = t
            local w = math.max(50, #t * 8 + 22)
            play(chip, 0.22, {Size = UDim2.fromOffset(w, 26)}, Enum.EasingStyle.Quart)
            if kbVisible then kbRebuild() end
        end
        function obj:Set(k, silent)
            if typeof(k) == "string" then k = Enum.KeyCode[k] or Enum.UserInputType[k] or nil end
            local old = obj.Value
            obj.Value = k
            obj.Binding = false
            refresh()
            if not silent then queueSave() end
            if old ~= k and type(o.OnChange) == "function" then
                local ok, err = pcall(o.OnChange, k)
                if not ok then
                    Cactus:MakeNotification({Name=label.." bind", Content=errorText(err), Type="Warning", Time=4})
                end
            end
        end
        function obj:Get() return obj.Value end
        chip.InputBegan:Connect(function(input)
            if not isPointer(input) then return end
            if obj:IsLocked() then return end
            if activeBindCapture and activeBindCapture ~= obj then
                activeBindCapture.Binding = false
                activeBindCapture = nil
            end
            activeBindCapture = obj
            obj.Binding = true
            refresh()
        end)
        keep(UserInputService.InputBegan:Connect(function(input, gpe)
            if obj.Binding then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode == Enum.KeyCode.Escape then
                        obj:Set(nil)
                        activeBindCapture = nil
                    elseif not banned[input.KeyCode] then
                        obj:Set(input.KeyCode)
                        activeBindCapture = nil
                    end
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                    obj:Set(input.UserInputType)
                    activeBindCapture = nil
                end
                return
            end
            if gpe or not obj.Value or obj:IsLocked() then return end
            if input.KeyCode == obj.Value or input.UserInputType == obj.Value then
                task.spawn(function()
                    local ok, err = pcall(o.Callback or function() end, true)
                    if not ok then fail(c, label, err) end
                end)
            end
        end))
        register(o.Flag, obj, o, function() return obj.Value end, function(v)
            obj:Set(v, true)
            if type(o.OnChange) == "function" then
                local ok, err = pcall(o.OnChange, obj.Value)
                if not ok then
                    Cactus:MakeNotification({Name=label.." bind", Content=errorText(err), Type="Warning", Time=4})
                end
            end
        end)
        decorate(obj, c, o, "Keybind")
        kbEntries[#kbEntries + 1] = {name=label, get=function() return obj.Value end}
        obj:Set(o.Default, true)
        return obj
    end
