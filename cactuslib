local function attachSearch(Window)
    local P = Window._parts
    local sText = P.sText
    local searchFrame = P.searchBox
    
    local listFrame = mk("ScrollingFrame", {
        Name = "SearchResults", Position = UDim2.new(0, 0, 1, 4), Size = UDim2.new(1, 0, 0, 200),
        BackgroundColor3 = Pal.Surface, BackgroundTransparency = 0.05, Visible = false, ZIndex = 150, Parent = searchFrame
    })
    round(listFrame, 8) outline(listFrame, "Stroke", 1, 0.2)
    stack(listFrame, 2) inset(listFrame, 4, 4, 4, 4)
    
    local function updateSearch()
        for _, c in ipairs(listFrame:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        
        local query = sText.Text:lower()
        if query == "" then listFrame.Visible = false return end
        
        local results = {}
        for _, e in ipairs(P.searchIndex) do
            if e.name:lower():find(query, 1, true) or e.kind:lower():find(query, 1, true) then
                table.insert(results, e)
            end
        end
        
        if #results == 0 then listFrame.Visible = false return end
        listFrame.Visible = true
        
        local count = 0
        for _, e in ipairs(results) do
            count = count + 1
            if count > 10 then break end -- Limit results
            
            local btn = mk("TextButton", {Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 0.9, LayoutOrder = count, ZIndex = 151, Parent = listFrame})
            round(btn, 6) bind(btn, "BackgroundColor3", "Elevated")
            tx("TextLabel", {Text = e.name, TextSize = 12, Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 152, Parent = btn}, 2)
            tx("TextLabel", {Text = e.tab .. " / " .. (e.section or "Main"), TextSize = 10, Position = UDim2.fromOffset(8, 18), Size = UDim2.new(1, -16, 0, 14), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 152, Parent = btn}, 1, "Sub")
            
            btn.MouseEnter:Connect(function() play(btn, 0.15, {BackgroundTransparency = 0.7}) end)
            btn.MouseLeave:Connect(function() play(btn, 0.2, {BackgroundTransparency = 0.9}) end)
            btn.InputBegan:Connect(function(input) 
                if isPointer(input) then 
                    sText.Text = "" 
                    listFrame.Visible = false 
                    e.go() 
                end 
            end)
        end
        
        listFrame.CanvasSize = UDim2.fromOffset(0, math.min(#results, 10) * 36)
    end
    
    sText:GetPropertyChangedSignal("Text"):Connect(updateSearch)
    sText.Focused:Connect(function() if sText.Text ~= "" then updateSearch() end end)
    
    keep(UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mousePos = UserInputService:GetMouseLocation()
            local a = listFrame.AbsolutePosition
            local s = listFrame.AbsoluteSize
            if not (mousePos.X >= a.X and mousePos.X <= a.X + s.X and mousePos.Y >= a.Y and mousePos.Y <= a.Y + s.Y) then
                if not sText:IsFocused() then
                    listFrame.Visible = false
                end
            end
        end
    end))
end

