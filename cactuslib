    local ring = outline(input, "Accent", 2, 0.5) input.Focused:Connect(function() play(ring, 0.2, {Transparency = 0}) end) input.FocusLost:Connect(function() play(ring, 0.3, {Transparency = 0.5}) end)
    
    local row = mk("Frame", {Size=UDim2.new(1,0,0,44), BackgroundTransparency=1, LayoutOrder=5, Parent=col}) 
    mk("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, HorizontalAlignment=Enum.HorizontalAlignment.Center, VerticalAlignment=Enum.VerticalAlignment.Center, Padding=UDim.new(0,10), SortOrder=Enum.SortOrder.LayoutOrder, Parent=row})
    
    local getBtn = tx("TextButton", {Text=cfg.GetKeyText, TextSize=13, Size=UDim2.fromOffset(100,40), LayoutOrder=1, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=302, Parent=row}, 3) bind(getBtn, "BackgroundColor3", "Elevated") getBtn.BackgroundTransparency = 0 round(getBtn, 10)
    local verifyBtn = tx("TextButton", {Text=cfg.ButtonText, TextSize=13, Size=UDim2.fromOffset(120,40), LayoutOrder=2, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=302, Parent=row}, 3) bind(verifyBtn, "BackgroundColor3", "Accent") verifyBtn.BackgroundTransparency = 0 round(verifyBtn, 10) verifyBtn.TextColor3 = onAccent()
    
    play(layer, 0.3, {BackgroundTransparency = 0.5}) fadeGroup(box, 0.35, 0, Enum.EasingStyle.Quart) play(boxScale, 0.5, {Scale = 1}, Enum.EasingStyle.Back)
    
    local verifying = false
    local function doVerify() 
        if verifying then return end 
        local key = input.Text 
        if key == nil or key == "" then return end 
        verifying = true 
        task.spawn(function() 
            local ok = Cactus:_validateKey(key) 
            if ok then 
                Cactus._keyVerified = true 
                if Cactus.KeyFile then Cactus:SaveKeyToFile(key) end 
                task.wait(0.3) 
                play(layer, 0.3, {BackgroundTransparency = 1}) 
                fadeGroup(box, 0.3, 1, Enum.EasingStyle.Quart) 
                task.wait(0.35) 
                layer:Destroy() 
                if onSuccess then onSuccess() end 
            else 
                verifying = false 
                shake(box) 
                play(ring, 0.1, {Color = Status.Error, Transparency = 0}) task.delay(0.5, function() play(ring, 0.3, {Color = Pal.Accent, Transparency = 0.5}) end)
            end 
        end) 
    end
    
    verifyBtn.InputBegan:Connect(function(i) if isPointer(i) then doVerify() end end) 
    input.FocusLost:Connect(function(enter) if enter then doVerify() end end)
    getBtn.InputBegan:Connect(function(i) if isPointer(i) then if cfg.GetKeyLink and setclipboard then setclipboard(cfg.GetKeyLink) Cactus:MakeNotification({Name="Copied", Content="Link copied to clipboard", Type="Success"}) end end end)
end

-- =========================================================
-- INIT
-- =========================================================
function Cactus:Init()
    if Cactus._ready then return end
    local window = Cactus.Windows[1] local cfg = window and window.Cfg or {}
    local function finish()
        if window then
            local has = false
            for _, t in ipairs(window.Tabs) do if t.Name == ALWAYS_NAME then has = true break end end
            if not has then
                local always = window:MakeTab({Name=ALWAYS_NAME, Icon=ALWAYS_ICON})
                local alwaysTab = always.Tab
                table.remove(window.Tabs, #window.Tabs)
                table.insert(window.Tabs, 1, alwaysTab)
                for i, t in ipairs(window.Tabs) do
                    t.Index = i
                    if t.Button then t.Button.LayoutOrder = i end
                end
                window.Selected = nil
                window:SelectTab(alwaysTab, true)
            end
        end
        if Cactus.SaveConfig then local auto = Cactus:GetAutoload() Cactus:LoadProfile(auto or "default") end
        refreshTheme(false)
        for _, fn in ipairs(initFires) do task.spawn(pcall, fn) end table.clear(initFires) Cactus._ready = true
        if window and Cactus.AutoShow then window.Show() elseif window and Cactus.ShowLauncher then window.Launcher.Visible = true window.Launcher.BackgroundTransparency = 0 end
        startCactusAds()
    end
    local function afterKey() finish() end
    local function afterLoading()
        if Cactus._keyCfg and not Cactus._keyVerified then
            if Cactus.KeyFile and Cactus.AutoVerify then local saved = Cactus:LoadKeyFromFile() if saved and saved ~= "" and Cactus:_validateKey(saved) then Cactus._keyVerified = true if Cactus._keyCfg.OnSuccess then pcall(Cactus._keyCfg.OnSuccess, saved) end end end
            if not Cactus._keyVerified then Cactus:_showKeyGate(function() afterKey() end) return end
        end
        afterKey()
    end
    loadingScreen(cfg, window and window.Name or "CactusLib", afterLoading)
end

function Cactus:Destroy()
    Cactus._ready = false Popup.close(true)
    if rainbowConn then rainbowConn:Disconnect() rainbowConn = nil end
    if noteLoop then noteLoop:Disconnect() noteLoop = nil end
    if adConn then pcall(function() task.cancel(adConn) end) adConn = nil end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end conns = {}
    for _, w in ipairs(Cactus.Windows) do pcall(function() w._parts.launcher:Destroy() end) end Cactus.Windows = {}
    if CactusBlur then CactusBlur:Destroy() CactusBlur = nil end
    pcall(function() Root:Destroy() end)
    if env.CactusLibInstance == Cactus then env.CactusLibInstance = nil end
end

return Cactus
