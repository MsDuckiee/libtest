local Notes = {active = {}, queue = {}, byKey = {}, queuedKey = {}, max = 4, duration = 4, position = "TopCenter"}
local noteLayer = mk("Frame", {Name = "Notifications", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 100, Parent = Root})
local noteContainer = mk("Frame", {Name="Container", BackgroundTransparency=1, Size=UDim2.fromScale(0,0), AutomaticSize=Enum.AutomaticSize.XY, ZIndex=100, Parent=noteLayer})
local noteLayout = mk("UIListLayout", {SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,10), HorizontalAlignment=Enum.HorizontalAlignment.Center, VerticalAlignment=Enum.VerticalAlignment.Top, Parent=noteContainer})
local notePadding = mk("UIPadding", {PaddingTop=UDim.new(0,20), PaddingRight=UDim.new(0,20), Parent=noteContainer})

local CORNERS = {TopRight={ax=1, ay=0}, BottomRight={ax=1, ay=1}, TopLeft={ax=0, ay=0}, BottomLeft={ax=0, ay=1}, TopCenter={ax=0.5, ay=0}, BottomCenter={ax=0.5, ay=1}}
local function updateNotePosition()
    local c = CORNERS[Notes.position] or CORNERS.TopCenter
