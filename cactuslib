local function fuzzy(query, text)
    query, text = query:lower(), text:lower()
    if query == "" then return 1 end
    local at = text:find(query, 1, true)
    if at then return 100 - at end
    local qi, score = 1, 0
    for i = 1, #text do
        if text:sub(i, i) == query:sub(qi, qi) then
            qi = qi + 1
            score = score + 1
            if qi > #query then return score end
        end
    end
    return nil
end

local function attachSearch(Window)
    local P = Window._parts
    local mobile = P.mobile
    local layer = mk("TextButton", {Name="Search", Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=1, Visible=false, ZIndex=180, Parent=Root})
    local w = math.clamp(viewport().X - 32, 260, 420)
    local box = mk("CanvasGroup", {Name="Box", AnchorPoint=Vector2.new(0.5,0), Position=UDim2.new(0.5,0,0,mobile and 16 or 70), Size=UDim2.fromOffset(w,0), AutomaticSize=Enum.AutomaticSize.Y, GroupTransparency=1, ZIndex=181, Parent=layer})
    bind(box, "BackgroundColor3", "Surface")
    box.BackgroundTransparency = 0
    round(box, 12)
    outline(box, "Stroke", 1, 0.4)
    local boxScale = mk("UIScale", {Scale=0.96, Parent=box})
    stack(box, 0)
    local top = mk("Frame", {Size=UDim2.new(1,0,0,44), BackgroundTransparency=1, LayoutOrder=1, ZIndex=182, Parent=box})
    makeIcon(top, SEARCH_ICON, 14, "Sub", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,16,0.5,0), ZIndex=183})
    local input = tx("TextBox", {Name="Input", Position=UDim2.fromOffset(38,0), Size=UDim2.new(1,-50,1,0), PlaceholderText="search features", TextSize=13, ZIndex=183, Parent=top}, 2)
    input.ClearTextOnFocus = false
    local line = mk("Frame", {Size=UDim2.new(1,0,0,1), LayoutOrder=2, ZIndex=182, Parent=box})
    bind(line, "BackgroundColor3", "Divider")
    local list = mk("ScrollingFrame", {Size=UDim2.new(1,0,0,0), BackgroundTransparency=1, ScrollBarThickness=2, LayoutOrder=3, CanvasSize=UDim2.new(), AutomaticCanvasSize=Enum.AutomaticSize.Y, ZIndex=182, Parent=box})
    inset(list, 6, 6, 6, 6)
    stack(list, 1)
    local open = false
    local buttons = {}
    local picked = 1
    local shown = {}
    local function highlight() for i, b in ipairs(buttons) do play(b, 0.1, {BackgroundTransparency = i == picked and 0.88 or 1}) end end
    local function render()
        for _, b in ipairs(buttons) do b:Destroy() end
        buttons = {} shown = {}
        local q = input.Text
        local scored = {}
        for _, e in ipairs(P.searchIndex) do
            local sc = fuzzy(q, e.name.." "..e.tab.." "..e.kind)
            if sc then scored[#scored + 1] = {e=e, s=sc} end
        end
        table.sort(scored, function(a, b) return a.s > b.s end)
        for i = 1, math.min(#scored, 30) do shown[i] = scored[i].e end
        for i, e in ipairs(shown) do
            local b = mk("TextButton", {Size=UDim2.new(1,0,0,36), BackgroundColor3=Color3.new(1,1,1), BackgroundTransparency=1, LayoutOrder=i, ZIndex=183, Parent=list})
            round(b, 6)
            tx("TextLabel", {Text=e.name, TextSize=13, Position=UDim2.fromOffset(10,4), Size=UDim2.new(1,-80,0,15), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=184, Parent=b}, 2)
            tx("TextLabel", {Text=e.tab..(e.section and (" / "..e.section) or ""), TextSize=10, Position=UDim2.fromOffset(10,20), Size=UDim2.new(1,-80,0,13), TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=184, Parent=b}, 1, "Sub")
            b.InputBegan:Connect(function(input) if not isPointer(input) then return end Window:CloseSearch() e.go() end)
            buttons[i] = b
        end
        picked = 1
        list.Size = UDim2.new(1, 0, 0, math.min(math.max(#shown, 1) * 38 + 10, mobile and 170 or 280))
        highlight()
    end
    input:GetPropertyChangedSignal("Text"):Connect(function() if open then render() end end)
    function Window:OpenSearch()
        if open then return end
        open = true
        Popup.close(true)
        for _, t in ipairs(Window.Tabs) do if t._EnsureBuilt then t:_EnsureBuilt() end end
        input.Text = ""
        layer.Visible = true
        render()
        play(layer, 0.22, {BackgroundTransparency = 0.6})
        fadeGroup(box, 0.24, 0, Enum.EasingStyle.Quart)
        play(boxScale, 0.3, {Scale = 1}, Enum.EasingStyle.Quart)
        if not mobile then task.delay(0.05, function() if open then input:CaptureFocus() end end) end
    end
    function Window:CloseSearch()
        if not open then return end
        open = false
        input:ReleaseFocus()
        play(layer, 0.18, {BackgroundTransparency = 1})
        fadeGroup(box, 0.2, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(boxScale, 0.2, {Scale = 0.97})
        task.delay(0.22, function() if not open then layer.Visible = false restoreGroup(box) end end)
    end
    layer.InputBegan:Connect(function(input) if isPointer(input) then Window:CloseSearch() end end)
    box.Active = true
    input.FocusLost:Connect(function(enter)
        if enter and shown[picked] then
            local e = shown[picked]
            Window:CloseSearch()
            e.go()
        end
    end)
    keep(UserInputService.InputBegan:Connect(function(i, gpe)
        if i.KeyCode == Enum.KeyCode.K and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
            if open then Window:CloseSearch() else Window:OpenSearch() end
            return
        end
        if not open then return end
        if i.KeyCode == Enum.KeyCode.Escape then Window:CloseSearch()
        elseif i.KeyCode == Enum.KeyCode.Down then picked = math.min(picked + 1, #shown) highlight()
        elseif i.KeyCode == Enum.KeyCode.Up then picked = math.max(picked - 1, 1) highlight() end
    end))
end

-- =========================================================
-- WINDOW METHODS
-- =========================================================
local function attachWindowMethods(Window)
    function Window:MakeTab(cfg) return TabImpl.make(Window, cfg) end
    function Window:SelectTab(tab, instant) TabImpl.select(Window, tab, instant) end
    function Window:Notify(cfg) return Cactus:MakeNotification(cfg) end
    function Window:SetScale(s)
        Window.Scale = math.clamp(tonumber(s) or 1, 0.5, 1.4)
        Window._parts.applyScale(true)
    end
    function Window:SetTitle(t)
        Window._parts.titleLbl.Text = tostring(t)
        Hud.title = tostring(t)
        Watermark.setText(t)
    end
    function Window:SetSubtitle(t)
        Window._parts.subLbl.Text = tostring(t)
        Window._parts.subLbl.Visible = tostring(t) ~= ""
        Watermark.setSub(t)
    end
    function Window:SetIcon(id)
        if Window.LogoIcon then Window.LogoIcon.Set(id) end
        if Window.LauncherIcon then Window.LauncherIcon.Set(id) end
    end
    function Window:CollapseAll()
        for _, t in ipairs(Window.Tabs) do
            for _, sec in ipairs(t.Sections) do
                if sec.Collapse then pcall(sec.Collapse, true) end
            end
        end
    end
    function Window:ExpandAll()
        for _, t in ipairs(Window.Tabs) do
            for _, sec in ipairs(t.Sections) do
                if sec.Collapse then pcall(sec.Collapse, false) end
            end
        end
    end
    attachSearch(Window)
    attachSettings(Window)
end

Hooks.attach = attachWindowMethods
if Hooks._pending then
    for _, w in ipairs(Hooks._pending) do attachWindowMethods(w) end
    Hooks._pending = nil
end

-- =========================================================
-- INIT
-- =========================================================
function Cactus:Init()
    if Cactus._ready then return end
    if Cactus._keyCfg and not Cactus._keyVerified then
        if Cactus.KeyFile and Cactus.AutoVerify then
            local saved = Cactus:LoadKeyFromFile()
            if saved and saved ~= "" and Cactus:_validateKey(saved) then
                Cactus._keyVerified = true
                if Cactus._keyCfg.OnSuccess then pcall(Cactus._keyCfg.OnSuccess, saved) end
            end
        end
        if not Cactus._keyVerified then
            Cactus:_showKeyGate(function() Cactus:Init() end)
            return
        end
    end
    local window = Cactus.Windows[1]
    local cfg = window and window.Cfg or {}
    local function finish()
        if window then
            local has = false
            for _, t in ipairs(window.Tabs) do if t.Name == ALWAYS_NAME then has = true break end end
            if not has then
                local home = window:MakeTab({Name=ALWAYS_NAME, Icon=ALWAYS_ICON})
                populateHomeTab(home)
                local homeTab
                for i, t in ipairs(window.Tabs) do
                    if t.Name == ALWAYS_NAME then homeTab = table.remove(window.Tabs, i) break end
                end
                if homeTab then
                    table.insert(window.Tabs, 1, homeTab)
                    for i, t in ipairs(window.Tabs) do
                        t.Index = i
                        t.Button.LayoutOrder = i
                    end
                    if homeTab.IconObj then homeTab.IconObj.Set(ALWAYS_ICON) end
                    window.Selected = nil
                    window:SelectTab(homeTab, true)
                end
            end
        end
        if Cactus.SaveConfig then
            local auto = Cactus:GetAutoload()
            Cactus:LoadProfile(auto or "default")
        end
        refreshTheme(false)
        task.defer(function() refreshTheme(false) end)
        task.delay(0.1, function() refreshTheme(false) end)
        for _, fn in ipairs(initFires) do task.spawn(pcall, fn) end
        table.clear(initFires)
        Cactus._ready = true
        if window and Cactus.AutoShow then window.Show()
        elseif window and Cactus.ShowLauncher then
            window.Launcher.Visible = true
            window.Launcher.BackgroundTransparency = 0
        end
    end
    loadingScreen(cfg, window and window.Name or "CactusLib", finish)
end

function Cactus:Destroy()
    Cactus._ready = false
    Popup.close(true)
    hideTip()
    if noteLoop then noteLoop:Disconnect() noteLoop = nil end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    for _, w in ipairs(Cactus.Windows) do pcall(function() w._parts.launcher:Destroy() end) end
    Cactus.Windows = {}
    if CactusBlur then CactusBlur:Destroy() CactusBlur = nil end
    pcall(function() Root:Destroy() end)
    if env.CactusLibInstance == Cactus then env.CactusLibInstance = nil end
end

return Cactus
