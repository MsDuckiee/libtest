local IconMap = {}
pcall(function()
    local raw = game:HttpGet("https://raw.githubusercontent.com/evoincorp/lucideblox/master/src/modules/util/icons.json")
    local decoded = HttpService:JSONDecode(raw)
    local icons = decoded.icons or decoded
    if type(icons) == "table" then
        for name, val in pairs(icons) do
            if type(val) == "string" then IconMap[name] = { url = val }
            elseif type(val) == "number" then IconMap[name] = { url = "rbxassetid://" .. val }
            elseif type(val) == "table" and val.url then IconMap[name] = { url = tostring(val.url) } end
        end
    end
end)
local function resolveIcon(name)
    if name == nil then return nil end
    local s = tostring(name)
    if s == "" then return nil end
    local special = SpecialIcons[s:lower()]
    if special then return { url = "rbxassetid://" .. special } end
    if s:find("^rbxassetid://") or s:find("^rbxasset://") then return { url = s } end
    if tonumber(s) then return { url = "rbxassetid://" .. s } end
    return IconMap[s]
end
local function firstIcon(list) for _, n in ipairs(list) do if IconMap[n] then return n end end return list[1] end

local function makeIcon(parent, name, size, tone, props)
    local holder = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size)})
    if props then for k, v in pairs(props) do holder[k] = v end end
    holder.Parent = parent
    local img = mk("ImageLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Fit, Parent = holder})
    local glyph = tx("TextLabel", {Size = UDim2.fromScale(1, 1), TextSize = math.floor(size * 0.9), TextXAlignment = Enum.TextXAlignment.Center, Visible = false, Parent = holder}, 3, (tone or "Text"))
    if tone ~= false then bind(img, "ImageColor3", tone or "Text") end
    local api = {Holder = holder, Image = img, Glyph = glyph}
    function api.Set(n)
        local resolved = resolveIcon(n)
        if resolved and resolved.url then
            img.Image = resolved.url img.Visible = true glyph.Visible = false
        else
            img.Visible = false glyph.Visible = true
            local key = tostring(n or "")
            glyph.Text = Glyphs[key] or key:sub(1, 1):upper()
        end
    end
    function api.Color(c, animated)
        if animated then play(img, 0.2, {ImageColor3 = c}) play(glyph, 0.2, {TextColor3 = c})
        else img.ImageColor3 = c glyph.TextColor3 = c end
    end
    api.Set(name)
    return api
end

