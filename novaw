        local box = New("Frame", {AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,0,0.5,0), AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0,120,0,30), BackgroundColor3 = t.Elevated, BackgroundTransparency = 0.05, ZIndex = 7})
        box.Parent = f
        Children(box, {
            New("UICorner", {CornerRadius = UDim.new(0,9)}),
            New("UIStroke", {Color = t.Stroke, Transparency = 0.35}),
            Padding(12,5,12,5),
        })
        local input = New("TextBox", {Name = "Input", BackgroundTransparency = 1, Text = cfg.Default or "", PlaceholderText = cfg.Placeholder or "Type...", PlaceholderColor3 = t.TextDark, TextColor3 = t.Text, Font = Enum.Font.GothamSemibold, TextSize = 13 * NovaLib.TextScale, ClearTextOnFocus = false, Size = UDim2.new(0,100,1,0), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 8})
        input.Parent = box

        Connect(input:GetPropertyChangedSignal("Text"), function()
            box.Size = UDim2.new(0, math.max(100, input.TextBounds.X + 26), 0, 30)
        end)
        Connect(input.FocusLost, function(enter)
            if cfg.Callback and (enter or cfg.FireOnFocusLost) and not NovaLib.PanicEnabled then
                task.spawn(cfg.Callback, input.Text)
            end
            if cfg.TextDisappear then input.Text = "" end
        end)
        return input
    end

    function api:AddColorpicker(cfg)
        cfg = cfg or {}
        local obj = {Value = cfg.Default or Color3.fromRGB(255,255,255), Toggled = false, Save = cfg.Save == true, Type = "Colorpicker"}
        local f = card(44)
        local click = New("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.new(1,0,0,44), ZIndex = 8})
        click.Parent = f
        local _, title = titleRow(f, cfg.Name or "Color")

        local swatch = New("Frame", {AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,0,0.5,0), Size = UDim2.new(0,42,0,28), BackgroundColor3 = obj.Value, BackgroundTransparency = 0, ZIndex = 7})
        swatch.Parent = f
        Children(swatch, {
            New("UICorner", {CornerRadius = UDim.new(0,9)}),
            New("UIStroke", {Color = t.Stroke, Transparency = 0.25, Thickness = 1.2}),
        })

        local h,s,v = Color3.toHSV(obj.Value)

        local picker = New("Frame", {Name = "Picker", Visible = false, BackgroundTransparency = 1, Position = UDim2.new(0,0,1,10), Size = UDim2.new(1,0,0,132), ZIndex = 10})
        picker.Parent = f

        local sv = New("ImageLabel", {Name = "SV", Image = "rbxassetid://4155801252", Size = UDim2.new(1,-28,1,0), BackgroundColor3 = Color3.fromHSV(h,1,1), ZIndex = 11})
        sv.Parent = picker
        Children(sv, {
            New("UICorner", {CornerRadius = UDim.new(0,12)}),
            New("UIStroke", {Color = t.Stroke, Transparency = 0.45}),
        })
        local svSel = New("ImageLabel", {Name = "Sel", Image = "rbxassetid://4805639000", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5,0.5), Size = UDim2.new(0,16,0,16), Position = UDim2.fromScale(s, 1-v), ZIndex = 12})
        svSel.Parent = sv

        local hue = New("Frame", {Name = "Hue", Size = UDim2.new(0,18,1,0), Position = UDim2.new(1,0,0,0), BackgroundColor3 = Color3.new(1,1,1), ZIndex = 11})
        hue.Parent = picker
        Children(hue, {
            New("UICorner", {CornerRadius = UDim.new(1,0)}),
            New("UIGradient", {Rotation = 90, Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
            }}),
        })
        local hueSel = New("ImageLabel", {Name = "Sel", Image = "rbxassetid://4805639000", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5,0.5), Size = UDim2.new(0,18,0,18), Position = UDim2.new(0.5,0,1-h,0), ZIndex = 12})
        hueSel.Parent = hue

        local function update(fromSV, fromHue)
            obj.Value = Color3.fromHSV(h, s, v)
            sv.BackgroundColor3 = Color3.fromHSV(h,1,1)
            if not fromSV then svSel.Position = UDim2.fromScale(s, 1-v) end
            if not fromHue then hueSel.Position = UDim2.new(0.5,0,1-h,0) end
            swatch.BackgroundColor3 = obj.Value
            if cfg.Callback and not NovaLib.PanicEnabled then task.spawn(cfg.Callback, obj.Value) end
            if obj.Save then DebounceSave() end
        end

        local dragSV, dragHue = false, false
        Connect(sv.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragSV = true end end)
        Connect(sv.InputEnded, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragSV = false end end)
        Connect(hue.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragHue = true end end)
        Connect(hue.InputEnded, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragHue = false end end)
        Connect(UserInputService.InputChanged, function(i)
            if i.UserInputType ~= Enum.UserInputType.MouseMovement or not Mouse then return end
            if dragSV then
                s = clamp((i.Position.X - sv.AbsolutePosition.X) / math.max(1, sv.AbsoluteSize.X), 0, 1)
                v = 1 - clamp((i.Position.Y - sv.AbsolutePosition.Y) / math.max(1, sv.AbsoluteSize.Y), 0, 1)
                update(true, false)
            elseif dragHue then
                h = 1 - clamp((i.Position.Y - hue.AbsolutePosition.Y) / math.max(1, hue.AbsoluteSize.Y), 0, 1)
                update(false, true)
            end
        end)

        function obj:Set(c) h,s,v = Color3.toHSV(c or obj.Value); update(false,false) end
        obj:Set(obj.Value)
        Connect(click.MouseButton1Click, function()
            obj.Toggled = not obj.Toggled
            picker.Visible = obj.Toggled
            Tween(f, TweenInfo.new(0.16, Enum.EasingStyle.Quint), {Size = obj.Toggled and UDim2.new(1,0,0,190) or UDim2.new(1,0,0,44)})
        end)
        flag(obj, cfg)
        return obj
    end

    return api
end

