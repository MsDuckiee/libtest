local WindowIndex = 0
function NovaLib:MakeWindow(cfg)
    cfg = cfg or {}
    WindowIndex += 1
    local t = Themes[NovaLib.SelectedTheme]
    local win = {
        Name = cfg.Name or ("Nova " .. WindowIndex),
        Subtitle = cfg.Subtitle or "",
        Visible = true,
        Minimized = false,
        Tabs = {},
        Floating = {},
        cfg = cfg,
    }
    table.insert(NovaLib.Windows, win)

    NovaLib.Folder = cfg.ConfigFolder or cfg.Name or "NovaLib"
    NovaLib.SaveCfg = cfg.SaveConfig == true
    NovaLib.ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift

    local size = cfg.Size or UDim2.new(0, 720, 0, 430)
    local pos = cfg.Position or UDim2.new(0.5, -360, 0.5, -215)

    -- Root frame
    local root = New("Frame", {
        Name = win.Name,
        BackgroundColor3 = t.Main,
        BackgroundTransparency = 0.04,
        Size = size,
        Position = pos,
        ClipsDescendants = true,
        Visible = true,
        ZIndex = 1,
    })
    root.Parent = Nova
    Children(root, {
        New("UICorner", {CornerRadius = UDim.new(0,18)}),
        New("UIStroke", {Color = t.Stroke, Transparency = 0.18, Thickness = 1.2}),
        New("UIScale", {Scale = NovaLib.UIScale}),
    })

    -- FIX: Wash first (behind)
    local wash = AuroraWash()
    wash.Parent = root

    -- Top bar
    local top = New("Frame", {Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1,0,0,52), ZIndex = 10})
    top.Parent = root
    local titleLbl = New("TextLabel", {Name = "Title", BackgroundTransparency = 1, Text = win.Name, TextColor3 = t.Text, TextSize = 17 * NovaLib.TextScale, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(0,18,0,8), Size = UDim2.new(1,-220,0,22), ZIndex = 11})
    titleLbl.Parent = top
    local subtitleLbl = New("TextLabel", {Name = "Subtitle", BackgroundTransparency = 1, Text = win.Subtitle, TextColor3 = t.TextDark, TextSize = 12 * NovaLib.TextScale, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(0,18,0,30), Size = UDim2.new(1,-220,0,14), ZIndex = 11})
    subtitleLbl.Parent = top
    local topLine = New("Frame", {Name = "TopLine", BackgroundColor3 = t.Stroke, BackgroundTransparency = 0.2, BorderSizePixel = 0, Position = UDim2.new(0,0,1,-1), Size = UDim2.new(1,0,0,1), ZIndex = 11})
    topLine.Parent = top

    local controls = New("Frame", {Name = "Controls", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-14,0.5,0), Size = UDim2.new(0,142,0,34), ZIndex = 11})
    controls.Parent = top
    Children(controls, {New("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0,8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right})})

    local function ctrlBtn(name, text, sizeX, order)
        local b = New("TextButton", {Name = name, Text = text, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = t.Text, AutoButtonColor = false, BackgroundColor3 = t.Elevated, Size = UDim2.new(0,sizeX,1,0), LayoutOrder = order, ZIndex = 12})
        b.Parent = controls
        Children(b, {
            New("UICorner", {CornerRadius = UDim.new(1,0)}),
            New("UIStroke", {Color = t.Stroke, Transparency = 0.25}),
        })
        return b
    end
    local paletteBtn = ctrlBtn("Palette", "⌘K", 44, 1)
    local miniBtn = ctrlBtn("Mini", "–", 34, 2)
    local closeBtn = ctrlBtn("Close", "×", 34, 3)

    -- Body
    local body = New("Frame", {Name = "Body", BackgroundTransparency = 1, Position = UDim2.new(0,0,0,52), Size = UDim2.new(1,0,1,-52), ZIndex = 10})
    body.Parent = root

    local sidebar = New("Frame", {Name = "Sidebar", BackgroundColor3 = t.Panel, BackgroundTransparency = 0.08, Size = UDim2.new(0,176,1,0), ZIndex = 11})
    sidebar.Parent = body
    Children(sidebar, {
        New("UICorner", {CornerRadius = UDim.new(0,18)}),
        New("UIStroke", {Color = t.Stroke, Transparency = 0.3, Thickness = 1}),
    })
    local tabs = New("ScrollingFrame", {Name = "Tabs", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0,10,0,14), Size = UDim2.new(1,-20,1,-92), CanvasSize = UDim2.new(), ScrollBarThickness = 0, ZIndex = 12})
    tabs.Parent = sidebar
    local tabsList = List(6)
    tabsList.Parent = tabs

    local profile = New("Frame", {Name = "Profile", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0,1), Position = UDim2.new(0,12,1,-12), Size = UDim2.new(1,-24,0,58), ZIndex = 12})
    profile.Parent = sidebar
    Children(profile, {
        New("UICorner", {CornerRadius = UDim.new(0,14)}),
        New("UIStroke", {Color = t.Stroke, Transparency = 0.35}),
    })
    local avatar = New("ImageLabel", {Name = "Avatar", BackgroundColor3 = t.Elevated, Size = UDim2.new(0,38,0,38), Position = UDim2.new(0,10,0.5,0), AnchorPoint = Vector2.new(0,0.5), Image = LocalPlayer and ("https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=150&height=150&format=png") or "", ZIndex = 13})
    avatar.Parent = profile
    Children(avatar, {New("UICorner", {CornerRadius = UDim.new(1,0)})})
    local dispLbl = New("TextLabel", {Name = "Display", BackgroundTransparency = 1, Text = NovaLib.StreamerMode and "Streamer" or (LocalPlayer and LocalPlayer.DisplayName or "Player"), TextColor3 = t.Text, TextSize = 13 * NovaLib.TextScale, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(0,58,0,10), Size = UDim2.new(1,-66,0,16), ZIndex = 13})
    dispLbl.Parent = profile
    local userLbl = New("TextLabel", {Name = "User", BackgroundTransparency = 1, Text = NovaLib.StreamerMode and "@hidden" or (LocalPlayer and ("@" .. LocalPlayer.Name) or "@player"), TextColor3 = t.TextDark, TextSize = 11 * NovaLib.TextScale, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(0,58,0,28), Size = UDim2.new(1,-66,0,14), ZIndex = 13})
    userLbl.Parent = profile

    -- ============================================================
    -- CONTENT AREA
    -- FIX: no UIListLayout here (it was reflowing the page to 0x0)
    -- ============================================================
    local content = New("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Position = UDim2.new(0,188,0,0),
        Size = UDim2.new(1,-200,1,0),
        ZIndex = 11,
    })
    content.Parent = body
    Children(content, {Padding(10,12,10,12)})

    -- Drag handle
    local dragHandle = New("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.new(1,0,0,52), ZIndex = 20})
    dragHandle.Parent = root
    Dragify(dragHandle, root)

    function win:SetVisible(v)
        self.Visible = v
        root.Visible = v
    end
    function win:Toggle() self:SetVisible(not self.Visible) end
    function win:Destroy() root:Destroy() end
    win.Root = root

    Connect(closeBtn.MouseButton1Click, function()
        win:SetVisible(false)
        NovaLib:Notify({Name = "Hidden", Content = "Press " .. NovaLib.ToggleKey.Name .. " or ⌘K to reopen.", Time = 3})
        if cfg.CloseCallback then task.spawn(cfg.CloseCallback) end
    end)
    Connect(miniBtn.MouseButton1Click, function()
        win.Minimized = not win.Minimized
        Tween(root, TweenInfo.new(0.32, Enum.EasingStyle.Quint), {
            Size = win.Minimized and UDim2.new(0, math.max(360, titleLbl.TextBounds.X + 220), 0, 52) or size
        })
        body.Visible = not win.Minimized
    end)
    Connect(paletteBtn.MouseButton1Click, OpenPalette)
    Connect(UserInputService.InputBegan, function(inp)
        if inp.KeyCode == Enum.KeyCode.RightControl or (inp.KeyCode == Enum.KeyCode.K and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)) then
            OpenPalette()
        end
        if inp.KeyCode == NovaLib.ToggleKey and not UserInputService:GetFocusedTextBox() then
            win:Toggle()
        end
    end)

    Connect(tabsList:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        tabs.CanvasSize = UDim2.new(0,0,0, tabsList.AbsoluteContentSize.Y + 8)
    end)

    local firstTab = true

    local TabFunctions = {}
    function TabFunctions:MakeTab(tabCfg)
        tabCfg = tabCfg or {}
        local tabName = tabCfg.Name or "Tab"
        local tabIcon = Icon(tabCfg.Icon or "circle")

        local btn = New("TextButton", {Name = tabName, Text = "", AutoButtonColor = false, BackgroundColor3 = t.Elevated, BackgroundTransparency = firstTab and 0.05 or 0.25, Size = UDim2.new(1,0,0,38), ZIndex = 13})
        btn.Parent = tabs
        Children(btn, {
            New("UICorner", {CornerRadius = UDim.new(0,12)}),
            New("UIStroke", {Color = firstTab and t.Accent or t.Stroke, Transparency = firstTab and 0.15 or 0.5, Thickness = 1}),
        })
        local iconLbl = New("ImageLabel", {Name = "Ico", BackgroundTransparency = 1, Image = tabIcon, ImageColor3 = firstTab and t.Accent or t.TextDark, ImageTransparency = firstTab and 0 or 0.25, Size = UDim2.new(0,18,0,18), AnchorPoint = Vector2.new(0,0.5), Position = UDim2.new(0,12,0.5,0), ZIndex = 14})
        iconLbl.Parent = btn
        local nameLbl = New("TextLabel", {Name = "Title", BackgroundTransparency = 1, Text = tabName, TextColor3 = firstTab and t.Text or t.TextDark, TextTransparency = firstTab and 0 or 0.25, TextSize = 14 * NovaLib.TextScale, Font = firstTab and Enum.Font.GothamBold or Enum.Font.GothamSemibold, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1,-48,1,0), Position = UDim2.new(0,40,0,0), ZIndex = 14})
        nameLbl.Parent = btn
        local dockBtn = New("TextButton", {Name = "Dock", Text = "⇱", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = t.TextDark, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-8,0.5,0), Size = UDim2.new(0,26,0,26), ZIndex = 14})
        dockBtn.Parent = btn

        -- Page: full-size ScrollingFrame positioned at content origin
        local page = New("ScrollingFrame", {
            Name = "Page",
            Visible = firstTab,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 5,
            ScrollBarImageColor3 = t.Accent,
            ZIndex = 12,
        })
        page.Parent = content
        local pageList = List(9)
        pageList.Parent = page
        Connect(pageList:GetPropertyChangedSignal("AbsoluteContentSize"), function()
            page.CanvasSize = UDim2.new(0,0,0, pageList.AbsoluteContentSize.Y + 24)
        end)

        local tab = {Name = tabName, Button = btn, Page = page, Icon = iconLbl, Label = nameLbl, Container = page, Window = win}
        local host = ElementHost(page)
        tab._elements = host

        local function select()
            for _, b in ipairs(tabs:GetChildren()) do
                if b:IsA("TextButton") then
                    local s = b:FindFirstChildOfClass("UIStroke")
                    if s then s.Color = t.Stroke; s.Transparency = 0.55 end
                    local ico = b:FindFirstChild("Ico")
                    if ico then ico.ImageTransparency = 0.25; ico.ImageColor3 = t.TextDark end
                    local tl = b:FindFirstChild("Title")
                    if tl then tl.TextTransparency = 0.25; tl.TextColor3 = t.TextDark; tl.Font = Enum.Font.GothamSemibold end
                end
            end
            for _, p in ipairs(content:GetChildren()) do
                if p.Name == "Page" and p:IsA("ScrollingFrame") then p.Visible = false end
            end
            local s = btn:FindFirstChildOfClass("UIStroke")
            if s then s.Color = t.Accent; s.Transparency = 0.15 end
            iconLbl.ImageTransparency = 0; iconLbl.ImageColor3 = t.Accent
            nameLbl.TextTransparency = 0; nameLbl.TextColor3 = t.Text; nameLbl.Font = Enum.Font.GothamBold
            page.Visible = true
        end
        tab.Select = select
        Connect(btn.MouseButton1Click, select)
        Connect(dockBtn.MouseButton1Click, function()
            NovaLib:Notify({Name="Dock", Content="Dock is a visual-only mode in this build.", Time=2})
        end)

        RegisterCommand("Open " .. tabName, "Switch to tab", select, win.Name)

        firstTab = false
        table.insert(win.Tabs, tab)

        setmetatable(tab, {
            __index = function(self, k)
                local e = rawget(self, "_elements")
                if e and e[k] then return e[k] end
                if TabFunctions[k] then return TabFunctions[k] end
                return nil
            end,
        })
        return tab
    end

    win.TabFunctions = TabFunctions
    setmetatable(win, {
        __index = function(self, k)
            if TabFunctions[k] then return TabFunctions[k] end
            return rawget(self, k)
        end,
    })

    RegisterCommand("Minimize " .. win.Name, "Collapse window", function()
        if not win.Minimized then miniBtn.MouseButton1Click:Fire() end
    end, win.Name)

    return win
end

NovaLib.Window = function(self, cfg)
    cfg = cfg or {}
    cfg.Name = cfg.Name or cfg.Title or "NovaLib"
    return self:MakeWindow(cfg)
end

return NovaLib
