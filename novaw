local function Score(query, item)
    query = string.lower(query or "")
    if query == "" then return 1 end
    if string.find(item.Lower, query, 1, true) then return 2 end
    local qi, score = 1, 0
    for i = 1, #item.Name do
        local a = string.sub(string.lower(item.Name), i, i)
        local b = string.sub(query, qi, qi)
        if a == b then qi += 1; score += 2 end
    end
    return qi > #query and score or 0
end

local function OpenPalette()
    if Palette and Palette.Parent then Palette.Visible = not Palette.Visible return end
    local t = Themes[NovaLib.SelectedTheme]

    Palette = New("Frame", {Name = "CommandPalette", BackgroundColor3 = Color3.new(0,0,0), BackgroundTransparency = 0.35, Size = UDim2.fromScale(1,1), Visible = true, ZIndex = 900})
    Palette.Parent = Nova

    local dismiss = New("TextButton", {Name = "Dismiss", Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1,1), ZIndex = 901})
    dismiss.Parent = Palette

    local root = New("Frame", {AnchorPoint = Vector2.new(0.5,0.25), Position = UDim2.new(0.5,0,0.25,0), Size = UDim2.new(0,560,0,420), BackgroundColor3 = t.Panel, BackgroundTransparency = 0.03, ZIndex = 902})
    root.Parent = Palette
    Children(root, {
        New("UICorner", {CornerRadius = UDim.new(0,16)}),
        New("UIStroke", {Color = t.Stroke, Transparency = 0.15, Thickness = 1.2}),
    })

    local query = New("TextBox", {Name = "Query", BackgroundTransparency = 1, Text = "", PlaceholderText = "Search actions, tabs, toggles...  (Esc to close)", PlaceholderColor3 = t.TextDark, TextColor3 = t.Text, TextSize = 18 * NovaLib.TextScale, Font = Enum.Font.GothamSemibold, ClearTextOnFocus = false, Size = UDim2.new(1,-28,0,52), Position = UDim2.new(0,14,0,8), ZIndex = 903})
    query.Parent = root
    Children(query, {Padding(4,0,4,0)})

    local line = New("Frame", {Name = "Line", BackgroundColor3 = t.Stroke, BorderSizePixel = 0, Size = UDim2.new(1,-24,0,1), Position = UDim2.new(0,12,0,64), ZIndex = 903})
    line.Parent = root

    local results = New("ScrollingFrame", {Name = "Results", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1,-24,1,-76), Position = UDim2.new(0,12,0,72), CanvasSize = UDim2.new(), ScrollBarThickness = 4, ScrollBarImageColor3 = t.Accent, ZIndex = 903})
    results.Parent = root
    Children(results, {List(6)})

    local selected = 1
    local buttons = {}

    local function Render()
        for _, c in ipairs(results:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        table.clear(buttons)
        local ranked = {}
        for i, item in ipairs(PaletteIndex) do
            local s = Score(query.Text, item)
            if s > 0 then table.insert(ranked, {s=s, i=i, item=item}) end
        end
        table.sort(ranked, function(a,b) return a.s == b.s and a.i < b.i or a.s > b.s end)

        for rank, entry in ipairs(ranked) do
            local item = entry.item
            local isSel = rank == selected
            local b = New("TextButton", {AutoButtonColor = false, BackgroundColor3 = isSel and t.Accent or t.Elevated, BackgroundTransparency = 0.15, Text = "", Size = UDim2.new(1,0,0,46), ZIndex = 904})
            b.Parent = results
            Children(b, {New("UICorner", {CornerRadius = UDim.new(0,10)})})

            local nameLbl = Label(item.Name, 15, true)
            nameLbl.Size = UDim2.new(1,-130,0,20)
            nameLbl.Position = UDim2.new(0,12,0,6)
            nameLbl.TextColor3 = isSel and bestText(t.Accent) or t.Text
            nameLbl.ZIndex = 905
            nameLbl.Parent = b

            local descLbl = Label(item.Description, 12)
            descLbl.Size = UDim2.new(1,-130,0,16)
            descLbl.Position = UDim2.new(0,12,0,25)
            descLbl.TextColor3 = isSel and bestText(t.Accent) or t.TextDark
            descLbl.ZIndex = 905
            descLbl.Parent = b

            local scopeLbl = Label(item.Scope, 11, true)
            scopeLbl.Size = UDim2.new(0,90,0,16)
            scopeLbl.Position = UDim2.new(1,-102,0,15)
            scopeLbl.TextXAlignment = Enum.TextXAlignment.Right
            scopeLbl.TextColor3 = isSel and bestText(t.Accent) or t.Accent
            scopeLbl.ZIndex = 905
            scopeLbl.Parent = b

            table.insert(buttons, b)
            Connect(b.MouseButton1Click, function() Palette.Visible = false task.spawn(item.Run) end)
            if #buttons >= 12 then break end
        end
        results.CanvasSize = UDim2.new(0,0,0, math.max(0, (#buttons * 52) - 6))
    end

    Render()
    Connect(query:GetPropertyChangedSignal("Text"), function() selected = 1 Render() end)
    Connect(dismiss.MouseButton1Click, function() Palette.Visible = false end)
    Connect(UserInputService.InputBegan, function(inp)
        if not Palette.Visible then return end
        if inp.KeyCode == Enum.KeyCode.Escape then Palette.Visible = false
        elseif inp.KeyCode == Enum.KeyCode.Down then selected = math.min(#buttons, selected + 1) Render()
        elseif inp.KeyCode == Enum.KeyCode.Up then selected = math.max(1, selected - 1) Render()
        elseif inp.KeyCode == Enum.KeyCode.Return then
            local b = buttons[selected]
            if b then b.MouseButton1Click:Fire() end
        end
    end)
    query:CaptureFocus()
end
