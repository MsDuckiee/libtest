        TextColor3 = t.TextDim,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, {})
    body.Parent = card

    TweenService:Create(card, EASE.normal, {
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 0,
