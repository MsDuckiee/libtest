            --========== KEYBIND ==========
            function Section:Keybind(cfg)
                cfg = cfg or {}
                local key = cfg.Default or Enum.KeyCode.Unknown
                local recording = false

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = t.CardHi,
                    BackgroundTransparency = 0.15,
                    BorderSizePixel = 0,
                }, {})
                row.Parent = body
                local rc2 = Instance.new("UICorner"); rc2.CornerRadius = UDim.new(0, 8); rc2.Parent = row
                stroke(t.Stroke, 1, row, 0.6)

                local lbl = mk("TextLabel", {
                    Size = UDim2.new(0.6, 0, 1, 0),
                    Position = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text = cfg.Name or "Keybind",
                    TextColor3 = t.Text,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, {})
                lbl.Parent = row

                local keyBtn = mk("TextButton", {
                    Size = UDim2.new(0, 90, 0, 24),
                    Position = UDim2.new(1, -100, 0.5, 0),
                    AnchorPoint = Vector2.new(0, 0.5),
                    BackgroundColor3 = t.Panel,
                    BorderSizePixel = 0,
                    Text = key.Name,
                    TextColor3 = self.Accent,
                    Font = Enum.Font.Code,
                    TextSize = 12,
                }, {})
                keyBtn.Parent = row
                local kbc = Instance.new("UICorner"); kbc.CornerRadius = UDim.new(0, 6); kbc.Parent = keyBtn

                conn(keyBtn.MouseButton1Click, function()
                    recording = true
                    keyBtn.Text = "..."
                end)

                local connKey = conn(UserInputService.InputBegan, function(input, processed)
                    if recording then
                        local k = input.KeyCode
                        if k ~= Enum.KeyCode.Unknown then
                            key = k
                            keyBtn.Text = k.Name
                            recording = false
                            if cfg.Callback then task.spawn(cfg.Callback, k) end
                        end
                    elseif input.KeyCode == key then
                        if cfg.Callback then task.spawn(cfg.Callback, key) end
                    end
                end)

                local api = {}
                function api:Set(k) key = k; keyBtn.Text = k.Name end
                function api:Get() return key end
                api.Type = "Keybind"

                if cfg.Flag then self.Flags[cfg.Flag] = api end
                registerElement(row, cfg.Name or "Keybind")
                return api
            end

