                TweenService:Create(tb.Button, EASE.fast, {BackgroundTransparency = 1}):Play()
                TweenService:Create(tb.Icon, EASE.fast, {TextColor3 = t.TextDim}):Play()
                TweenService:Create(tb.Label, EASE.fast, {TextColor3 = t.TextDim}):Play()
