    local search = mk("TextBox", {
        Size = UDim2.new(1, -24, 0, 44),
        Position = UDim2.new(0, 12, 0, 12),
        BackgroundColor3 = t.Card,
        BorderSizePixel = 0,
        Text = "",
        PlaceholderText = "🔍  Type to search commands...",
        PlaceholderColor3 = t.TextDim,
        TextColor3 = t.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    }, {})
    search.Parent = pg
    local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(0, 8); sc.Parent = search
    local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 12); sp.Parent = search

    local listFrame = mk("ScrollingFrame", {
        Size = UDim2.new(1, -24, 1, -80),
        Position = UDim2.new(0, 12, 0, 64),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = NovaLib.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, {})
    listFrame.Parent = pg
    mk("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, {listFrame})

    local function refresh(query)
        for _, c in ipairs(listFrame:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        query = (query or ""):lower()
        for i, el in ipairs(paletteElements) do
            if query == "" or el.name:lower():find(query, 1, true) then
                local btn = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = t.Card,
                    BackgroundTransparency = 0.4,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    LayoutOrder = i,
                }, {})
                btn.Parent = listFrame
                local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 6); bc.Parent = btn
                local lbl = mk("TextLabel", {
                    Size = UDim2.new(1, -16, 1, 0),
                    Position = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text = el.name,
                    TextColor3 = t.Text,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, {})
                lbl.Parent = btn
                local tag = mk("TextLabel", {
                    Size = UDim2.new(0, 80, 1, 0),
                    Position = UDim2.new(1, -90, 0, 0),
                    BackgroundTransparency = 1,
                    Text = el.tab or "",
                    TextColor3 = NovaLib.Accent,
                    Font = Enum.Font.GothamBold,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, {})
                tag.Parent = btn
                conn(btn.MouseEnter, function()
                    TweenService:Create(btn, EASE.fast, {BackgroundTransparency = 0}):Play()
                end)
                conn(btn.MouseLeave, function()
                    TweenService:Create(btn, EASE.fast, {BackgroundTransparency = 0.4}):Play()
                end)
                conn(btn.MouseButton1Click, function()
                    pg:Destroy(); paletteGui = nil
                    if el.onClick then el.onClick() end
                end)
            end
        end
    end

    conn(search:GetPropertyChangedSignal("Text"), function()
        refresh(search.Text)
    end)
    refresh("")
    paletteGui = pg
    search:CaptureFocus()
end

conn(UserInputService.InputBegan, function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.K and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        openPalette()
    end
end)

NovaLib.OpenPalette = openPalette

