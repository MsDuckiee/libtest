                local function update(v)
                    value = v
                    TweenService:Create(track, EASE.fast, {BackgroundColor3 = v and onColor or t.Divider}):Play()
                    TweenService:Create(knob, EASE.fast, {
                        Position = v and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
                    }):Play()
