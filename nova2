            --========== DROPDOWN (supports multi-select) ==========
            function Section:Dropdown(cfg)
                cfg = cfg or {}
                local multi = cfg.Multi or false
                local options = cfg.Options or {}
                local selected = {}
                if multi then
                    for _, v in ipairs(cfg.Default or {}) do selected[v] = true end
                else
                    if cfg.Default then selected[cfg.Default] = true end
                end
                local open = false

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = t.CardHi,
                    BackgroundTransparency = 0.15,
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                }, {})
                row.Parent = body
                local rc2 = Instance.new("UICorner"); rc2.CornerRadius = UDim.new(0, 8); rc2.Parent = row
                stroke(t.Stroke, 1, row, 0.6)

                local header = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundTransparency = 1,
                    Text = "",
                }, {})
                header.Parent = row

                local lbl = mk("TextLabel", {
                    Size = UDim2.new(0.5, 0, 1, 0),
                    Position = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text = cfg.Name or "Select",
                    TextColor3 = t.Text,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, {})
                lbl.Parent = header

                local valLbl = mk("TextLabel", {
                    Size = UDim2.new(0.5, -40, 1, 0),
                    Position = UDim2.new(0.5, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    TextColor3 = self.Accent,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, {})
                valLbl.Parent = header

                local arrow = mk("TextLabel", {
                    Size = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -26, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "▾",
                    TextColor3 = t.TextDim,
                    Font = Enum.Font.GothamBold,
                    TextSize = 12,
                }, {})
                arrow.Parent = header

                local list = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 0, 34),
                    BackgroundTransparency = 1,
                }, {})
                list.Parent = row
                mk("UIListLayout", {Padding = UDim.new(0, 2)}, {list})
                mk("UIPadding", {
                    PaddingLeft = UDim.new(0, 6),
                    PaddingRight = UDim.new(0, 6),
                    PaddingBottom = UDim.new(0, 6),
                }, {list})

                local optionButtons = {}
                local function refreshLabel()
                    local arr = {}
                    for k in pairs(selected) do table.insert(arr, k) end
                    if #arr == 0 then valLbl.Text = "none"
                    elseif multi then valLbl.Text = #arr .. " selected"
                    else valLbl.Text = arr[1] end
                end

                local function buildOptions()
                    for _, b in ipairs(optionButtons) do b:Destroy() end
                    optionButtons = {}
                    for _, opt in ipairs(options) do
                        local ob = mk("TextButton", {
                            Size = UDim2.new(1, 0, 0, 28),
                            BackgroundColor3 = t.Panel,
                            BackgroundTransparency = 0.3,
                            BorderSizePixel = 0,
                            Text = "",
                            AutoButtonColor = false,
                        }, {})
                        ob.Parent = list
                        local obc = Instance.new("UICorner"); obc.CornerRadius = UDim.new(0, 6); obc.Parent = ob

                        local indicatorDot = mk("Frame", {
                            Size = UDim2.new(0, 12, 0, 12),
                            Position = UDim2.new(0, 8, 0.5, 0),
                            AnchorPoint = Vector2.new(0, 0.5),
                            BackgroundColor3 = selected[opt] and self.Accent or t.Divider,
                            BorderSizePixel = 0,
                        }, {})
                        indicatorDot.Parent = ob
                        local idc = Instance.new("UICorner"); idc.CornerRadius = UDim.new(1, 0); idc.Parent = indicatorDot

                        local txt = mk("TextLabel", {
                            Size = UDim2.new(1, -30, 1, 0),
                            Position = UDim2.new(0, 28, 0, 0),
                            BackgroundTransparency = 1,
                            Text = opt,
                            TextColor3 = t.Text,
                            Font = Enum.Font.Gotham,
                            TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left,
                        }, {})
                        txt.Parent = ob

                        conn(ob.MouseButton1Click, function()
                            if multi then
                                selected[opt] = not selected[opt] or nil
                            else
                                for k in pairs(selected) do selected[k] = nil end
                                selected[opt] = true
                                open = false
                                TweenService:Create(row, EASE.fast, {Size = UDim2.new(1, 0, 0, 34)}):Play()
                                arrow.Rotation = 0
                            end
                            indicatorDot.BackgroundColor3 = selected[opt] and self.Accent or t.Divider
                            refreshLabel()
                            if cfg.Callback then
                                if multi then
                                    local arr = {}
                                    for k in pairs(selected) do table.insert(arr, k) end
                                    task.spawn(cfg.Callback, arr)
                                else
                                    task.spawn(cfg.Callback, opt)
                                end
                            end
                        end)

                        table.insert(optionButtons, ob)
                    end
                end

                conn(header.MouseButton1Click, function()
                    open = not open
                    local h = open and (#options * 30 + 40) or 34
                    TweenService:Create(row, EASE.normal, {Size = UDim2.new(1, 0, 0, h)}):Play()
                    arrow.Rotation = open and 180 or 0
                end)

                buildOptions()
                refreshLabel()

                local api = {}
                function api:Set(v)
                    selected = {}
                    if multi then
                        for _, x in ipairs(v) do selected[x] = true end
                    else selected[v] = true end
                    buildOptions()
                    refreshLabel()
                end
                function api:Get()
                    if multi then
                        local arr = {}
                        for k in pairs(selected) do table.insert(arr, k) end
                        return arr
                    end
                    for k in pairs(selected) do return k end
                end
                function api:Refresh(newOpts, keep)
                    options = newOpts
                    if not keep then selected = {} end
                    buildOptions()
                    refreshLabel()
                end
                api.Type = "Dropdown"
                api.Multi = multi

                if cfg.Flag then self.Flags[cfg.Flag] = api end
