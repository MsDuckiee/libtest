            --========== COLORPICKER ==========
            function Section:Colorpicker(cfg)
                cfg = cfg or {}
                local hue, sat, val = Color3.toHSV(cfg.Default or Color3.new(1,1,1))
                local current = cfg.Default or Color3.new(1,1,1)
                local open = false

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = t.CardHi,
                    BackgroundTransparency = 0.15,
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                }, {})
                row.Parent = body
                local rc2 = Instance.new("UICorner"); rc2.CornerRadius = UDim.new(0, 8); rc2.Parent = row
                stroke(t.Stroke, 1, row, 0.6)

                local lbl = mk("TextLabel", {
                    Size = UDim2.new(0.6, 0, 1, 0),
                    Position = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text = cfg.Name or "Color",
                    TextColor3 = t.Text,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, {})
                lbl.Parent = row

                local swatch = mk("Frame", {
                    Size = UDim2.new(0, 24, 0, 24),
                    Position = UDim2.new(1, -36, 0.5, 0),
                    AnchorPoint = Vector2.new(0, 0.5),
                    BackgroundColor3 = current,
                    BorderSizePixel = 0,
                }, {})
                swatch.Parent = row
                local swc = Instance.new("UICorner"); swc.CornerRadius = UDim.new(0, 6); swc.Parent = swatch

                local picker = mk("Frame", {
                    Size = UDim2.new(1, -24, 0, 100),
                    Position = UDim2.new(0, 12, 0, 44),
                    BackgroundTransparency = 1,
                }, {})
                picker.Parent = row

                local sv = mk("ImageLabel", {
                    Size = UDim2.new(1, -30, 1, 0),
                    BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
                    BorderSizePixel = 0,
                    Image = "rbxassetid://4155801252",
                }, {})
                sv.Parent = picker
                local svc = Instance.new("UICorner"); svc.CornerRadius = UDim.new(0, 8); svc.Parent = sv

                local hueBar = mk("Frame", {
                    Size = UDim2.new(0, 20, 1, 0),
                    Position = UDim2.new(1, -20, 0, 0),
                    BackgroundColor3 = Color3.new(1,1,1),
                    BorderSizePixel = 0,
                }, {})
                hueBar.Parent = picker
                local hbc = Instance.new("UICorner"); hbc.CornerRadius = UDim.new(0, 8); hbc.Parent = hueBar
                local hg = Instance.new("UIGradient")
                hg.Rotation = 270
                hg.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                    ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                    ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                    ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                    ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)),
                    ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                    ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
                })
                hg.Parent = hueBar

                local header = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundTransparency = 1,
                    Text = "",
                }, {})
                header.Parent = row

                conn(header.MouseButton1Click, function()
                    open = not open
                    TweenService:Create(row, EASE.normal, {
                        Size = open and UDim2.new(1, 0, 0, 160) or UDim2.new(1, 0, 0, 34),
                    }):Play()
                end)

                local function updateColor()
                    current = Color3.fromHSV(hue, sat, val)
                    swatch.BackgroundColor3 = current
                    sv.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                    if cfg.Callback then task.spawn(cfg.Callback, current) end
                end

                local dragSV, dragHue = false, false
                conn(sv.InputBegan, function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragSV = true end
                end)
                conn(hueBar.InputBegan, function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragHue = true end
                end)
                conn(UserInputService.InputEnded, function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragSV, dragHue = false, false
                    end
                end)
                conn(RunService.RenderStepped, function()
                    if dragSV then
                        sat = math.clamp((Mouse.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
                        val = 1 - math.clamp((Mouse.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
                        updateColor()
                    elseif dragHue then
                        hue = 1 - math.clamp((Mouse.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
                        updateColor()
                    end
                end)

                local api = {}
                function api:Set(c)
                    hue, sat, val = Color3.toHSV(c)
                    updateColor()
                end
                function api:Get() return current end
                api.Type = "Colorpicker"
                api.Value = current

                if cfg.Flag then self.Flags[cfg.Flag] = api end
                registerElement(row, cfg.Name or "Color")
                return api
            end

            refreshSize()
            return Section
        end

        table.insert(tabs, tabObj)
        if #tabs == 1 then activate() end
        return Tab
    end

    --=================================================================
    -- CLOSE / TOGGLE
    --=================================================================
    local hidden = false
    conn(UserInputService.InputBegan, function(input, processed)
        if processed then return end
        if input.KeyCode == toggle then
            hidden = not hidden
            root.Visible = not hidden
        end
    end)

    Window.Close = function() root:Destroy() end
    Window.Hide  = function() hidden = true; root.Visible = false end
    Window.Show  = function() hidden = false; root.Visible = true end
    Window.Root  = root

    return Window
end

--=====================================================================
-- FLAG LINKING (unique cross-element feature)
--=====================================================================
function NovaLib:Link(flagA, flagB, transform)
    local a = self.Flags[flagA]
    local b = self.Flags[flagB]
    if not a or not b then return end
    if a.Type == "Toggle" and b.Type == "Toggle" then
        local suppress = false
        local origA, origB = a.Set, b.Set
        function a:Set(v)
            origA(self, v)
            if suppress then return end
            suppress = true
            origB(b, transform and transform(v) or v)
            suppress = false
        end
        function b:Set(v)
            origB(self, v)
            if suppress then return end
            suppress = true
            origA(a, transform and transform(v) or v)
            suppress = false
        end
    end
end

--=====================================================================
-- CONFIG SAVE/LOAD (JSON)
--=====================================================================
function NovaLib:SaveConfig(name)
    name = name or "default"
    local data = {}
    for flag, obj in pairs(self.Flags) do
        if obj.Value ~= nil then
            if obj.Type == "Colorpicker" then
                data[flag] = {R = obj.Value.R, G = obj.Value.G, B = obj.Value.B}
            else
                data[flag] = obj.Value
            end
        end
    end
    pcall(function()
        if not isfolder(self.Folder) then makefolder(self.Folder) end
        writefile(self.Folder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    end)
end

function NovaLib:LoadConfig(name)
    name = name or "default"
    local path = self.Folder .. "/" .. name .. ".json"
    pcall(function()
        if isfile(path) then
            local data = HttpService:JSONDecode(readfile(path))
            for flag, v in pairs(data) do
                local obj = self.Flags[flag]
                if obj then
                    if obj.Type == "Colorpicker" then
                        obj:Set(Color3.new(v.R, v.G, v.B))
                    else
                        obj:Set(v)
                    end
                end
            end
        end
    end)
end

--=====================================================================
-- CLEANUP
--=====================================================================
function NovaLib:Destroy()
    for _, c in ipairs(self.Connections) do
        pcall(function() c:Disconnect() end)
    end
    screen:Destroy()
end

return NovaLib
