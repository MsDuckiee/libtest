                end)

                local api = {}
                function api:Set(v) update(v); if cfg.Callback then task.spawn(cfg.Callback, v) end end
                function api:Get() return value end
                api.Type = "Toggle"
                api.Value = value

                if flag then self.Flags[flag] = api end
                registerElement(row, cfg.Name or "Toggle")
                return api
            end

            --========== SLIDER ==========
            function Section:Slider(cfg)
                cfg = cfg or {}
                local min, max = cfg.Min or 0, cfg.Max or 100
                local inc      = cfg.Increment or 1
                local value    = cfg.Default or min
                local flag     = cfg.Flag

                local row = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 52),
                    BackgroundColor3 = t.CardHi,
                    BackgroundTransparency = 0.15,
                    BorderSizePixel = 0,
                }, {})
                row.Parent = body
                local rc2 = Instance.new("UICorner"); rc2.CornerRadius = UDim.new(0, 8); rc2.Parent = row
                stroke(t.Stroke, 1, row, 0.6)

                local lbl = mk("TextLabel", {
                    Size = UDim2.new(1, -30, 0, 16),
                    Position = UDim2.new(0, 12, 0, 8),
                    BackgroundTransparency = 1,
                    Text = cfg.Name or "Slider",
                    TextColor3 = t.Text,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, {})
                lbl.Parent = row

                local valLbl = mk("TextLabel", {
                    Size = UDim2.new(1, -30, 0, 16),
                    Position = UDim2.new(0, 12, 0, 8),
                    BackgroundTransparency = 1,
                    Text = tostring(value) .. " " .. (cfg.ValueName or ""),
                    TextColor3 = self.Accent,
                    Font = Enum.Font.Code,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, {})
                valLbl.Parent = row

                local track = mk("Frame", {
                    Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.new(0, 12, 1, -16),
                    BackgroundColor3 = t.Divider,
                    BorderSizePixel = 0,
                }, {})
                track.Parent = row
                local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(1, 0); tc.Parent = track

                local fill = mk("Frame", {
                    Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = self.Accent,
                    BorderSizePixel = 0,
                }, {})
                fill.Parent = track
                local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(1, 0); fc.Parent = fill
                grad(self.Accent, self.Themes[self.SelectedTheme].Accent2, 0, fill)

                local handle = mk("Frame", {
                    Size = UDim2.new(0, 14, 0, 14),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
                    BackgroundColor3 = Color3.new(1,1,1),
                    BorderSizePixel = 0,
                }, {})
                handle.Parent = track
                local hc = Instance.new("UICorner"); hc.CornerRadius = UDim.new(1, 0); hc.Parent = handle

                local dragging = false
                conn(track.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                    end
                end)
                conn(UserInputService.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                local api = {}
                function api:Set(v)
                    v = math.clamp(tonumber(v) or value, min, max)
                    v = math.floor(v / inc + 0.5) * inc
                    value = v
                    local pct = (v - min) / (max - min)
                    TweenService:Create(fill, EASE.fast, {Size = UDim2.new(pct, 0, 1, 0)}):Play()
                    TweenService:Create(handle, EASE.fast, {Position = UDim2.new(pct, 0, 0.5, 0)}):Play()
                    valLbl.Text = tostring(v) .. " " .. (cfg.ValueName or "")
                    if cfg.Callback then task.spawn(cfg.Callback, v) end
                end
                function api:Get() return value end
                api.Type = "Slider"
                api.Value = value

                conn(UserInputService.InputChanged, function(input)
                    if not dragging then return end
                    if input.UserInputType ~= Enum.UserInputType.MouseMovement
                    and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    api:Set(min + (max - min) * pct)
                end)

                if flag then self.Flags[flag] = api end
                registerElement(row, cfg.Name or "Slider")
                return api
            end

