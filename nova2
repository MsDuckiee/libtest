--=====================================================================
-- UTILITIES
--=====================================================================
local function conn(signal, fn)
    local c = signal:Connect(fn)
    table.insert(NovaLib.Connections, c)
    return c
end

local function mk(class, props, children)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = o end
    return o
end

local function corner(r, parent)
    return mk("UICorner", {CornerRadius = UDim.new(0, r)}, {parent and nil or nil}) or
           (function() local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = parent; return c end)()
end

local function stroke(color, thickness, parent, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.new(1,1,1)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function grad(c1, c2, rot, parent)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c1, c2)
    g.Rotation = rot or 0
    g.Parent = parent
    return g
end

local EASE = {
    fast    = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    normal  = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    slow    = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    pop     = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    bounce  = TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
}

--=====================================================================
-- 🌀 RIPPLE EFFECT (signature feature)
--=====================================================================
local function attachRipple(button)
    local rippleHolder = mk("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = button.ZIndex + 1,
    }, {})
    rippleHolder.Parent = button

    conn(button.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local pos = input.Position
        local rel = Vector2.new(
            pos.X - button.AbsolutePosition.X,
            pos.Y - button.AbsolutePosition.Y
        )
        local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2
        local r = Instance.new("Frame")
        r.BackgroundColor3 = NovaLib.Accent
        r.BackgroundTransparency = 0.55
        r.BorderSizePixel = 0
        r.Size = UDim2.fromOffset(0, 0)
        r.Position = UDim2.fromOffset(rel.X, rel.Y)
        r.AnchorPoint = Vector2.new(0.5, 0.5)
        r.ZIndex = rippleHolder.ZIndex
        r.Parent = rippleHolder
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = r

        TweenService:Create(r, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(size, size),
            BackgroundTransparency = 1,
        }):Play()
        task.delay(0.6, function() r:Destroy() end)
    end)
end

--=====================================================================
-- 🕐 LIVE STATUS BAR (FPS / Ping / Clock — unique feature)
--=====================================================================
local function startStatusBar(label, root)
    task.spawn(function()
        local frames = 0
        local last = tick()
        local fps = 60
        RunService.RenderStepped:Connect(function()
            frames = frames + 1
            if tick() - last >= 1 then
                fps = frames
                frames = 0
                last = tick()
            end
        end)
        while label.Parent do
            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            label.Text = string.format("● %d FPS  ●  %d ms  ●  %s",
                fps, ping, os.date("%H:%M:%S"))
            task.wait(0.5)
        end
    end)
end

