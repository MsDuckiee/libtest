function NovaLib:SetTheme(name)
    if not self.Themes[name] then return end
    self.SelectedTheme = name
    local t = self.Themes[name]
    self.Accent = t.Accent
    for _, obj in ipairs(self.ThemeObjects) do
        if obj.map then
            for prop, key in pairs(obj.map) do
                pcall(function() obj.instance[prop] = t[key] end)
            end
        end
    end
end

function NovaLib:GetThemes()
    local out = {}
    for k in pairs(self.Themes) do table.insert(out, k) end
    table.sort(out)
    return out
end

local function Theme(instance, map)
    table.insert(NovaLib.ThemeObjects, {instance = instance, map = map})
    local t = NovaLib.Themes[NovaLib.SelectedTheme]
    for prop, key in pairs(map) do
        pcall(function() instance[prop] = t[key] end)
    end
end

