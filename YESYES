-- Utility Functions
local function mk(class, props)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    if props then
        for k, v in pairs(props) do
            inst[k] = v
        end
    end
    return inst
end

local function round(parent, r)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, r)
    corner.Parent = parent
    return corner
end

local function outline(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Colors.Border
    stroke.Thickness = thickness or 1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

local function play(obj, dur, props, style)
    if not obj or not obj.Parent then return end
    local info = TweenInfo.new(dur, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local tw = TweenService:Create(obj, info, props)
    tw:Play()
    return tw
end

-- Notification System
local Notifications = {active = {}, max = 5}

function Nihon:Notify(cfg)
    cfg = cfg or {}
    local title = tostring(cfg.Name or cfg.Title or "Notification")
    local content = tostring(cfg.Content or "")
    local kind = cfg.Type or "Info"
    
    local colors = {
        Info = Colors.AccentLight,
        Success = Colors.Success,
        Error = Colors.Error,
    }
    
    local note = mk("Frame", {
        Size = UDim2.new(0, 280, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Colors.Surface,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Parent = Root,
    })
    round(note, 12)
    outline(note, colors[kind], 1)
    
    local pad = mk("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        Parent = note,
    })
    
    local titleLbl = mk("TextLabel", {
        Text = title,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextColor3 = Colors.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        Parent = note,
    })
    
    local contentLbl = mk("TextLabel", {
        Text = content,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextColor3 = Colors.SubText,
        TextWrapped = true,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 22),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = note,
    })
    
    table.insert(Notifications.active, note)
    
    -- Position
    local yPos = 20
    for i, n in ipairs(Notifications.active) do
        n.Position = UDim2.new(1, -300, 0, yPos)
        yPos = yPos + n.AbsoluteSize.Y + 10
    end
    
    -- Auto-dismiss
    task.delay(4, function()
        if note.Parent then
            play(note, 0.3, {BackgroundTransparency = 1})
            task.delay(0.35, function() note:Destroy() end)
        end
    end)
end

-- Main Window Creation
function Nihon:MakeWindow(cfg)
    cfg = cfg or {}
    
    local Window = {
        Name = tostring(cfg.Name or "UI Library"),
        Tabs = {},
        Selected = nil,
        Hidden = false,
    }
    
    table.insert(Nihon.Windows, Window)
    
    -- Main Shell
    local shell = mk("Frame", {
        Name = "Window",
        Size = UDim2.fromOffset(920, 640),
        Position = UDim2.new(0.5, -460, 0.5, -320),
        BackgroundColor3 = Colors.Bg,
        BackgroundTransparency = 0.05,
        Parent = Root,
    })
    round(shell, 16)
    outline(shell, Colors.Border, 1)
    
    -- Header
    local header = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = Colors.Surface,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Parent = shell,
    })
    outline(header, Colors.Border, 1)
    
    local titleLbl = mk("TextLabel", {
        Text = Window.Name,
        TextSize = 16,
        Font = Enum.Font.GothamBold,
        TextColor3 = Colors.Text,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 12),
        Size = UDim2.new(0, 300, 0, 26),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header,
    })
    
    -- Header Buttons
    local minBtn = mk("TextButton", {
        Text = "−",
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        TextColor3 = Colors.Text,
        BackgroundColor3 = Colors.Card,
        BackgroundTransparency = 0.5,
        Size = UDim2.fromOffset(40, 32),
        Position = UDim2.new(1, -90, 0.5, -16),
        Parent = header,
    })
    round(minBtn, 8)
    
    local closeBtn = mk("TextButton", {
        Text = "×",
        TextSize = 20,
        Font = Enum.Font.GothamBold,
        TextColor3 = Colors.Text,
        BackgroundColor3 = Colors.Error,
        BackgroundTransparency = 0.5,
        Size = UDim2.fromOffset(40, 32),
        Position = UDim2.new(1, -44, 0.5, -16),
        Parent = header,
    })
    round(closeBtn, 8)
    
    -- Sidebar
    local sidebar = mk("Frame", {
        Size = UDim2.new(0, 140, 1, -50),
        Position = UDim2.new(0, 0, 0, 50),
        BackgroundColor3 = Colors.Surface,
        BackgroundTransparency = 0.5,
        Parent = shell,
    })
    outline(sidebar, Colors.Border, 1)
    
    local tabList = mk("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = sidebar,
    })
    
    local listLayout = mk("UIListLayout", {
        Padding = UDim.new(0, 8),
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = tabList,
    })
    
    mk("UIPadding", {
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        Parent = tabList,
    })
    
    -- Content Area
    local content = mk("Frame", {
        Size = UDim2.new(1, -140, 1, -50),
        Position = UDim2.new(0, 140, 0, 50),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = shell,
    })
    
    -- Dragging
    local dragging = false
    local dragStart = nil
    
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
        end
    end)
    
    header.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and dragStart then
            local delta = input.Position - dragStart
            shell.Position = shell.Position + UDim2.fromOffset(delta.X, delta.Y)
            dragStart = input.Position
        end
    end)
    
    -- Tab Management
    function Window:MakeTab(tabName)
        tabName = tostring(tabName or "Tab")
        local idx = #self.Tabs + 1
        
        local tab = {Name = tabName, Elements = {}}
        self.Tabs[idx] = tab
        
        -- Tab Button
        local tabBtn = mk("TextButton", {
            Text = "",
            BackgroundColor3 = Colors.Card,
            BackgroundTransparency = 0.6,
            Size = UDim2.new(1, -16, 0, 36),
            Parent = tabList,
            LayoutOrder = idx,
        })
        round(tabBtn, 8)
        
        local tabLabel = mk("TextLabel", {
            Text = tabName,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextColor3 = Colors.SubText,
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Parent = tabBtn,
        })
        
        -- Tab Content
        local tabContent = mk("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Visible = false,
            ClipsDescendants = true,
            Parent = content,
        })
        
        local scroll = mk("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            ScrollBarThickness = 4,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Parent = tabContent,
        })
        
        mk("UIListLayout", {
            Padding = UDim.new(0, 12),
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = scroll,
        })
        
        mk("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
            Parent = scroll,
        })
        
        -- Tab Selection
        tabBtn.MouseButton1Click:Connect(function()
            for _, t in ipairs(self.Tabs) do
                if t.Content then t.Content.Visible = false end
            end
            self.Selected = tab
            tabContent.Visible = true
            
            play(tabBtn, 0.2, {BackgroundTransparency = 0.2})
            tabLabel.TextColor3 = Colors.Accent
        end)
        
        tab.Button = tabBtn
        tab.Content = tabContent
        tab.Scroll = scroll
        
        -- Add elements
        function tab:AddSection(name)
            name = tostring(name or "Section")
            local section = mk("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder = #self.Elements + 1,
                Parent = scroll,
            })
            
            mk("UIListLayout", {
                Padding = UDim.new(0, 8),
                FillDirection = Enum.FillDirection.Vertical,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = section,
            })
            
            -- Section Title
            local sectionTitle = mk("TextLabel", {
                Text = string.upper(name),
                TextSize = 11,
                Font = Enum.Font.GothamBold,
                TextColor3 = Colors.Accent,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 16),
                LayoutOrder = 0,
                Parent = section,
            })
            
            self.Elements[name] = section
            
            return {Section = section, Parent = tab}
        end
        
        if idx == 1 then
            tabBtn:FireButton(Enum.UserInputType.MouseButton1)
        end
        
        return tab
    end
    
    -- Close and Minimize
    closeBtn.MouseButton1Click:Connect(function()
        play(shell, 0.3, {BackgroundTransparency = 1})
        task.delay(0.35, function() shell:Destroy() end)
        Nihon:Notify({Name = "Window Closed", Type = "Info"})
    end)
    
    minBtn.MouseButton1Click:Connect(function()
        if content.Visible then
            content.Visible = false
            sidebar.Visible = false
            shell.Size = UDim2.fromOffset(920, 50)
        else
            content.Visible = true
            sidebar.Visible = true
            shell.Size = UDim2.fromOffset(920, 640)
        end
    end)
    
    Window.Shell = shell
    Window.Content = content
    
    return Window
end

