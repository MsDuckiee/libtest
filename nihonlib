    local function show(fromMorph)
        Window.Morphing = false
        if tweens[shell] then
            for _, tw in pairs(tweens[shell]) do
                pcall(function() tw:Cancel() end)
            end
        end
        Window.Hidden = false
        applyScale(false)

        uiScale.Scale = activeScale
        shell.AnchorPoint = Vector2.new(0.5, 0.5)
