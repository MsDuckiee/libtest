-- ============================================================
-- DRAG — v5.1, simple and reliable
-- ============================================================
-- Rules:
--   * target's AnchorPoint must be (0,0) before drag starts (we set it).
--   * Delta comes directly from input.Position, never from AbsolutePosition.
--   * We keep `basePos` at drag start; every frame we just do base + delta.
--   * clamp keeps everything inside the viewport.
--   * We absolutely do NOT read AbsolutePosition during drag.
local function makeDraggable(handles, target, opts)
    opts = opts or {}
    local dragging, moved = false, false
    local startInput = Vector2.zero
    local basePos = Vector2.zero
    local moveThreshold = opts.MoveThreshold or 3
    local lastBump = {x = 0, y = 0}

    local function doBump(axis, dir)
        if not opts.onBump then return end
        local t = os.clock()
        if t - lastBump[axis] < 0.2 then return end
        lastBump[axis] = t
        opts.onBump(axis, dir)
    end

    local function applyPos(x, y)
        if opts.clamp then
            local c = opts.clamp(Vector2.new(x, y))
            if c.X ~= x then doBump("x", x > c.X and 1 or -1) end
            if c.Y ~= y then doBump("y", y > c.Y and 1 or -1) end
            x, y = c.X, c.Y
        end
        target.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
    end

    local function onBegan(input)
        if not isPointer(input) then return end
        if opts.canDrag and not opts.canDrag() then return end
        -- Normalize anchor so we always work in top-left space.
        if target.AnchorPoint ~= Vector2.new(0, 0) then
            local sz = target.AbsoluteSize
            local ap = target.AnchorPoint
            local pos = target.AbsolutePosition
            target.AnchorPoint = Vector2.new(0, 0)
            -- Preserve visual position
            target.Position = UDim2.fromOffset(
                math.floor(pos.X + ap.X * sz.X + 0.5),
                math.floor(pos.Y + ap.Y * sz.Y + 0.5)
            )
        end
        dragging = true
        moved = false
        startInput = Vector2.new(input.Position.X, input.Position.Y)
        basePos = Vector2.new(target.AbsolutePosition.X, target.AbsolutePosition.Y)
        if opts.onBegin then opts.onBegin() end
    end

    local function onChanged(input)
        if not dragging then return end
        local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
            and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        local isTouch = input.UserInputType == Enum.UserInputType.Touch
        if not isMouse and not isTouch then return end
        local cur = Vector2.new(input.Position.X, input.Position.Y)
        local delta = cur - startInput
        if not moved and delta.Magnitude < moveThreshold then return end
        moved = true
        applyPos(basePos.X + delta.X, basePos.Y + delta.Y)
        if opts.onMove then opts.onMove(basePos + delta) end
    end

    local function onEnded(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = false
        if opts.onEnd then opts.onEnd(moved) end
        if not moved and opts.onClick then opts.onClick() end
    end

    for _, h in ipairs(handles) do
        if h:IsA("GuiObject") then
            h.Active = true
            if h:IsA("TextButton") then h.AutoButtonColor = false end
        end
        keep(h.InputBegan:Connect(onBegan))
        keep(h.InputChanged:Connect(onChanged))
        keep(h.InputEnded:Connect(onEnded))
    end
    keep(UserInputService.InputEnded:Connect(onEnded))
end

local function makeFirer(getValue, run)
    local last = {}
    local busy = false
    local api = {}
    function api.Fire()
        if busy then return end
        busy = true
        task.spawn(function()
            while true do
                local v = getValue()
                if v == last then break end
                last = v
                pcall(run, v)
            end
            busy = false
        end)
    end
    function api.Sync(v) last = v end
    return api
end

local function onAccent()
    local c = Pal.Accent
    if (c.R * 0.299 + c.G * 0.587 + c.B * 0.114) > 0.62 then
        return Color3.fromRGB(16, 16, 22)
    end
    return Color3.new(1, 1, 1)
end

local Metrics = {fps = 60, ping = 0, mem = 0}
do
    local frames, clock, sample = 0, 0, 0
    keep(RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1
        clock = clock + dt
        sample = sample + dt
        if clock >= 0.5 then
            Metrics.fps = math.floor(frames / clock + 0.5)
            frames, clock = 0, 0
        end
        if sample >= 1 then
            sample = 0
            local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            if ok and v then Metrics.ping = math.floor(v + 0.5) end
            local okm, m = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
            if okm and m then Metrics.mem = math.floor(m + 0.5) end
        end
    end))
end

