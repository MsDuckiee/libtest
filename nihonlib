local Notes = {active = {}, queue = {}, byKey = {}, queuedKey = {}, max = 5, duration = 4, position = "TopRight"}
local noteLayer = mk("Frame", {Name = "Notifications", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 100, Parent = Root})
local corners = {
    TopRight = {ax = 1, ay = 0}, TopLeft = {ax = 0, ay = 0}, TopCenter = {ax = 0.5, ay = 0},
    BottomRight = {ax = 1, ay = 1}, BottomLeft = {ax = 0, ay = 1}, BottomCenter = {ax = 0.5, ay = 1},
}
local noteLoop

local function noteWidth() return math.clamp(math.floor(viewport().X - 28), 240, 340) end

local function notePos(slot, dx)
    local c = corners[Notes.position] or corners.TopRight
    local mx = c.ax == 0.5 and 0 or (c.ax == 1 and -14 or 14)
    local my = c.ay == 0 and (14 + slot) or -(14 + slot)
    return UDim2.new(c.ax, mx + (dx or 0), c.ay, my)
end

local function relayout()
    local c = corners[Notes.position] or corners.TopRight
    local cum = 0
    for _, n in ipairs(Notes.active) do
        n.slot = cum
        n.frame.AnchorPoint = Vector2.new(c.ax, c.ay)
        if not n.dragging then
            play(n.frame, 0.35, {Position = notePos(cum, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        end
        cum = cum + n.height + 10
    end
end

local promoteQueue, spawnNote

promoteQueue = function()
    while #Notes.active < Notes.max and #Notes.queue > 0 do
        local entry = table.remove(Notes.queue, 1)
        Notes.queuedKey[entry.key] = nil
        spawnNote(entry)
    end
end

local function dismissNote(n)
    if n.dying then return end
    n.dying = true
    for i, x in ipairs(Notes.active) do
        if x == n then table.remove(Notes.active, i) break end
    end
    if Notes.byKey[n.key] == n then Notes.byKey[n.key] = nil end
    local c = corners[Notes.position] or corners.TopRight
    local out = c.ax == 1 and (noteWidth() + 80) or (c.ax == 0 and -(noteWidth() + 80) or 0)
    local target = out ~= 0 and notePos(n.slot, out) or notePos(n.slot - 80)
    fadeGroup(n.frame, 0.3, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    play(n.frame, 0.3, {Position = target}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    task.delay(0.4, function() if n.frame then n.frame:Destroy() end end)
    relayout()
    promoteQueue()
end

local function bumpNote(n, extra)
    n.count = n.count + 1
    n.expires = os.clock() + (extra or n.time)
    if n.pop then
        n.pop.Scale = 1.15
        play(n.pop, 0.3, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end
    if not n.dragging then
        n.frame.Position = notePos(n.slot, 12)
        play(n.frame, 0.35, {Position = notePos(n.slot, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    end
end

local function ensureNoteLoop()
    if noteLoop then return end
    noteLoop = RunService.Heartbeat:Connect(function(dt)
        local now = os.clock()
        for i = #Notes.active, 1, -1 do
            local n = Notes.active[i]
            if n and not n.dying and not n.sticky then
                if n.hover or n.dragging then n.expires = n.expires + dt end
                local left = n.expires - now
                if not n.custom and n.bar then
                    n.bar.Size = UDim2.new(math.clamp(left / n.time, 0, 1), 0, 0, 2)
                end
                if left <= 0 then dismissNote(n) end
            end
        end
        if #Notes.active == 0 and noteLoop then
            noteLoop:Disconnect()
            noteLoop = nil
        end
    end)
end

spawnNote = function(entry)
    local cfg, handle = entry.cfg, entry.handle
    local color = Status[entry.kind]
    local w = noteWidth()
    local n = {
        key = entry.key, count = entry.count, handle = handle, height = 64, slot = 0,
        time = math.max(1, tonumber(cfg.Time) or Notes.duration), sticky = cfg.Sticky == true,
    }
    n.expires = os.clock() + n.time
    local content = tostring(cfg.Content or "")

    local frame = mk("CanvasGroup", {
        Name = "Note", Size = UDim2.fromOffset(w, 0), AutomaticSize = Enum.AutomaticSize.Y,
        GroupTransparency = 1, BackgroundColor3 = Pal.Surface, Parent = noteLayer,
    })
    round(frame, 12)
    mk("UIStroke", {Color = Pal.Stroke, Thickness = 1, Transparency = 0.35, Parent = frame}):SetAttribute("_baseTrans", 0.35)
    mk("UISizeConstraint", {MinSize = Vector2.new(0, 56), Parent = frame})

    local accentBar = mk("Frame", {
        Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(0, 8),
        BackgroundColor3 = color, ZIndex = 6, Parent = frame,
    })
    round(accentBar, 2)

    local frameScale = mk("UIScale", {Scale = 0.92, Parent = frame})
    n.pop = frameScale

    local topRow = mk("Frame", {Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Parent = frame})
    inset(topRow, 12, 12, 0, 12)

    local bellHolder = mk("Frame", {
        Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 4), Parent = topRow,
    })
    local bellIcon = makeIcon(bellHolder, cfg.Icon or firstIcon(StatusIcons[entry.kind]) or "bell", 18, false, {
        AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromScale(0, 0), ZIndex = 3,
    })
    bellIcon.Color(color, false)
    bellIcon.Image.ZIndex = 3
    bellIcon.Glyph.ZIndex = 3

    local title = tx("TextLabel", {
        Text = tostring(cfg.Name or cfg.Title or "Notification"),
        TextSize = 14, Font = Fonts[currentFont][3],
        Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -60, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        TextColor3 = Pal.Text, Parent = topRow,
    }, 3)

    local closeBtn = mk("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, ZIndex = 4, Parent = topRow,
    })
    round(closeBtn, 5)
    local closeIcon = makeIcon(closeBtn, "x", 14, "Sub", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 5,
    })
    closeIcon.Image.ZIndex = 5
    closeIcon.Glyph.ZIndex = 5
    closeBtn.MouseEnter:Connect(function() play(closeBtn, 0.15, {BackgroundTransparency = 0.9}) closeIcon.Color(Pal.Text, true) end)
    closeBtn.MouseLeave:Connect(function() play(closeBtn, 0.2, {BackgroundTransparency = 1}) closeIcon.Color(Pal.Sub, true) end)
    closeBtn.Activated:Connect(function() dismissNote(n) end)

    local body = tx("TextLabel", {
        Text = content, TextSize = 12,
        Position = UDim2.fromOffset(12, 30), Size = UDim2.new(1, -24, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        Visible = content ~= "", TextColor3 = Pal.Sub, Parent = frame,
    }, 1)

    local actionsRow
    if type(cfg.Actions) == "table" and #cfg.Actions > 0 then
        actionsRow = mk("Frame", {
            Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, 0), Parent = frame,
        })
        inset(actionsRow, 12, 12, 0, 12)
        mk("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder, Parent = actionsRow,
        })
        for i, act in ipairs(cfg.Actions) do
            local lbl = tostring(act.Name or "OK")
            local sz = TextService:GetTextSize(lbl, 12, Fonts[currentFont][3], Vector2.new(400, 26))
            local b = tx("TextButton", {
                Text = lbl, TextSize = 12, Size = UDim2.fromOffset(sz.X + 20, 22),
                LayoutOrder = i, TextXAlignment = Enum.TextXAlignment.Center,
                BackgroundTransparency = 0, Parent = actionsRow,
            }, 3)
            round(b, 6)
            if i == 1 then
                b.BackgroundColor3 = color
                b.TextColor3 = Color3.fromRGB(14, 14, 20)
            else
                b.BackgroundColor3 = Pal.Elevated
            end
            b.Activated:Connect(function()
                if act.Callback then
                    local ok, err = pcall(act.Callback)
                    if not ok then
                        Nihon:MakeNotification({Name = "Action failed", Content = tostring(err), Type = "Error"})
                    end
                end
                dismissNote(n)
            end)
        end
    end

    task.defer(function()
        local topPad = 12
        local titleH = 24
        local bodyH = 0
        if content ~= "" then bodyH = body.AbsoluteSize.Y end
        local actionsH = actionsRow and 30 or 0
        local bottomPad = 12
        if content ~= "" then body.Position = UDim2.fromOffset(12, topPad + titleH) end
        if actionsRow then actionsRow.Position = UDim2.fromOffset(0, topPad + titleH + bodyH) end
        local total = topPad + titleH + bodyH + actionsH + bottomPad
        n.height = math.max(64, total)
        frame.Size = UDim2.fromOffset(w, n.height)
        if not n.dying then relayout() end
    end)

    n.title, n.body = title, body
    n.bar = mk("Frame", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = color,
        BackgroundTransparency = 0.1, Visible = not n.sticky, ZIndex = 5, Parent = frame,
    })

    n.frame = frame
    frame.MouseEnter:Connect(function() n.hover = true end)
    frame.MouseLeave:Connect(function() n.hover = false end)

    local startX, swiped = 0, false
    frame.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        startX = input.Position.X
        swiped = false
        n.dragging = true
    end)
    keep(UserInputService.InputChanged:Connect(function(input)
        if not n.dragging then return end
        local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        local isTouch = input.UserInputType == Enum.UserInputType.Touch
        if not isMouse and not isTouch then return end
        local dx = input.Position.X - startX
        if math.abs(dx) > 6 then swiped = true end
        if swiped then n.frame.Position = notePos(n.slot, dx) end
    end))
    keep(UserInputService.InputEnded:Connect(function(input)
        if not n.dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        n.dragging = false
        local dx = input.Position.X - startX
        if math.abs(dx) > 70 then dismissNote(n)
        else play(n.frame, 0.35, {Position = notePos(n.slot, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out) end
    end))

    local c = corners[Notes.position] or corners.TopRight
    local out = c.ax == 1 and (w + 100) or (c.ax == 0 and -(w + 100) or 0)
    frame.AnchorPoint = Vector2.new(c.ax, c.ay)
    frame.Position = out ~= 0 and notePos(0, out) or notePos(-80, 0)

    table.insert(Notes.active, 1, n)
    if entry.dedupe then Notes.byKey[n.key] = n end
    handle.n = n
    relayout()

    frame.GroupTransparency = 1
    frameScale.Scale = 0.92

    task.delay(0.02, function()
        if not n.dying and frame.Parent then
            play(frame, 0.35, {Position = notePos(n.slot, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            play(frameScale, 0.32, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            fadeGroup(frame, 0.2, 0)
        end
    end)

    ensureNoteLoop()
    return n
end

function Nihon:MakeNotification(cfg)
    if type(cfg) ~= "table" then cfg = {Content = tostring(cfg)} end
    local kind = Status[cfg.Type] and cfg.Type or "Info"
    local name = tostring(cfg.Name or cfg.Title or "Notification")
    local content = tostring(cfg.Content or "")
    local key = kind .. "|" .. name .. "|" .. content
    local dedupe = not cfg.Sticky and not (type(cfg.Actions) == "table" and #cfg.Actions > 0)

    if dedupe then
        local live = Notes.byKey[key]
        if live and not live.dying then
            bumpNote(live, tonumber(cfg.Time))
            return live.handle
        end
        local waiting = Notes.queuedKey[key]
        if waiting then waiting.count = waiting.count + 1 return waiting.handle end
    end

    local handle = {}
    function handle:Dismiss() if handle.n then dismissNote(handle.n) end end
    function handle:SetTitle(t) if handle.n then handle.n.title.Text = tostring(t) end end
    function handle:SetContent(t)
        if handle.n and handle.n.body then
            handle.n.body.Text = tostring(t)
            handle.n.body.Visible = tostring(t) ~= ""
        end
    end
    function handle:SetProgress(p)
        local n = handle.n
        if not n then return end
        n.custom = true
        n.bar.Visible = true
        play(n.bar, 0.18, {Size = UDim2.new(math.clamp(p, 0, 1), 0, 0, 2)})
    end

    local entry = {cfg = cfg, kind = kind, key = key, count = 1, handle = handle, dedupe = dedupe}
    if #Notes.active >= Notes.max then
        Notes.queue[#Notes.queue + 1] = entry
        if dedupe then Notes.queuedKey[key] = entry end
    else
        spawnNote(entry)
    end
    return handle
end

function Nihon:Notify(cfg) return Nihon:MakeNotification(cfg) end
function Nihon:SetNotificationLimit(n) Notes.max = math.clamp(math.floor(tonumber(n) or 5), 1, 10) end
function Nihon:SetNotificationTime(s) Notes.duration = math.clamp(tonumber(s) or 4, 1, 30) end
function Nihon:SetNotificationPosition(name)
    if not corners[name] then return end
    Notes.position = name
    for _, n in ipairs(Notes.active) do
        n.frame.AnchorPoint = Vector2.new(corners[name].ax, corners[name].ay)
    end
    relayout()
end
function Nihon:ClearNotifications()
    Notes.queue = {}
    Notes.queuedKey = {}
    for i = #Notes.active, 1, -1 do dismissNote(Notes.active[i]) end
end

