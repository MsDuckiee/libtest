    -- ============================================
    -- DROPDOWN
    -- ============================================
    local function buildDropdown(o, multi)
        o = o or {}
        local label = tostring(o.Name or (multi and "Multi Select" or "Dropdown"))
        local c = card(rowH, true)
        c.ClipsDescendants = false
        c.AutomaticSize = Enum.AutomaticSize.None

        local header = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, rowH), BackgroundTransparency = 1, ZIndex = 25, Parent = c,
        })
        header.Text = ""
        header.AutoButtonColor = false
        nameLabel(header, label, UDim2.new(0.45, 0, 1, 0))
        local valLbl = tx("TextLabel", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -36, 0.5, 0), Size = UDim2.new(0.5, -44, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 12, ZIndex = 15, Parent = header,
        }, 3, "Accent")
        local arrow = makeIcon(header, "chevron-down", 14, "Sub", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), ZIndex = 15,
        })
        arrow.Image.ZIndex = 15
        arrow.Glyph.ZIndex = 15

        local listFrame = mk("Frame", {
            Name = "List", Position = UDim2.fromOffset(8, rowH + 4), Size = UDim2.new(1, -16, 0, 0),
            BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 24, Parent = c,
        })
        local listScroll = mk("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 3,
            ScrollBarImageTransparency = 0.35, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.Never,
            ZIndex = 24, Parent = listFrame,
        })
        bind(listScroll, "ScrollBarImageColor3", "Accent")
        stack(listScroll, 3)
        inset(listScroll, 4, 4, 4, 4)

        local obj = {Options = o.Options or {}, Value = multi and {} or nil, IsOpen = false}
        local firer
        local rows = {}

        local function selected(opt)
            if multi then return obj.Value[opt] == true end
            return obj.Value == opt
        end
        local function orderedSelection()
            local out = {}
            for _, opt in ipairs(obj.Options) do
                if obj.Value[opt] then out[#out + 1] = opt end
            end
            return out
        end
        local function summary()
            if multi then
                local list = orderedSelection()
                if #list == 0 then return "None" end
                if #list <= 2 then return table.concat(list, ", ") end
                return #list .. " selected"
            end
            return obj.Value ~= nil and tostring(obj.Value) or "None"
        end
        local function current()
            if multi then return orderedSelection() end
            return obj.Value
        end

        firer = makeFirer(function()
            if multi then return table.concat(orderedSelection(), "\0") end
            return obj.Value
        end, function()
            local ok, err = pcall(o.Callback or function() end, current())
            if not ok then fail(c, label, err) end
        end)

        local function restyle()
            valLbl.Text = summary()
            for opt, r in pairs(rows) do
                if r.btn.Parent then
                    local on = selected(opt)
                    play(r.btn, 0.15, {BackgroundTransparency = on and 0.86 or 1})
                    play(r.check, 0.15, {ImageTransparency = on and 0 or 1})
                    r.label.TextColor3 = on and Pal.Text or Pal.Sub
                end
            end
        end

        local function layoutList()
            local visible = 0
            for _, r in pairs(rows) do
                if r.btn.Visible then visible = visible + 1 end
            end
            local searchH = (obj._hasSearch) and 38 or 0
            local h = math.min(visible * 34 + 8 + searchH, 240)
            if obj.IsOpen then
                play(listFrame, 0.28, {Size = UDim2.new(1, -16, 0, h)}, Enum.EasingStyle.Quart)
            else
                play(listFrame, 0.2, {Size = UDim2.new(1, -16, 0, 0)}, Enum.EasingStyle.Quart)
            end
            play(c, 0.28, {Size = UDim2.new(1, 0, 0, rowH + (obj.IsOpen and (h + 8) or 0))}, Enum.EasingStyle.Quart)
            play(arrow.Image, 0.25, {Rotation = obj.IsOpen and 180 or 0}, Enum.EasingStyle.Back)
            play(arrow.Glyph, 0.25, {Rotation = obj.IsOpen and 180 or 0}, Enum.EasingStyle.Back)
        end

        local searchBox, filter = nil, ""

        local function rebuildRows()
            for _, r in pairs(rows) do r.btn:Destroy() end
            rows = {}
            local count = #obj.Options
            local wantSearch = count > 4
            obj._hasSearch = wantSearch
            if wantSearch and not searchBox then
                local searchHolder = mk("Frame", {
                    Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, ZIndex = 25, Parent = listScroll, LayoutOrder = -1,
                })
                local sb = tx("TextBox", {
                    Size = UDim2.new(1, -42, 1, 0), Position = UDim2.fromOffset(30, 0),
                    PlaceholderText = "Search...", TextSize = 12, ZIndex = 25, Parent = searchHolder,
                }, 2)
                bind(sb, "BackgroundColor3", "Elevated")
                sb.BackgroundTransparency = 0
                round(sb, 8)
                inset(sb, 0, 10, 0, 10)
                local sIcon = makeIcon(searchHolder, SEARCH_ICON, 12, "Sub", {
                    AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), ZIndex = 26,
                })
                sIcon.Image.ZIndex = 26
                sIcon.Glyph.ZIndex = 26
                sb:GetPropertyChangedSignal("Text"):Connect(function()
                    filter = sb.Text:lower()
                    for opt, r in pairs(rows) do
                        r.btn.Visible = filter == "" or tostring(opt):lower():find(filter, 1, true) ~= nil
                    end
                    layoutList()
                end)
                searchBox = searchHolder
            end
            for i, opt in ipairs(obj.Options) do
                local b = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Color3.new(1, 1, 1),
                    BackgroundTransparency = 1, LayoutOrder = i, ZIndex = 25, Parent = listScroll,
                })
                round(b, 8)
                accentGradient(b, 0)
                local l = tx("TextLabel", {
                    Text = tostring(opt), TextSize = 12, Position = UDim2.fromOffset(12, 0),
                    Size = UDim2.new(1, -44, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 26, Parent = b,
                }, 2, "Sub")
                local ck = makeIcon(b, "check", 15, "Accent", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), ZIndex = 26,
                })
                ck.Image.ZIndex = 26
                ck.Glyph.ZIndex = 26
                ck.Image.ImageTransparency = selected(opt) and 0 or 1
                ck.Glyph.TextTransparency = selected(opt) and 0 or 1
                rows[opt] = {btn = b, label = l, check = ck.Image}
                b.MouseEnter:Connect(function()
                    if not selected(opt) then play(b, 0.12, {BackgroundTransparency = 0.92}) end
                end)
                b.MouseLeave:Connect(function()
                    if not selected(opt) then play(b, 0.18, {BackgroundTransparency = 1}) end
                end)
                b.InputBegan:Connect(function(input)
                    if not isPointer(input) then return end
                    if multi then
                        obj.Value[opt] = (not obj.Value[opt]) or nil
                        restyle()
                        firer.Fire()
                        queueSave()
                    else
                        obj:Set(opt)
                        obj:Toggle()
                    end
                end)
            end
            restyle()
        end

        function obj:Open()
            if obj.IsOpen or obj:IsLocked() then return end
            obj.IsOpen = true
            rebuildRows()
            layoutList()
        end
        function obj:Close()
            if not obj.IsOpen then return end
            obj.IsOpen = false
            layoutList()
        end
        function obj:Toggle()
            if obj.IsOpen then obj:Close() else obj:Open() end
        end
        function obj:Get() return current() end
        function obj:Set(v, silent)
            if multi then
                obj.Value = {}
                if type(v) == "table" then
                    for k, x in pairs(v) do
                        if type(k) == "number" then obj.Value[x] = true elseif x then obj.Value[k] = true end
                    end
                end
            else
                if v ~= nil and not table.find(obj.Options, v) then return end
                obj.Value = v
            end
            restyle()
            if silent then firer.Sync(multi and table.concat(orderedSelection(), "\0") or obj.Value)
            else firer.Fire() queueSave() end
        end
        function obj:Refresh(list, keepValue)
            obj.Options = list or {}
            if not keepValue then obj.Value = multi and {} or nil
            elseif not multi and obj.Value ~= nil and not table.find(obj.Options, obj.Value) then obj.Value = nil end
            if obj.IsOpen then rebuildRows() layoutList() end
            valLbl.Text = summary()
        end
        function obj:Add(opt) obj.Options[#obj.Options + 1] = opt end

        header.InputBegan:Connect(function(input)
            if isPointer(input) then obj:Toggle() end
        end)
        register(o.Flag, obj, o, current, function(v) obj:Set(v) end)
        decorate(obj, c, o, multi and "Multi Dropdown" or "Dropdown")
        if multi then obj:Set(o.Default or {}, true)
        else
            local first = o.Default
            if first == nil and o.AllowNone ~= true then first = obj.Options[1] end
            obj:Set(first, true)
        end
        valLbl.Text = summary()
        initFires[#initFires + 1] = function() firer.Fire() end
        return obj
    end

    function E:AddDropdown(o) return buildDropdown(o, false) end
    function E:AddMultiDropdown(o) return buildDropdown(o, true) end

    -- ============================================
    -- COLORPICKER
    -- ============================================
    function E:AddColorpicker(o)
        o = o or {}
        local label = tostring(o.Name or "Color")
        local c = card(rowH, true)
        c.ClipsDescendants = false
        c.AutomaticSize = Enum.AutomaticSize.None

        local header = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, rowH), BackgroundTransparency = 1, ZIndex = 25, Parent = c,
        })
        header.Text = ""
        header.AutoButtonColor = false
        nameLabel(header, label, UDim2.new(1, -80, 1, 0))
        local swatch = mk("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(38, 22), ZIndex = 15, Parent = header,
        })
        round(swatch, 7)
        outline(swatch, "Text", 1, 0.75)
        local arrow = makeIcon(header, "chevron-down", 12, "Sub", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -58, 0.5, 0), ZIndex = 15,
        })
        arrow.Image.ZIndex = 15
        arrow.Glyph.ZIndex = 15

        local panel = mk("Frame", {
            Name = "Panel", Position = UDim2.fromOffset(8, rowH + 4), Size = UDim2.new(1, -16, 0, 0),
            BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 24, Parent = c,
        })

        local start = typeof(o.Default) == "Color3" and o.Default or Color3.fromRGB(255, 70, 90)
        local h, s, v = start:ToHSV()
        local obj = {Value = start, IsOpen = false, Rainbow = false}
        local firer = makeFirer(function() return obj.Value end, function(col)
            local ok, err = pcall(o.Callback or function() end, col)
            if not ok then fail(c, label, err) end
        end)

        local ui = {}
        local function apply(silent)
            local col = Color3.fromHSV(h, s, v)
            obj.Value = col
            swatch.BackgroundColor3 = col
            if ui.sv and ui.sv.Parent then
                ui.sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                ui.svKnob.Position = UDim2.fromScale(s, 1 - v)
                ui.svKnob.BackgroundColor3 = col
                ui.hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
                if not ui.hex:IsFocused() then ui.hex.Text = "#" .. col:ToHex():upper() end
            end
            if silent then firer.Sync(col) else firer.Fire() queueSave() end
        end

        local built = false
        local function buildPanel()
            if built then return end
            built = true
            inset(panel, 8, 8, 8, 8)
            local holder = mk("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Parent = panel})

            local sv = mk("TextButton", {
                Size = UDim2.new(1, 0, 0, 120), BackgroundColor3 = Color3.fromHSV(h, 1, 1), ZIndex = 62, Parent = holder,
            })
            round(sv, 8)
            local white = mk("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63, Parent = sv})
            round(white, 8)
            mk("UIGradient", {Transparency = NumberSequence.new(0, 1), Parent = white})
            local black = mk("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 64, Parent = sv})
            round(black, 8)
            mk("UIGradient", {Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = black})
            local svKnob = mk("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = obj.Value, ZIndex = 66, Parent = sv,
            })
            round(svKnob, 8)
            mk("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 2, Parent = svKnob})

            local hue = mk("TextButton", {
                Position = UDim2.fromOffset(0, 128), Size = UDim2.new(1, 0, 0, 14), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 62, Parent = holder,
            })
            round(hue, 7)
            local keys = {}
            for i = 0, 6 do
                keys[#keys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.999), 1, 1))
            end
            mk("UIGradient", {Color = ColorSequence.new(keys), Parent = hue})
            local hueKnob = mk("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(h, 0, 0.5, 0), Size = UDim2.fromOffset(6, 20),
                BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 64, Parent = hue,
            })
            round(hueKnob, 3)
            mk("UIStroke", {Color = Color3.new(0, 0, 0), Transparency = 0.5, Parent = hueKnob})

            local hex = tx("TextBox", {
                Position = UDim2.fromOffset(0, 152), Size = UDim2.new(1, -86, 0, 28), PlaceholderText = "#RRGGBB", TextSize = 12, ZIndex = 62, Parent = holder,
            }, 2)
            bind(hex, "BackgroundColor3", "Elevated")
            hex.BackgroundTransparency = 0
            round(hex, 8)
            inset(hex, 0, 8, 0, 8)
            local rb = tx("TextButton", {
                AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 152), Size = UDim2.fromOffset(78, 28), Text = "Rainbow",
                TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 62, Parent = holder,
            }, 3)
            bind(rb, "BackgroundColor3", "Elevated")
            rb.BackgroundTransparency = 0
            round(rb, 8)

            local swatchRow = mk("Frame", {Position = UDim2.fromOffset(0, 188), Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, ZIndex = 62, Parent = holder})
            mk("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = swatchRow})
            local presets = {
                Color3.fromRGB(255, 70, 90), Color3.fromRGB(255, 150, 60), Color3.fromRGB(255, 220, 70), Color3.fromRGB(90, 220, 140),
                Color3.fromRGB(70, 200, 240), Color3.fromRGB(110, 140, 255), Color3.fromRGB(190, 120, 255), Color3.fromRGB(255, 255, 255),
            }
            for i, pc in ipairs(presets) do
                local p = mk("TextButton", {Size = UDim2.fromOffset(mobile and 22 or 24, 22), BackgroundColor3 = pc, LayoutOrder = i, ZIndex = 63, Parent = swatchRow})
                round(p, 6)
                p.InputBegan:Connect(function(input)
                    if not isPointer(input) then return end
                    h, s, v = pc:ToHSV()
                    obj.Rainbow = false
                    apply()
                end)
            end

            ui = {sv = sv, svKnob = svKnob, hueKnob = hueKnob, hex = hex}

            local mode
            local function fromPos(pos)
                if mode == "sv" then
                    s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
                    v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
                elseif mode == "hue" then
                    h = math.clamp((pos.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 0.999)
                end
                obj.Rainbow = false
                apply()
            end
            sv.InputBegan:Connect(function(input) if isPointer(input) then mode = "sv" fromPos(input.Position) end end)
            hue.InputBegan:Connect(function(input) if isPointer(input) then mode = "hue" fromPos(input.Position) end end)
            keep(UserInputService.InputChanged:Connect(function(input)
                if not mode then return end
                local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                local isTouch = input.UserInputType == Enum.UserInputType.Touch
                if not isMouse and not isTouch then return end
                fromPos(input.Position)
            end))
            keep(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    mode = nil
                end
            end))

            hex.FocusLost:Connect(function()
                local txt = hex.Text:gsub("#", "")
                if #txt == 6 then
                    local ok, col = pcall(Color3.fromHex, txt)
                    if ok then
                        h, s, v = col:ToHSV()
                        apply()
                    end
                end
                hex.Text = "#" .. obj.Value:ToHex():upper()
            end)
            rb.InputBegan:Connect(function(input)
                if not isPointer(input) then return end
                obj.Rainbow = not obj.Rainbow
                rb.TextColor3 = obj.Rainbow and Pal.Accent or Pal.Text
            end)
            hex.Text = "#" .. obj.Value:ToHex():upper()
            svKnob.Position = UDim2.fromScale(s, 1 - v)
        end

        function obj:Open()
            if obj.IsOpen or obj:IsLocked() then return end
            obj.IsOpen = true
            buildPanel()
            play(panel, 0.28, {Size = UDim2.new(1, -16, 0, 240)}, Enum.EasingStyle.Quart)
            play(c, 0.28, {Size = UDim2.new(1, 0, 0, rowH + 248)}, Enum.EasingStyle.Quart)
            play(arrow.Image, 0.25, {Rotation = 180}, Enum.EasingStyle.Back)
            play(arrow.Glyph, 0.25, {Rotation = 180}, Enum.EasingStyle.Back)
        end
        function obj:Close()
            if not obj.IsOpen then return end
            obj.IsOpen = false
            play(panel, 0.2, {Size = UDim2.new(1, -16, 0, 0)}, Enum.EasingStyle.Quart)
            play(c, 0.28, {Size = UDim2.new(1, 0, 0, rowH)}, Enum.EasingStyle.Quart)
            play(arrow.Image, 0.25, {Rotation = 0}, Enum.EasingStyle.Back)
            play(arrow.Glyph, 0.25, {Rotation = 0}, Enum.EasingStyle.Back)
        end
        function obj:Toggle()
            if obj.IsOpen then obj:Close() else obj:Open() end
        end

        keep(RunService.Heartbeat:Connect(function()
            if obj.Rainbow then
                h = (os.clock() * 0.2) % 1
                apply()
            end
        end))

        function obj:Set(col, silent)
            if typeof(col) ~= "Color3" then return end
            h, s, v = col:ToHSV()
            apply(silent)
        end
        function obj:Get() return obj.Value end

        header.InputBegan:Connect(function(input)
            if isPointer(input) then obj:Toggle() end
        end)

        register(o.Flag, obj, o, function() return obj.Value end, function(col) obj:Set(col) end)
        decorate(obj, c, o, "Colorpicker")
        apply(true)
        initFires[#initFires + 1] = function()
            local ok, err = pcall(o.Callback or function() end, obj.Value)
            if not ok then fail(c, label, err) end
        end
        return obj
    end

