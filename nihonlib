        status.Text = tostring(text or "")
        status.Visible = text ~= nil and text ~= ""
        status.TextColor3 = tone or Pal.Sub
    end

    local verifying = false

    getBtn.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        local spec = cfg.GrabKeyFromSite or cfg.GetKeyURL
        if not spec then
            Nihon:MakeNotification({Name = "Get Key", Content = "No source configured.", Type = "Warning", Time = 3})
            return
        end
        if type(spec) == "table" or (type(spec) == "string" and spec:find("^https?://")) then
            setStatus("Fetching key...", Pal.Sub)
            task.spawn(function()
                local key, err = Nihon:GrabKeyFromSite(spec)
                if key and key ~= "" then
                    input.Text = key
                    setStatus("Key loaded. Press Verify.", Status.Success)
                    if cfg.OnGetKey then pcall(cfg.OnGetKey, key) end
                else
                    setStatus("Fetch failed: " .. tostring(err or "unknown"), Status.Error)
                    if type(spec) == "string" then
                        if setclipboard then pcall(setclipboard, spec) end
                    elseif type(spec) == "table" and spec.Url then
                        if setclipboard then pcall(setclipboard, spec.Url) end
                    end
                end
            end)
        end
    end)

