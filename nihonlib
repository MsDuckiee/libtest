-- ============================================
-- SMOOTH DRAG
-- ============================================
local function makeDraggable(handles, target, opts)
    opts = opts or {}
    local state = {
        dragging = false, moved = false,
        startInput = Vector2.new(), startPos = Vector2.new(),
        lastInput = Vector2.new(), lastTime = 0,
        velocity = Vector2.new(),
        currentPos = Vector2.new(), targetPos = Vector2.new(),
        lastHit = {x = 0, y = 0}, runConn = nil,
    }
    local smoothing = opts.smoothing or 26

    local function hit(axis, dir, strength)
        if not opts.onBump then return end
        local now = os.clock()
        if now - state.lastHit[axis] < 0.22 then return end
        state.lastHit[axis] = now
        opts.onBump(axis, dir, strength or 1)
    end

    local function screenToPosition(screenPos)
        local parent = target.Parent
        if not parent then return screenPos end
        local parentPos = parent.AbsolutePosition
        local size = target.AbsoluteSize
        local anchor = target.AnchorPoint
        return screenPos - parentPos + Vector2.new(size.X * anchor.X, size.Y * anchor.Y)
    end

    local function step(dt)
        if not target.Parent then
            if state.runConn then state.runConn:Disconnect() state.runConn = nil end
            return
        end

        if not state.dragging then
            state.targetPos = state.targetPos + state.velocity * dt
            state.velocity = state.velocity * math.exp(-dt * 7)
            if state.velocity.Magnitude < 2 then state.velocity = Vector2.new() end

            if opts.clamp then
                local want = state.targetPos
                local clamped = opts.clamp(want)
                local dx, dy = want.X - clamped.X, want.Y - clamped.Y
                if math.abs(dx) > 0.5 then
                    hit("x", dx > 0 and 1 or -1, math.min(1, math.abs(dx) / 80))
                    state.velocity = Vector2.new(-state.velocity.X * 0.32, state.velocity.Y)
                end
                if math.abs(dy) > 0.5 then
                    hit("y", dy > 0 and 1 or -1, math.min(1, math.abs(dy) / 80))
                    state.velocity = Vector2.new(state.velocity.X, -state.velocity.Y * 0.32)
                end
                state.targetPos = clamped
            end
        end

        local alpha = 1 - math.exp(-dt * smoothing)
        state.currentPos = state.currentPos:Lerp(state.targetPos, alpha)

        local p = screenToPosition(state.currentPos)
        target.Position = UDim2.fromOffset(
            math.floor(p.X + 0.5),
            math.floor(p.Y + 0.5)
        )

        if not state.dragging and state.velocity.Magnitude < 0.6
           and (state.currentPos - state.targetPos).Magnitude < 0.6 then
            state.currentPos = state.targetPos
            if state.runConn then state.runConn:Disconnect() state.runConn = nil end
        end
    end

    local function ensureRun()
        if state.runConn then return end
        state.runConn = RunService.RenderStepped:Connect(step)
    end

    for _, h in ipairs(handles) do
        if h:IsA("GuiObject") then
            h.Active = true
            if h:IsA("TextButton") then h.AutoButtonColor = false end
        end
        keep(h.InputBegan:Connect(function(input)
            if not isPointer(input) then return end
            if opts.canDrag and not opts.canDrag() then return end
            state.dragging = true
            state.moved = false
            local p = target.AbsolutePosition
            state.startInput = v2(input)
            state.startPos = p
            state.currentPos = p
            state.targetPos = p
            state.lastInput = v2(input)
            state.lastTime = os.clock()
            state.velocity = Vector2.new()
            ensureRun()
            if opts.onBegin then opts.onBegin() end
        end))
        keep(UserInputService.InputChanged:Connect(function(input)
            if not state.dragging then return end
            local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
                and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            local isTouch = input.UserInputType == Enum.UserInputType.Touch
            if not isMouse and not isTouch then return end

            local now = os.clock()
            local newPos = v2(input)
            local dt = now - state.lastTime
            if dt > 0.001 and dt < 0.25 then
                local inst = (newPos - state.lastInput) / dt
                state.velocity = state.velocity:Lerp(inst, 0.4)
            end
            state.lastInput = newPos
            state.lastTime = now

            local delta = newPos - state.startInput
            if not state.moved and delta.Magnitude < 3 then return end
            state.moved = true

            local want = state.startPos + delta
            if opts.clamp then
                local clamped = opts.clamp(want)
                local dx, dy = want.X - clamped.X, want.Y - clamped.Y
                if math.abs(dx) > 0.5 then hit("x", dx > 0 and 1 or -1, math.min(1, math.abs(dx) / 80)) end
                if math.abs(dy) > 0.5 then hit("y", dy > 0 and 1 or -1, math.min(1, math.abs(dy) / 80)) end
                want = clamped
            end
            state.targetPos = want
            if opts.onMove then opts.onMove(want) end
        end))
        keep(UserInputService.InputEnded:Connect(function(input)
            if not state.dragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            state.dragging = false
            local maxV = opts.maxVelocity or 2400
            if state.velocity.Magnitude > maxV then
                state.velocity = state.velocity.Unit * maxV
            end
            if opts.onEnd then opts.onEnd(state.moved) end
            if not state.moved and opts.onClick then opts.onClick() end
        end))
    end
end

local function makeFirer(getValue, run)
    local last = {}
    local busy = false
    local api = {}
    function api.Fire()
        if busy then return end
        busy = true
        task.spawn(function()
            while true do
                local v = getValue()
                if v == last then break end
                last = v
                pcall(run, v)
            end
            busy = false
        end)
    end
    function api.Sync(v) last = v end
    return api
end

local function onAccent()
    local c = Pal.Accent
    if (c.R * 0.299 + c.G * 0.587 + c.B * 0.114) > 0.62 then
        return Color3.fromRGB(16, 16, 22)
    end
    return Color3.new(1, 1, 1)
end

local Metrics = {fps = 60, ping = 0, mem = 0}
do
    local frames, clock, sample = 0, 0, 0
    keep(RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1
        clock = clock + dt
        sample = sample + dt
        if clock >= 0.5 then
            Metrics.fps = math.floor(frames / clock + 0.5)
            frames, clock = 0, 0
        end
        if sample >= 1 then
            sample = 0
            local ok, v = pcall(function()
                return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
            end)
            if ok and v then Metrics.ping = math.floor(v + 0.5) end
            local okm, m = pcall(function()
                return Stats:GetTotalMemoryUsageMb()
            end)
            if okm and m then Metrics.mem = math.floor(m + 0.5) end
        end
    end))
end

