local tipBox, tipToken, tipFollowConn = nil, 0, nil
local tipDelay = 0.2

local function ensureTipFollow()
    if tipFollowConn then return end
    tipFollowConn = RunService.RenderStepped:Connect(function()
        if not tipBox or not tipBox.Parent then
            if tipFollowConn then tipFollowConn:Disconnect() tipFollowConn = nil end
            return
        end
        local m = UserInputService:GetMouseLocation()
        local v = viewport()
        local s = tipBox.AbsoluteSize
        local x = math.clamp(m.X + 14, 6, v.X - s.X - 26)
        local y = math.clamp(m.Y + 18, 6, v.Y - s.Y - 26)
        tipBox.Position = UDim2.fromOffset(x, y)
    end)
end

local function hideTip()
    tipToken = tipToken + 1
    if tipFollowConn then tipFollowConn:Disconnect() tipFollowConn = nil end
    if tipBox then
        local old = tipBox
        tipBox = nil
        fadeGroup(old, 0.1, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.18, function() if old and old.Parent then old:Destroy() end end)
    end
end

local function showTip(text, anchorX)
    if tipBox then tipBox:Destroy() tipBox = nil end
    if not text or text == "" then return end
    local size = TextService:GetTextSize(tostring(text), 12, Fonts[currentFont][2], Vector2.new(280, 1000))
    local box = mk("CanvasGroup", {
        Size = UDim2.fromOffset(size.X + 20, size.Y + 10),
        ZIndex = 400, BackgroundColor3 = Pal.Elevated, BackgroundTransparency = 0.02,
        GroupTransparency = 1, Parent = Root,
    })
    round(box, 6)
    mk("UIStroke", {Color = Pal.Stroke, Thickness = 1, Transparency = 0.2, Parent = box})
    tx("TextLabel", {
        Size = UDim2.fromScale(1, 1), Text = tostring(text), TextSize = 12, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Pal.Text, ZIndex = 401, Parent = box,
    }, 2)
    if anchorX then
        box.Position = UDim2.fromOffset(anchorX, 0)
    else
        local m = UserInputService:GetMouseLocation()
        local v = viewport()
        local x = math.clamp(m.X + 14, 6, v.X - size.X - 26)
        local y = math.clamp(m.Y + 18, 6, v.Y - size.Y - 26)
        box.Position = UDim2.fromOffset(x, y)
    end
    tipBox = box
    if not anchorX then ensureTipFollow() end
    fadeGroup(box, 0.12, 0, Enum.EasingStyle.Quart)
end

