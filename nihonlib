function Nihon:SetKeySystem(cfg)
    cfg = cfg or {}
    cfg.Title       = cfg.Title       or "Key System"
    cfg.Subtitle    = cfg.Subtitle    or "Enter your key to continue"
    cfg.ButtonText  = cfg.ButtonText  or "Verify"
    cfg.GetKeyText  = cfg.GetKeyText  or "Get Key"
    cfg.DiscordText = cfg.DiscordText or "Discord"
    cfg.Icon        = cfg.Icon        or "key"

    if cfg.KeyFile ~= nil then Nihon.KeyFile = cfg.KeyFile == true end
    if cfg.KeyFileName then Nihon.KeyFileName = tostring(cfg.KeyFileName) end
    if cfg.AutoVerify ~= nil then Nihon.AutoVerify = cfg.AutoVerify ~= false end

    Nihon._keyCfg = cfg
end

local function keyFSReady()
    return type(writefile) == "function" and type(readfile) == "function"
       and type(isfile) == "function" and type(makefolder) == "function"
       and type(isfolder) == "function"
end

function Nihon:_keyFolder() return Nihon.Folder .. "/keys" end
function Nihon:_keyPath()  return Nihon:_keyFolder() .. "/" .. tostring(Nihon.KeyFileName or "key") .. ".key" end

function Nihon:SaveKeyToFile(key)
    if not keyFSReady() or key == nil or key == "" then return false end
    return pcall(function()
        if not isfolder(Nihon:_keyFolder()) then makefolder(Nihon:_keyFolder()) end
        writefile(Nihon:_keyPath(), tostring(key))
    end)
end

function Nihon:LoadKeyFromFile()
    if not keyFSReady() then return nil end
    local path = Nihon:_keyPath()
    local ok, data = pcall(function()
        if not isfile(path) then return nil end
        return readfile(path)
    end)
    if ok and data and data ~= "" then return data end
    return nil
end

function Nihon:DeleteKeyFile()
    if not keyFSReady() or type(delfile) ~= "function" then return false end
    local path = Nihon:_keyPath()
    return pcall(function()
        if isfile(path) then delfile(path) end
    end)
end

function Nihon:HasKeyFile()
    if not keyFSReady() then return false end
    local ok, exists = pcall(function() return isfile(Nihon:_keyPath()) end)
    return ok and exists
end

function Nihon:GrabKeyFromSite(spec)
    local s
    if type(spec) == "string" then
        s = {Url = spec, Method = "GET"}
    elseif type(spec) == "table" then
        s = spec
    else
        return nil, "invalid spec"
    end
    local url = s.Url or s.URL or s.url
    if not url then return nil, "no url" end

    local method  = s.Method or "GET"
    local headers = s.Headers or {}
    local body    = s.Body
    local field   = s.Field

    local raw
    if type(request) == "function" then
        local ok, resp = pcall(request, {
            Url = url, Method = method, Headers = headers, Body = body,
        })
        if ok and resp then
            raw = resp.Body or (type(resp) == "string" and resp) or nil
        end
    elseif type(game.HttpGet) == "function" then
        local ok, r = pcall(function() return game:HttpGet(url, true) end)
        if ok then raw = r end
    end

    if not raw or raw == "" then return nil, "fetch failed" end

    if field then
        local decOk, dec = pcall(function() return HttpService:JSONDecode(raw) end)
        if decOk and type(dec) == "table" and dec[field] ~= nil then
            return tostring(dec[field])
        end
        return nil, "field not found"
    end
    return (tostring(raw):gsub("^%s+", ""):gsub("%s+$", ""))
end

function Nihon:_validateKey(key)
    local cfg = Nihon._keyCfg or {}
    if type(cfg.Validate) == "function" then
        local ok, r = pcall(cfg.Validate, key)
        return ok and r == true
    elseif cfg.Key ~= nil then
        return tostring(key) == tostring(cfg.Key)
    end
    return true
end

