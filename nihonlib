        local url = cfg.DiscordURL
        if url and url ~= "" then
            if setclipboard then pcall(setclipboard, url) end
            pcall(function()
                if request then request({Url = url, Method = "GET"}) end
            end)
            if cfg.OnDiscord then pcall(cfg.OnDiscord, url) end
            Nihon:MakeNotification({Name = "Discord", Content = "Link copied / opened.", Type = "Info", Time = 3})
        else
            Nihon:MakeNotification({Name = "Discord", Content = "No URL configured.", Type = "Warning", Time = 3})
        end
    end)

    local function doVerify()
        if verifying then return end
        local key = input.Text
        if key == nil or key == "" then
            setStatus("Please enter a key.", Status.Error)
            play(ring, 0.15, {Transparency = 0, Color = Status.Error})
            task.delay(0.4, function() play(ring, 0.3, {Color = Pal.Accent}) end)
            return
        end
        verifying = true
        setStatus("Verifying...", Pal.Sub)
        task.spawn(function()
            local ok = Nihon:_validateKey(key)
            if ok then
                Nihon._keyVerified = true
                if Nihon.KeyFile and Nihon._keySaveToggle and Nihon._keySaveToggle() then
                    Nihon:SaveKeyToFile(key)
                end
                setStatus("Verified!", Status.Success)
                if cfg.OnSuccess then pcall(cfg.OnSuccess, key) end
                task.wait(0.35)
                closeGate()
                task.wait(0.32)
                if onSuccess then onSuccess() end
            else
                verifying = false
                setStatus("Invalid key, please try again.", Status.Error)
                play(ring, 0.15, {Transparency = 0, Color = Status.Error})
                task.delay(0.5, function() play(ring, 0.3, {Color = Pal.Accent, Transparency = 0.5}) end)
                shake(box)
                if cfg.OnFail then pcall(cfg.OnFail, key) end
            end
        end)
    end

    verifyBtn.InputBegan:Connect(function(input)
        if isPointer(input) then doVerify() end
    end)
    input.FocusLost:Connect(function(enter)
        if enter then doVerify() end
    end)
end

