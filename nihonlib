        ZIndex = 21, Parent = clip,
    })

    -- ============================================
    -- Sidebar — icon-only, with tooltips
    -- ============================================
    local side = mk("Frame", {
        Name = "Sidebar", Size = UDim2.new(0, sideW, 1, 0),
        BackgroundColor3 = Pal.Bg, BackgroundTransparency = 0.3,
        ZIndex = 22, Parent = body,
    })

    local sideLine = mk("Frame", {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 1, 1, 0), BackgroundColor3 = Pal.Stroke,
        BackgroundTransparency = 0.65, ZIndex = 22, Parent = side,
    })
    bind(sideLine, "BackgroundColor3", "Stroke")

    local tabScroll = mk("ScrollingFrame", {
        Name = "Tabs", Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, ScrollBarThickness = 0,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 23, Parent = side,
    })
    inset(tabScroll, 10, 8, 10, 8)
    stack(tabScroll, 4)

    local content = mk("Frame", {
        Name = "Content", Position = UDim2.fromOffset(sideW + 1, 0),
        Size = UDim2.new(1, -(sideW + 1), 1, 0), BackgroundTransparency = 1,
        ClipsDescendants = true, ZIndex = 22, Parent = body,
    })
    Window.Content = content

    -- ============================================
    -- Resize grip
    -- ============================================
    local resizeGrip = mk("TextButton", {
        Name = "ResizeGrip", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -4),
        Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, ZIndex = 40, Parent = clip,
    })
    local resizing, resizeStart = false, nil
    local fullW, fullH = baseW, baseH
    resizeGrip.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        if Window.Hidden or Window.Minimized then return end
        resizing = true
        resizeStart = Vector2.new(input.Position.X, input.Position.Y)
        fullW = shell.Size.X.Offset
        fullH = shell.Size.Y.Offset
    end)
    keep(UserInputService.InputChanged:Connect(function(input)
        if not resizing then return end
        local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        local isTouch = input.UserInputType == Enum.UserInputType.Touch
        if not isMouse and not isTouch then return end
        local d = Vector2.new(input.Position.X - resizeStart.X, input.Position.Y - resizeStart.Y)
        local newW = math.max(360, math.floor(fullW + d.X))
        local newH = math.max(260, math.floor(fullH + d.Y))
        shell.Size = UDim2.fromOffset(newW, newH)
    end))
    keep(UserInputService.InputEnded:Connect(function(input)
        if not resizing then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        resizing = false
        fullW = shell.Size.X.Offset
        fullH = shell.Size.Y.Offset
    end))

    -- ============================================
    -- Drag handles
    -- ============================================
    makeDraggable({header}, shell, {
        clamp = function(p)
            local v = viewport()
            local s = shell.AbsoluteSize
            return Vector2.new(
                math.clamp(p.X, 0, math.max(0, v.X - s.X)),
                math.clamp(p.Y, 0, math.max(0, v.Y - math.min(s.Y, topH + 8)))
            )
        end,
        canDrag = function() return not Window.Hidden end,
    })

    -- ============================================
    -- Traffic light actions
    -- ============================================
    local closeToken = 0
    local placed = false

    local function show()
        Window.Hidden = false
        closeToken = closeToken + 1
        if not placed then
            placed = true
            local v = viewport()
            shell.Position = UDim2.fromOffset(
                math.floor((v.X - baseW) / 2),
                math.floor((v.Y - baseH) / 2)
            )
        end
        body.Visible = true
        shell.Visible = true
        uiScale.Scale = 1
        shell.GroupTransparency = 1
        fadeGroup(shell, 0.28, 0, Enum.EasingStyle.Quart)
        play(uiScale, 0.4, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    local function hide()
        Window.Hidden = true
        Popup.close(true)
        hideTip()
        closeToken = closeToken + 1
        fadeGroup(shell, 0.22, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(uiScale, 0.24, {Scale = 0.96}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        local mine = closeToken
        task.delay(0.3, function()
            if mine == closeToken and Window.Hidden then
                shell.Visible = false
            end
        end)
    end

    Window.Show = show
    Window.Hide = hide
    function Window:Toggle()
        if Window.Hidden then show() else hide() end
    end

    tlClose.Activated:Connect(function() hide() end)
    tlMin.Activated:Connect(function()
        Window.Minimized = not Window.Minimized
        if Window.Minimized then
            body.Visible = false
            play(shell, 0.35, {Size = UDim2.fromOffset(shell.Size.X.Offset, topH)}, Enum.EasingStyle.Quart)
        else
            body.Visible = true
            play(shell, 0.4, {Size = UDim2.fromOffset(shell.Size.X.Offset, fullH)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end
    end)
    tlSearch.Activated:Connect(function()
        if Window._openSearch then Window:_openSearch() else Window:OpenSearch() end
    end)

    keep(UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Window.ToggleKey then Window:Toggle() end
    end))

    -- Launcher (floating pill when hidden)
    local launcher = mk("TextButton", {
        Name = "Launcher", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0, 60), Size = UDim2.fromOffset(180, 42),
        BackgroundColor3 = Color3.fromRGB(26, 26, 30), Visible = false,
        ZIndex = 250, Parent = Root,
    })
    round(launcher, 21)
    local launcherStroke = outline(launcher, "Stroke", 1, 0.55)

    local launcherIcon = makeIcon(launcher, cfg.Icon or "zap", 16, false, {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0), ZIndex = 252,
    })
    launcherIcon.Color(Color3.new(1, 1, 1))
    launcherIcon.Image.ZIndex = 252
    launcherIcon.Glyph.ZIndex = 252
    tx("TextLabel", {
        Text = title, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -50, 1, 0),
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 251, Parent = launcher,
    }, 3).TextColor3 = Color3.new(1, 1, 1)

    local launcherScale = mk("UIScale", {Scale = 0, Parent = launcher})
    Window.Launcher = launcher

    local launcherMoved = false
    makeDraggable({launcher}, launcher, {
        MoveThreshold = 6,
        clamp = function(p)
            local v = viewport()
            local s = launcher.AbsoluteSize
            return Vector2.new(math.clamp(p.X, 0, math.max(0, v.X - s.X)), math.clamp(p.Y, 0, math.max(0, v.Y - s.Y)))
        end,
        onEnd = function(moved) launcherMoved = moved end,
    })
    launcher.Activated:Connect(function()
        if launcherMoved then launcherMoved = false return end
        launcher.Visible = false
        show()
    end)

    -- ============================================
    -- Tab construction
    -- ============================================
    local function addTabButton(tab, icon, name)
        local btn = mk("TextButton", {
            Name = "Tab_" .. name, Size = UDim2.new(1, 0, 0, 40),
            BackgroundColor3 = Pal.Elevated, BackgroundTransparency = 1,
            ZIndex = 24, Parent = tabScroll,
        })
        round(btn, 10)
        tab.Button = btn

        local ico = makeIcon(btn, icon, 20, "Sub", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            ZIndex = 25,
        })
        ico.Image.ZIndex = 25
        ico.Glyph.ZIndex = 25
        tab.IconObj = ico

        function tab:SetIcon(id) ico.Set(id) end
        function tab:SetActive(active)
            play(btn, 0.2, {BackgroundTransparency = active and 0.82 or 1})
            ico.Color(active and Pal.Accent or Pal.Sub, true)
        end

        btn.MouseEnter:Connect(function()
            if Window.Selected ~= tab then
                play(btn, 0.15, {BackgroundTransparency = 0.92})
                ico.Color(Pal.Text, true)
            end
            -- Tooltip: pinned to the right of the button
            tipToken = tipToken + 1
            local mine = tipToken
            task.delay(tipDelay, function()
                if mine ~= tipToken then return end
                local absPos = btn.AbsolutePosition
                local absSz = btn.AbsoluteSize
                showTip(name, absPos.X + absSz.X + 6)
            end)
        end)
        btn.MouseLeave:Connect(function()
            if Window.Selected ~= tab then
                play(btn, 0.2, {BackgroundTransparency = 1})
                ico.Color(Pal.Sub, true)
            end
            hideTip()
        end)
        btn.Activated:Connect(function()
            Window:SelectTab(tab)
        end)
    end

    -- ============================================
    -- Return an API for the user
    -- ============================================
    Window._parts = {
        shell = shell, clip = clip, header = header, body = body, side = side,
        tabScroll = tabScroll, content = content, uiScale = uiScale,
        topH = topH, sideW = sideW, mobile = mobile, searchIndex = searchIndex,
        baseW = baseW, baseH = baseH, launcher = launcher,
        fullH = function() return fullH end,
        closeBtn = tlClose, minBtn = tlMin, searchBtn = tlSearch,
        titleIcon = titleIcon,
    }

    if not Nihon.ShowLauncher then launcher.Visible = false end

    -- Register so methods get attached
    if Hooks.attach then Hooks.attach(Window)
    else
        Hooks._pending = Hooks._pending or {}
        Hooks._pending[#Hooks._pending + 1] = Window
    end

    -- Expose the addTabButton helper so TabImpl can use it
    Window._addTabButton = addTabButton

    -- Set flags if ShowClose etc. off: hide the traffic lights
    if not Nihon.ShowClose then tlClose.Visible = false end
    if not Nihon.ShowMinimize then tlMin.Visible = false end
    if not Nihon.ShowSearch then tlSearch.Visible = false end

    return Window
end

-- ============================================
-- Tab implementation
-- ============================================
local TabImpl = {}

function TabImpl.make(Window, tcfg)
    local P = Window._parts
    local mobile = P.mobile
    tcfg = tcfg or {}
    local name = tostring(tcfg.Name or "Tab")
    local iconName = tcfg.Icon or "circle"
    local pendingBuilder = type(tcfg.Builder) == "function" and tcfg.Builder or nil
    local tabBuilt = false

    local Tab = {Name = name, Sections = {}, Window = Window, SubTabs = {}, _icon = iconName}
    local index = #Window.Tabs + 1
    Tab.Index = index

    Window._addTabButton(Tab, iconName, name)

    -- Page
    local page = mk("CanvasGroup", {
        Name = "Page_" .. name, Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, GroupTransparency = 1, Visible = false,
        ZIndex = 23, Parent = P.content,
    })

    local scroll = mk("ScrollingFrame", {
        Name = "Scroll", Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, ScrollBarThickness = 3,
        ScrollBarImageTransparency = 0.4, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.Never,
        ZIndex = 23, Parent = page,
    })
    bind(scroll, "ScrollBarImageColor3", "Stroke")
    inset(scroll, 18, 18, 18, 18)
    stack(scroll, 10)

    Tab.Page, Tab.Scroll = page, scroll

    local scrollMemory = 0
    Tab.Remember = function() scrollMemory = scroll.CanvasPosition.Y end
    Tab.Restore = function() scroll.CanvasPosition = Vector2.new(0, scrollMemory) end

    Window.Tabs[index] = Tab

    if #Window.Tabs == 1 then
        task.defer(function()
            task.wait()
            Window:SelectTab(Tab, true)
        end)
    end

    local tabApi = ElementFactory(Window, Tab, scroll, nil)

    function Tab:_EnsureBuilt()
        if tabBuilt then return end
        tabBuilt = true
        if pendingBuilder then
            local ok, err = pcall(pendingBuilder, tabApi)
            if not ok then warn("[Nihon] tab builder failed: " .. tostring(err)) end
        end
    end

    function tabApi:AddSection(sc)
        sc = type(sc) == "table" and sc or {Name = sc}
        local secName = tostring(sc.Name or "Section")
        local holder = mk("Frame", {
            Name = "Section_" .. secName, Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
            LayoutOrder = #Tab.Sections + 1, ZIndex = 23, Parent = scroll,
        })
        stack(holder, 6)

        local head = mk("Frame", {
            Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
            LayoutOrder = 0, ZIndex = 24, Parent = holder,
        })
        local bar = mk("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(3, 10), BackgroundColor3 = Pal.Accent,
            ZIndex = 25, Parent = head,
        })
        round(bar, 2)
        accentGradient(bar, 90)
        tx("TextLabel", {
            Text = string.upper(secName), TextSize = 10, Font = Fonts[currentFont][3],
            Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0),
            ZIndex = 25, Parent = head,
        }, 3, "Sub")

        local bodyClip = mk("Frame", {
            Name = "Body", Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
            LayoutOrder = 1, ZIndex = 24, Parent = holder,
        })
        stack(bodyClip, 8)

        local section = ElementFactory(Window, Tab, bodyClip, secName)
        section.Holder = holder
        Tab.Sections[#Tab.Sections + 1] = section

        function section:SetName(n)
            secName = tostring(n)
            -- Update the header label
            for _, c in ipairs(head:GetChildren()) do
                if c:IsA("TextLabel") then c.Text = string.upper(secName) end
            end
        end

        function section:AddInfoGrid()
            local grid = mk("Frame", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, LayoutOrder = 99999, ZIndex = 24, Parent = bodyClip,
            })
            mk("UIGridLayout", {
                CellSize = UDim2.new(0.5, -4, 0, 64),
                CellPadding = UDim2.new(0, 8, 0, 8),
                SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid,
            })
            local api = {}
            function api:Add(icon, label, getValue, getColor)
                local cell = mk("Frame", {
                    BackgroundColor3 = Pal.Surface, BackgroundTransparency = 0.5,
                    ZIndex = 24, Parent = grid,
                })
                round(cell, 10)
                outline(cell, "Stroke", 1, 0.55)
                local ic = makeIcon(cell, icon, 14, "Sub", {Position = UDim2.fromOffset(12, 10), ZIndex = 25})
                tx("TextLabel", {
                    Text = tostring(label), TextSize = 10, Position = UDim2.fromOffset(32, 10),
                    Size = UDim2.new(1, -44, 0, 14), ZIndex = 25, Parent = cell,
                }, 1, "Sub")
                local val = tx("TextLabel", {
                    Text = "-", TextSize = 14, Position = UDim2.fromOffset(12, 30),
                    Size = UDim2.new(1, -24, 0, 22), ZIndex = 25, Parent = cell,
                }, 3)
                task.spawn(function()
                    while cell.Parent do
                        val.Text = tostring(getValue())
                        if getColor then
                            local c = getColor()
                            if c then ic.Color(c, false) end
                        end
                        task.wait(0.4)
                    end
                end)
                return cell
            end
            return api
        end

        return section
    end

    return tabApi
end

function TabImpl.select(Window, target, instant)
    if type(target) == "number" then target = Window.Tabs[target] end
    if type(target) == "string" then
        for _, t in ipairs(Window.Tabs) do
            if t.Name == target then target = t break end
        end
    end
    if type(target) ~= "table" or not target.Button then return end
    local prev = Window.Selected
    if prev == target then return end
    Popup.close(true)
    hideTip()
    Window.Selected = target
    if target._EnsureBuilt then target:_EnsureBuilt() end

    for _, t in ipairs(Window.Tabs) do
        local active = t == target
        if t.SetActive then t:SetActive(active) end
        t.Page.Visible = active
        t.Page.GroupTransparency = active and 0 or 1
    end
    if target.Restore then target.Restore() end
    if Window.OnTabChanged then task.spawn(Window.OnTabChanged, target) end
end

-- ============================================
-- Element factory (all elements preserved)
-- ============================================
local ElementFactory
local function extendElements(E, ctx)
    local Window, Tab, P = ctx.Window, ctx.Tab, ctx.P
    local card, nameLabel, decorate, register, fail = ctx.card, ctx.nameLabel, ctx.decorate, ctx.register, ctx.fail
    local mobile, rowH = ctx.mobile, ctx.rowH

    function E:AddButton(o)
        o = o or {}
        local label = tostring(o.Name or "Button")
        local c = card(rowH, true)
        nameLabel(c, label, UDim2.new(1, -60, 1, 0))
        local arrow = makeIcon(c, o.Icon or "chevron-right", 16, "Sub", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), ZIndex = 25,
        })
        arrow.Image.ZIndex = 25
        arrow.Glyph.ZIndex = 25
        local obj = {}
        local running = false
        function obj:Fire(...)
            if obj:IsLocked() or running then return end
            running = true
            play(c, 0.08, {BackgroundTransparency = 0.3})
            task.delay(0.08, function() play(c, 0.25, {BackgroundTransparency = 0.15}) end)
            local args = table.pack(...)
            task.spawn(function()
                local cb = o.Callback
                if type(cb) == "function" then
                    local ok, err = pcall(cb, table.unpack(args, 1, args.n))
                    if not ok then fail(c, label, err) end
                end
                running = false
            end)
        end
        c.Activated:Connect(function() obj:Fire() end)
        function obj:SetCallback(fn) o.Callback = fn end
        return decorate(obj, c, o, "Button")
    end

    function E:AddToggle(o)
        o = o or {}
        local label = tostring(o.Name or "Toggle")
        local c = card(rowH, true)
        nameLabel(c, label, UDim2.new(1, -80, 1, 0))
        local track = mk("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
            Size = UDim2.fromOffset(42, 22), ZIndex = 25, Parent = c,
        })
        bind(track, "BackgroundColor3", "Elevated")
        round(track, 11)
        local trackStroke = outline(track, "Stroke", 1, 0.25)
        local fill = mk("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1, ZIndex = 26, Parent = track,
        })
        round(fill, 11)
        accentGradient(fill, 25)
        local knob = mk("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1),
            ZIndex = 28, Parent = track,
        })
        round(knob, 8)
        local state = {value = false}
        local obj = {Value = false}
        local function paint(v, animated)
            local dur = animated and 0.28 or 0.001
            play(fill, dur, {BackgroundTransparency = v and 0 or 1})
            play(knob, dur, {Position = UDim2.new(0, v and 23 or 3, 0.5, 0)}, Enum.EasingStyle.Back)
            play(trackStroke, dur, {Transparency = v and 1 or 0.25})
        end
        local firer = makeFirer(function() return state.value end, function(v)
            local ok, err = pcall(o.Callback or function() end, v)
            if not ok then fail(c, label, err) end
        end)
        function obj:Set(v, silent)
            v = v and true or false
            state.value = v
            obj.Value = v
            paint(v, true)
            if silent then firer.Sync(v) else firer.Fire() queueSave() end
        end
        function obj:Get() return state.value end
        function obj:Toggle() obj:Set(not state.value) end
        c.Activated:Connect(function() if not obj:IsLocked() then obj:Set(not state.value) end end)
        register(o.Flag, obj, o, function() return state.value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Toggle")
        local start = o.Default and true or false
        state.value = start
        obj.Value = start
        paint(start, false)
        if start then initFires[#initFires + 1] = function() firer.Fire() end
        else firer.Sync(false) end
        return obj
    end

    function E:AddSlider(o)
        o = o or {}
        local label = tostring(o.Name or "Slider")
        local min, max = tonumber(o.Min) or 0, tonumber(o.Max) or 100
        if max <= min then max = min + 1 end
        local step = tonumber(o.Increment) or 1
        local c = card(54, true)
        local nm = nameLabel(c, label, UDim2.new(0.55, 0, 0, 20))
        nm.Position = UDim2.fromOffset(14, 8)
        local valLbl = tx("TextLabel", {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 8),
            Size = UDim2.new(0.45, 0, 0, 20), TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 16, Parent = c,
        }, 3, "Accent")
        local rail = mk("TextButton", {
            Position = UDim2.new(0, 14, 1, -20), Size = UDim2.new(1, -28, 0, 8),
            ZIndex = 16, Parent = c,
        })
        bind(rail, "BackgroundColor3", "Elevated")
        round(rail, 4)
        local fillBar = mk("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 17, Parent = rail})
        round(fillBar, 4)
        accentGradient(fillBar, 0)
        local knob = mk("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 19, Parent = rail,
        })
        round(knob, 7)
        local value = math.clamp(tonumber(o.Default) or min, min, max)
        local obj = {Value = value}
        local function fracOf(v) return math.clamp((v - min) / (max - min), 0, 1) end
        local function draw(frac)
            fillBar.Size = UDim2.new(frac, 0, 1, 0)
            knob.Position = UDim2.new(frac, 0, 0.5, 0)
        end
        local firer = makeFirer(function() return obj.Value end, function(v)
            local ok, err = pcall(o.Callback or function() end, v)
            if not ok then fail(c, label, err) end
        end)
        local function commit(v, silent)
            v = math.clamp(snapTo(v, step, min), min, max)
            if v == obj.Value then return end
            obj.Value = v
            draw(fracOf(v))
            valLbl.Text = numFormat(v, step, o.ValueName or "")
            if silent then firer.Sync(v) else firer.Fire() queueSave() end
        end
        function obj:Set(v, silent) commit(tonumber(v) or min, silent) end
        function obj:Get() return obj.Value end
        local function fromX(x)
            local rel = (x - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1)
            commit(min + (max - min) * math.clamp(rel, 0, 1))
        end
        local railDragging = false
        rail.InputBegan:Connect(function(input)
            if not isPointer(input) then return end
            railDragging = true
            fromX(input.Position.X)
        end)
        keep(UserInputService.InputChanged:Connect(function(input)
            if not railDragging then return end
            local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            local isTouch = input.UserInputType == Enum.UserInputType.Touch
            if not isMouse and not isTouch then return end
            fromX(input.Position.X)
        end))
        keep(UserInputService.InputEnded:Connect(function(input)
            if not railDragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            railDragging = false
        end))
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Slider")
        valLbl.Text = numFormat(value, step, o.ValueName or "")
        draw(fracOf(value))
        initFires[#initFires + 1] = function() firer.Fire() end
        return obj
    end

    function E:AddTextbox(o)
        o = o or {}
        local label = tostring(o.Name or "Textbox")
        local c = card(rowH, true)
        nameLabel(c, label, UDim2.new(0.4, 0, 1, 0))
        local box = tx("TextBox", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.new(0.54, -6, 0, 28),
            Text = tostring(o.Default or ""), PlaceholderText = o.Placeholder or "type here",
            TextSize = 12, ZIndex = 16, Parent = c,
        }, 2)
        bind(box, "BackgroundColor3", "Elevated")
        box.BackgroundTransparency = 0
        round(box, 8)
        inset(box, 0, 10, 0, 10)
        local obj = {Value = box.Text}
        local firer = makeFirer(function() return obj.Value end, function(v)
            local ok, err = pcall(o.Callback or function() end, v)
            if not ok then fail(c, label, err) end
        end)
        box.FocusLost:Connect(function()
            obj.Value = box.Text
            firer.Sync(nil); firer.Fire(); queueSave()
        end)
        function obj:Set(v, silent)
            box.Text = tostring(v); obj.Value = box.Text
            if silent then firer.Sync(obj.Value) else firer.Sync(nil); firer.Fire(); queueSave() end
        end
        function obj:Get() return obj.Value end
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v) end)
        return decorate(obj, c, o, "Textbox")
    end

    function E:AddKeybind(o)
        o = o or {}
        local label = tostring(o.Name or "Keybind")
        local c = card(rowH, true)
        nameLabel(c, label, UDim2.new(1, -110, 1, 0))
        local chip = tx("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.fromOffset(56, 26), TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 16, Parent = c,
        }, 3)
        bind(chip, "BackgroundColor3", "Elevated")
        chip.BackgroundTransparency = 0
        round(chip, 8)
        local obj = {Value = o.Default, Binding = false}
        local function refresh()
            local t = obj.Binding and "..." or (obj.Value and keyText(obj.Value) or "None")
            chip.Text = t
        end
        function obj:Set(k, silent) obj.Value = k; obj.Binding = false; refresh(); if not silent then queueSave() end end
        function obj:Get() return obj.Value end
        chip.Activated:Connect(function() obj.Binding = true; refresh() end)
        keep(UserInputService.InputBegan:Connect(function(input, gpe)
            if obj.Binding then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode == Enum.KeyCode.Escape then obj:Set(nil)
                    else obj:Set(input.KeyCode) end
                end
                return
            end
            if gpe or not obj.Value then return end
            if input.KeyCode == obj.Value then
                task.spawn(function()
                    local ok, err = pcall(o.Callback or function() end, true)
                    if not ok then fail(c, label, err) end
                end)
            end
        end))
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v, true) end)
        decorate(obj, c, o, "Keybind")
        obj:Set(o.Default, true)
        return obj
    end
    E.AddBind = E.AddKeybind

    function E:AddDropdown(o)
        o = o or {}
        local label = tostring(o.Name or "Dropdown")
        local c = card(rowH, true)
        c.ClipsDescendants = false
        c.AutomaticSize = Enum.AutomaticSize.None
        local header = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, rowH), BackgroundTransparency = 1, ZIndex = 25, Parent = c,
        })
        nameLabel(header, label, UDim2.new(0.5, 0, 1, 0))
        local valLbl = tx("TextLabel", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -36, 0.5, 0),
            Size = UDim2.new(0.5, -44, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
            TextSize = 12, ZIndex = 15, Parent = header,
        }, 3, "Accent")
        local arrow = makeIcon(header, "chevron-down", 14, "Sub", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), ZIndex = 15,
        })
        arrow.Image.ZIndex = 15
        arrow.Glyph.ZIndex = 15

        local listFrame = mk("Frame", {
            Name = "List", Position = UDim2.fromOffset(8, rowH + 4),
            Size = UDim2.new(1, -16, 0, 0), BackgroundTransparency = 1,
            ClipsDescendants = true, ZIndex = 24, Parent = c,
        })
        local listScroll = mk("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
            ScrollBarThickness = 3, CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 24, Parent = listFrame,
        })
        stack(listScroll, 3)
        inset(listScroll, 4, 4, 4, 4)

        local obj = {Options = o.Options or {}, Value = nil, IsOpen = false}
        local firer
        local rows = {}

        local function summary()
            return obj.Value ~= nil and tostring(obj.Value) or "None"
        end
        firer = makeFirer(function() return obj.Value end, function()
            local ok, err = pcall(o.Callback or function() end, obj.Value)
            if not ok then fail(c, label, err) end
        end)

        local function restyle()
            valLbl.Text = summary()
            for opt, r in pairs(rows) do
                if r.btn.Parent then
                    local on = obj.Value == opt
                    play(r.btn, 0.15, {BackgroundTransparency = on and 0.86 or 1})
                    r.label.TextColor3 = on and Pal.Text or Pal.Sub
                end
            end
        end

        local function layoutList()
            local visible = 0
            for _, r in pairs(rows) do if r.btn.Visible then visible = visible + 1 end end
            local h = math.min(visible * 32 + 8, 240)
            if obj.IsOpen then
                play(listFrame, 0.26, {Size = UDim2.new(1, -16, 0, h)}, Enum.EasingStyle.Quart)
            else
                play(listFrame, 0.2, {Size = UDim2.new(1, -16, 0, 0)}, Enum.EasingStyle.Quart)
            end
            play(c, 0.26, {Size = UDim2.new(1, 0, 0, rowH + (obj.IsOpen and (h + 8) or 0))}, Enum.EasingStyle.Quart)
            play(arrow.Image, 0.22, {Rotation = obj.IsOpen and 180 or 0})
            play(arrow.Glyph, 0.22, {Rotation = obj.IsOpen and 180 or 0})
        end

        local function rebuildRows()
            for _, r in pairs(rows) do r.btn:Destroy() end
            rows = {}
            for i, opt in ipairs(obj.Options) do
                local b = mk("TextButton", {
                    Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.new(1, 1, 1),
                    BackgroundTransparency = 1, LayoutOrder = i, ZIndex = 25, Parent = listScroll,
                })
                round(b, 7)
                accentGradient(b, 0)
                local l = tx("TextLabel", {
                    Text = tostring(opt), TextSize = 12, Position = UDim2.fromOffset(12, 0),
                    Size = UDim2.new(1, -24, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 26, Parent = b,
                }, 2, "Sub")
                rows[opt] = {btn = b, label = l}
                b.MouseEnter:Connect(function() if obj.Value ~= opt then play(b, 0.12, {BackgroundTransparency = 0.92}) end end)
                b.MouseLeave:Connect(function() if obj.Value ~= opt then play(b, 0.18, {BackgroundTransparency = 1}) end end)
                b.Activated:Connect(function() obj:Set(opt); obj:Close() end)
            end
            restyle()
        end

        function obj:Open()
            if obj.IsOpen then return end
            obj.IsOpen = true
            rebuildRows()
            layoutList()
        end
        function obj:Close()
            if not obj.IsOpen then return end
            obj.IsOpen = false
            layoutList()
        end
        function obj:Toggle() if obj.IsOpen then obj:Close() else obj:Open() end end
        function obj:Get() return obj.Value end
        function obj:Set(v, silent)
            if v ~= nil and not table.find(obj.Options, v) then return end
            obj.Value = v
            restyle()
            if silent then firer.Sync(v) else firer.Fire(); queueSave() end
        end
        function obj:Refresh(list, keepValue)
            obj.Options = list or {}
            if not keepValue or not table.find(obj.Options, obj.Value) then obj.Value = nil end
            if obj.IsOpen then rebuildRows(); layoutList() end
            valLbl.Text = summary()
        end

        header.Activated:Connect(function() obj:Toggle() end)
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Dropdown")
        obj:Set(o.Default or obj.Options[1], true)
        initFires[#initFires + 1] = function() firer.Fire() end
        return obj
    end

