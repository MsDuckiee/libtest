        hideTip()
        closeToken = closeToken + 1
        local mine = closeToken

        if toMorph and Nihon.ShowLauncher then
            Window.Morphing = true

            local startW = shell.Size.X.Offset
            local startH = shell.Size.Y.Offset
            play(shell, 0.3, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
