    -- For simplicity, we'll just move it along with shell using a follow connection.
    local shadowFollow
    shadowFollow = RunService.RenderStepped:Connect(function()
        if not shell.Parent or not shell.Visible then
            shadow.Visible = false
            return
        end
        shadow.Visible = shell.BackgroundTransparency < 0.9
        shadow.Position = shell.Position + UDim2.fromOffset(6, 8)
        shadow.Size = shell.Size
        shadow.BackgroundColor3 = Color3.new(0, 0, 0)
