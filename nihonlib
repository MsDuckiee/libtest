            return
        end
        local m = UserInputService:GetMouseLocation()
        local v = viewport()
        local s = tipBox.AbsoluteSize
        local x = math.clamp(m.X + 16, 6, v.X - s.X - 26)
        local y = math.clamp(m.Y + 20, 6, v.Y - s.Y - 26)
        tipBox.Position = UDim2.fromOffset(x, y)
    end)
end

local function hideTip()
    tipToken = tipToken + 1
    if tipFollowConn then tipFollowConn:Disconnect() tipFollowConn = nil end
    if tipBox then
        local old = tipBox
        tipBox = nil
        fadeGroup(old, 0.12, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.2, function()
            if old and old.Parent then old:Destroy() end
        end)
    end
end

local function showTip(text)
    if tipBox then tipBox:Destroy() tipBox = nil end
    if not text or text == "" then return end
    local size = TextService:GetTextSize(tostring(text), 12, Fonts[currentFont][2], Vector2.new(230, 1000))
    local box = mk("CanvasGroup", {
        Size = UDim2.fromOffset(size.X + 20, size.Y + 10),
        ZIndex = 400,
        BackgroundColor3 = Pal.Elevated,
        BackgroundTransparency = 0.02,
        GroupTransparency = 1,
        Parent = Root,
    })
    round(box, 6)
    mk("UIStroke", {Color = Pal.Stroke, Thickness = 1, Transparency = 0.15, Parent = box})
    tx("TextLabel", {
        Size = UDim2.fromScale(1, 1), Text = tostring(text), TextSize = 12, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Pal.Text, ZIndex = 401, Parent = box,
    }, 2)
    local m = UserInputService:GetMouseLocation()
    local v = viewport()
    local x = math.clamp(m.X + 16, 6, v.X - size.X - 26)
    local y = math.clamp(m.Y + 20, 6, v.Y - size.Y - 26)
    box.Position = UDim2.fromOffset(x, y)
    tipBox = box
    ensureTipFollow()
    fadeGroup(box, 0.15, 0, Enum.EasingStyle.Quart)
end

local function attachTip(gui, getText)
    if Nihon.IsMobile then return end
    gui.MouseEnter:Connect(function()
        tipToken = tipToken + 1
        local mine = tipToken
        task.delay(tipDelay, function()
            if mine ~= tipToken then return end
            local t = type(getText) == "function" and getText() or getText
            if t and t ~= "" then showTip(tostring(t)) end
        end)
    end)
    gui.MouseLeave:Connect(hideTip)
    gui.InputBegan:Connect(function(i)
        if isPointer(i) then hideTip() end
    end)
end

