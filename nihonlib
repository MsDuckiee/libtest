function ElementFactory(Window, Tab, parent, sectionName)
    local P = Window._parts
    local mobile = P.mobile
    local E = {_count = 0}
    local rowH = mobile and 42 or 38

    local function card(height, hover)
        local c = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, height or rowH), BackgroundTransparency = 0.35,
            ZIndex = 24, LayoutOrder = E._count + 1, Parent = parent,
        })
        bind(c, "BackgroundColor3", "Surface")
        round(c, 9)
        local st = outline(c, "Stroke", 1, 0.55)
        if hover ~= false then
            if mobile then
                c.InputBegan:Connect(function(input)
                    if isPointer(input) then
                        play(c, 0.08, {BackgroundTransparency = 0.2})
                        play(st, 0.08, {Transparency = 0.2})
                    end
                end)
                c.InputEnded:Connect(function(input)
                    if isPointer(input) then
                        play(c, 0.2, {BackgroundTransparency = 0.35})
                        play(st, 0.2, {Transparency = 0.55})
                    end
                end)
            else
                c.MouseEnter:Connect(function()
                    play(c, 0.15, {BackgroundTransparency = 0.2})
                    play(st, 0.15, {Transparency = 0.2})
                end)
                c.MouseLeave:Connect(function()
                    play(c, 0.2, {BackgroundTransparency = 0.35})
                    play(st, 0.2, {Transparency = 0.55})
                end)
            end
        end
        return c, st
    end

    local function nameLabel(c, text, width)
        return tx("TextLabel", {
            Name = "Name", Text = tostring(text), TextSize = 13, Position = UDim2.fromOffset(14, 0),
            Size = width or UDim2.new(1, -90, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 25, Parent = c,
        }, 2)
    end

    local function decorate(obj, c, opts, kind)
        E._count = E._count + 1
        local locked = false
        local veil = mk("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 0.5, Visible = false, ZIndex = 40, Parent = c,
        })
        round(veil, 9)
        makeIcon(veil, "lock", 14, "Sub", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 41,
        })
        function obj:Lock(v)
            if v == nil then v = true end
            locked = v and true or false
            veil.Visible = locked
        end
        function obj:IsLocked() return locked end
        function obj:Destroy()
            c:Destroy()
            for i, e in ipairs(P.searchIndex) do
                if e.owner == obj then table.remove(P.searchIndex, i) break end
            end
        end
        function obj:SetName(n)
            local l = c:FindFirstChild("Name")
            if l then l.Text = tostring(n) end
        end
        obj.Card = c
        obj.Kind = kind
        if opts.Locked then obj:Lock(true) end
        P.searchIndex[#P.searchIndex + 1] = {
            owner = obj, name = tostring(opts.Name or kind), tab = Tab.Name,
            section = sectionName, kind = kind,
            go = function()
                if Window.RequestOpen then Window.RequestOpen() end
                Window:SelectTab(Tab)
            end,
        }
        return obj
    end

    local function register(flag, obj, opts, get, set)
        if not flag then return end
        registerFlag(flag, {get = get, set = set, save = opts.Save == true, obj = obj})
        Nihon.Flags[flag] = obj
    end

    local function fail(c, label, err)
        flashCard(c, Status.Error, 1.1)
        shake(c)
        Nihon:MakeNotification({
            Name = (label or "Action") .. " failed", Content = errorText(err), Type = "Error", Time = 5,
        })
    end

    extendElements(E, {
        Window = Window, Tab = Tab, P = P, card = card, nameLabel = nameLabel,
        decorate = decorate, register = register, fail = fail, mobile = mobile, rowH = rowH,
    })

    return E
end

-- helpers
function numFormat(v, step, suffix)
    local s
    if step < 1 then
        local frac = (tostring(step):gsub("^0%.", ""))
        local places = math.min(3, math.max(1, #frac))
        s = string.format("%." .. places .. "f", v)
        s = (s:gsub("0+$", ""))
        s = (s:gsub("%.$", ""))
    else
        s = tostring(math.floor(v + 0.5))
    end
    if suffix and suffix ~= "" then return s .. " " .. suffix end
    return s
end
function snapTo(v, step, min)
    if step <= 0 then return v end
    return min + math.floor((v - min) / step + 0.5) * step
end
function keyText(k)
    if not k then return "None" end
    if type(k) == "string" then return k end
    local map = {LeftShift = "LShift", RightShift = "RShift", LeftControl = "LCtrl",
        RightControl = "RCtrl", LeftAlt = "LAlt", RightAlt = "RAlt", Backquote = "`", Return = "Enter"}
    return map[k.Name] or k.Name
end

