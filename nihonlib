        Name = "Window", AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(baseW, baseH),
        ClipsDescendants = false, GroupTransparency = 0, Visible = false,
