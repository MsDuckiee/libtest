local function flipTabs(Window, from, to, forward)
    local P = Window._parts
    local dir = forward and 1 or -1
    local contentW = P.content.AbsoluteSize.X

    if from and from ~= to then
        from.Remember()
        local outPage = from.Page
        outPage.Visible = true
        outPage.Position = UDim2.fromOffset(0, 0)
        outPage.GroupTransparency = 0
        play(outPage, 0.32, {Position = UDim2.fromOffset(-contentW * dir, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
        play(outPage, 0.26, {GroupTransparency = 1}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
        task.delay(0.34, function()
            if Window.Selected ~= from then
                outPage.Visible = false
                outPage.Position = UDim2.fromOffset(0, 0)
                outPage.GroupTransparency = 1
            end
        end)
    end

    local inPage = to.Page
    inPage.Visible = true
    inPage.GroupTransparency = 1
    inPage.Position = UDim2.fromOffset(contentW * dir, 0)
    to.Restore()

    play(inPage, 0.42, {Position = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    play(inPage, 0.32, {GroupTransparency = 0}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
end

function TabImpl.select(Window, target, instant)
    local P = Window._parts
    if type(target) == "number" then target = Window.Tabs[target] end
    if type(target) == "string" then
        for _, t in ipairs(Window.Tabs) do
            if t.Name == target then target = t break end
        end
    end
    if type(target) ~= "table" or not target.Button then return end
    local prev = Window.Selected
    if prev == target then return end
    Popup.close(true)
    hideTip()
    Window.Selected = target
    if target._EnsureBuilt then target:_EnsureBuilt() end
    if Window._updatePill then Window._updatePill() end

    local forward = not prev or target.Index > prev.Index
    if instant or not prev then
        for _, t in ipairs(Window.Tabs) do
            t.Page.Visible = t == target
            t.Page.GroupTransparency = t == target and 0 or 1
            t.Page.Position = UDim2.fromOffset(0, 0)
        end
        target.Restore()
    else
        flipTabs(Window, prev, target, forward)
    end

    for _, t in ipairs(Window.Tabs) do
        local active = t == target
        t.IconObj.Color(active and Pal.Accent or Pal.Sub, not instant)
    end

    if Window.OnTabChanged then task.spawn(Window.OnTabChanged, target) end
end

local function numFormat(v, step, suffix)
    local s
    if step < 1 then
        local frac = (tostring(step):gsub("^0%.", ""))
        local places = math.min(3, math.max(1, #frac))
        s = string.format("%." .. places .. "f", v)
        s = (s:gsub("0+$", ""))
        s = (s:gsub("%.$", ""))
    else
        s = tostring(math.floor(v + 0.5))
    end
    if suffix and suffix ~= "" then return s .. " " .. suffix end
    return s
end

local function snapTo(v, step, min)
    if step <= 0 then return v end
    return min + math.floor((v - min) / step + 0.5) * step
end

local function toneColor(name)
    if name == nil then return Pal.Accent end
    if typeof(name) == "Color3" then return name end
    if type(name) == "string" then
        if Pal[name] then return Pal[name] end
        if Status[name] then return Status[name] end
    end
    return Pal.Accent
end

local function extendElements(E, ctx)
    local Window, Tab, P = ctx.Window, ctx.Tab, ctx.P
    local card, nameLabel, decorate, register, fail = ctx.card, ctx.nameLabel, ctx.decorate, ctx.register, ctx.fail
    local mobile, rowH = ctx.mobile, ctx.rowH

    -- ============================================
    -- SLIDER (no glow)
    -- ============================================
    function E:AddSlider(o)
        o = o or {}
        local label = tostring(o.Name or "Slider")
        local min, max = tonumber(o.Min) or 0, tonumber(o.Max) or 100
        if max <= min then max = min + 1 end
        local step = tonumber(o.Increment) or 1
        local suffix = o.ValueName or ""
        local c = card(mobile and 60 or 56, true)
        local nm = nameLabel(c, label, UDim2.new(0.55, 0, 0, 22))
        nm.Position = UDim2.fromOffset(14, 7)
        local valBox = tx("TextBox", {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 7), Size = UDim2.new(0.45, 0, 0, 22), TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 16, Parent = c,
        }, 3, "Accent")
        valBox.ClearTextOnFocus = true
        local rail = mk("TextButton", {
            Position = UDim2.new(0, 14, 1, mobile and -22 or -20), Size = UDim2.new(1, -28, 0, mobile and 10 or 8), ZIndex = 16, Parent = c,
        })
        bind(rail, "BackgroundColor3", "Elevated")
        round(rail, 5)
        local fillBar = mk("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 17, Parent = rail})
        round(fillBar, 5)
        accentGradient(fillBar, 0)
        local knob = mk("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(mobile and 18 or 14, mobile and 18 or 14),
            BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 19, Parent = rail,
        })
        round(knob, 9)
        local value = math.clamp(tonumber(o.Default) or min, min, max)
        local obj = {Value = value}
        local function fracOf(v) return math.clamp((v - min) / (max - min), 0, 1) end
        local function draw(frac)
            fillBar.Size = UDim2.new(frac, 0, 1, 0)
            knob.Position = UDim2.new(frac, 0, 0.5, 0)
        end
        local firer = makeFirer(function() return obj.Value end, function(v)
            local ok, err = pcall(o.Callback or function() end, v)
            if not ok then fail(c, label, err) end
        end)
        local function commit(v, silent, jump)
            v = math.clamp(snapTo(v, step, min), min, max)
            if v == obj.Value and not jump then return end
            obj.Value = v
            draw(fracOf(v))
            valBox.Text = numFormat(v, step, suffix)
            if silent then firer.Sync(v) else firer.Fire() queueSave() end
        end
        function obj:Set(v, silent) commit(tonumber(v) or min, silent) end
        function obj:Get() return obj.Value end
        local function fromX(x)
            local rel = (x - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1)
            commit(min + (max - min) * math.clamp(rel, 0, 1))
        end
        local railDragging = false
        rail.InputBegan:Connect(function(input)
            if not isPointer(input) then return end
            if obj:IsLocked() then return end
            railDragging = true
            fromX(input.Position.X)
        end)
        keep(UserInputService.InputChanged:Connect(function(input)
            if not railDragging then return end
            local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            local isTouch = input.UserInputType == Enum.UserInputType.Touch
            if not isMouse and not isTouch then return end
            fromX(input.Position.X)
        end))
        keep(UserInputService.InputEnded:Connect(function(input)
            if not railDragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            railDragging = false
        end))
        valBox.FocusLost:Connect(function()
            local n = tonumber(valBox.Text:match("-?%d+%.?%d*"))
            if n then obj:Set(n) else valBox.Text = numFormat(obj.Value, step, suffix) end
        end)
        register(o.Flag, obj, o, function() return obj.Value end, function(v) obj:Set(v) end)
        decorate(obj, c, o, "Slider")
        valBox.Text = numFormat(value, step, suffix)
        draw(fracOf(value))
        initFires[#initFires + 1] = function() firer.Fire() end
        return obj
    end

