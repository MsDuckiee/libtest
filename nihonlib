        Visible = false, ZIndex = 180, Parent = Root,
    })
    local w = math.clamp(viewport().X - 32, 260, 440)
    local box = mk("CanvasGroup", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, mobile and 16 or 70), Size = UDim2.fromOffset(w, 0),
        AutomaticSize = Enum.AutomaticSize.Y, GroupTransparency = 1, ZIndex = 181, Parent = layer,
    })
    bind(box, "BackgroundColor3", "Surface")
    round(box, 14)
    outline(box, "Stroke", 1, 0.1)
    local boxScale = mk("UIScale", {Scale = 0.94, Parent = box})
    stack(box, 0)
    local top = mk("Frame", {Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 182, Parent = box})
    makeIcon(top, SEARCH_ICON, 16, "Sub", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.5, 0), ZIndex = 183})
    local input = tx("TextBox", {
        Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -90, 1, 0), PlaceholderText = "search features", TextSize = 14, ZIndex = 183, Parent = top,
    }, 2)
    input.ClearTextOnFocus = false
    local line = mk("Frame", {Size = UDim2.new(1, 0, 0, 1), LayoutOrder = 2, ZIndex = 182, Parent = box})
    bind(line, "BackgroundColor3", "Stroke")
    local list = mk("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ScrollBarThickness = 2, LayoutOrder = 3,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 182, Parent = box,
    })
    inset(list, 6, 6, 6, 6)
    stack(list, 2)

    local open = false
    local buttons = {}
    local picked = 1
    local shown = {}

    local function highlight()
        for i, b in ipairs(buttons) do play(b, 0.1, {BackgroundTransparency = i == picked and 0.84 or 1}) end
    end

    local function render()
        for _, b in ipairs(buttons) do b:Destroy() end
        buttons = {}
        shown = {}
        local q = input.Text
        local scored = {}
        for _, e in ipairs(P.searchIndex) do
            local sc = fuzzy(q, e.name .. " " .. e.tab .. " " .. e.kind)
            if sc then scored[#scored + 1] = {e = e, s = sc} end
        end
        table.sort(scored, function(a, b) return a.s > b.s end)
        for i = 1, math.min(#scored, 30) do shown[i] = scored[i].e end
        for i, e in ipairs(shown) do
            local b = mk("TextButton", {
                Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, LayoutOrder = i, ZIndex = 183, Parent = list,
            })
            round(b, 8)
            tx("TextLabel", {Text = e.name, TextSize = 13, Position = UDim2.fromOffset(12, 5), Size = UDim2.new(1, -90, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 184, Parent = b}, 2)
            tx("TextLabel", {
                Text = e.tab .. (e.section and (" / " .. e.section) or ""), TextSize = 10, Position = UDim2.fromOffset(12, 22), Size = UDim2.new(1, -90, 0, 13),
                TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 184, Parent = b,
            }, 1, "Sub")
            tx("TextLabel", {
                Text = e.kind, TextSize = 10, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(70, 14),
                TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 184, Parent = b,
            }, 3, "Accent")
            b.InputBegan:Connect(function(input)
                if not isPointer(input) then return end
                Window:CloseSearch()
                e.go()
            end)
            buttons[i] = b
        end
        if #shown == 0 then
            local none = tx("TextLabel", {
                Text = "nothing matches", TextSize = 12, Size = UDim2.new(1, 0, 0, 40),
                TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 183, Parent = list,
            }, 1, "Sub")
            buttons[1] = none
        end
        picked = 1
        list.Size = UDim2.new(1, 0, 0, math.min(math.max(#shown, 1) * 42 + 12, mobile and 170 or 300))
        highlight()
    end

    input:GetPropertyChangedSignal("Text"):Connect(function() if open then render() end end)

    function Window:OpenSearch()
        if open then return end
        open = true
        Popup.close(true)
        for _, t in ipairs(Window.Tabs) do if t._EnsureBuilt then t:_EnsureBuilt() end end
        input.Text = ""
        layer.Visible = true
        render()
        play(layer, 0.25, {BackgroundTransparency = 0.6})
        fadeGroup(box, 0.28, 0, Enum.EasingStyle.Quart)
        play(boxScale, 0.4, {Scale = 1}, Enum.EasingStyle.Back)
        if not mobile then
            task.delay(0.05, function()
                if open then input:CaptureFocus() end
            end)
        end
    end

    function Window:CloseSearch()
        if not open then return end
        open = false
        input:ReleaseFocus()
        play(layer, 0.2, {BackgroundTransparency = 1})
        fadeGroup(box, 0.22, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        play(boxScale, 0.22, {Scale = 0.96})
        task.delay(0.26, function()
            if not open then
                layer.Visible = false
                restoreGroup(box)
            end
        end)
    end

    layer.InputBegan:Connect(function(input)
        if isPointer(input) then Window:CloseSearch() end
    end)
    box.Active = true
    input.FocusLost:Connect(function(enter)
        if enter and shown[picked] then
            local e = shown[picked]
            Window:CloseSearch()
            e.go()
        end
    end)
    top.InputBegan:Connect(function(i) if isPointer(i) and open then input:CaptureFocus() end end)

    keep(UserInputService.InputBegan:Connect(function(i, gpe)
        if i.KeyCode == Enum.KeyCode.K and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
            if open then Window:CloseSearch() else Window:OpenSearch() end
            return
        end
        if not open then return end
        if i.KeyCode == Enum.KeyCode.Escape then
            Window:CloseSearch()
        elseif i.KeyCode == Enum.KeyCode.Down then
            picked = math.min(picked + 1, #shown)
            highlight()
        elseif i.KeyCode == Enum.KeyCode.Up then
            picked = math.max(picked - 1, 1)
            highlight()
        end
    end))

    P.searchBtn.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        if open then Window:CloseSearch() else Window:OpenSearch() end
    end)
end

local function attachStats(Window)
    local P = Window._parts
    local mobile = P.mobile
    local layer = mk("TextButton", {
        Name = "Stats", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
        Visible = false, ZIndex = 170, Parent = Root,
    })
    local w = mobile and 320 or 440
    local sheet = mk("CanvasGroup", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w, 0),
        AutomaticSize = Enum.AutomaticSize.Y, GroupTransparency = 1, ZIndex = 171, Parent = layer,
    })
    bind(sheet, "BackgroundColor3", "Surface")
    round(sheet, 16)
    outline(sheet, "Stroke", 1, 0.1)
    local sheetScale = mk("UIScale", {Scale = 0.92, Parent = sheet})
    local sheetLayout = stack(sheet, 0)
    sheetLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    local hero = mk("Frame", {Size = UDim2.new(1, 0, 0, 92), BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 1, ZIndex = 172, Parent = sheet})
    accentGradient(hero, 30)
    hero.BackgroundTransparency = 0.72
    local bigAvatar = mk("ImageLabel", {
        Position = UDim2.fromOffset(16, 16), Size = UDim2.fromOffset(60, 60), ZIndex = 173, Parent = hero,
    })
    bind(bigAvatar, "BackgroundColor3", "Elevated")
    round(bigAvatar, 30)
    outline(bigAvatar, "Text", 2, 0.6)
    Stat.avatar(function(img)
        if bigAvatar.Parent then bigAvatar.Image = img end
    end)
    tx("TextLabel", {Text = LocalPlayer.DisplayName, TextSize = 17, Position = UDim2.fromOffset(88, 22), Size = UDim2.new(1, -100, 0, 22), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 173, Parent = hero}, 3)
    tx("TextLabel", {Text = "@" .. LocalPlayer.Name, TextSize = 12, Position = UDim2.fromOffset(88, 45), Size = UDim2.new(1, -100, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 173, Parent = hero}, 1, "Sub")
    local rowsBox = mk("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 172, Parent = sheet})
    inset(rowsBox, 10, 12, 10, 12)
    mk("UIGridLayout", {
        CellSize = UDim2.new(0.5, -5, 0, 52), CellPadding = UDim2.fromOffset(8, 8),
        SortOrder = Enum.SortOrder.LayoutOrder, Parent = rowsBox,
    })
    local valueLabels = {}
    local done = tx("TextButton", {
        Text = "Close", TextSize = 12, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.new(1, -24, 0, 34),
        TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 173, Parent = sheet, LayoutOrder = 3,
    }, 3)
    bind(done, "BackgroundColor3", "Accent")
    done.BackgroundTransparency = 0
    round(done, 9)
    done.TextColor3 = onAccent()

    local open = false
    local ticker

    local function build()
        for _, c in ipairs(rowsBox:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        valueLabels = {}
        for i, r in ipairs(Stat.rows()) do
            local row = mk("Frame", {Size = UDim2.new(0, 0, 0, 52), BackgroundColor3 = Pal.Elevated, BackgroundTransparency = 0.08, LayoutOrder = i, ZIndex = 172, Parent = rowsBox})
            round(row, 9)
            outline(row, "Stroke", 1, 0.55)
            tx("TextLabel", {Text = r[1], TextSize = 10, Position = UDim2.fromOffset(9, 5), Size = UDim2.new(1, -18, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 173, Parent = row}, 1, "Sub")
            valueLabels[r[1]] = tx("TextLabel", {
                Text = r[2], TextSize = 12, Position = UDim2.fromOffset(9, 23), Size = UDim2.new(1, -18, 0, 22),
                TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 173, Parent = row,
            }, 3)
        end
    end

    function Window:OpenStats()
        if open then return end
        open = true
        Popup.close(true)
        build()
        layer.Visible = true
        play(layer, 0.25, {BackgroundTransparency = 0.55})
        fadeGroup(sheet, 0.28, 0, Enum.EasingStyle.Quart)
        play(sheetScale, 0.45, {Scale = 1}, Enum.EasingStyle.Back)
        ticker = RunService.Heartbeat:Connect(function(dt)
            for _, r in ipairs(Stat.rows()) do
                local l = valueLabels[r[1]]
                if l and l.Text ~= r[2] then l.Text = r[2] end
            end
        end)
    end

    function Window:CloseStats()
        if not open then return end
        open = false
        if ticker then ticker:Disconnect() ticker = nil end
        play(layer, 0.22, {BackgroundTransparency = 1})
        fadeGroup(sheet, 0.24, 1, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.28, function()
            if not open then
                layer.Visible = false
                restoreGroup(sheet)
            end
        end)
    end

    layer.InputBegan:Connect(function(input)
        if isPointer(input) then Window:CloseStats() end
    end)
    done.InputBegan:Connect(function(input)
        if isPointer(input) then Window:CloseStats() end
    end)

    if P.avatar and P.avatar.Parent then
        local userCard = P.avatar.Parent
        userCard.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                if open then Window:CloseStats() else Window:OpenStats() end
            end
        end)
    end
end

local function attachWindowMethods(Window)
    function Window:MakeTab(cfg) return TabImpl.make(Window, cfg) end
    function Window:SelectTab(tab, instant) TabImpl.select(Window, tab, instant) end
    function Window:Notify(cfg) return Nihon:MakeNotification(cfg) end
    function Window:SetScale(s)
        Window.Scale = math.clamp(tonumber(s) or 1, 0.5, 1.4)
        Window._parts.applyScale(true)
    end
    function Window:SetTitle(t)
        Window.TitleLabel.Text = tostring(t)
        Hud.title = tostring(t)
        Watermark.setText(t)
    end
    function Window:SetSubtitle(t)
        Window.SubtitleLabel.Text = tostring(t)
        Window.SubtitleLabel.Visible = tostring(t) ~= ""
        Watermark.setSub(t)
    end
    function Window:SetIcon(id)
        Window.LogoIcon.Set(id)
        Window.LauncherIcon.Set(id)
    end
    function Window:SetTabIcon(name, id)
        for _, t in ipairs(Window.Tabs) do
            if t.Name == name and t.Name ~= ALWAYS_NAME then t:SetIcon(id) end
        end
    end
    attachSearch(Window)
    attachStats(Window)
    attachSettings(Window)
end

Hooks.attach = attachWindowMethods
if Hooks._pending then
    for _, w in ipairs(Hooks._pending) do attachWindowMethods(w) end
    Hooks._pending = nil
end

function Nihon:Init()
    if Nihon._ready then return end

    if Nihon._keyCfg and not Nihon._keyVerified then
        if Nihon.KeyFile and Nihon.AutoVerify then
            local saved = Nihon:LoadKeyFromFile()
            if saved and saved ~= "" and Nihon:_validateKey(saved) then
                Nihon._keyVerified = true
                if Nihon._keyCfg.OnSuccess then
                    pcall(Nihon._keyCfg.OnSuccess, saved)
                end
            end
        end
        if not Nihon._keyVerified then
            Nihon:_showKeyGate(function() Nihon:Init() end)
            return
        end
    end

    local window = Nihon.Windows[1]
    local cfg = window and window.Cfg or {}
    local function finish()
        if window then
            local has = false
            for _, t in ipairs(window.Tabs) do
                if t.Name == ALWAYS_NAME then has = true break end
            end
            if not has then
                local always = window:MakeTab({Name = ALWAYS_NAME, Icon = ALWAYS_ICON})
                populateAlwaysTab(always)
                local alwaysTab
                for i, t in ipairs(window.Tabs) do
                    if t.Name == ALWAYS_NAME then
                        alwaysTab = table.remove(window.Tabs, i)
                        break
                    end
                end
                if alwaysTab then
                    table.insert(window.Tabs, 1, alwaysTab)
                    for i, t in ipairs(window.Tabs) do
                        t.Index = i
                        t.Button.LayoutOrder = i
                    end
                    if alwaysTab.IconObj then
                        alwaysTab.IconObj.Set(ALWAYS_ICON)
                    end
                    window.Selected = nil
                    window:SelectTab(alwaysTab, true)
                end
            end
        end

        if Nihon.SaveConfig then
            local auto = Nihon:GetAutoload()
            Nihon:LoadProfile(auto or "default")
        end
        for _, fn in ipairs(initFires) do task.spawn(pcall, fn) end
        table.clear(initFires)
        Nihon._ready = true
        if window and Nihon.AutoShow then
            window.Show()
        elseif window and Nihon.ShowLauncher then
            window.Launcher.Visible = true
            window.Launcher.BackgroundTransparency = 0
        end
    end
    loadingScreen(cfg, window and window.Name or "Nihon Lib", finish)
end

function Nihon:Destroy()
    Nihon._ready = false
    Popup.close(true)
    hideTip()
    if rainbowConn then rainbowConn:Disconnect() rainbowConn = nil end
    if noteLoop then noteLoop:Disconnect() noteLoop = nil end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    for _, w in ipairs(Nihon.Windows) do
        pcall(function() w._parts.launcher:Destroy() end)
    end
    Nihon.Windows = {}
    Nihon._keySaveToggle = nil
    pcall(function() Root:Destroy() end)
    if env.NihonLibInstance == Nihon then env.NihonLibInstance = nil end
end

return Nihon
