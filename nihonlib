            LayoutOrder = 1, ZIndex = 25, Parent = c,
        })
        stack(bodyHolder, 2)
        local obj = {Headers = headers, Rows = o.Rows or {}}
        local function buildRows()
            for _, ch in ipairs(bodyHolder:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
            for i, r in ipairs(obj.Rows) do
                local rf = mk("Frame", {Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = i % 2 == 0 and 0.94 or 1, ZIndex = 26, Parent = bodyHolder})
                if i % 2 == 0 then bind(rf, "BackgroundColor3", "Elevated") end
                round(rf, 5)
                for ci = 1, columns do
                    tx("TextLabel", {
                        Text = tostring(r[ci] or ""), TextSize = 11, Size = UDim2.new(1 / columns, -8, 1, 0),
                        Position = UDim2.new((ci - 1) / columns, 6, 0, 0), ZIndex = 27, Parent = rf,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                    }, 2, ci == 1 and "Text" or "Sub")
                end
            end
        end
        function obj:SetRows(r)
            obj.Rows = r or {}
            buildRows()
        end
        function obj:AddRow(r)
            obj.Rows[#obj.Rows + 1] = r
            buildRows()
        end
        function obj:Clear()
            obj.Rows = {}
            buildRows()
        end
        buildRows()
        return decorate(obj, c, o, "Table")
    end

