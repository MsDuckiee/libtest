local function attachWindowMethods(Window)
    function Window:MakeTab(cfg) return TabImpl.make(Window, cfg) end
    function Window:SelectTab(tab, instant) TabImpl.select(Window, tab, instant) end
    function Window:Notify(cfg) return Nihon:MakeNotification(cfg) end
    function Window:SetTitle(t) Window.TitleLabel.Text = tostring(t); Hud.title = tostring(t) end
    function Window:SetIcon(id)
        if Window._parts.titleIcon then Window._parts.titleIcon.Set(id) end
        if Window.Launcher and Window.Launcher:FindFirstChildOfClass("Frame") then end
    end
    Window.RequestOpen = function() if Window.Hidden then Window.Show() end end
    Window.OpenSearch = function()
        -- Not implemented in this build; kept for API parity
    end
    Window.CloseSearch = function() end
    attachSettings(Window)
end

Hooks.attach = attachWindowMethods
if Hooks._pending then
    for _, w in ipairs(Hooks._pending) do attachWindowMethods(w) end
    Hooks._pending = nil
end

