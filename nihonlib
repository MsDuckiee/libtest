            play(shell, 0.32, {BackgroundTransparency = 0.06}, Enum.EasingStyle.Quart)
            play(uiScale, 0.5, {Scale = activeScale}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            if shell:IsA("CanvasGroup") then
                fadeGroup(shell, 0.32, 0)
            else
                for _, d in ipairs(shell:GetDescendants()) do
                    if d:IsA("UIStroke") then
                        local base = d:GetAttribute("_baseTrans") or 0
                        d.Transparency = 1
                        play(d, 0.32, {Transparency = base})
                    end
                end
            end

            task.delay(0.40, function()
                if mine ~= closeToken then return end
                launcher.Visible = false
                launcherScale.Scale = 0
                Window.Morphing = false
            end)
        else
            shell.Size = UDim2.fromOffset(targetW, targetH)
            shell.Visible = true
            uiScale.Scale = activeScale * 0.85
            play(uiScale, 0.55, {Scale = activeScale}, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
